{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SV-Assistent rule candidate; approval is verified by trusted server policy",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "text", "classification", "binding_status", "scope", "sources", "valid_from", "reviewed_at", "dependencies", "exceptions", "supersedes", "test_cases", "approval"],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "text": {"type": "string", "minLength": 1},
    "classification": {"enum": ["rule", "case_fact", "unresolved", "historical_reference"]},
    "binding_status": {"enum": ["ENTWURF", "IN PRÜFUNG", "AKTIV", "ERSETZT", "ARCHIVIERT"]},
    "scope": {
      "type": "object", "additionalProperties": false,
      "required": ["insurers", "lines", "document_types", "workflows"],
      "properties": {
        "insurers": {"$ref": "#/$defs/strings"}, "lines": {"$ref": "#/$defs/strings"},
        "document_types": {"$ref": "#/$defs/strings"}, "workflows": {"$ref": "#/$defs/strings"}
      }
    },
    "sources": {"type": "array", "minItems": 1, "items": {
      "type": "object", "additionalProperties": false,
      "required": ["source_id", "locator", "sha256", "modified_at", "effective_date"],
      "properties": {
        "source_id": {"type": "string", "minLength": 1}, "locator": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "modified_at": {"type": "string", "minLength": 1},
        "effective_date": {"type": ["string", "null"]}
      }
    }},
    "valid_from": {"type": ["string", "null"]}, "reviewed_at": {"type": ["string", "null"]},
    "dependencies": {"$ref": "#/$defs/strings"}, "exceptions": {"$ref": "#/$defs/strings"},
    "supersedes": {"$ref": "#/$defs/strings"}, "test_cases": {"$ref": "#/$defs/strings"},
    "approval": {"type": ["object", "null"], "additionalProperties": false,
      "required": ["decision_id", "approver_id", "content_sha256", "approved_at"],
      "properties": {
        "decision_id": {"type": "string", "minLength": 1}, "approver_id": {"type": "string", "minLength": 1},
        "content_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "approved_at": {"type": "string", "minLength": 1}
      }
    }
  },
  "allOf": [{"if": {"properties": {"binding_status": {"const": "AKTIV"}}},
    "then": {"properties": {"classification": {"const": "rule"}, "approval": {"type": "object"}, "reviewed_at": {"type": "string", "minLength": 1}, "test_cases": {"minItems": 1}}}}],
  "$defs": {"strings": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}}
}
