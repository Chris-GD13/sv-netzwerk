# SV-Netzwerk – Internes Pruefportal – Konfigurationsvorlage
# Kopieren Sie diese Datei als .env in dasselbe Verzeichnis auf dem Server.
# Die .env-Datei wird nie committet oder deployed (exclusion via .gitignore und lftp --exclude-glob).

# ─── Datenbankverbindung ──────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_NAME=sv_intern
DB_USER=sv_intern_user
DB_PASSWORD=

# ─── Anwendungsgeheimnisse ────────────────────────────────────────────────────
# Mindestens 32 zufaellige Zeichen. Erzeugen mit: php -r "echo bin2hex(random_bytes(32));"
APP_SECRET=

# ─── Pfade ────────────────────────────────────────────────────────────────────
# Absoluter Pfad zum Upload-Verzeichnis (ausserhalb Webroot bevorzugt).
# Fallback: relatives Pfad-Beispiel (innerhalb Webroot, durch .htaccess gesichert)
UPLOAD_PATH=../uploads/photos

# ─── Laufzeitumgebung ─────────────────────────────────────────────────────────
# production | development
APP_ENV=production

# ─── Session-Timeouts ─────────────────────────────────────────────────────────
# Inaktivitaets-Timeout in Minuten (Standard: 480 = 8 Stunden)
SESSION_LIFETIME_MINUTES=480
# Absolutes Session-Maximum in Stunden (Standard: 12)
SESSION_ABSOLUTE_HOURS=12

# ─── E-Mail (optional, fuer Passwort-Reset) ───────────────────────────────────
MAIL_FROM=intern@sv-netzwerk.eu
MAIL_FROM_NAME=SV-Netzwerk Intern
