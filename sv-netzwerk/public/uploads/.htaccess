# Sperrt direkten HTTP-Zugriff auf alle Dateien in diesem Verzeichnis.
# Fotos werden ausschliesslich ueber den autorisierten PHP-Endpunkt ausgeliefert.
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
</IfModule>

# PHP-Ausfuehrung in diesem Verzeichnis deaktivieren (redundante Sicherung)
<FilesMatch "\.php$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
</FilesMatch>
