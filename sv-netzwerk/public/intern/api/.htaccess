# API-Verzeichnis – SV-Netzwerk Prüfportal
Options -Indexes
AddDefaultCharset UTF-8

# PHP Upload-Limits für KI-Import (bis 200 MB)
<IfModule mod_php.c>
    php_value upload_max_filesize 200M
    php_value post_max_size 210M
    php_value max_execution_time 300
    php_value memory_limit 512M
</IfModule>

# SharePoint-Excel und intelligente API-Routen.
<IfModule mod_rewrite.c>
    RewriteEngine On

    # GF-KI: Reine Text-/Formularaufträge werden ohne Fallakten-Dateien verarbeitet.
    # Datei-/Belegprüfungen werden vom Smart-Router per 307 mit legacy=1 an den
    # bestehenden vollständigen Generator zurückgegeben.
    RewriteCond %{QUERY_STRING} !(^|&)legacy=1(&|$) [NC]
    RewriteRule ^gf-ai-generate\.php$ gf-ai-smart.php [L,QSA]

    RewriteCond %{QUERY_STRING} (^|&)action=import_sharepoint_excel(&|$) [NC]
    RewriteRule ^sharepoint\.php$ sharepoint-excel-multisheet.php [L,QSA]

    # Rekursiver SharePoint-V2-Import für Fotos, Dokumente und Datenübernahme.
    RewriteCond %{QUERY_STRING} (^|&)action=(list_sharepoint_photos|list_sharepoint_documents|apply_excel)(&|$) [NC]
    RewriteRule ^sharepoint\.php$ sharepoint-v2.php [L,QSA]
</IfModule>

# Sicherheitsheader für API-Antworten
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "DENY"
    Header always set Cache-Control "no-store"
</IfModule>
