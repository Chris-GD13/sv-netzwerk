# API-Verzeichnis – SV-Netzwerk Prüfportal
Options -Indexes
AddDefaultCharset UTF-8

# PHP Upload-Limits für KI-Import (bis 200 MB)
<IfModule mod_php.c>
    php_value upload_max_filesize 200M
    php_value post_max_size 210M
    php_value max_execution_time 300
    php_value memory_limit 512M
</IfModule>

# Rekursiver SharePoint-V2-Import: alle Tabellen und Unterordner konsolidieren.
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{QUERY_STRING} (^|&)action=(import_sharepoint_excel|list_sharepoint_photos|list_sharepoint_documents|apply_excel)(&|$) [NC]
    RewriteRule ^sharepoint\.php$ sharepoint-v2.php [L,QSA]
</IfModule>

# Sicherheitsheader für API-Antworten
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "DENY"
    Header always set Cache-Control "no-store"
</IfModule>
