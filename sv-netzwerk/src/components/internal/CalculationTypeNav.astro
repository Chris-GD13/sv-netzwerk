---
interface Props {
  active: 'bki' | 'insurance' | 'glass' | 'timevalue' | 'value1914';
}

const { active } = Astro.props;
const entries = [
  { id: 'bki', label: 'BKI-Kalkulation', href: '/intern/kalkulation/' },
  { id: 'insurance', label: 'Versicherungsschäden', href: '/intern/kalkulation/versicherungsschaeden/' },
  { id: 'glass', label: 'Glas-Erstattungspreise', href: '/intern/kalkulation/glas-erstattungspreise/' },
  { id: 'timevalue', label: 'Zeitwertberechnung', href: '/intern/zeitwertberechnung/' },
  { id: 'value1914', label: 'Wert 1914', href: '/intern/wert-1914/' },
] as const;
---
<section class="calculation-type-nav" aria-label="Kalkulationsart">
  <label>Berechnungsart
    <select data-calculation-type aria-label="Berechnungsart auswählen">
      {entries.map((entry) => <option value={entry.href} selected={active === entry.id}>{entry.label}</option>)}
    </select>
  </label>
  <noscript><nav>{entries.map((entry) => <a href={entry.href}>{entry.label}</a>)}</nav></noscript>
</section>
<script is:inline>
document.querySelectorAll('[data-calculation-type]').forEach(select => {
  select.addEventListener('change', () => {
    const url = new URL(select.value, location.origin);
    url.search = location.search;
    location.assign(url.pathname + url.search);
  });
});
</script>
<style is:global>
.calculation-type-nav{margin-bottom:16px;color:#17324a}.calculation-type-nav label{display:grid;grid-template-columns:auto minmax(200px,460px);align-items:center;gap:12px;font-weight:800}.calculation-type-nav select{width:100%;min-width:0;border:1px solid #b8c7d2;border-radius:5px;background:#fff;padding:10px 12px;font:inherit;color:#17324a}.calculation-type-nav nav{display:flex;flex-wrap:wrap;gap:10px}@media(max-width:760px){.calculation-type-nav label{grid-template-columns:1fr;gap:5px}}@media print{.calculation-type-nav{display:none!important}}
</style>
