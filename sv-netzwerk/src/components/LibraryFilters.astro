---
import { categories, tags, slugify } from '../data/library';
interface Props { activeCategory?: string; activeTag?: string; }
const { activeCategory, activeTag } = Astro.props;
---
<section class="library-tools" aria-label="Fachartikel filtern und navigieren">
  <div class="search-row">
    <label for="library-search">Beiträge durchsuchen</label>
    <input id="library-search" type="search" placeholder="Suchbegriff eingeben …" autocomplete="off" />
  </div>
  <div class="filter-group">
    <span>Kategorien</span>
    <div class="chips">
      <a class:list={{ active: !activeCategory }} href="/fachwissen/">Alle</a>
      {categories.map((category) => (
        <a class:list={{ active: activeCategory === category }} href={`/fachwissen/kategorie/${slugify(category)}/`}>{category}</a>
      ))}
    </div>
  </div>
  <details>
    <summary>Schlagwörter anzeigen</summary>
    <div class="chips tags">
      {tags.map((tag) => (
        <a class:list={{ active: activeTag === tag }} href={`/fachwissen/tag/${slugify(tag)}/`}>#{tag}</a>
      ))}
    </div>
  </details>
  <p id="library-result-count" class="result-count" aria-live="polite"></p>
</section>

<script>
  const input = document.querySelector<HTMLInputElement>('#library-search');
  const cards = [...document.querySelectorAll<HTMLElement>('[data-library-card]')];
  const resultCount = document.querySelector<HTMLElement>('#library-result-count');
  const normalize = (value: string) => value.toLocaleLowerCase('de-DE').normalize('NFD').replace(/[\u0300-\u036f]/g, '');
  const update = () => {
    const query = normalize(input?.value.trim() ?? '');
    let visible = 0;
    cards.forEach((card) => {
      const matches = !query || normalize(card.dataset.search ?? '').includes(query);
      card.hidden = !matches;
      if (matches) visible += 1;
    });
    if (resultCount) resultCount.textContent = query ? `${visible} Treffer auf dieser Seite` : '';
  };
  input?.addEventListener('input', update);
</script>

<style>
  .library-tools{display:grid;min-width:0;gap:.65rem;margin:0;padding:.75rem 1rem;border:1px solid var(--sv-color-border);border-radius:var(--sv-radius-lg);background:rgba(255,255,255,.62);backdrop-filter:blur(16px)}
  .search-row{display:grid;grid-template-columns:10rem minmax(0,1fr);align-items:center;gap:.75rem}
  .search-row label,.filter-group>span{font-weight:800}
  .search-row input{width:100%;min-width:0;min-height:2.35rem;padding:.25rem .7rem;border:1px solid var(--sv-color-border);border-radius:var(--sv-radius-sm);background:rgba(255,255,255,.78);color:var(--sv-color-ink);font:inherit}
  .filter-group{display:grid;min-width:0;grid-template-columns:8rem minmax(0,1fr);align-items:center;gap:.75rem}
  .chips{display:flex;min-width:0;gap:.4rem;margin:0;padding:.15rem 0;overflow-x:auto;overscroll-behavior-inline:contain;scrollbar-width:thin}
  .chips a{flex:none;padding:.36rem .62rem;border:1px solid var(--sv-color-border);border-radius:999px;color:var(--sv-color-ink);font-size:.8rem;text-decoration:none;white-space:nowrap}
  .chips a:hover,.chips a.active{border-color:var(--sv-color-primary);background:var(--sv-color-primary);color:white}
  details{border-top:1px solid color-mix(in srgb,var(--sv-color-border) 65%,transparent);padding-top:.5rem}
  details summary{cursor:pointer;font-weight:800}
  .tags{margin-top:.6rem;flex-wrap:wrap;overflow:visible}
  .result-count{margin:0;color:var(--sv-color-muted);font-size:.85rem}
  @media(max-width:42rem){
    .library-tools{gap:.9rem;padding:1rem}
    .search-row,.filter-group{grid-template-columns:1fr;align-items:stretch;gap:.35rem}
    .search-row input{min-height:2.75rem}
    .chips{flex-wrap:wrap;overflow:visible}
  }
</style>
