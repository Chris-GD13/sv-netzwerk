---
import Navigation from './Navigation.astro';
import MobileMenu from './MobileMenu.astro';
import HamburgerButton from './HamburgerButton.astro';
import SearchButton from './SearchButton.astro';
import { navigation } from '../data/navigation';
import logoSrc from '../assets/sv-netzwerk-logo-freigestellt-v3.svg';

const currentPath = Astro.url.pathname;
---

<header class="site-header" data-site-header>
  <div class="sv-container site-header__bar">
    <a class="site-brand" href="/" aria-label="SV-Netzwerk – Startseite">
      <img class="site-brand__logo" src={logoSrc.src} alt="" width="220" height="46" />
    </a>

    <Navigation items={navigation} currentPath={currentPath} />

    <div class="site-header__actions">
      <a class="header-platform-cta" href="/gutachter-plattform/anfrage/">
        Gutachter-Plattform
        <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M4 10h12m-5-5 5 5-5 5" /></svg>
      </a>
      <SearchButton />
      <HamburgerButton />
    </div>
  </div>
</header>

<MobileMenu items={navigation} currentPath={currentPath} />

<script is:inline>
  (() => {
    const header = document.querySelector('[data-site-header]');
    const update = () => header?.classList.toggle('is-scrolled', window.scrollY > 16);
    update();
    window.addEventListener('scroll', update, { passive: true });
  })();
</script>
