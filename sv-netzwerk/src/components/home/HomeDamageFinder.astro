---
import { regionalAreas } from '../../data/regions';
const topics=[{name:'Wasserschaden und Rohrbruch',href:'/schadenarten/leitungswasser/',text:'Ursache, Durchfeuchtung, Trocknung und Wiederherstellung prüfen.'},{name:'Brand, Rauch und Ruß',href:'/schadenarten/brand/',text:'Schäden an Gebäude und Hausrat dokumentieren und Sanierungsumfang bewerten.'},{name:'Sturm und Hagel',href:'/schadenarten/sturm/',text:'Dach, Fassade, Fenster und Oberflächen bauteilbezogen untersuchen.'},{name:'Starkregen und Rückstau',href:'/schadenarten/elementar/',text:'Eintrittswege, betroffene Räume und erforderliche Maßnahmen abgrenzen.'}];
---
<section class="v4-section" aria-labelledby="damage-finder-title"><div class="v4-shell"><div class="v4-section-head"><div><p class="v4-kicker"><span></span>Versicherungsschaden prüfen lassen</p><h2 id="damage-finder-title">Was ist passiert?<br/>Wer kann es prüfen?</h2></div><p>Finden Sie den Einstieg für Ihren Schaden und die passende Fachkompetenz nach Standort. Für Versicherungsnehmer, Eigentümer und Versicherer.</p></div><div class="damage-finder-grid">{topics.map((topic)=><article><h3><a href={topic.href}>{topic.name}</a></h3><p>{topic.text}</p><a href={topic.href}>Prüfung und Gutachten ansehen →</a></article>)}</div><p><a href="/schadenarten/">Alle Schadenarten, einschließlich Hausrat, Haftpflicht und Gebäudetechnik →</a></p><h3>Sachverständige und Regulierer nach Standort finden</h3><nav class="region-links" aria-label="Expertenstandorte">{regionalAreas.map((area)=><a href={`/regionen/${area.slug}/`}>{area.city}</a>)}<a href="/regionen/">Standorte und Fachgebiete</a></nav></div></section>
<style>.damage-finder-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1.5rem}.damage-finder-grid article{border:1px solid var(--v4-line);padding:1.5rem;border-radius:var(--sv-radius-sm)}.damage-finder-grid h3{margin-top:0}.damage-finder-grid h3 a{text-decoration:none}.damage-finder-grid p{color:#3f5c6f}.region-links{display:flex;flex-wrap:wrap;gap:.7rem}.region-links a{padding:.65rem .9rem;background:#edf2f5;border-radius:.4rem;text-decoration:none;font-weight:700}@media(max-width:46rem){.damage-finder-grid{grid-template-columns:1fr}}</style>
