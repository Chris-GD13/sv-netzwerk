---
import { sortedLibrary, formatDate } from '../../data/library';
import { getCollection } from 'astro:content';
const entries = await getCollection('knowledge');
const articles = sortedLibrary.filter((item) => item.type === 'article').slice(0,3).map(article => {
  const entry = entries.find(entry => `/fachwissen/${entry.id}/` === article.href || entry.data.seo.canonical === `https://www.sv-netzwerk.eu${article.href}`);
  return { ...article, image: entry?.data.seo.image };
});
---
<section class="v4-section v4-knowledge">
  <div class="v4-shell"><div class="v4-section-head"><div><p class="v4-kicker"><span></span>Fachartikel</p><h2>Aktuell aus der Schadenpraxis.</h2></div><a class="v4-text-link" href="/fachwissen/">Zu den Fachartikeln <span>→</span></a></div>
  <div class="v4-knowledge__grid">{articles.map((article,index) => <article class={index===0?'is-featured':''}>{article.image && <a class="home-article-image" href={article.href} tabindex="-1" aria-hidden="true"><img src={article.image} alt="" width="960" height="540" loading="lazy" decoding="async" /></a>}<div class="v4-knowledge__meta"><span>{article.category}</span><time datetime={article.date}>{formatDate(article.date)}</time></div><h3><a href={article.href}>{article.title}</a></h3><p>{article.description}</p><ul>{article.tags.slice(0,3).map(tag => <li>#{tag}</li>)}</ul><a class="v4-knowledge__read" href={article.href}>Beitrag lesen <span>→</span></a></article>)}</div></div>
</section>

<style>.home-article-image{display:block;margin-bottom:1.25rem;overflow:hidden;border-radius:var(--sv-radius-sm)}.home-article-image img{display:block;width:100%;height:auto;aspect-ratio:16/9;object-fit:cover}</style>
