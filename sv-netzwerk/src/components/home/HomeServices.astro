---
const services = [
  { number: '01', title: 'Sachverständigenleistungen', text: 'Belastbare Feststellungen, technische Bewertungen und klare Empfehlungen für Versicherer und weitere Auftraggeber.', href: '/leistungen/#sachverstaendigenleistungen' },
  { number: '02', title: 'Kosten- und Leistungsprüfung', text: 'Plausibilisierung von Kostenvoranschlägen, Nachträgen und Rechnungen mit nachvollziehbarer Zuordnung zum festgestellten Schadenumfang.', href: '/leistungen/schadenregulierung-fuer-versicherer/' },
  { number: '03', title: 'Kumulschadenmanagement', text: 'Strukturierte Steuerung zahlreicher Schäden aus einem gemeinsamen Ereignis – mit priorisierter Erstaufnahme, einheitlicher Dokumentation und fortlaufender Statusübersicht.', href: '/leistungen/kumulschadenmanagement/' },
  { number: '04', title: 'Regulierung im Komplex- und Großschaden', text: 'Koordinierte Bearbeitung umfangreicher Schadenfälle – von der Erstaufnahme über Reserven, Maßnahmen und Freigaben bis zur dokumentierten Schlusserklärung.', href: '/grossschadenregulierung/' },
];
---
<section class="v4-section home-service-overview" id="leistungen">
  <div class="v4-shell">
    <div class="v4-section-head">
      <div><p class="v4-kicker"><span></span>Leistungen für Versicherer</p><h2>Technischer Befund.<br/>Prüffähige Entscheidung.</h2></div>
      <p>Das SV-Netzwerk verbindet technische Feststellung, Kostenprüfung und koordinierte Schadenbearbeitung. Befund, Ursache, Maßnahmenbedarf, Deckungsprüfung und Kostenfolge bleiben dabei nachvollziehbar getrennt.</p>
    </div>
    <div class="service-list">
      {services.map((service) => (
        <article class="service-item">
          <span>{service.number}</span>
          <div>
            <h3>{service.title}</h3>
            <p>{service.text}</p>
          </div>
          <a href={service.href} aria-label={`${service.title}: Mehr erfahren`}>Mehr erfahren <span aria-hidden="true">→</span></a>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .service-list{border-top:1px solid var(--v4-line)}
  .service-item{display:grid;grid-template-columns:3rem minmax(0,1fr) auto;align-items:start;gap:1.25rem;padding:1.35rem 0;border-bottom:1px solid var(--v4-line)}
  .service-item>span{color:#0d4f73;font-size:.75rem;font-weight:900;letter-spacing:.1em}
  .service-item h3{margin:0 0 .35rem;font-size:clamp(1.05rem,1.8vw,1.35rem)}
  .service-item p{max-width:72ch;margin:0;color:#3f5c6f}
  .service-item a{align-self:center;font-weight:850;color:#0d4f73;text-decoration:none;white-space:nowrap}
  @media(max-width:48rem){.service-item{grid-template-columns:2.25rem minmax(0,1fr)}.service-item a{grid-column:2;justify-self:start;white-space:normal}}
</style>
