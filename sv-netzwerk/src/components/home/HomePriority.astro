---
const priorities = [
  {
    index: '01',
    title: 'Schaden beauftragen',
    text: 'Allgemeine Sachschäden sowie Kumul-, Komplex- und Großschäden mit den erforderlichen Basisdaten und Unterlagen strukturiert einreichen.',
    href: '/schaden-melden/',
    cta: 'Schadenmeldung öffnen',
  },
  {
    index: '02',
    title: 'Leistungen für Versicherer',
    text: 'Technische Feststellung, Kostenprüfung, Entscheidungsvorbereitung und Regulierung im Komplex- und Großschaden kennenlernen.',
    href: '/versicherer/fuer-wen-wir-taetig-sind/',
    cta: 'Versicherer-Leistungen öffnen',
  },
  {
    index: '03',
    title: 'Experten und Fachkompetenz',
    text: 'Sachverständige und Fachplaner nach Fachgebiet, Aufgabenstellung und Region finden und gezielt einbinden.',
    href: '/experten/',
    cta: 'Experten finden',
  },
];
---

<section class="v4-section priority-start" aria-labelledby="prioritaeten">
  <div class="v4-shell">
    <div class="v4-section-head">
      <div>
        <p class="v4-kicker"><span></span>Direkter Einstieg</p>
        <h2 id="prioritaeten">Drei Wege zur passenden Bearbeitung.</h2>
      </div>
      <p>Der Auftrag beginnt mit einer klaren Aufgabenstellung. Wir ordnen Schadenart und Bearbeitungstiefe ein und binden die erforderliche Fachkompetenz ein.</p>
    </div>
    <div class="priority-grid">
      {priorities.map((item) => (
        <article class="priority-card">
          <small>{item.index}</small>
          <h3>{item.title}</h3>
          <p>{item.text}</p>
          <a href={item.href}>{item.cta} <span aria-hidden="true">→</span></a>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .priority-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1rem}
  .priority-card{display:grid;gap:.65rem;padding:clamp(1.1rem,2.4vw,1.5rem);border:1px solid var(--v4-line);border-radius:.9rem;background:rgba(255,255,255,.86)}
  .priority-card small{color:#0d4f73;font-size:.72rem;font-weight:900;letter-spacing:.1em}
  .priority-card h3{margin:0;font-size:1.18rem;line-height:1.2}
  .priority-card p{margin:0;color:#3f5c6f;font-size:.94rem}
  .priority-card a{display:inline-flex;align-items:center;gap:.4rem;margin-top:.3rem;font-weight:850;color:#0d4f73;text-decoration:none}
  @media(max-width:58rem){.priority-grid{grid-template-columns:1fr}}
</style>
