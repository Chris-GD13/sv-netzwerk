---
import BaseLayout from '../../layouts/BaseLayout.astro';
const groups = [
  { title: 'Versicherer und Versicherungsmakler', text: 'Erstaufnahme, technische Abgrenzung, Kostenprüfung und Regulierung im Komplex- und Großschaden.', href: '/versicherer/fuer-wen-wir-taetig-sind/' },
  { title: 'Unternehmen und Immobilienwirtschaft', text: 'Gebäude-, Betriebs- und komplexe Sachschäden mit Beweissicherung, Maßnahmen- und Kostenprüfung.', href: '/auftraggeber/unternehmen-immobilienwirtschaft/' },
  { title: 'Kommunen und öffentliche Auftraggeber', text: 'Prüffähige Entscheidungsgrundlagen für kommunale Liegenschaften, Einrichtungen und Infrastruktur.', href: '/auftraggeber/kommunen-oeffentliche-hand/' },
  { title: 'Private Eigentümer und Bauherren', text: 'Unabhängige technische Prüfung von Ursache, Schadenumfang, Wiederherstellung und Kosten.', href: '/auftraggeber/private-eigentuemer/' },
];
---
<BaseLayout title="Auftraggeber und Leistungen | SV-Netzwerk" description="Sachverständigenleistungen und Schadenbearbeitung für Versicherer, Unternehmen, Kommunen, öffentliche Auftraggeber und private Eigentümer." breadcrumbs={[{ label: 'Start', href: '/' }, { label: 'Auftraggeber' }]}>
  <section class="sv-section"><div class="sv-container intro"><p class="sv-eyebrow">Auftraggeberprofil</p><h1>Unabhängige technische Klarheit für unterschiedliche Auftraggeber</h1><p class="sv-lead">Das SV-Netzwerk bearbeitet Sachschäden im klar abgegrenzten Prüfauftrag. Die fachliche Methode bleibt einheitlich; Bearbeitungstiefe, Kommunikation und Ergebnisform richten sich nach dem Informations- und Entscheidungsbedarf des Auftraggebers.</p><div class="actions"><a class="sv-button sv-button-primary" href="/assets/downloads/auftraggeberprofil-sv-netzwerk.pdf">Auftraggeberprofil als PDF</a><a class="sv-button sv-button-secondary" href="/kontakt/">Zusammenarbeit anfragen</a></div></div></section>
  <section class="sv-section sv-section-alt"><div class="sv-container group-grid">{groups.map((group) => <article class="sv-card"><h2>{group.title}</h2><p>{group.text}</p><a href={group.href}>Leistungen im Detail <span aria-hidden="true">→</span></a></article>)}</div></section>
  <section class="sv-section"><div class="sv-container boundary"><article><p class="sv-eyebrow">Gemeinsamer Standard</p><h2>Feststellung, Bewertung und Zuständigkeit bleiben getrennt</h2><p>Wir verbinden Schadenaufnahme, technische Ursachen- und Umfangsabgrenzung, Beweissicherung sowie KVA-, Nachtrags- und Rechnungsprüfung. Versicherungsrechtliche Deckungsentscheidungen und Rechtsberatung bleiben hiervon getrennt.</p></article><article><p class="sv-eyebrow">Direkte Beauftragung</p><h2>Auch bei bereits laufender Schadenregulierung</h2><p>Private, gewerbliche und öffentliche Auftraggeber können uns auch dann beauftragen, wenn die Bewertung des Versicherers, eines Dienstleisters oder eines ausführenden Unternehmens vom dokumentierten Schadenbild abweicht. Ziel ist eine belastbare technische Grundlage für die weitere Klärung.</p></article></div></section>
</BaseLayout>
<style>.intro{max-width:76rem}.intro .sv-lead{max-width:70ch}.actions{display:flex;flex-wrap:wrap;gap:.75rem;margin-top:1.5rem}.group-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1rem}.group-grid .sv-card{padding:clamp(1.3rem,2.5vw,2rem)}.group-grid h2{font-size:clamp(1.3rem,2vw,1.7rem)}.group-grid a{font-weight:850;text-decoration:none}.boundary{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:3rem}@media(max-width:52rem){.group-grid,.boundary{grid-template-columns:1fr}}</style>
