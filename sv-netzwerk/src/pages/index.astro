---
import HomeLayout from '../layouts/HomeLayout.astro';
import HomeInsurerBand from '../components/home/HomeInsurerBand.astro';
import HomeHero from '../components/home/HomeHero.astro';
import HomeQuestions from '../components/home/HomeQuestions.astro';
import HomeAudiences from '../components/home/HomeAudiences.astro';
import HomeServices from '../components/home/HomeServices.astro';
import HomeTeam from '../components/home/HomeTeam.astro';
import HomeKnowledge from '../components/home/HomeKnowledge.astro';
import HomePodcast from '../components/home/HomePodcast.astro';
import HomeCta from '../components/home/HomeCta.astro';
import HomeDamageFinder from '../components/home/HomeDamageFinder.astro';
---

<HomeLayout
  title="Schadengutachten und Schadenregulierer | SV-Netzwerk"
  description="Sachverständige für Versicherungsschäden, Schadengutachten und Großschadenregulierung. Standort Aalen, bundesweite Koordination für Versicherer und Auftraggeber."
>
  <HomeHero />
  <section class="v4-section" aria-labelledby="start-entry-title">
    <div class="v4-shell">
      <h2 id="start-entry-title">Wer sind Sie?</h2>
      <div class="start-entry-grid">
        <article class="start-entry"><h3>Ich bin betroffen.</h3><p>Sie haben einen Schaden und möchten ihn prüfen lassen. Schildern Sie uns den Fall, wir melden uns mit dem passenden Einstieg.</p><a href="/schaden-melden/">Schaden melden</a></article>
        <article class="start-entry"><h3>Ich bin Versicherer, Makler oder anderer Auftraggeber.</h3><p>Sie brauchen einen Prüfauftrag, eine Kostenprüfung oder eine Regulierung.</p><a href="/versicherer/">Für Versicherer</a> · <a href="/auftraggeber/">Weitere Auftraggeber</a></article>
        <article class="start-entry"><h3>Ich bin Sachverständiger.</h3><p>Sie möchten als unabhängiger Sachverständiger oder Schadenregulierer mit unserem Netzwerk zusammenarbeiten?</p><a href="/sachverstaendige-werden/">Partner im SV-Netzwerk werden</a></article>
      </div>
    </div>
  </section>
  <section class="v4-section" aria-labelledby="start-platform-title">
    <div class="v4-shell"><h2 id="start-platform-title">Unsere Bereiche im Überblick</h2>
      <div class="start-entry-grid">
        <article class="start-entry"><h3>SV-Netzwerk</h3><p>Der Verbund aus Sachverständigen und Regulierern, über den unsere Leistungen laufen.</p></article>
        <article class="start-entry"><h3>Gutachter-Plattform</h3><p>Hier beschreiben wir unsere Leistungen für Auftraggeber und nehmen Prüfaufträge entgegen.</p><a href="/gutachter-plattform/">Zur Plattform</a></article>
        <article class="start-entry"><h3>SVOS</h3><p>Unsere Wissenssammlung mit Fachartikeln zu Schadenbild, Befund und Regulierung.</p><a href="/svos/">Zum SVOS</a></article>
      </div>
    </div>
  </section>
  <HomeQuestions />
  <HomeDamageFinder />
  <HomeKnowledge />
  <HomeTeam />
  <HomeServices />
  <HomeAudiences />
  <HomePodcast />
  <HomeInsurerBand />
  <HomeCta />
</HomeLayout>

<style>.start-entry-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1rem}.start-entry{padding:1.5rem;border:1px solid var(--v4-line);border-radius:1rem;background:#fff}.start-entry h3{margin:0 0 .6rem}.start-entry p{color:#3f5c6f}.start-entry a{color:#0d4f73;font-weight:800}@media(max-width:46rem){.start-entry-grid{grid-template-columns:1fr}}</style>
