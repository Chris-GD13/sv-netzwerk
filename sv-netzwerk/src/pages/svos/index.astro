---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/Hero.astro';
import SectionHeader from '../../components/SectionHeader.astro';
import ProcessFlow from '../../components/platform/ProcessFlow.astro';
import CallToAction from '../../components/CallToAction.astro';

const steps=[
  {title:'Schaden erfassen',text:'Grunddaten, Beteiligte und vorhandene Unterlagen aufnehmen.'},
  {title:'Auftrag und Prüfziel klären',text:'Aufgabenstellung, Bearbeitungstiefe und offene Fragen festlegen.'},
  {title:'Fachkompetenz bestimmen',text:'Erforderliche Fachdisziplinen und Zuständigkeiten einordnen.'},
  {title:'Bearbeitung koordinieren',text:'Qualifikation, Region, Verfügbarkeit und notwendige Übergaben abstimmen.'},
  {title:'Feststellungen dokumentieren',text:'Befunde, Ursachen, Abgrenzungen und offene Punkte nachvollziehbar führen.'},
  {title:'Maßnahmen und Kosten prüfen',text:'Schadenbezug, Erforderlichkeit, Mengen, Leistungen und Kostenfolgen bewerten.'},
  {title:'Ergebnis übergeben',text:'Entscheidungen, Unterlagen, Empfehlungen und verbleibende Punkte prüffähig zusammenführen.'}
];
---
<BaseLayout title="SVOS – Digitale Struktur für Schadenbearbeitung und Regulierung" description="SVOS verbindet Schadenaufnahme, fachliche Zuständigkeiten, Dokumentation, Maßnahmen- und Kostenprüfung zu einer nachvollziehbaren Arbeitsstruktur für Versicherer, Unternehmen und Sachverständige." breadcrumbs={[{label:'Start',href:'/'},{label:'SVOS'}]}>
  <Hero compact eyebrow="Digitale Arbeits- und Prozessstruktur" title="Vom Schadenereignis zur prüffähigen Entscheidung." text="SVOS strukturiert die Schadenaufnahme, das Prüfziel, die fachlichen Zuständigkeiten, Unterlagen, Feststellungen, Maßnahmen und Kosten. Dadurch entsteht eine nachvollziehbare Arbeitsgrundlage für Sachverständige, Schadenregulierer, Versicherer und Unternehmen." primaryLabel="Schadenbearbeitung anfragen" primaryHref="/schaden-melden/" secondaryLabel="Fachwissen ansehen" secondaryHref="/fachwissen/" />

  <section class="sv-section sv-section-alt"><div class="sv-container">
    <SectionHeader eyebrow="Im Überblick" title="Die wesentlichen Arbeitsschritte nachvollziehbar verbunden"/>
    <div class="features">
      <article><h3>Strukturierte Schadenaufnahme</h3><p>Grunddaten, Beteiligte, Unterlagen und Prüfauftrag werden von Beginn an geordnet zusammengeführt.</p></article>
      <article><h3>Qualifikationsbezogene Zuständigkeit</h3><p>Fachdisziplin, Bearbeitungstiefe und Verantwortlichkeiten werden passend zur Aufgabenstellung bestimmt.</p></article>
      <article><h3>Prüffähige Dokumentation</h3><p>Feststellungen, Maßnahmen, Kostenstände, Entscheidungen und offene Punkte bleiben nachvollziehbar.</p></article>
    </div>
  </div></section>

  <section class="sv-section"><div class="sv-container">
    <SectionHeader eyebrow="Prozess" title="Sieben Stationen mit dokumentierter Übergabe"/>
    <ProcessFlow steps={steps}/>
  </div></section>

  <section class="sv-section sv-section-alt"><div class="sv-container">
    <SectionHeader eyebrow="Vorteile" title="Eine gemeinsame Struktur für alle fachlich Beteiligten"/>
    <div class="audiences">
      <article><h3>Versicherer und Schadenabteilungen</h3><p>Prüffähige Bearbeitungsstände, transparente Zuständigkeiten und belastbare Entscheidungsgrundlagen.</p></article>
      <article><h3>Sachverständige und Fachplaner</h3><p>Klar abgegrenzte Prüfaufträge, strukturierte Unterlagen und dokumentierte Fachverantwortung.</p></article>
      <article><h3>Schadenregulierung und Koordination</h3><p>Verknüpfte Feststellungen, Maßnahmen, Kostenstände und eindeutig benannte Entscheidungspunkte.</p></article>
      <article><h3>Fach- und Sanierungsunternehmen</h3><p>Eindeutige Leistungsgrenzen, dokumentierte Übergaben und nachvollziehbare Rückmeldungen.</p></article>
    </div>
  </div></section>

  <section class="sv-section"><div class="sv-container responsibility">
    <SectionHeader eyebrow="Verantwortung" title="Fachliche und vertragliche Entscheidungen bleiben klar zugeordnet"/>
    <p>SVOS trifft keine automatischen Fach- oder Deckungsentscheidungen. Die fachliche Verantwortung verbleibt beim jeweils zuständigen Bearbeiter; die versicherungsvertragliche Entscheidung liegt beim Versicherer.</p>
  </div></section>

  <CallToAction title="Schadenbearbeitung und Einsatz einordnen" text="Wir klären Aufgabenstellung, Prüfziel, beteiligte Fachdisziplinen, benötigte Unterlagen und die erforderlichen Übergaben gemeinsam." href="/kontakt/" label="Anwendungsfall besprechen" />
</BaseLayout>

<style>
.features,.audiences{display:grid;gap:1rem}
.features{grid-template-columns:repeat(3,1fr)}
.audiences{grid-template-columns:repeat(4,1fr)}
.features article,.audiences article{padding:1.4rem;border-top:3px solid var(--sv-color-accent);background:white}
.features p,.audiences p,.responsibility>p{color:var(--sv-color-muted)}
.responsibility>p{max-width:68rem;font-size:1.1rem;line-height:1.75}
@media(max-width:58rem){.features,.audiences{grid-template-columns:repeat(2,1fr)}}
@media(max-width:36rem){.features,.audiences{grid-template-columns:1fr}}
</style>
