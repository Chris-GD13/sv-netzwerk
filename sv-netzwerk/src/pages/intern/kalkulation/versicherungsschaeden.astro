---
import InternalLayout from '../../../layouts/InternalLayout.astro';
import logoSrc from '../../../assets/sv-netzwerk-logo-freigestellt-v3.svg';
import positions from '../../../data/insurance-damage-prices.json';
import CalculationTypeNav from '../../../components/internal/CalculationTypeNav.astro';
const groups = [...new Set(positions.map((p) => p.group))];
---
<InternalLayout title="Kalkulation Versicherungsschäden" description="Kalkulation typischer Leistungen bei Versicherungsschäden mit fest hinterlegten Listenpreisen.">
  <main class="vs-app" data-positions={JSON.stringify(positions)}>
    <nav class="vs-nav"><a href="/intern/versicherungsfaelle/">← Zurück zum Versicherungsportal</a></nav>
    <CalculationTypeNav active="insurance" />
    <section class="vs-head"><div><p class="vs-kicker">Versicherungsschäden</p><h1>Kalkulation Versicherungsschäden</h1><p>Leckageortung, Trocknung, Sanierung, Rückbau und weitere typische Schadenleistungen mit fest hinterlegten Netto-Einheitspreisen.</p></div><div id="vs-case" class="vs-case">Freie Kalkulation · keinem Fall zugeordnet</div></section>
    <section class="vs-card vs-catalog">
      <div class="vs-tools"><label>Position suchen<input id="vs-search" type="search" placeholder="z. B. Trocknung, Rückbau, Leckage …"></label><button id="vs-clear" class="secondary" type="button">Auswahl löschen</button></div>
      <div class="vs-groups"><button class="group on" data-group="Alle">Alle</button>{groups.map((group) => <button class="group" data-group={group}>{group}</button>)}</div>
      <div id="vs-list" class="vs-list"></div>
      <div class="vs-actions"><button id="vs-add" class="primary" type="button">Auswahl übernehmen</button><span id="vs-state"></span></div>
      <p class="vs-source">Preisstand 2025/2026. Festpreise ohne Regionalfaktor. Positionen ohne Listenpreis bleiben editierbare Freipositionen. Prozentpositionen werden auf den als Menge eingetragenen Fremdkostenbetrag berechnet.</p>
    </section>
    <section class="vs-card vs-protocol">
      <div class="print-logo"><img src={logoSrc.src} alt="SV-Netzwerk"></div>
      <div class="title-row"><div><p class="print-kicker">Versicherungsschäden</p><h2>Kalkulation</h2></div><button id="vs-manual" class="secondary" type="button">Freie Position hinzufügen</button></div>
      <div class="table-wrap"><table><thead><tr><th>Pos.</th><th>Leistung</th><th>Menge</th><th>Einheit</th><th>EP netto</th><th>Gesamt netto</th><th></th></tr></thead><tbody id="vs-lines"></tbody></table></div>
      <div class="summary"><label>USt. %<input id="vs-vat" type="number" value="19"></label><div><span>Netto</span><strong id="vs-net">0,00 €</strong></div><div><span>USt.</span><strong id="vs-tax">0,00 €</strong></div><div class="grand"><span>Brutto</span><strong id="vs-gross">0,00 €</strong></div></div>
      <div class="notes"><strong>Hinweise / Vereinbarungen</strong><div class="checks"><label><input type="checkbox" class="note-choice" value="Kalkulation vor Ort mit dem VN besprochen; der VN stimmt der Kalkulation zu."> Kalkulation vor Ort mit VN besprochen; VN stimmt der Kalkulation zu.</label><label><input type="checkbox" class="note-choice" value="Die Kalkulation verwendet fest hinterlegte Einheitspreise für typische Leistungen bei Versicherungsschäden."> Fest hinterlegte Einheitspreise für typische Leistungen bei Versicherungsschäden verwendet.</label><label><input type="checkbox" class="note-choice" value="Der ausgewiesene Betrag wird als pauschale Abgeltung an den VN ausgezahlt."> Betrag wird als pauschale Abgeltung an den VN ausgezahlt.</label><label><input type="checkbox" class="note-choice" value="Die Auszahlung bzw. Abgeltungsvereinbarung steht unter dem Vorbehalt der Zustimmung des Versicherers."> Auszahlung/Abgeltung vorbehaltlich Zustimmung des Versicherers.</label></div><label class="note">Zusätzlicher Hinweis / Abgeltungsvermerk<textarea id="vs-note" rows="3"></textarea></label></div>
      <div class="signatures"><div class="sign-options"><label><input type="checkbox"> Keine Unterschrift erforderlich</label><label><input type="checkbox"> Zur Unterzeichnung per E-Mail an VN/Bevollmächtigten versandt</label></div><label class="date">Datum<input id="vs-date" type="date"></label><div class="sign-grid"><div><div class="sig-line"></div><strong>VN oder Bevollmächtigter</strong></div><div><input id="vs-regulator" class="sig-name" placeholder="Name Regulierer"><div class="sig-line"></div><strong>Regulierer</strong></div></div></div>
      <div class="footer-actions"><button id="vs-save" class="primary" type="button">Kalkulation speichern</button><button id="vs-print" class="secondary" type="button">Drucken / PDF</button><span id="vs-save-state"></span></div>
    </section>
  </main>
</InternalLayout>
<style is:global>
:root{--vs:#17324a;--muted:#687b8c;--orange:#ff970f;--line:#dce5ec}.vs-app{max-width:1450px;margin:auto;padding:18px 24px 56px;color:var(--vs)}.vs-nav{display:flex;gap:10px;margin-bottom:12px}.vs-nav a{border:1px solid #b8c7d2;background:#fff;color:var(--vs);border-radius:9px;padding:9px 13px;font-weight:800;text-decoration:none}.vs-head{display:flex;justify-content:space-between;gap:24px;margin-bottom:16px}.vs-head h1{margin:4px 0}.vs-head p{color:var(--muted)}.vs-kicker,.print-kicker{margin:0;color:var(--orange)!important;font-weight:800}.vs-case{background:#eef4f7;border:1px solid var(--line);border-radius:12px;padding:10px 13px;font-weight:750;max-width:460px}.vs-case.on{background:#eaf6f0;color:#236e50}.vs-card{background:#fff;border:1px solid var(--line);border-radius:15px;padding:18px;margin-bottom:16px}.vs-tools,.vs-actions,.footer-actions,.title-row{display:flex;align-items:end;justify-content:space-between;gap:12px}.vs-tools label{flex:1;font-size:.78rem;font-weight:800;color:#536a7d}.vs-tools input,.summary input,.note textarea,.item input,.vs-protocol td input{box-sizing:border-box;border:1px solid #bdcbd6;border-radius:8px;padding:9px}.vs-tools input,.note textarea{display:block;width:100%;margin-top:4px}.vs-groups{display:flex;flex-wrap:wrap;gap:7px;margin:14px 0}.group{border:1px solid #bdcbd6;background:#f7fafc;color:var(--vs);border-radius:999px;padding:7px 11px;font-weight:800}.group.on{background:var(--vs);color:#fff}.vs-list{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px;max-height:620px;overflow:auto}.item{display:grid;grid-template-columns:auto 1fr 90px 55px 105px;gap:8px;align-items:center;border:1px solid var(--line);border-radius:11px;padding:9px}.item.off{display:none}.item.checked{background:#fff8ee;border-color:var(--orange)}.item .code{font-size:.73rem;color:#5d7283}.item .desc{font-weight:750}.item .price{text-align:right;font-weight:800}.item input[type=checkbox]{width:18px;height:18px}.item .qty,.item .manual-price{width:100%;text-align:right}.vs-actions{justify-content:flex-start;margin-top:14px}.primary,.secondary{border-radius:9px;padding:10px 14px;font-weight:800;cursor:pointer}.primary{background:var(--vs);color:#fff;border:1px solid var(--vs)}.secondary{background:#fff;border:1px solid #b8c7d2}.vs-source{font-size:.76rem;color:var(--muted);margin:12px 0 0}.print-logo{display:none}.title-row{align-items:center}.title-row h2{margin:2px 0}.table-wrap{overflow:auto}table{width:100%;border-collapse:collapse;min-width:900px}th,td{padding:8px;border-bottom:1px solid #e4ebf0;text-align:left}td .desc{min-width:300px;width:100%}.remove{border:0;background:#fff1f1}.summary{display:grid;grid-template-columns:130px repeat(3,1fr);gap:10px;margin-top:18px}.summary>div{background:#f5f8fa;border-radius:10px;padding:10px}.summary span,.summary strong{display:block}.summary .grand{background:#edf5f1}.notes,.signatures{margin-top:18px;border-top:1px solid var(--line);padding-top:14px}.checks{display:grid;gap:7px;margin-top:10px}.checks label,.sign-options label{display:flex;gap:8px;font-size:.88rem}.note{display:block;margin-top:12px;font-size:.78rem;font-weight:800;color:#536a7d}.sign-options{display:flex;gap:24px;flex-wrap:wrap}.date{display:block;margin-top:14px}.date input{display:block;padding:7px;margin-top:4px}.sign-grid{display:grid;grid-template-columns:1fr 1fr;gap:60px;margin-top:34px}.sig-line{height:34px;border-bottom:1px solid #405466}.sig-name{width:100%;border:0;border-bottom:1px dashed #9aabb8;padding:5px 0}.footer-actions{justify-content:flex-start;margin-top:16px}@media(max-width:900px){.vs-list{grid-template-columns:1fr}.vs-head{display:block}}@media print{@page{margin:12mm 14mm}.intern-header,.vs-nav,.vs-head,.vs-catalog,.footer-actions,#vs-manual,.skip-link{display:none!important}html,body{background:#fff!important}.vs-app{padding:0;max-width:none}.vs-card{border:0;padding:0;margin:0}.print-logo{display:block;margin-bottom:8mm}.print-logo img{width:58mm}table{min-width:0;font-size:9pt}td input{border:0!important}.remove{display:none}.summary{grid-template-columns:repeat(4,1fr)}}
</style>
<script is:inline>
(()=>{const root=document.querySelector('.vs-app'),positions=JSON.parse(root?.dataset.positions||'[]'),$=id=>document.getElementById(id),money=v=>new Intl.NumberFormat('de-DE',{style:'currency',currency:'EUR'}).format(Number(v)||0),num=v=>{const n=Number(String(v??'').replace(',','.'));return Number.isFinite(n)?n:0},percentCodes=new Set(['01.04.002','07.00.001','14.03.000']);let lines=[],active=null,currentGroup='Alle';for(const s of[sessionStorage,localStorage])try{const d=JSON.parse(s.getItem('svnet-case')||'null');if(d?.folder_id){active=d;break}}catch{}const meta=active?.meta||{};if(active){$('vs-case').classList.add('on');$('vs-case').textContent=`Fall ${meta.schaden_nr||'ohne Schaden-Nr.'} · ${meta.schadenart||'Schaden'} · ${meta.vn_objekt||meta.ort||''}`}try{const u=JSON.parse(localStorage.getItem('svnet-user')||sessionStorage.getItem('svnet-user')||'null');$('vs-regulator').value=u?.name||u?.display_name||u?.full_name||''}catch{}$('vs-date').value=new Date().toISOString().slice(0,10);const esc=s=>String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));function drawCatalog(){const q=$('vs-search').value.trim().toLowerCase(),list=$('vs-list');list.innerHTML='';positions.forEach((p,i)=>{if(currentGroup!=='Alle'&&p.group!==currentGroup)return;if(q&&!`${p.code} ${p.description} ${p.group}`.toLowerCase().includes(q))return;const e=document.createElement('div');e.className='item';const percent=percentCodes.has(p.code),open=p.price===null;e.innerHTML=`<input type="checkbox" data-pick="${i}"><div><div class="code">${esc(p.code)} · ${esc(p.group)}</div><div class="desc">${esc(p.description)}</div></div><input class="qty" data-qty="${i}" inputmode="decimal" value="1" title="${percent?'Fremdkosten netto':'Menge'}"><span>${percent?'€ Basis':esc(p.unit)}</span>${open?`<input class="manual-price" data-price="${i}" inputmode="decimal" placeholder="EP netto">`:`<span class="price">${percent?'15 %':money(p.price)}</span>`}`;const cb=e.querySelector('[data-pick]');cb.onchange=()=>e.classList.toggle('checked',cb.checked);list.appendChild(e)});}function add(p={}){lines.push({position_code:p.code||'',description:p.description||'Freie Position',quantity:num(p.quantity)||1,unit:p.unit||'St',unit_price:num(p.price)});render()}function totals(){const net=lines.reduce((s,l)=>s+l.quantity*l.unit_price,0),vat=num($('vs-vat').value),tax=net*vat/100;return{net,tax,gross:net+tax,vat}}function render(){const b=$('vs-lines');b.innerHTML='';lines.forEach((l,i)=>{const tr=document.createElement('tr');tr.innerHTML=`<td>${esc(l.position_code||i+1)}</td><td><input class="desc" data-i="${i}" data-k="description" value="${esc(l.description)}"></td><td><input data-i="${i}" data-k="quantity" value="${l.quantity}"></td><td><input data-i="${i}" data-k="unit" value="${esc(l.unit)}"></td><td><input data-i="${i}" data-k="unit_price" value="${l.unit_price}"></td><td>${money(l.quantity*l.unit_price)}</td><td><button class="remove" data-remove="${i}">×</button></td>`;b.appendChild(tr)});b.querySelectorAll('input').forEach(n=>n.onchange=()=>{const i=+n.dataset.i,k=n.dataset.k;lines[i][k]=['quantity','unit_price'].includes(k)?num(n.value):n.value;render()});b.querySelectorAll('[data-remove]').forEach(x=>x.onclick=()=>{lines.splice(+x.dataset.remove,1);render()});const t=totals();$('vs-net').textContent=money(t.net);$('vs-tax').textContent=money(t.tax);$('vs-gross').textContent=money(t.gross)}$('vs-search').oninput=drawCatalog;document.querySelectorAll('.group').forEach(b=>b.onclick=()=>{currentGroup=b.dataset.group;document.querySelectorAll('.group').forEach(x=>x.classList.toggle('on',x===b));drawCatalog()});$('vs-clear').onclick=()=>{drawCatalog();$('vs-state').textContent=''};$('vs-add').onclick=()=>{let n=0;document.querySelectorAll('[data-pick]:checked').forEach(cb=>{const i=+cb.dataset.pick,p=positions[i],quantity=num(document.querySelector(`[data-qty="${i}"]`)?.value)||1,manual=num(document.querySelector(`[data-price="${i}"]`)?.value),percent=percentCodes.has(p.code);if(p.price===null&&manual<=0)return;add({...p,quantity,unit:percent?'€ Basis':p.unit,price:p.price===null?manual:p.price});n++});$('vs-state').textContent=n?`${n} Position(en) übernommen.`:'Keine Position mit gültigem Preis ausgewählt.'};$('vs-manual').onclick=()=>add();$('vs-vat').oninput=render;$('vs-print').onclick=()=>window.print();function note(){return[...[...document.querySelectorAll('.note-choice:checked')].map(x=>x.value),$('vs-note').value.trim()].filter(Boolean).join('\n')}async function api(url,opt={}){const r=await fetch(url,{credentials:'same-origin',...opt}),j=await r.json().catch(()=>({}));if(!r.ok)throw new Error(j.error||`HTTP ${r.status}`);return j}$('vs-save').onclick=async()=>{if(!lines.length)return;try{const d=await api('/intern/api/bki-calculator.php?action=save',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({folder_id:active?.folder_id||'',case_meta:meta,location:[meta.plz,meta.ort].filter(Boolean).join(' '),note:note(),items:lines.map(l=>({...l,regional_factor:1})),totals:totals(),calculation_type:'Versicherungsschäden'})});$('vs-save-state').textContent=`Gespeichert · Kalkulation ${d.id||''}${active?.folder_id?' · in Fallakte archiviert':''}`}catch(e){$('vs-save-state').textContent=e.message}};drawCatalog();render()})();
</script>
