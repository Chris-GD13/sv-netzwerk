---
import InternalLayout from '../../../layouts/InternalLayout.astro';
import logoSrc from '../../../assets/sv-netzwerk-logo-freigestellt-v3.svg';
import positions from '../../../data/insurance-damage-prices.json';
import CalculationTypeNav from '../../../components/internal/CalculationTypeNav.astro';
const groups = [...new Set(positions.map((p) => p.group))];
---
<InternalLayout title="Kalkulation Versicherungsschäden" description="Kalkulation typischer Leistungen bei Versicherungsschäden mit fest hinterlegten Listenpreisen.">
  <main class="vs-app" data-positions={JSON.stringify(positions)}>
    <nav class="vs-nav"><a href="/intern/versicherungsfaelle/">← Zurück zum Versicherungsportal</a></nav>
    <CalculationTypeNav active="insurance" />
    <section class="vs-head"><div><p class="vs-kicker">Versicherungsschäden</p><h1>Kalkulation Versicherungsschäden</h1><p>Leckageortung, Trocknung, Sanierung, Rückbau und weitere typische Schadenleistungen mit fest hinterlegten Netto-Einheitspreisen.</p></div><div class="vs-case-tools"><div id="vs-case" class="vs-case">Freie Kalkulation · keinem Fall zugeordnet</div><button id="vs-case-calc" class="primary vs-case-calc" type="button" disabled>Diesen Fall kalkulieren</button><small id="vs-case-calc-note">Aktiven Wasserschaden öffnen, um den Schnelldurchgang zu starten.</small></div></section>
    <section class="vs-card vs-catalog">
      <div class="vs-tools"><label>Position suchen<input id="vs-search" type="search" placeholder="z. B. Trocknung, Rückbau, Leckage …"></label><button id="vs-clear" class="secondary" type="button">Auswahl löschen</button></div>
      <div class="vs-groups"><button class="group on" data-group="Alle">Alle</button>{groups.map((group) => <button class="group" data-group={group}>{group}</button>)}</div>
      <div id="vs-list" class="vs-list"></div>
      <div class="vs-actions"><button id="vs-add" class="primary" type="button">Auswahl übernehmen</button><span id="vs-state"></span></div>
      <p class="vs-source">Preisstand 2025/2026. Festpreise ohne Regionalfaktor. Positionen ohne Listenpreis bleiben editierbare Freipositionen. Prozentpositionen werden auf den als Menge eingetragenen Fremdkostenbetrag berechnet.</p>
    </section>
    <section class="vs-card vs-protocol">
      <div class="print-logo"><img src={logoSrc.src} alt="SV-Netzwerk"></div>
      <div class="title-row"><div><p class="print-kicker">Versicherungsschäden</p><h2>Kalkulation</h2></div><button id="vs-manual" class="secondary" type="button">Freie Position hinzufügen</button></div>
      <div class="table-wrap"><table><thead><tr><th>Pos.</th><th>Leistung</th><th>Menge</th><th>Einheit</th><th>EP netto</th><th>Gesamt netto</th><th></th></tr></thead><tbody id="vs-lines"></tbody></table></div>
      <div class="summary"><label>USt. %<input id="vs-vat" type="number" value="19"></label><div><span>Netto</span><strong id="vs-net">0,00 €</strong></div><div><span>USt.</span><strong id="vs-tax">0,00 €</strong></div><div class="grand"><span>Brutto</span><strong id="vs-gross">0,00 €</strong></div></div>
      <div class="notes"><strong>Hinweise / Vereinbarungen</strong><div class="checks"><label><input type="checkbox" class="note-choice" value="Kalkulation vor Ort mit dem VN besprochen; der VN stimmt der Kalkulation zu."> Kalkulation vor Ort mit VN besprochen; VN stimmt der Kalkulation zu.</label><label><input type="checkbox" class="note-choice" value="Die Kalkulation verwendet fest hinterlegte Einheitspreise für typische Leistungen bei Versicherungsschäden."> Fest hinterlegte Einheitspreise für typische Leistungen bei Versicherungsschäden verwendet.</label><label><input type="checkbox" class="note-choice" value="Der ausgewiesene Betrag wird als pauschale Abgeltung an den VN ausgezahlt."> Betrag wird als pauschale Abgeltung an den VN ausgezahlt.</label><label><input type="checkbox" class="note-choice" value="Die Auszahlung bzw. Abgeltungsvereinbarung steht unter dem Vorbehalt der Zustimmung des Versicherers."> Auszahlung/Abgeltung vorbehaltlich Zustimmung des Versicherers.</label><label><input type="checkbox" class="note-choice" value="Mit der vereinbarten Zahlung sind ausschließlich die in dieser Kalkulation ausdrücklich als abgegolten bezeichneten Schadenpositionen abschließend reguliert."> Die ausdrücklich als abgegolten bezeichneten Schadenpositionen sind abschließend reguliert.</label></div><div class="optical-settlement"><div><strong>Optischer Schaden</strong><span>Fügt eine editierbare Abgeltungsvereinbarung für ausdrücklich bezeichnete Positionen ein.</span></div><button type="button" class="secondary" data-optical-settlement-template data-note-target="vs-note">Mustertext einfügen</button></div><label class="note">Zusätzlicher Hinweis / Abgeltungsvermerk<textarea id="vs-note" rows="3" data-auto-grow></textarea></label></div>
      <div class="signatures" data-signature-section><div class="sign-options"><label><input type="checkbox" data-signature-alternative> Keine Unterschrift erforderlich</label><label><input type="checkbox" data-signature-alternative> Zur Unterzeichnung per E-Mail an VN/Bevollmächtigten versandt</label><label><input id="vs-sign-on-site" type="checkbox" data-signature-toggle> VN/Bevollmächtigter unterschreibt jetzt vor Ort</label></div><div class="signature-capture" data-signature-capture hidden><div class="signature-capture-head"><strong>Unterschrift VN oder Bevollmächtigter</strong><button type="button" class="secondary" data-signature-clear>Unterschrift löschen</button></div><canvas data-signature-canvas aria-label="Unterschriftenfeld für VN oder Bevollmächtigten"></canvas><small>Bitte mit Finger oder Stift im Feld unterschreiben.</small></div><label class="date">Datum<input id="vs-date" type="date"></label><div class="sign-grid"><div data-signature-print><div class="sig-line"></div><strong>VN oder Bevollmächtigter</strong></div><div><input id="vs-regulator" class="sig-name" placeholder="Name Regulierer"><div class="sig-line"></div><strong>Regulierer</strong></div></div></div>
      <div class="footer-actions"><button id="vs-save" class="primary" type="button">Kalkulation speichern</button><button id="vs-print" class="secondary" type="button">Drucken / PDF</button><span id="vs-save-state"></span></div>
    </section>
    <section class="vs-card vs-history">
      <div class="title-row"><div><p class="print-kicker">Fallakte</p><h2>Gespeicherte Kalkulationen</h2></div><button id="vs-history-refresh" class="secondary" type="button">Neu laden</button></div>
      <p class="vs-history-help">Hier stehen die gespeicherten Kalkulationen des aktiven Falls. „Weiter bearbeiten“ lädt Positionen, Mengen, Preise, Umsatzsteuer und Hinweise wieder in die Kalkulation oben.</p>
      <div id="vs-history" class="vs-history-list">Gespeicherte Kalkulationen werden geladen …</div>
    </section>
    <dialog id="vs-view-dialog" class="vs-dialog"><div class="vs-dialog-head"><div><p class="print-kicker">Gespeicherte Kalkulation</p><h2 id="vs-view-title">Kalkulation</h2></div><button id="vs-view-close" class="secondary" type="button">Schließen</button></div><div id="vs-view-content"></div></dialog>
  </main>
</InternalLayout>
<style is:global>
:root{--vs:#17324a;--muted:#687b8c;--orange:#ff970f;--line:#d9dde1}.vs-app{max-width:1450px;margin:auto;padding:18px 24px 56px;color:var(--vs)}.vs-nav{display:flex;gap:10px;margin-bottom:12px}.vs-nav a{border:1px solid #b8c7d2;background:#fff;color:var(--vs);border-radius:3px;padding:9px 13px;font-weight:800;text-decoration:none}.vs-head{display:flex;align-items:flex-start;justify-content:space-between;gap:24px;margin-bottom:16px}.vs-head h1{margin:4px 0}.vs-head p{color:var(--muted)}.vs-kicker,.print-kicker{margin:0;color:var(--orange)!important;font-weight:800}.vs-case-tools{display:grid;gap:7px;width:min(460px,100%);align-self:flex-start}.vs-case{background:#eef0f2;border:1px solid var(--line);border-left:4px solid var(--orange);border-radius:3px;padding:7px 13px;font-weight:750;min-height:0;line-height:1.35}.vs-case.on{background:#eaf6f0;color:#236e50}.vs-case-calc{width:100%}.vs-case-calc:disabled{cursor:not-allowed;opacity:.5}.vs-case-tools small{color:var(--muted);line-height:1.3}.vs-card{background:#fff;border:1px solid var(--line);border-radius:3px;padding:18px;margin-bottom:16px;box-shadow:0 2px 8px rgba(7,26,46,.05)}.vs-tools,.vs-actions,.footer-actions,.title-row{display:flex;align-items:end;justify-content:space-between;gap:12px}.vs-tools label{flex:1;font-size:.78rem;font-weight:800;color:#536a7d}.vs-tools input,.summary input,.note textarea,.item input,.vs-protocol td input{box-sizing:border-box;border:1px solid #bdcbd6;border-radius:3px;padding:9px}.vs-tools input:focus,.summary input:focus,.note textarea:focus,.item input:focus,.vs-protocol td input:focus{border-color:var(--orange);outline:2px solid rgba(255,151,15,.18);outline-offset:1px}.vs-tools input,.note textarea{display:block;width:100%;margin-top:4px}.vs-groups{display:flex;flex-wrap:wrap;gap:6px;margin:14px 0}.group{border:1px solid #bdcbd6;background:#f4f5f6;color:var(--vs);border-radius:3px;padding:8px 12px;font-weight:800}.group:hover{border-color:var(--orange);background:#fff7ed}.group.on{border-color:var(--vs);background:var(--vs);color:#fff}.vs-list{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px;max-height:620px;overflow:auto;padding-right:4px}.item{display:grid;grid-template-columns:auto 1fr 90px 55px 105px;gap:8px;align-items:center;border:1px solid var(--line);border-radius:3px;padding:10px;background:#fff}.item.off{display:none}.item.checked{background:#fff8ee;border-color:var(--orange);box-shadow:inset 4px 0 0 var(--orange)}.item .code{font-size:.73rem;color:#5d7283}.item .desc{font-weight:750}.item .price{text-align:right;font-weight:800}.item input[type=checkbox]{width:18px;height:18px;accent-color:var(--orange)}.item .qty,.item .manual-price{width:100%;text-align:right}.vs-actions{justify-content:flex-start;margin-top:14px}.primary,.secondary{border-radius:3px;padding:10px 14px;font-weight:800;cursor:pointer}.primary{background:var(--vs);color:#fff;border:1px solid var(--vs)}.primary:hover{background:#24445f}.secondary{background:#fff;border:1px solid #b8c7d2;color:var(--vs)}.secondary:hover{border-color:var(--orange);background:#fff7ed}.vs-source{font-size:.76rem;color:var(--muted);margin:12px 0 0}.print-logo{display:none}.title-row{align-items:center}.title-row h2{margin:2px 0}.table-wrap{overflow:auto}table{width:100%;border-collapse:collapse;min-width:900px}th,td{padding:8px;border-bottom:1px solid #e4ebf0;text-align:left}th{background:#17324a;color:#fff}td .desc{min-width:300px;width:100%}.remove{border:1px solid #f1d1d1;border-radius:3px;background:#fff1f1}.summary{display:grid;grid-template-columns:130px repeat(3,1fr);gap:10px;margin-top:18px}.summary>div{background:#f5f8fa;border:1px solid var(--line);border-radius:3px;padding:10px}.summary span,.summary strong{display:block}.summary .grand{background:#edf5f1}.notes,.signatures{margin-top:18px;border-top:1px solid var(--line);padding-top:14px}.checks{display:grid;gap:7px;margin-top:10px}.checks label,.sign-options label{display:flex;gap:8px;font-size:.88rem}.note{display:block;margin-top:12px;font-size:.78rem;font-weight:800;color:#536a7d}.sign-options{display:flex;gap:24px;flex-wrap:wrap}.date{display:block;margin-top:14px}.date input{display:block;padding:7px;margin-top:4px}.sign-grid{display:grid;grid-template-columns:1fr 1fr;gap:60px;margin-top:34px}.sig-line{height:34px;border-bottom:1px solid #405466}.sig-name{width:100%;border:0;border-bottom:1px dashed #9aabb8;padding:5px 0}.footer-actions{justify-content:flex-start;margin-top:16px}@media(max-width:900px){.vs-app{padding:12px 10px 40px}.vs-list{grid-template-columns:1fr}.vs-head{display:block}.vs-case-tools{margin-top:12px;width:100%}.vs-tools{align-items:stretch;flex-direction:column}.vs-tools .secondary{width:100%}.group{padding:8px 10px}.item{grid-template-columns:auto minmax(0,1fr) 76px 48px 92px}}@media(max-width:620px){.vs-groups{display:grid;grid-template-columns:1fr 1fr}.group{text-align:left}.item{grid-template-columns:auto minmax(0,1fr)}.item>input.qty,.item>span,.item>input.manual-price{grid-column:auto}.item .price{text-align:left}.summary{grid-template-columns:1fr 1fr}.summary>label,.summary .grand{grid-column:1/-1}}@media print{@page{margin:12mm 14mm}.intern-header,.intern-sidebar,.vs-nav,.vs-head,.vs-catalog,.footer-actions,#vs-manual,.skip-link{display:none!important}html,body{background:#fff!important}.intern-portal-shell{display:block!important}.vs-app{padding:0;max-width:none}.vs-card{border:0;padding:0;margin:0;box-shadow:none}.print-logo{display:block;margin-bottom:8mm}.print-logo img{width:58mm}table{min-width:0;font-size:9pt}td input{border:0!important}.remove{display:none}.summary{grid-template-columns:repeat(4,1fr)}}
</style>
<style is:global>
.signature-capture{margin-top:16px;max-width:720px}.signature-capture-head{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-bottom:7px}.signature-capture canvas{display:block;width:100%;height:180px;box-sizing:border-box;border:1px solid #8799a8;border-radius:3px;background:#fff;touch-action:none}.signature-capture small{display:block;margin-top:5px;color:var(--muted)}[data-signature-print].has-signature .sig-line{height:auto;border:0}[data-signature-print] img{display:block;max-width:100%;height:70px;object-fit:contain;object-position:left bottom;border-bottom:1px solid #405466}@media(max-width:700px){.signature-capture canvas{height:210px}.signature-capture-head{align-items:flex-start;flex-direction:column}}@media print{.signature-capture-head,.signature-capture small{display:none!important}.signature-capture{max-width:none;margin-top:8mm}.signature-capture canvas{height:42mm;border:0;border-bottom:1px solid #405466}.signature-capture[hidden]{display:none!important}[data-signature-print].has-signature{display:none!important}}
</style>
<style is:global>
.optical-settlement{display:flex;align-items:center;justify-content:space-between;gap:16px;margin-top:12px;padding:12px;border:1px solid #f1c98f;border-left:4px solid var(--orange);border-radius:3px;background:#fff8ee}.optical-settlement div{display:grid;gap:3px}.optical-settlement span{font-size:.8rem;color:var(--muted)}.note textarea[data-auto-grow]{min-height:96px;overflow-y:hidden;resize:vertical;line-height:1.5}@media(max-width:700px){.optical-settlement{align-items:stretch;flex-direction:column}.optical-settlement .secondary{width:100%}}
</style>
<style is:global>
.vs-history-help{margin:4px 0 14px;color:var(--muted)}.vs-history-list{display:grid;gap:8px}.vs-history-item{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:16px;align-items:center;border:1px solid var(--line);border-left:4px solid var(--orange);border-radius:3px;padding:12px;background:#f8fafb}.vs-history-meta{display:grid;gap:4px}.vs-history-meta small{color:var(--muted)}.vs-history-actions{display:flex;flex-wrap:wrap;gap:7px}.vs-history-actions .danger{border-color:#d99;background:#fff5f5;color:#8b2222}.vs-dialog{width:min(1100px,calc(100vw - 32px));max-height:calc(100vh - 32px);border:1px solid var(--line);border-radius:4px;padding:18px;color:var(--vs)}.vs-dialog::backdrop{background:rgba(10,27,43,.55)}.vs-dialog-head{display:flex;justify-content:space-between;align-items:flex-start;gap:16px}.vs-dialog-head h2{margin:3px 0 14px}.vs-view-meta{margin-bottom:12px;color:var(--muted)}.vs-view-note{white-space:pre-wrap;border-left:4px solid var(--orange);background:#fff8ee;padding:10px;margin-top:12px}.vs-view-total{text-align:right;font-size:1.05rem;margin-top:12px}@media(max-width:760px){.vs-history-item{grid-template-columns:1fr}.vs-history-actions>*{flex:1}.vs-dialog{padding:12px}}
</style>
<script is:inline>
(()=>{const root=document.querySelector('.vs-app'),positions=JSON.parse(root?.dataset.positions||'[]'),$=id=>document.getElementById(id),API='/intern/api/bki-calculator.php',money=v=>new Intl.NumberFormat('de-DE',{style:'currency',currency:'EUR'}).format(Number(v)||0),num=v=>{const n=Number(String(v??'').replace(',','.'));return Number.isFinite(n)?n:0},percentCodes=new Set(['01.04.002','07.00.001','14.03.000']);let lines=[],active=null,currentGroup='Alle';for(const s of[sessionStorage,localStorage])try{const d=JSON.parse(s.getItem('svnet-case')||'null');if(d?.folder_id){active=d;break}}catch{}const meta=active?.meta||{},waterCase=/wasser/i.test(`${meta.schadenart||''} ${meta.damage_type||''}`);if(active){$('vs-case').classList.add('on');$('vs-case').textContent=`Fall ${meta.schaden_nr||'ohne Schaden-Nr.'} · ${meta.schadenart||'Schaden'} · ${meta.vn_objekt||meta.ort||''}`;$('vs-case-calc').disabled=!waterCase;$('vs-case-calc-note').textContent=waterCase?'Schnelldurchgang: Ortung/Reparatur, Rückbau, Trocknung und Wiederherstellung.':'Der Schnelldurchgang steht für Wasserschäden zur Verfügung.'}try{const u=JSON.parse(localStorage.getItem('svnet-user')||sessionStorage.getItem('svnet-user')||'null');$('vs-regulator').value=u?.name||u?.display_name||u?.full_name||''}catch{}$('vs-date').value=new Date().toISOString().slice(0,10);const esc=s=>String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));function drawCatalog(){const q=$('vs-search').value.trim().toLowerCase(),list=$('vs-list');list.innerHTML='';positions.forEach((p,i)=>{if(currentGroup!=='Alle'&&p.group!==currentGroup)return;if(q&&!`${p.code} ${p.description} ${p.group}`.toLowerCase().includes(q))return;const e=document.createElement('div');e.className='item';const percent=percentCodes.has(p.code),open=p.price===null;e.innerHTML=`<input type="checkbox" data-pick="${i}"><div><div class="code">${esc(p.code)} · ${esc(p.group)}</div><div class="desc">${esc(p.description)}</div></div><input class="qty" data-qty="${i}" inputmode="decimal" value="1" title="${percent?'Fremdkosten netto':'Menge'}"><span>${percent?'€ Basis':esc(p.unit)}</span>${open?`<input class="manual-price" data-price="${i}" inputmode="decimal" placeholder="EP netto">`:`<span class="price">${percent?'15 %':money(p.price)}</span>`}`;const cb=e.querySelector('[data-pick]');cb.onchange=()=>e.classList.toggle('checked',cb.checked);list.appendChild(e)});}function add(p={}){lines.push({position_code:p.code||p.position_code||'',description:p.description||'Freie Position',quantity:num(p.quantity)||1,unit:p.unit||'St',unit_price:num(p.price??p.unit_price)});render()}const waterQuick=[['01.01.000',1,'Ortung / Reparatur'],['01.03.002',1,'Ortung / Reparatur'],['02.01.000',1,'Trocknung'],['02.03.000',1,'Trocknung'],['10.00.000',10,'Rückbau'],['13.02.000',24,'Rückbau Laminat'],['07.00.000',1,'Rückbau / Entsorgung'],['03.01.000',1,'Wiederherstellung'],['10.00.001',10,'Wiederherstellung'],['10.01.000',10,'Wiederherstellung'],['09.00.004',10,'Wiederherstellung'],['09.00.001',10,'Wiederherstellung'],['13.04.000',24,'Wiederherstellung Laminat'],['13.05.004',24,'Wiederherstellung Laminat']];function calculateWaterCase(){if(!active||!waterCase)return;const selected=[];for(const[code,quantity,block]of waterQuick){const p=positions.find(row=>row.code===code&&row.price!==null);if(p)selected.push({...p,quantity,description:`${block}: ${p.description}`})}lines=[];selected.forEach(p=>add(p));const warning='Schnelldurchgang Wasserschaden: Ortung/Reparatur, Rückbau einschließlich Entsorgung, Trocknung und Wiederherstellung angesetzt. Mengen sind vorläufig und vor Ort beziehungsweise anhand der Akte zu prüfen.';if(!$('vs-note').value.includes('Schnelldurchgang Wasserschaden'))$('vs-note').value=[$('vs-note').value.trim(),warning].filter(Boolean).join('\n');$('vs-state').textContent=`${selected.length} typische Wasserschaden-Positionen übernommen.`;$('vs-case-calc-note').textContent='Schnelldurchgang erstellt · Mengen und Positionen jetzt fallbezogen prüfen.';document.querySelector('.vs-protocol')?.scrollIntoView({behavior:'smooth',block:'start'})}function totals(){const net=lines.reduce((s,l)=>s+l.quantity*l.unit_price,0),vat=num($('vs-vat').value),tax=net*vat/100;return{net,tax,gross:net+tax,vat}}function render(){const b=$('vs-lines');b.innerHTML='';lines.forEach((l,i)=>{const tr=document.createElement('tr');tr.innerHTML=`<td>${esc(l.position_code||i+1)}</td><td><input class="desc" data-i="${i}" data-k="description" value="${esc(l.description)}"></td><td><input data-i="${i}" data-k="quantity" value="${l.quantity}"></td><td><input data-i="${i}" data-k="unit" value="${esc(l.unit)}"></td><td><input data-i="${i}" data-k="unit_price" value="${l.unit_price}"></td><td>${money(l.quantity*l.unit_price)}</td><td><button class="remove" data-remove="${i}">×</button></td>`;b.appendChild(tr)});b.querySelectorAll('input').forEach(n=>n.onchange=()=>{const i=+n.dataset.i,k=n.dataset.k;lines[i][k]=['quantity','unit_price'].includes(k)?num(n.value):n.value;render()});b.querySelectorAll('[data-remove]').forEach(x=>x.onclick=()=>{lines.splice(+x.dataset.remove,1);render()});const t=totals();$('vs-net').textContent=money(t.net);$('vs-tax').textContent=money(t.tax);$('vs-gross').textContent=money(t.gross)}$('vs-search').oninput=drawCatalog;document.querySelectorAll('.group').forEach(b=>b.onclick=()=>{currentGroup=b.dataset.group;document.querySelectorAll('.group').forEach(x=>x.classList.toggle('on',x===b));drawCatalog()});$('vs-clear').onclick=()=>{drawCatalog();$('vs-state').textContent=''};$('vs-add').onclick=()=>{let n=0;document.querySelectorAll('[data-pick]:checked').forEach(cb=>{const i=+cb.dataset.pick,p=positions[i],quantity=num(document.querySelector(`[data-qty="${i}"]`)?.value)||1,manual=num(document.querySelector(`[data-price="${i}"]`)?.value),percent=percentCodes.has(p.code);if(p.price===null&&manual<=0)return;add({...p,quantity,unit:percent?'€ Basis':p.unit,price:p.price===null?manual:p.price});n++});$('vs-state').textContent=n?`${n} Position(en) übernommen.`:'Keine Position mit gültigem Preis ausgewählt.'};$('vs-case-calc').onclick=calculateWaterCase;$('vs-manual').onclick=()=>add();$('vs-vat').oninput=render;$('vs-print').onclick=()=>window.print();function note(){return[...[...document.querySelectorAll('.note-choice:checked')].map(x=>x.value),$('vs-note').value.trim()].filter(Boolean).join('\n')}async function api(url,opt={}){const r=await fetch(url,{credentials:'same-origin',...opt}),j=await r.json().catch(()=>({}));if(!r.ok)throw new Error(j.error||`HTTP ${r.status}`);return j}async function savedItem(id){const d=await api(`${API}?action=get&id=${encodeURIComponent(id)}`);return d.item||{}}async function loadSaved(){const h=$('vs-history');try{const d=await api(`${API}?action=list&folder_id=${encodeURIComponent(active?.folder_id||'')}`),items=d.items||d.calculations||[];h.innerHTML=items.length?items.map(item=>`<div class="vs-history-item"><div class="vs-history-meta"><strong>${esc(item.case_no||'Freie Kalkulation')} · ${money(item.gross_total)}</strong><small>${esc(item.created_at||'')} · ${esc(item.title||'BKI-Kalkulation')} · ${Number(item.item_count)||0} Positionen</small></div><div class="vs-history-actions"><button class="secondary" type="button" data-view-calc="${item.id}">Öffnen</button><button class="primary" type="button" data-edit-calc="${item.id}">Weiter bearbeiten</button><button class="secondary danger" type="button" data-delete-calc="${item.id}">Löschen</button></div></div>`).join(''):'Für diesen Fall ist noch keine Kalkulation gespeichert.'}catch(e){h.textContent=e.message}}function viewSaved(item){const rows=(item.items||[]).map((l,i)=>`<tr><td>${esc(l.position_code||i+1)}</td><td>${esc(l.description||'')}</td><td>${num(l.quantity)}</td><td>${esc(l.unit||'')}</td><td>${money(l.unit_price)}</td><td>${money(num(l.quantity)*num(l.unit_price)*num(l.regional_factor||1))}</td></tr>`).join('');$('vs-view-title').textContent=`Kalkulation ${item.id||''} · ${item.case_no||'frei'}`;$('vs-view-content').innerHTML=`<div class="vs-view-meta">${esc(item.damage_type||'')} · ${esc(item.object_name||'')} · ${esc(item.created_at||'')}</div><div class="table-wrap"><table><thead><tr><th>Pos.</th><th>Leistung</th><th>Menge</th><th>Einheit</th><th>EP netto</th><th>Gesamt netto</th></tr></thead><tbody>${rows}</tbody></table></div><div class="vs-view-total"><strong>Netto ${money(item.net_total)}</strong> · USt. ${money(item.vat_total)} · <strong>Brutto ${money(item.gross_total)}</strong></div>${item.note?`<div class="vs-view-note"><strong>Hinweise</strong><br>${esc(item.note)}</div>`:''}`;$('vs-view-dialog').showModal()}function editSaved(item){lines=(item.items||[]).map(l=>({position_code:l.position_code||'',description:l.description||'Freie Position',quantity:num(l.quantity)||1,unit:l.unit||'St',unit_price:num(l.unit_price)}));$('vs-vat').value=item.vat_rate??19;document.querySelectorAll('.note-choice').forEach(x=>x.checked=false);$('vs-note').value=item.note||'';render();$('vs-save-state').textContent=`Kalkulation ${item.id} zur Weiterbearbeitung geladen. Speichern legt eine neue Fassung an.`;document.querySelector('.vs-protocol')?.scrollIntoView({behavior:'smooth',block:'start'})}$('vs-history').onclick=async event=>{const view=event.target.closest('[data-view-calc]'),edit=event.target.closest('[data-edit-calc]'),remove=event.target.closest('[data-delete-calc]');try{if(view)viewSaved(await savedItem(view.dataset.viewCalc));if(edit)editSaved(await savedItem(edit.dataset.editCalc));if(remove&&confirm('Diese Kalkulation aus der Übersicht löschen? Die archivierte Datei in der Fallakte bleibt als Nachweis erhalten.')){await api(`${API}?action=delete`,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({id:Number(remove.dataset.deleteCalc)})});await loadSaved();$('vs-save-state').textContent=`Kalkulation ${remove.dataset.deleteCalc} aus der Übersicht gelöscht.`}}catch(e){$('vs-save-state').textContent=e.message}};$('vs-history-refresh').onclick=loadSaved;$('vs-view-close').onclick=()=>$('vs-view-dialog').close();$('vs-save').onclick=async()=>{if(!lines.length)return;try{const d=await api(`${API}?action=save`,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({folder_id:active?.folder_id||'',case_meta:meta,location:[meta.plz,meta.ort].filter(Boolean).join(' '),note:note(),items:lines.map(l=>({...l,regional_factor:1})),totals:totals(),calculation_type:'Versicherungsschäden'})});$('vs-save-state').textContent=`Gespeichert · Kalkulation ${d.id||''}${active?.folder_id?' · in Fallakte archiviert':''}`;await loadSaved()}catch(e){$('vs-save-state').textContent=e.message}};drawCatalog();render();loadSaved()})();
</script>
