---
import InternalLayout from '../../../layouts/InternalLayout.astro';
import logoSrc from '../../../assets/sv-netzwerk-logo-freigestellt-v3.svg';
import CalculationTypeNav from '../../../components/internal/CalculationTypeNav.astro';
---
<InternalLayout title="BKI-Kalkulation" description="Fallbezogene und freie Schadenkalkulation mit BKI Altbau 2026.">
  <main class="bk-app">
    <a id="bk-back-portal" class="bk-back" href="/intern/versicherungsfaelle/">← Zurück zum Versicherungsportal</a>
    <CalculationTypeNav active="bki" />
    <section class="bk-head"><div><p class="bk-kicker">BKI Altbau 2026</p><h1>Schadenkalkulation</h1><p>Leistungen vor Ort erfassen, passende BKI-Positionen suchen und eine nachvollziehbare Kalkulation erstellen.</p></div><div id="bk-case" class="bk-case">Freie Kalkulation · keinem Fall zugeordnet</div></section>
    <section class="bk-card bk-input-card"><div class="bk-grid"><label class="wide">Leistung / Schadenbeschreibung<textarea id="bk-query" rows="3"></textarea></label><label>Ort / Region<input id="bk-location"></label><label>Menge optional<input id="bk-qty" inputmode="decimal"></label><label>Einheit optional<select id="bk-unit"><option value="">automatisch</option><option>m²</option><option>m</option><option>St</option><option>h</option><option>psch</option></select></label><label>Preisniveau<select id="bk-level"><option value="mid" selected>Mittelwert</option><option value="low">unterer Wert</option><option value="high">oberer Wert</option></select></label></div><div class="bk-actions"><button id="bk-search" class="bk-primary">BKI-Position suchen</button><span id="bk-state"></span></div></section>
    <section id="bk-results-card" class="bk-card" hidden><h2>Gefundene BKI-Positionen</h2><div id="bk-results"></div></section>
    <section class="bk-card bk-protocol"><div class="bk-print-logo"><img src={logoSrc.src} alt="SV-Netzwerk" /></div><div class="bk-title-row"><h2>Kalkulation</h2><button id="bk-add-manual" class="bk-secondary">Freie Position hinzufügen</button></div><div class="bk-table-wrap"><table class="bk-table"><thead><tr><th>Pos.</th><th>Leistung</th><th>Menge</th><th>Einheit</th><th>EP netto</th><th>Reg.-Faktor</th><th>Gesamt netto</th><th></th></tr></thead><tbody id="bk-lines"></tbody></table></div><div class="bk-summary"><label>USt. %<input id="bk-vat" type="number" value="19"></label><div><span>Netto</span><strong id="bk-net">0,00 €</strong></div><div><span>USt.</span><strong id="bk-tax">0,00 €</strong></div><div class="grand"><span>Brutto</span><strong id="bk-gross">0,00 €</strong></div></div>
      <div class="bk-notes"><strong>Hinweise / Vereinbarungen</strong><div class="bk-checks"><label><input type="checkbox" class="bk-note-choice" value="Kalkulation vor Ort mit dem VN besprochen; der VN stimmt der Kalkulation zu."> Kalkulation vor Ort mit VN besprochen; VN stimmt der Kalkulation zu.</label><label><input type="checkbox" class="bk-note-choice" value="Die Kalkulationsansätze wurden auf Grundlage der BKI-Baukostendaten ermittelt."> Kalkulationsansätze auf Grundlage der BKI-Baukostendaten ermittelt.</label><label><input type="checkbox" class="bk-note-choice" value="Der ausgewiesene Betrag wird als pauschale Abgeltung an den VN ausgezahlt."> Betrag wird als pauschale Abgeltung an den VN ausgezahlt.</label><label><input type="checkbox" class="bk-note-choice" value="Die Auszahlung bzw. Abgeltungsvereinbarung steht unter dem Vorbehalt der Zustimmung des Versicherers."> Auszahlung/Abgeltung vorbehaltlich der Zustimmung des Versicherers.</label><label><input type="checkbox" class="bk-note-choice" value="Mit der vereinbarten Zahlung ist der Schadenfall vollumfänglich abgegolten."> Schadenfall ist mit der vereinbarten Zahlung vollumfänglich abgegolten.</label></div><label class="bk-note">Zusätzlicher Hinweis / Abgeltungsvermerk<textarea id="bk-note" rows="3"></textarea></label></div>
      <div class="bk-signatures"><div class="bk-sign-options"><label><input type="checkbox"> Keine Unterschrift erforderlich</label><label><input type="checkbox"> Zur Unterzeichnung per E-Mail an VN/Bevollmächtigten versandt</label></div><label class="bk-date">Datum<input id="bk-date" type="date"></label><div class="bk-sign-grid"><div><div class="sig-line"></div><strong>VN oder Bevollmächtigter</strong></div><div><input id="bk-regulator" class="sig-name" placeholder="Name Regulierer"><div class="sig-line"></div><strong>Regulierer</strong></div></div></div>
      <div class="bk-footer-actions"><button id="bk-save" class="bk-primary">Kalkulation speichern</button><button id="bk-print" class="bk-secondary">Drucken / PDF</button><span id="bk-save-state"></span></div></section><section class="bk-card bk-history"><h2>Gespeicherte Kalkulationen</h2><div id="bk-history">Noch keine Kalkulation geladen.</div></section>
  </main>
</InternalLayout>
<style is:global>
:root{--bki:#17324a;--bkm:#687b8c;--bko:#ff970f;--bkl:#dce5ec}.bk-app{max-width:1450px;margin:auto;padding:18px 24px 56px;color:var(--bki)}.bk-head{display:flex;justify-content:space-between;gap:24px;margin-bottom:16px}.bk-kicker{margin:0;color:var(--bko);font-weight:800}.bk-head h1{margin:4px 0}.bk-head p{color:var(--bkm)}.bk-case{background:#eef4f7;border:1px solid var(--bkl);border-radius:12px;padding:10px 13px;font-weight:750;max-width:460px}.bk-case.on{background:#eaf6f0;color:#236e50}.bk-card{background:#fff;border:1px solid var(--bkl);border-radius:15px;padding:18px;margin-bottom:16px}.bk-grid{display:grid;grid-template-columns:2fr 1fr 1fr 1fr;gap:10px}.wide{grid-column:1/-1}.bk-grid label,.bk-note{font-size:.78rem;font-weight:750;color:#536a7d}.bk-grid input,.bk-grid select,.bk-grid textarea,.bk-note textarea,.bk-summary input{width:100%;box-sizing:border-box;border:1px solid #bdcbd6;border-radius:9px;padding:10px;margin-top:4px}.bk-actions,.bk-footer-actions,.bk-title-row{display:flex;align-items:center;gap:10px;margin-top:12px}.bk-title-row{justify-content:space-between;margin-top:0}.bk-primary,.bk-secondary{border-radius:9px;padding:10px 14px;font-weight:800;cursor:pointer}.bk-primary{background:var(--bki);color:#fff;border:1px solid var(--bki)}.bk-secondary{background:#fff;border:1px solid #b8c7d2}.bk-result{border:1px solid var(--bkl);border-radius:11px;padding:12px;margin-top:9px}.bk-result-top,.bk-prices{display:flex;justify-content:space-between;gap:8px;flex-wrap:wrap}.bk-table{width:100%;border-collapse:collapse;min-width:980px}.bk-table th,.bk-table td{padding:8px;border-bottom:1px solid #e4ebf0;text-align:left}.bk-table input{width:100%;box-sizing:border-box}.bk-table .desc{min-width:290px}.bk-remove{border:0;background:#fff1f1}.bk-summary{display:grid;grid-template-columns:130px repeat(3,1fr);gap:10px;margin-top:18px}.bk-summary>div{background:#f5f8fa;border-radius:10px;padding:10px}.bk-summary span,.bk-summary strong{display:block}.bk-summary .grand{background:#edf5f1}.bk-notes,.bk-signatures{margin-top:18px;border-top:1px solid var(--bkl);padding-top:14px}.bk-checks{display:grid;gap:7px;margin-top:10px}.bk-checks label,.bk-sign-options label{display:flex;gap:8px;font-size:.88rem}.bk-note{display:block;margin-top:12px}.bk-sign-options{display:flex;gap:24px;flex-wrap:wrap}.bk-date{display:block;margin-top:14px}.bk-date input{display:block;padding:7px;margin-top:4px}.bk-sign-grid{display:grid;grid-template-columns:1fr 1fr;gap:60px;margin-top:34px}.sig-line{height:34px;border-bottom:1px solid #405466}.sig-name{width:100%;border:0;border-bottom:1px dashed #9aabb8;padding:5px 0}.bk-sign-grid strong{font-size:.82rem}.bk-print-logo{display:none}.bk-history-item{border-top:1px solid var(--bkl);padding:9px 0}@media print{@page{margin:12mm 14mm}.intern-header,.bk-head,.bk-input-card,#bk-results-card,.bk-history,.bk-footer-actions,#bk-add-manual,.skip-link{display:none!important}html,body{background:#fff!important}.bk-app{padding:0;max-width:none}.bk-card{border:0;padding:0;margin:0}.bk-print-logo{display:block;margin-bottom:10mm}.bk-print-logo img{width:58mm}.bk-table{min-width:0;font-size:9pt}.bk-table input{border:0}.bk-remove{display:none}.bk-summary{grid-template-columns:repeat(4,1fr)}.sig-name{border:0}}
.bk-back{display:inline-flex;align-items:center;margin-bottom:12px;text-decoration:none;border:1px solid #b8c7d2;background:#fff;color:var(--bki);border-radius:9px;padding:9px 13px;font-weight:800}
@media print{.bk-back{display:none!important}}
</style>
<script is:inline>
(()=>{const $=id=>document.getElementById(id),API='/intern/api/bki-calculator.php',money=v=>new Intl.NumberFormat('de-DE',{style:'currency',currency:'EUR'}).format(Number(v)||0),num=v=>{const n=Number(String(v??'').replace(',','.'));return Number.isFinite(n)?n:0};let active=null,lines=[];window.__bkiCalcBridge={getLines:()=>JSON.parse(JSON.stringify(lines)),setLines:value=>{lines=Array.isArray(value)?JSON.parse(JSON.stringify(value)):[];render()},addLine:value=>add(value||{}),getMeta:()=>meta,getActive:()=>active};for(const s of[sessionStorage,localStorage])try{const d=JSON.parse(s.getItem('svnet-case')||'null');if(d?.folder_id){active=d;break}}catch{}const meta=active?.meta||{};if(active){$('bk-case').classList.add('on');$('bk-case').textContent=`Fall ${meta.schaden_nr||'ohne Schaden-Nr.'} · ${meta.schadenart||'Schaden'} · ${meta.vn_objekt||meta.ort||''}`;$('bk-location').value=[meta.plz,meta.ort].filter(Boolean).join(' ')}$('bk-date').value=new Date().toISOString().slice(0,10);try{const u=JSON.parse(localStorage.getItem('svnet-user')||sessionStorage.getItem('svnet-user')||'null');$('bk-regulator').value=u?.name||u?.display_name||u?.full_name||''}catch{}async function api(url,opt={}){const r=await fetch(url,{credentials:'same-origin',...opt}),j=await r.json().catch(()=>({}));if(!r.ok)throw new Error(j.error||`HTTP ${r.status}`);return j}function esc(s){return String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]))}function price(p){return num($('bk-level').value==='low'?p.price_low:$('bk-level').value==='high'?p.price_high:p.price_mid)}function add(p={}){lines.push({position_code:p.position_code||'',description:p.description||'Freie Position',quantity:num(p.recommended_quantity||p.quantity||1)||1,unit:p.unit||'St',unit_price:p.unit_price??price(p),regional_factor:num(p.regional_factor)||1});render()}function totals(){const net=lines.reduce((s,l)=>s+l.quantity*l.unit_price*l.regional_factor,0),vat=num($('bk-vat').value),tax=net*vat/100;return{net,tax,gross:net+tax,vat}}function rt(){const t=totals();$('bk-net').textContent=money(t.net);$('bk-tax').textContent=money(t.tax);$('bk-gross').textContent=money(t.gross)}function render(){const b=$('bk-lines');b.innerHTML='';lines.forEach((l,i)=>{const tr=document.createElement('tr');tr.innerHTML=`<td>${esc(l.position_code||i+1)}</td><td><input class="desc" data-i="${i}" data-k="description" value="${esc(l.description)}"></td><td><input data-i="${i}" data-k="quantity" value="${l.quantity}"></td><td><input data-i="${i}" data-k="unit" value="${esc(l.unit)}"></td><td><input data-i="${i}" data-k="unit_price" value="${l.unit_price}"></td><td><input data-i="${i}" data-k="regional_factor" value="${l.regional_factor}"></td><td class="sum">${money(l.quantity*l.unit_price*l.regional_factor)}</td><td><button class="bk-remove" data-remove="${i}">×</button></td>`;b.appendChild(tr)});b.querySelectorAll('input').forEach(n=>n.oninput=()=>{const i=+n.dataset.i,k=n.dataset.k;lines[i][k]=['quantity','unit_price','regional_factor'].includes(k)?num(n.value):n.value;const row=n.closest('tr'),sum=row?.querySelector('.sum');if(sum)sum.textContent=money(lines[i].quantity*lines[i].unit_price*lines[i].regional_factor);rt()});b.querySelectorAll('[data-remove]').forEach(x=>x.onclick=()=>{lines.splice(+x.dataset.remove,1);render()});rt()}$('bk-vat').oninput=rt;$('bk-add-manual').onclick=()=>add();$('bk-print').onclick=()=>window.print();$('bk-search').onclick=async()=>{const q=$('bk-query').value.trim();if(!q)return;$('bk-state').textContent='BKI Altbau wird durchsucht …';try{const d=await api(API+'?action=search',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({query:q,quantity:$('bk-qty').value,unit:$('bk-unit').value,location:$('bk-location').value,case_meta:meta})}),box=$('bk-results');box.innerHTML='';(d.positions||[]).forEach(p=>{const e=document.createElement('div');e.className='bk-result';e.innerHTML=`<div class="bk-result-top"><strong>${esc(p.position_code||'BKI')} · ${esc(p.description)}</strong><button class="bk-primary">Übernehmen</button></div><div class="bk-prices"><span>unten ${money(p.price_low)}</span><span>Mittel ${money(p.price_mid)}</span><span>oben ${money(p.price_high)}</span></div>`;e.querySelector('button').onclick=()=>add({...p,unit_price:price(p)});box.appendChild(e)});$('bk-results-card').hidden=false;$('bk-state').textContent=(d.positions||[]).length?'BKI-Treffer gefunden.':'Keine belastbare BKI-Position gefunden.'}catch(e){$('bk-state').textContent=e.message}};function note(){return[...[...document.querySelectorAll('.bk-note-choice:checked')].map(x=>x.value),$('bk-note').value.trim()].filter(Boolean).join('\n')}$('bk-save').onclick=async()=>{if(!lines.length)return;try{const d=await api(API+'?action=save',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({folder_id:active?.folder_id||'',case_meta:meta,location:$('bk-location').value,note:note(),items:lines,totals:totals()})});if(d.drive_file?.webViewLink){$('bk-save-state').innerHTML=`Gespeichert · Kalkulation ${d.id} · <a href="${esc(d.drive_file.webViewLink)}" target="_blank" rel="noreferrer">in Fallakte archiviert</a>`}else{$('bk-save-state').textContent=`Gespeichert · Kalkulation ${d.id}${active?.folder_id?' · in Fallakte archiviert':''}`}history()}catch(e){$('bk-save-state').textContent=e.message}};async function history(){try{const d=await api(API+'?action=list&folder_id='+encodeURIComponent(active?.folder_id||'')),h=$('bk-history');h.innerHTML='';(d.calculations||[]).forEach(x=>{const e=document.createElement('div');e.className='bk-history-item';e.innerHTML=`<strong>${esc(x.case_no||'Freie Kalkulation')} · ${money(x.gross_total)}</strong><br><small>${esc(x.created_at||'')} · ${esc(x.object_name||'')}</small>`;h.appendChild(e)})}catch{}}history();rt()})();
</script>
<script is:inline>
(()=>{
  const API='/intern/api/bki-calculator.php',DRAFT='/intern/api/bki-drafts.php',historyBox=document.getElementById('bk-history');
  const money=value=>new Intl.NumberFormat('de-DE',{style:'currency',currency:'EUR'}).format(Number(value)||0),esc=value=>String(value??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c])),folder=()=>window.__bkiCalcBridge?.getActive()?.folder_id||'';
  async function json(url,options={}){const response=await fetch(url,{credentials:'same-origin',...options}),data=await response.json().catch(()=>({}));if(!response.ok)throw new Error(data.error||`HTTP ${response.status}`);return data;}
  async function renderSaved(){try{const data=await json(`${API}?action=list&folder_id=${encodeURIComponent(folder())}`),items=data.calculations||data.items||[];historyBox.innerHTML=items.length?items.map(item=>`<div class="bk-history-item"><strong>${esc(item.case_no||'Freie Kalkulation')} · ${money(item.gross_total)}</strong><br><small>${esc(item.created_at||'')} · ${esc(item.object_name||item.title||'')}</small><div class="bk-history-actions"><button class="bk-secondary" type="button" data-edit-calc="${item.id}">Bearbeiten</button><button class="bk-remove" type="button" data-delete-calc="${item.id}">Löschen</button></div></div>`).join(''):'Noch keine Kalkulation gespeichert.';}catch(error){historyBox.textContent=error.message;}}
  historyBox?.addEventListener('click',async event=>{const edit=event.target.closest('[data-edit-calc]'),remove=event.target.closest('[data-delete-calc]');try{if(edit){const data=await json(`${API}?action=get&id=${encodeURIComponent(edit.dataset.editCalc)}`),item=data.item||{};window.__bkiCalcBridge?.setLines(item.items||[]);document.getElementById('bk-vat').value=item.vat_rate??19;document.getElementById('bk-location').value=item.location||'';document.getElementById('bk-note').value=item.note||'';document.querySelector('.bk-protocol')?.scrollIntoView({behavior:'smooth',block:'start'});}if(remove&&confirm('Diese gespeicherte Kalkulation wirklich löschen?')){await json(`${API}?action=delete`,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({id:Number(remove.dataset.deleteCalc)})});await renderSaved();}}catch(error){document.getElementById('bk-save-state').textContent=error.message;}});
  document.getElementById('bk-save')?.addEventListener('click',()=>setTimeout(renderSaved,900));
  const drafts=document.getElementById('bk-drafts-list');if(drafts){const enhance=()=>drafts.querySelectorAll('[data-draft]').forEach(button=>{button.textContent='Bearbeiten';if(button.parentElement.querySelector('[data-delete-draft]'))return;const remove=document.createElement('button');remove.type='button';remove.className='bk-remove';remove.dataset.deleteDraft=button.dataset.draft;remove.textContent='Löschen';button.insertAdjacentElement('afterend',remove);});new MutationObserver(enhance).observe(drafts,{childList:true,subtree:true});enhance();drafts.addEventListener('click',async event=>{const remove=event.target.closest('[data-delete-draft]');if(!remove||!confirm('Diesen Kalkulationsentwurf wirklich löschen?'))return;event.preventDefault();event.stopPropagation();try{await json(DRAFT+'?action=delete',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({draft_key:remove.dataset.deleteDraft})});remove.parentElement.remove();}catch(error){document.getElementById('bk-save-state').textContent=error.message;}});}
  renderSaved();
})();
</script>
