---
import InternalLayout from '../../../layouts/InternalLayout.astro';
---
<InternalLayout title="BKI-Kalkulation" description="Fallbezogene und freie Schadenkalkulation mit BKI Altbau 2026.">
  <main class="bk-app">
    <section class="bk-head">
      <div>
        <p class="bk-kicker">BKI Altbau 2026</p>
        <h1>Schadenkalkulation</h1>
        <p>Leistungen vor Ort erfassen, passende BKI-Positionen suchen und eine nachvollziehbare Kalkulation erstellen.</p>
      </div>
      <div id="bk-case" class="bk-case">Freie Kalkulation · keinem Fall zugeordnet</div>
    </section>

    <section class="bk-card bk-input-card">
      <div class="bk-grid">
        <label class="wide">Leistung / Schadenbeschreibung
          <textarea id="bk-query" rows="3" placeholder="z. B. 5 Rollläden à 2 m², PVC, komplett austauschen"></textarea>
        </label>
        <label>Ort / Region
          <input id="bk-location" placeholder="z. B. Aalen oder 73432 Aalen" />
        </label>
        <label>Menge optional
          <input id="bk-qty" inputmode="decimal" placeholder="z. B. 40" />
        </label>
        <label>Einheit optional
          <select id="bk-unit"><option value="">automatisch</option><option>m²</option><option>m</option><option>St</option><option>h</option><option>psch</option></select>
        </label>
        <label>Preisniveau
          <select id="bk-level"><option value="mid" selected>Mittelwert</option><option value="low">unterer Wert</option><option value="high">oberer Wert</option></select>
        </label>
      </div>
      <div class="bk-actions"><button id="bk-search" class="bk-primary">BKI-Position suchen</button><span id="bk-state"></span></div>
    </section>

    <section id="bk-results-card" class="bk-card" hidden>
      <h2>Gefundene BKI-Positionen</h2>
      <div id="bk-results"></div>
    </section>

    <section class="bk-card">
      <div class="bk-title-row"><h2>Kalkulation</h2><button id="bk-add-manual" class="bk-secondary">Freie Position hinzufügen</button></div>
      <div class="bk-table-wrap"><table class="bk-table"><thead><tr><th>Pos.</th><th>Leistung</th><th>Menge</th><th>Einheit</th><th>EP netto</th><th>Reg.-Faktor</th><th>Gesamt netto</th><th></th></tr></thead><tbody id="bk-lines"></tbody></table></div>
      <div class="bk-summary">
        <label>USt. %<input id="bk-vat" type="number" min="0" max="30" step="0.1" value="19"></label>
        <div><span>Netto</span><strong id="bk-net">0,00 €</strong></div>
        <div><span>USt.</span><strong id="bk-tax">0,00 €</strong></div>
        <div class="grand"><span>Brutto</span><strong id="bk-gross">0,00 €</strong></div>
      </div>
      <label class="bk-note">Hinweis / Abgeltungsvermerk<textarea id="bk-note" rows="2" placeholder="z. B. Kalkulation vor Ort mit VN besprochen; vorbehaltlich abschließender Prüfung."></textarea></label>
      <div class="bk-footer-actions"><button id="bk-save" class="bk-primary">Kalkulation speichern</button><button id="bk-print" class="bk-secondary">Drucken / PDF</button><span id="bk-save-state"></span></div>
    </section>

    <section class="bk-card bk-history"><h2>Gespeicherte Kalkulationen</h2><div id="bk-history">Noch keine Kalkulation geladen.</div></section>
  </main>
</InternalLayout>

<style is:global>
:root{--bki:#17324a;--bkm:#687b8c;--bko:#ff970f;--bkl:#dce5ec;--bkg:#2f8f67}.bk-app{max-width:1450px;margin:auto;padding:18px 24px 56px;color:var(--bki)}.bk-head{display:flex;justify-content:space-between;gap:24px;align-items:flex-start;margin-bottom:16px}.bk-kicker{margin:0 0 4px;color:var(--bko);font-weight:800;text-transform:uppercase;letter-spacing:.1em;font-size:.78rem}.bk-head h1{margin:0 0 6px;font-size:clamp(1.8rem,4vw,2.8rem)}.bk-head p{margin:0;color:var(--bkm)}.bk-case{background:#eef4f7;border:1px solid var(--bkl);border-radius:12px;padding:10px 13px;font-weight:750;max-width:460px}.bk-case.on{background:#eaf6f0;border-color:#b7decc;color:#236e50}.bk-card{background:#fff;border:1px solid var(--bkl);border-radius:15px;padding:18px;margin-bottom:16px;box-shadow:0 5px 18px #17324a0b}.bk-grid{display:grid;grid-template-columns:2fr 1fr 1fr 1fr;gap:10px}.bk-grid .wide{grid-column:1/-1}.bk-grid label,.bk-note{font-size:.78rem;font-weight:750;color:#536a7d}.bk-grid input,.bk-grid select,.bk-grid textarea,.bk-note textarea,.bk-summary input{width:100%;box-sizing:border-box;border:1px solid #bdcbd6;border-radius:9px;padding:10px 11px;font:inherit;margin-top:4px}.bk-actions,.bk-footer-actions,.bk-title-row{display:flex;align-items:center;gap:10px;margin-top:12px}.bk-title-row{justify-content:space-between;margin-top:0}.bk-title-row h2,.bk-card h2{margin:0}.bk-primary,.bk-secondary{border-radius:9px;padding:10px 14px;font-weight:800;cursor:pointer}.bk-primary{background:var(--bki);border:1px solid var(--bki);color:#fff}.bk-primary:disabled{opacity:.45}.bk-secondary{background:#fff;border:1px solid #b8c7d2;color:var(--bki)}#bk-state,#bk-save-state{font-size:.86rem;color:var(--bkm)}.bk-result{border:1px solid var(--bkl);border-radius:11px;padding:12px;margin-top:9px}.bk-result-top{display:flex;justify-content:space-between;gap:12px}.bk-result small{color:var(--bkm)}.bk-prices{display:flex;flex-wrap:wrap;gap:8px;margin:9px 0}.bk-prices span{background:#f4f7f9;border-radius:8px;padding:6px 8px;font-size:.82rem}.bk-table-wrap{overflow:auto;margin-top:12px}.bk-table{width:100%;border-collapse:collapse;min-width:980px}.bk-table th,.bk-table td{padding:8px;border-bottom:1px solid #e4ebf0;text-align:left;vertical-align:top}.bk-table th{font-size:.76rem;color:#5d7182}.bk-table input{width:100%;box-sizing:border-box;border:1px solid #c7d2db;border-radius:7px;padding:7px}.bk-table .desc{min-width:290px}.bk-remove{border:0;background:#fff1f1;color:#9f2929;border-radius:7px;padding:7px 9px}.bk-summary{display:grid;grid-template-columns:130px repeat(3,minmax(150px,1fr));gap:10px;align-items:end;margin-top:18px}.bk-summary>div{background:#f5f8fa;border-radius:10px;padding:10px}.bk-summary span,.bk-summary strong{display:block}.bk-summary span{font-size:.78rem;color:var(--bkm)}.bk-summary strong{font-size:1.15rem}.bk-summary .grand{background:#edf5f1}.bk-note{display:block;margin-top:14px}.bk-history-item{border-top:1px solid var(--bkl);padding:9px 0}.bk-history-item:first-child{border-top:0}@media(max-width:850px){.bk-head{display:block}.bk-case{margin-top:12px}.bk-grid{grid-template-columns:1fr 1fr}.bk-grid .wide{grid-column:1/-1}.bk-summary{grid-template-columns:1fr 1fr}.bk-app{padding:12px 12px 38px}.bk-footer-actions{flex-wrap:wrap}}@media(max-width:560px){.bk-grid,.bk-summary{grid-template-columns:1fr}.bk-grid .wide{grid-column:1}.bk-actions{align-items:stretch;flex-direction:column}.bk-primary,.bk-secondary{width:100%}.bk-result-top{display:block}.bk-footer-actions{display:grid;grid-template-columns:1fr}}
@media print{.intern-header,.bk-input-card,#bk-results-card,.bk-history,.bk-footer-actions,#bk-add-manual{display:none!important}.bk-app{padding:0}.bk-card{box-shadow:none;border:0}.bk-table{min-width:0;font-size:9pt}.bk-table input{border:0;padding:0}.bk-remove{display:none}.bk-summary{grid-template-columns:repeat(4,1fr)}}
</style>

<script is:inline>
(()=>{
  const $=id=>document.getElementById(id), API='/intern/api/bki-calculator.php';
  const money=v=>new Intl.NumberFormat('de-DE',{style:'currency',currency:'EUR'}).format(Number(v)||0);
  const num=v=>{const n=Number(String(v??'').replace(',','.'));return Number.isFinite(n)?n:0};
  let active=null, lines=[];
  for(const storage of [sessionStorage,localStorage]){try{const d=JSON.parse(storage.getItem('svnet-case')||'null');if(d?.folder_id){active=d;break}}catch{}}
  const meta=active?.meta||{};
  if(active){$('bk-case').classList.add('on');$('bk-case').textContent=`Fall ${meta.schaden_nr||'ohne Schaden-Nr.'} · ${meta.schadenart||'Schaden'} · ${meta.vn_objekt||meta.ort||''}`;$('bk-location').value=[meta.plz,meta.ort].filter(Boolean).join(' ')}
  else $('bk-location').value='';

  async function api(url,opt={}){const r=await fetch(url,{credentials:'same-origin',...opt});const j=await r.json().catch(()=>({}));if(!r.ok)throw new Error(j.error||`HTTP ${r.status}`);return j}
  function esc(s){return String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]))}
  function pickedPrice(p){const level=$('bk-level').value;return num(level==='low'?p.price_low:level==='high'?p.price_high:p.price_mid)}
  function addLine(p={}){lines.push({position_code:p.position_code||'',description:p.description||'Freie Position',quantity:num(p.recommended_quantity||p.quantity||1)||1,unit:p.unit||'St',unit_price:p.unit_price??pickedPrice(p),regional_factor:num(p.regional_factor)||1,source_page:p.source_page||'',source_name:p.source_name||'',bki:true});renderLines()}
  function renderLines(){const body=$('bk-lines');body.innerHTML='';lines.forEach((l,i)=>{const tr=document.createElement('tr');tr.innerHTML=`<td>${esc(l.position_code||String(i+1))}</td><td><input class="desc" data-i="${i}" data-k="description" value="${esc(l.description)}"></td><td><input data-i="${i}" data-k="quantity" inputmode="decimal" value="${String(l.quantity).replace('.',',')}"></td><td><input data-i="${i}" data-k="unit" value="${esc(l.unit)}"></td><td><input data-i="${i}" data-k="unit_price" inputmode="decimal" value="${String(l.unit_price).replace('.',',')}"></td><td><input data-i="${i}" data-k="regional_factor" inputmode="decimal" value="${String(l.regional_factor).replace('.',',')}"></td><td class="sum">${money(l.quantity*l.unit_price*l.regional_factor)}</td><td><button class="bk-remove" data-remove="${i}">×</button></td>`;body.appendChild(tr)});body.querySelectorAll('input').forEach(n=>n.addEventListener('input',()=>{const i=Number(n.dataset.i),k=n.dataset.k;if(['quantity','unit_price','regional_factor'].includes(k))lines[i][k]=num(n.value);else lines[i][k]=n.value;renderTotals();const row=n.closest('tr');if(row)row.querySelector('.sum').textContent=money(lines[i].quantity*lines[i].unit_price*lines[i].regional_factor)}));body.querySelectorAll('[data-remove]').forEach(b=>b.onclick=()=>{lines.splice(Number(b.dataset.remove),1);renderLines()});renderTotals()}
  function totals(){const net=lines.reduce((s,l)=>s+l.quantity*l.unit_price*l.regional_factor,0),vat=num($('bk-vat').value),tax=net*vat/100;return{net,tax,gross:net+tax,vat}}
  function renderTotals(){const t=totals();$('bk-net').textContent=money(t.net);$('bk-tax').textContent=money(t.tax);$('bk-gross').textContent=money(t.gross)}
  $('bk-vat').addEventListener('input',renderTotals);
  $('bk-add-manual').onclick=()=>addLine({description:'Freie Position',quantity:1,unit:'St',unit_price:0,regional_factor:1});
  $('bk-print').onclick=()=>window.print();

  $('bk-search').onclick=async()=>{const q=$('bk-query').value.trim();if(!q)return;$('bk-search').disabled=true;$('bk-state').textContent='BKI Altbau wird durchsucht …';$('bk-results-card').hidden=true;try{const d=await api(API+'?action=search',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({query:q,quantity:$('bk-qty').value,unit:$('bk-unit').value,location:$('bk-location').value,case_meta:meta})});const box=$('bk-results');box.innerHTML='';(d.positions||[]).forEach((p,i)=>{const e=document.createElement('div');e.className='bk-result';e.innerHTML=`<div class="bk-result-top"><div><strong>${esc(p.position_code||'BKI')} · ${esc(p.description)}</strong><br><small>${esc(p.unit||'')} · ${esc(p.source_name||'BKI Altbau 2026')}${p.source_page?' · Seite '+esc(p.source_page):''}</small></div><button class="bk-primary">Übernehmen</button></div><div class="bk-prices"><span>unten ${money(p.price_low)}</span><span>Mittel ${money(p.price_mid)}</span><span>oben ${money(p.price_high)}</span><span>Reg.-Faktor ${esc(p.regional_factor??1)}</span><span>Menge ${esc(p.recommended_quantity??'')}</span></div>${p.note?`<small>${esc(p.note)}</small>`:''}`;e.querySelector('button').onclick=()=>addLine({...p,unit_price:pickedPrice(p)});box.appendChild(e)});$('bk-results-card').hidden=false;$('bk-state').textContent=(d.positions||[]).length?'BKI-Treffer gefunden. Bitte fachlich auswählen.':'Keine belastbare BKI-Position gefunden.'}catch(e){$('bk-state').textContent=e.message}finally{$('bk-search').disabled=false}};

  $('bk-save').onclick=async()=>{if(!lines.length)return;$('bk-save').disabled=true;$('bk-save-state').textContent='Kalkulation wird gespeichert …';try{const t=totals(),d=await api(API+'?action=save',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({folder_id:active?.folder_id||'',case_meta:meta,location:$('bk-location').value.trim(),note:$('bk-note').value.trim(),items:lines,totals:t})});$('bk-save-state').textContent=`Gespeichert · Kalkulation ${d.id}`;loadHistory()}catch(e){$('bk-save-state').textContent=e.message}finally{$('bk-save').disabled=false}};

  async function loadHistory(){try{const qs=active?.folder_id?'&folder_id='+encodeURIComponent(active.folder_id):'';const d=await api(API+'?action=list'+qs);$('bk-history').innerHTML=(d.items||[]).length?(d.items||[]).map(x=>`<div class="bk-history-item"><strong>${esc(x.title||'Kalkulation')}</strong><br><small>${esc(x.created_at)} · ${money(x.gross_total)}${x.case_no?' · Schaden '+esc(x.case_no):' · frei'}</small></div>`).join(''):'Noch keine passende Kalkulation gespeichert.'}catch(e){$('bk-history').textContent=e.message}}
  loadHistory();renderLines();
})();
</script>
