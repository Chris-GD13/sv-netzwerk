    searchCard.parentElement.insertBefore(quickCard, searchCard);
  }
  const cards = [
    { selector: '.bk-quick', title: 'Schnellkalkulation typische Schäden', collapsed: true },
    { selector: '.bk-input-card', title: 'BKI-Position suchen', collapsed: true },
    { selector: '#bk-results-card', title: 'Gefundene BKI-Positionen', collapsed: true },
    { selector: '.bk-protocol', title: 'Kalkulation', collapsed: true },
    { selector: '.bk-history', title: 'Gespeicherte Kalkulationen', collapsed: true },
  ];
  for (const config of cards) {
    const card = document.querySelector(config.selector);
    if (!card || card.dataset.collapsible === '1') continue;
    card.dataset.collapsible = '1';
    let header = card.querySelector(':scope > .bk-title-row, :scope > h2');
    if (!header) {
      header = document.createElement('div');
      header.innerHTML = `<h2>${config.title}</h2>`;
      card.prepend(header);
    }
    header.classList.add('bk-collapse-header');
    const button = document.createElement('button');
    button.type = 'button';
    button.className = 'bk-collapse-toggle';
    if (config.collapsed) card.classList.add('is-collapsed');
    button.setAttribute('aria-expanded', String(!config.collapsed));
    button.innerHTML = `<span class="bk-chevron" aria-hidden="true">▼</span><span class="bk-collapse-label">${config.collapsed ? 'Aufklappen' : 'Zuklappen'}</span>`;
    header.append(button);
    button.addEventListener('click', () => {
      const collapsed = card.classList.toggle('is-collapsed');
      button.setAttribute('aria-expanded', String(!collapsed));
      button.querySelector('.bk-collapse-label').textContent = collapsed ? 'Aufklappen' : 'Zuklappen';
    });
  }
})();
</script>


<script is:inline>
(()=>{
  const card=document.querySelector('.bk-card.bk-history'),box=document.getElementById('bk-history');
  if(!card||!box)return;
  const esc=value=>String(value??'').replace(/[&<>"']/g,char=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[char]));
  const money=value=>new Intl.NumberFormat('de-DE',{style:'currency',currency:'EUR'}).format(Number(value)||0);
  const refresh=async()=>{try{const folder=window.__bkiCalcBridge?.getActive?.()?.folder_id||'',response=await fetch('/intern/api/bki-calculator.php?action=list&folder_id='+encodeURIComponent(folder),{credentials:'same-origin'}),data=await response.json();if(!response.ok)throw new Error(data.error||`HTTP ${response.status}`);const items=data.calculations||data.items||[];box.innerHTML=items.length?items.map(item=>`<div class="bk-history-item"><strong>${esc(item.case_no||'Freie Kalkulation')} · ${money(item.gross_total)}</strong><br><small>${esc(item.created_at||'')} · ${esc(item.object_name||item.title||'')}</small><div class="bk-history-actions"><button class="bk-secondary" type="button" data-edit-calc="${item.id}">Bearbeiten</button><button class="bk-remove" type="button" data-delete-calc="${item.id}">Löschen</button></div></div>`).join(''):'Noch keine Kalkulation gespeichert.';}catch(error){box.textContent=error.message||String(error);}};
  card.querySelector('.bk-collapse-toggle')?.addEventListener('click',()=>{if(!card.classList.contains('is-collapsed'))refresh();});
  document.getElementById('bk-save')?.addEventListener('click',()=>setTimeout(refresh,1000));
})();
</script>

