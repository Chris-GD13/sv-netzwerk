---
import InternalLayout from '../../../layouts/InternalLayout.astro';
import logoSrc from '../../../assets/sv-netzwerk-logo-freigestellt-v3.svg';
import CalculationTypeNav from '../../../components/internal/CalculationTypeNav.astro';
---
<InternalLayout title="BKI-Kalkulation" description="Fallbezogene und freie Schadenkalkulation mit BKI Altbau 2026.">
  <main class="bk-app">
    <a id="bk-back-portal" class="bk-back" href="/intern/versicherungsfaelle/">← Zurück zum Versicherungsportal</a>
    <CalculationTypeNav active="bki" />
    <section class="bk-head"><div><p class="bk-kicker">BKI Altbau 2026</p><h1>Schadenkalkulation</h1><p>Leistungen vor Ort erfassen, passende BKI-Positionen suchen und eine nachvollziehbare Kalkulation erstellen.</p></div><div id="bk-case" class="bk-case">Freie Kalkulation · keinem Fall zugeordnet</div></section>
    <section class="bk-card bk-input-card"><div class="bk-grid"><label class="wide">Leistung / Schadenbeschreibung<textarea id="bk-query" rows="3"></textarea></label><label>Ort / Region<input id="bk-location"></label><label>Menge optional<input id="bk-qty" inputmode="decimal"></label><label>Einheit optional<select id="bk-unit"><option value="">automatisch</option><option>m²</option><option>m</option><option>St</option><option>h</option><option>psch</option></select></label><label>Preisniveau<select id="bk-level"><option value="mid" selected>Mittelwert</option><option value="low">unterer Wert</option><option value="high">oberer Wert</option></select></label></div><div class="bk-actions"><button id="bk-search" class="bk-primary">BKI-Position suchen</button><span id="bk-state"></span></div></section>
    <section class="bk-card bk-kva-import" data-kva-import>
      <div class="bk-title-row bk-kva-head"><div><p class="bk-kicker">KVA vor Ort</p><h2>Kostenvoranschlag nachkalkulieren</h2><p>Vorhandenen KVA auswählen oder direkt fotografieren. Die erkannten Positionen werden anschließend mit den eigenen BKI-Preisen kalkuliert.</p></div></div>
      <div class="bk-kva-source"><label>KVA aus dem aktiven Fall<select id="bk-kva-select" disabled><option value="">Bitte zuerst einen Fall öffnen</option></select></label><span>oder</span><div class="bk-kva-upload-options"><label class="bk-kva-file">Datei vom Gerät auswählen<input id="bk-kva-file" type="file" accept=".pdf,.doc,.docx,.jpg,.jpeg,.png,.webp"></label><label class="bk-kva-file">KVA fotografieren<input id="bk-kva-camera" type="file" accept="image/*" capture="environment"></label></div></div>
      <div class="bk-actions"><button id="bk-kva-read" class="bk-secondary" type="button" disabled>KVA auslesen</button><span id="bk-kva-state" role="status" aria-live="polite"></span></div>
      <div id="bk-kva-review" hidden><div class="bk-kva-review-head"><strong id="bk-kva-title">Erkannte Positionen</strong><label><input id="bk-kva-all" type="checkbox" checked> alle auswählen</label></div><div id="bk-kva-positions" class="bk-kva-positions"></div><div class="bk-actions bk-kva-actions"><button id="bk-kva-copy" class="bk-secondary" type="button">Alle Positionen 1:1 in die Kalkulation übernehmen</button><button id="bk-kva-calc" class="bk-primary" type="button">Ausgewählte Positionen mit unseren Preisen kalkulieren</button><span id="bk-kva-calc-state" role="status" aria-live="polite"></span></div></div>
    </section>
    <section class="bk-card bk-quick" data-bki-storm-index="1">
      <div class="bk-title-row bk-quick-head"><div><p class="bk-kicker">Sturm / Hagel / Leitungswasser</p><h2>Schnellkalkulation typische Schäden</h2><p>Bauteile anhaken, Menge eintragen und gemeinsam kalkulieren. Die Schnellposition wird als Wiederherstellung inklusive Demontage, Entsorgung und Neumontage angesetzt.</p></div><button id="bk-quick-clear" class="bk-secondary" type="button">Auswahl löschen</button></div>
      <div id="bk-quick-cats" class="bk-quick-cats"></div>
      <div id="bk-quick-list" class="bk-quick-list"></div>
      <div class="bk-actions"><button id="bk-quick-calc" class="bk-primary" type="button">Auswahl kalkulieren</button><span id="bk-quick-state"></span></div>
    </section>
    <section id="bk-results-card" class="bk-card" hidden><h2>Gefundene BKI-Positionen</h2><div id="bk-results"></div></section>
    <section class="bk-card bk-protocol"><div class="bk-print-logo"><img src={logoSrc.src} alt="SV-Netzwerk" /></div><div class="bk-title-row"><h2>Kalkulation</h2><div class="bk-title-actions"><button id="bk-clear-lines" class="bk-secondary" type="button">Alle Zeilen löschen</button><button id="bk-add-manual" class="bk-secondary">Freie Position hinzufügen</button></div></div><div class="bk-table-wrap"><table class="bk-table"><thead><tr><th>Pos.</th><th>Leistung</th><th>Menge</th><th>Einheit</th><th>EP netto</th><th>Reg.-Faktor</th><th>Gesamt netto</th><th></th></tr></thead><tbody id="bk-lines"></tbody></table></div><div class="bk-summary"><label>USt. %<input id="bk-vat" type="number" value="19"></label><div><span>Netto</span><strong id="bk-net">0,00 €</strong></div><div><span>USt.</span><strong id="bk-tax">0,00 €</strong></div><div class="grand"><span>Brutto</span><strong id="bk-gross">0,00 €</strong></div></div>
      <div class="bk-notes"><strong>Hinweise / Vereinbarungen</strong><div class="bk-checks"><label><input type="checkbox" class="bk-note-choice" value="Kalkulation vor Ort mit dem VN besprochen; der VN stimmt der Kalkulation zu."> Kalkulation vor Ort mit VN besprochen; VN stimmt der Kalkulation zu.</label><label><input type="checkbox" class="bk-note-choice" value="Die Kalkulationsansätze wurden auf Grundlage der BKI-Baukostendaten ermittelt."> Kalkulationsansätze auf Grundlage der BKI-Baukostendaten ermittelt.</label><label><input type="checkbox" class="bk-note-choice" value="Der ausgewiesene Betrag wird als pauschale Abgeltung an den VN ausgezahlt."> Betrag wird als pauschale Abgeltung an den VN ausgezahlt.</label><label><input type="checkbox" class="bk-note-choice" value="Die Auszahlung bzw. Abgeltungsvereinbarung steht unter dem Vorbehalt der Zustimmung des Versicherers."> Auszahlung/Abgeltung vorbehaltlich der Zustimmung des Versicherers.</label><label><input type="checkbox" class="bk-note-choice" value="Mit der vereinbarten Zahlung sind ausschließlich die in dieser Kalkulation ausdrücklich als abgegolten bezeichneten Schadenpositionen abschließend reguliert."> Die ausdrücklich als abgegolten bezeichneten Schadenpositionen sind abschließend reguliert.</label></div><div class="bk-optical-settlement"><div><strong>Optischer Schaden</strong><span>Fügt eine editierbare Abgeltungsvereinbarung für ausdrücklich bezeichnete Positionen ein.</span></div><button type="button" class="bk-secondary" data-optical-settlement-template data-note-target="bk-note">Mustertext einfügen</button></div><label class="bk-note">Zusätzlicher Hinweis / Abgeltungsvermerk<textarea id="bk-note" rows="3" data-auto-grow></textarea></label></div>
      <div class="bk-signatures" data-signature-section><div class="bk-sign-options"><label><input type="checkbox" data-signature-alternative> Keine Unterschrift erforderlich</label><label><input type="checkbox" data-signature-alternative> Zur Unterzeichnung per E-Mail an VN/Bevollmächtigten versandt</label><label><input id="bk-sign-on-site" type="checkbox" data-signature-toggle> VN/Bevollmächtigter unterschreibt jetzt vor Ort</label></div><div class="signature-capture" data-signature-capture hidden><div class="signature-capture-head"><strong>Unterschrift VN oder Bevollmächtigter</strong><button type="button" class="bk-secondary" data-signature-clear>Unterschrift löschen</button></div><canvas data-signature-canvas aria-label="Unterschriftenfeld für VN oder Bevollmächtigten"></canvas><small>Bitte mit Finger oder Stift im Feld unterschreiben.</small></div><label class="bk-date">Datum<input id="bk-date" type="date"></label><div class="bk-sign-grid"><div data-signature-print><div class="sig-line"></div><strong>VN oder Bevollmächtigter</strong></div><div><input id="bk-regulator" class="sig-name" placeholder="Name Regulierer"><div class="sig-line"></div><strong>Regulierer</strong></div></div></div>
      <div class="bk-footer-actions"><button id="bk-save" class="bk-primary">Kalkulation speichern</button><button id="bk-print" class="bk-secondary">Drucken / PDF</button><span id="bk-save-state"></span></div></section><section class="bk-card bk-history"><h2>Gespeicherte Kalkulationen</h2><div id="bk-history">Noch keine Kalkulation geladen.</div></section>
  </main>
</InternalLayout>
<style is:global>
:root{--bki:#17324a;--bkm:#687b8c;--bko:#ff970f;--bkl:#dce5ec}.bk-app{max-width:1450px;margin:auto;padding:18px 24px 56px;color:var(--bki)}.bk-head{display:flex;justify-content:space-between;gap:24px;margin-bottom:16px}.bk-kicker{margin:0;color:var(--bko);font-weight:800}.bk-head h1{margin:4px 0}.bk-head p{color:var(--bkm)}.bk-case{background:#eef4f7;border:1px solid var(--bkl);border-radius:12px;padding:10px 13px;font-weight:750;max-width:460px}.bk-case.on{background:#eaf6f0;color:#236e50}.bk-card{background:#fff;border:1px solid var(--bkl);border-radius:15px;padding:18px;margin-bottom:16px}.bk-grid{display:grid;grid-template-columns:2fr 1fr 1fr 1fr;gap:10px}.wide{grid-column:1/-1}.bk-grid label,.bk-note{font-size:.78rem;font-weight:750;color:#536a7d}.bk-grid input,.bk-grid select,.bk-grid textarea,.bk-note textarea,.bk-summary input{width:100%;box-sizing:border-box;border:1px solid #bdcbd6;border-radius:9px;padding:10px;margin-top:4px}.bk-actions,.bk-footer-actions,.bk-title-row{display:flex;align-items:center;gap:10px;margin-top:12px}.bk-title-row{justify-content:space-between;margin-top:0}.bk-primary,.bk-secondary{border-radius:9px;padding:10px 14px;font-weight:800;cursor:pointer}.bk-primary{background:var(--bki);color:#fff;border:1px solid var(--bki)}.bk-secondary{background:#fff;border:1px solid #b8c7d2}.bk-result{border:1px solid var(--bkl);border-radius:11px;padding:12px;margin-top:9px}.bk-result-top,.bk-prices{display:flex;justify-content:space-between;gap:8px;flex-wrap:wrap}.bk-table{width:100%;border-collapse:collapse;min-width:980px}.bk-table th,.bk-table td{padding:8px;border-bottom:1px solid #e4ebf0;text-align:left}.bk-table input{width:100%;box-sizing:border-box}.bk-table .desc{min-width:290px}.bk-remove{border:0;background:#fff1f1}.bk-summary{display:grid;grid-template-columns:130px repeat(3,1fr);gap:10px;margin-top:18px}.bk-summary>div{background:#f5f8fa;border-radius:10px;padding:10px}.bk-summary span,.bk-summary strong{display:block}.bk-summary .grand{background:#edf5f1}.bk-notes,.bk-signatures{margin-top:18px;border-top:1px solid var(--bkl);padding-top:14px}.bk-checks{display:grid;gap:7px;margin-top:10px}.bk-checks label,.bk-sign-options label{display:flex;gap:8px;font-size:.88rem}.bk-note{display:block;margin-top:12px}.bk-sign-options{display:flex;gap:24px;flex-wrap:wrap}.bk-date{display:block;margin-top:14px}.bk-date input{display:block;padding:7px;margin-top:4px}.bk-sign-grid{display:grid;grid-template-columns:1fr 1fr;gap:60px;margin-top:34px}.sig-line{height:34px;border-bottom:1px solid #405466}.sig-name{width:100%;border:0;border-bottom:1px dashed #9aabb8;padding:5px 0}.bk-sign-grid strong{font-size:.82rem}.bk-print-logo{display:none}.bk-history-item{border-top:1px solid var(--bkl);padding:9px 0}@media print{@page{margin:12mm 14mm}.intern-header,.bk-head,.bk-input-card,#bk-results-card,.bk-history,.bk-footer-actions,#bk-add-manual,.skip-link{display:none!important}html,body{background:#fff!important}.bk-app{padding:0;max-width:none}.bk-card{border:0;padding:0;margin:0}.bk-print-logo{display:block;margin-bottom:10mm}.bk-print-logo img{width:58mm}.bk-table{min-width:0;font-size:9pt}.bk-table input{border:0}.bk-remove{display:none}.bk-summary{grid-template-columns:repeat(4,1fr)}.sig-name{border:0}}
.bk-back{display:inline-flex;align-items:center;margin-bottom:12px;text-decoration:none;border:1px solid #b8c7d2;background:#fff;color:var(--bki);border-radius:9px;padding:9px 13px;font-weight:800}
.bk-optical-settlement{display:flex;align-items:center;justify-content:space-between;gap:16px;margin-top:12px;padding:12px;border:1px solid #f1c98f;border-left:4px solid var(--bko);border-radius:9px;background:#fff8ee}.bk-optical-settlement div{display:grid;gap:3px}.bk-optical-settlement span{font-size:.8rem;color:var(--bkm)}.bk-note textarea[data-auto-grow]{min-height:96px;overflow-y:hidden;resize:vertical;line-height:1.5}@media(max-width:700px){.bk-optical-settlement{align-items:stretch;flex-direction:column}.bk-optical-settlement .bk-secondary{width:100%}}
@media print{.bk-back{display:none!important}}
.signature-capture{margin-top:16px;max-width:720px}.signature-capture-head{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-bottom:7px}.signature-capture canvas{display:block;width:100%;height:180px;box-sizing:border-box;border:1px solid #8799a8;border-radius:3px;background:#fff;touch-action:none}.signature-capture small{display:block;margin-top:5px;color:var(--bkm)}[data-signature-print].has-signature .sig-line{height:auto;border:0}[data-signature-print] img{display:block;max-width:100%;height:70px;object-fit:contain;object-position:left bottom;border-bottom:1px solid #405466}@media(max-width:700px){.signature-capture canvas{height:210px}.signature-capture-head{align-items:flex-start;flex-direction:column}}@media print{.signature-capture-head,.signature-capture small{display:none!important}.signature-capture{max-width:none;margin-top:8mm}.signature-capture canvas{height:42mm;border:0;border-bottom:1px solid #405466}.signature-capture[hidden]{display:none!important}[data-signature-print].has-signature{display:none!important}}
.bk-collapse-header{display:flex;align-items:flex-start;justify-content:space-between;gap:12px}.bk-title-actions{display:flex;flex-wrap:wrap;justify-content:flex-end;gap:8px;margin-left:auto}.bk-collapse-toggle{flex:0 0 auto;display:inline-flex;align-items:center;gap:7px;border:1px solid #b8c7d2;border-radius:3px;background:#f4f6f7;color:var(--bki);padding:8px 11px;font:inherit;font-size:.82rem;font-weight:800;cursor:pointer}.bk-collapse-toggle:hover{background:#e9edf0}.bk-collapse-toggle .bk-chevron{display:inline-block;transition:transform .18s ease}.bk-card.is-collapsed>.bk-collapse-header~*{display:none!important}.bk-card.is-collapsed>.bk-collapse-header .bk-chevron{transform:rotate(-90deg)}.bk-card.is-collapsed>.bk-collapse-header p:not(.bk-kicker){display:none}.bk-card.is-collapsed{padding-bottom:12px}.bk-card.is-collapsed>.bk-collapse-header{margin-bottom:0}@media(max-width:700px){.bk-collapse-header{flex-wrap:wrap}.bk-title-actions{width:100%;justify-content:flex-start;margin-left:0}.bk-title-actions .bk-secondary{flex:1 1 auto}}@media print{.bk-collapse-toggle,#bk-clear-lines{display:none!important}.bk-card.is-collapsed>.bk-collapse-header~*{display:initial!important}}
.bk-quick{border-radius:3px;padding:14px}.bk-quick-head{align-items:flex-start}.bk-quick-head h2{margin:.1rem 0}.bk-quick-head p{margin:.2rem 0 0;color:var(--bkm);max-width:920px}.bk-quick-cats{display:flex;flex-wrap:wrap;gap:5px;margin:10px 0}.bk-quick-cat{min-height:32px;border:1px solid #bdcbd6;background:#f7fafc;color:var(--bki);border-radius:3px;padding:5px 9px;font-size:.78rem;line-height:1.1;font-weight:800;cursor:pointer}.bk-quick-cat:hover{border-color:var(--bko);background:#fff8ee}.bk-quick-cat.on{background:var(--bki);color:#fff;border-color:var(--bki);box-shadow:inset 3px 0 0 var(--bko)}.bk-quick-list{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:6px}.bk-quick-item{display:grid;grid-template-columns:auto 1fr 78px 44px;align-items:center;gap:7px;border:1px solid var(--bkl);border-radius:3px;padding:7px 8px;background:#fbfdfe}.bk-quick-item.off{display:none}.bk-quick-item>label{display:flex;align-items:center;gap:7px;font-size:.82rem;font-weight:750;min-width:0}.bk-quick-item input[type=checkbox]{width:16px;height:16px;flex:0 0 auto}.bk-quick-qty{width:100%;box-sizing:border-box;border:1px solid #bdcbd6;border-radius:3px;padding:5px;text-align:right}.bk-quick-unit{font-size:.78rem;font-weight:800;color:#5c7182}.bk-quick-item.checked{border-color:#ff970f;background:#fff8ee}.bk-quick-note{display:block;font-size:.68rem;color:#718493;font-weight:500;margin-top:1px}.bk-quick-extra{grid-column:1/-1;display:flex;gap:7px;align-items:center;padding-left:23px}.bk-quick-extra label{font-size:.7rem;color:#5c7182;font-weight:750}.bk-quick-extra input{width:92px;border:1px solid #bdcbd6;border-radius:3px;padding:5px;text-align:right}.bk-quick-extra small{color:#718493}.bk-quick-state-error{color:#a82929}.bk-quick-state-ok{color:#236e50}@media(max-width:1050px){.bk-quick-list{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:700px){.bk-quick{padding:10px}.bk-quick-list{grid-template-columns:1fr}.bk-quick-item{grid-template-columns:auto 1fr 70px 38px}}@media print{.bk-quick{display:none!important}}
@media(max-width:700px){.bk-quick{min-width:0;max-width:100%;overflow-x:hidden}.bk-quick-list,.bk-quick-item,.bk-quick-extra,.bk-quick-extra label{min-width:0;max-width:100%;box-sizing:border-box}.bk-quick-extra{display:grid;grid-template-columns:1fr;padding-left:0}.bk-quick-extra input,.bk-quick-qty{width:100%;max-width:100%;box-sizing:border-box;font-size:16px!important}.bk-quick input[inputmode],.bk-table input,.bk-summary input,.bk-grid input,.bk-grid textarea,.bk-grid select,.bk-note textarea{font-size:16px!important}}</style>
<script is:inline>
(()=>{const $=id=>document.getElementById(id),API='/intern/api/bki-calculator.php',money=v=>new Intl.NumberFormat('de-DE',{style:'currency',currency:'EUR'}).format(Number(v)||0),num=v=>{const n=Number(String(v??'').replace(',','.'));return Number.isFinite(n)?n:0};let active=null,lines=[];window.__bkiCalcBridge={getLines:()=>JSON.parse(JSON.stringify(lines)),setLines:value=>{lines=Array.isArray(value)?JSON.parse(JSON.stringify(value)):[];render()},addLine:value=>add(value||{}),getMeta:()=>meta,getActive:()=>active};for(const s of[sessionStorage,localStorage])try{const d=JSON.parse(s.getItem('svnet-case')||'null');if(d?.folder_id){active=d;break}}catch{}const meta=active?.meta||{};if(active){$('bk-case').classList.add('on');$('bk-case').textContent=`Fall ${meta.schaden_nr||'ohne Schaden-Nr.'} · ${meta.schadenart||'Schaden'} · ${meta.vn_objekt||meta.ort||''}`;$('bk-location').value=[meta.plz,meta.ort].filter(Boolean).join(' ')}$('bk-date').value=new Date().toISOString().slice(0,10);try{const u=JSON.parse(localStorage.getItem('svnet-user')||sessionStorage.getItem('svnet-user')||'null');$('bk-regulator').value=u?.name||u?.display_name||u?.full_name||''}catch{}async function api(url,opt={}){const r=await fetch(url,{credentials:'same-origin',...opt}),j=await r.json().catch(()=>({}));if(!r.ok)throw new Error(j.error||`HTTP ${r.status}`);return j}function esc(s){return String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]))}function price(p){return num($('bk-level').value==='low'?p.price_low:$('bk-level').value==='high'?p.price_high:p.price_mid)}function add(p={}){lines.push({position_code:p.position_code||'',description:p.description||'Freie Position',quantity:num(p.recommended_quantity||p.quantity||1)||1,unit:p.unit||'St',unit_price:p.unit_price??price(p),regional_factor:num(p.regional_factor)||1});render()}function totals(){const net=lines.reduce((s,l)=>s+l.quantity*l.unit_price*l.regional_factor,0),vat=num($('bk-vat').value)