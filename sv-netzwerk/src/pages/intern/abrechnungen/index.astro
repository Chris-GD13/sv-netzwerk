---
import InternalLayout from '../../../layouts/InternalLayout.astro';
---
<InternalLayout title="Abrechnungen" description="Geschützte Claims- und Rekon-Abrechnungen." currentPath="/intern/abrechnungen/">
  <section class="settlement-app">
    <header class="settlement-head">
      <div><p class="settlement-kicker">Die Regulierer</p><h1>Abrechnungen</h1><p id="settlement-meta">Abrechnungsdaten werden geladen …</p></div>
      <div class="settlement-refresh"><input id="settlement-file" type="file" accept="application/vnd.openxmlformats-officedocument.spreadsheetml.sheet,application/vnd.ms-excel.sheet.macroEnabled.12" hidden /><button id="settlement-refresh" type="button" hidden>Jetzt aktualisieren</button><small id="settlement-refresh-help" hidden>Gespeicherte Umsatzdatei auswählen</small></div>
    </header>
    <nav class="settlement-profile-tabs" aria-label="Abrechnung auswählen">
      <span>Claims</span><a id="profile-christian" href="?profile=christian">Christian</a><a id="profile-holger" href="?profile=holger">Holger</a>
      <span>Rekon</span><a id="profile-rekon_marc" href="?profile=rekon_marc">Marc</a><a id="profile-rekon_holger" href="?profile=rekon_holger">Holger</a>
    </nav>
    <div id="settlement-state" class="settlement-state">Abrechnungsdaten werden geladen …</div>
    <div id="settlement-content" hidden>
      <section id="settlement-summary" class="settlement-summary" aria-label="Abrechnungssummen"></section>
      <p id="christian-note" class="settlement-note">Berechnungsgrundlage Christian: Die Auszahlung an das SV-Büro entspricht 60 % der tatsächlichen Auftragssumme. Der verbleibende Anteil von 40 % wird „Die Regulierer“ zugerechnet. Die Bruttowerte enthalten 19 % Umsatzsteuer.</p>
      <p id="holger-note" class="settlement-note" hidden>Berechnungsgrundlage Holger: Die Claims-Gutschrift entspricht dem 60-%-Anteil. „Die Regulierer“ erhalten rechnerisch 40 % der tatsächlichen Auftragssumme. Von Holgers Gutschrift werden 10 % für das SV-Büro sowie die gesondert ausgewiesenen Office-365-Kosten abgezogen. Die Bruttowerte enthalten 19 % Umsatzsteuer.</p>
      <p id="rekon-note" class="settlement-note" hidden>Berechnungsgrundlage Rekon: Die in der Einzelpostenliste ausgewiesene Netto-Auszahlung entspricht dem Anteil des SV-Büros von 60 %. Die tatsächliche Auftragssumme wird durch 0,60 geteilt; die verbleibenden 40 % werden Rekon zugerechnet. Für Holger werden ausschließlich ausdrücklich auf ihn gebuchte Rekon-Positionen angezeigt. Die Bruttowerte enthalten 19 % Umsatzsteuer.</p>
      <div class="settlement-tools"><label>Jahr <select id="settlement-year"></select></label><label>Suche <input id="settlement-search" type="search" placeholder="Auftragsnummer, VN, Ort oder Versicherer" /></label></div>

      <div id="christian-content">
        <div id="settlement-scroll-top" class="settlement-scroll-top" aria-label="Christians Abrechnungstabelle horizontal verschieben" tabindex="0"><div id="settlement-scroll-width"></div></div>
        <div id="settlement-table-wrap" class="settlement-table-wrap"><table id="settlement-table"><thead><tr><th>Monat</th><th>Auftragsnummer</th><th>VN / Objekt</th><th>erbracht</th><th>abgerechnet</th><th>Versicherer</th><th class="num">Kilometer<br><small>km · Betrag netto / brutto</small></th><th class="num">Arbeitszeit<br><small>Betrag netto / brutto</small></th><th class="num">Fahrzeit<br><small>Betrag netto / brutto</small></th><th class="num">Auszahlung SV<br><small>60 % · netto / brutto</small></th><th class="num">Auftragssumme<br><small>100 % · netto / brutto</small></th><th class="num">Die Regulierer<br><small>40 % · netto / brutto</small></th><th class="num">Schadenhöhe ca.<br><small>laut Quelle</small></th></tr></thead><tbody id="settlement-rows"></tbody><tfoot id="settlement-total"></tfoot></table></div>
        <section class="private-section"><h2>Privataufträge</h2><p>Diese Bruttowerte werden unverändert aus dem Blatt „Privataufträge“ übernommen und nicht nach 60/40 umgerechnet.</p><div class="settlement-table-wrap"><table><thead><tr><th>Jahr</th><th>Auftraggeber</th><th>Ort</th><th>Ersttermin</th><th class="num">Brutto</th></tr></thead><tbody id="private-rows"></tbody><tfoot id="private-total"></tfoot></table></div></section>
      </div>

      <div id="holger-content" hidden>
        <div id="holger-scroll-top" class="settlement-scroll-top" aria-label="Holgers Abrechnungstabelle horizontal verschieben" tabindex="0"><div id="holger-scroll-width"></div></div>
        <div id="holger-table-wrap" class="settlement-table-wrap"><table id="holger-table"><thead><tr><th>Monat</th><th>Leistungszeitraum</th><th>Gutschriftdatum</th><th class="num">Auftragssumme<br><small>100 % · netto / brutto</small></th><th class="num">Die Regulierer<br><small>40 % · netto / brutto</small></th><th class="num">Claims-Gutschrift<br><small>60 % · netto / brutto</small></th><th class="num">SV-Büro<br><small>10 % der Gutschrift</small></th><th class="num">Office 365<br><small>netto / brutto</small></th><th class="num">Gesamt an SV-Büro<br><small>10 % + Office 365</small></th><th class="num">Holger nach 10 %<br><small>netto / brutto</small></th><th class="num">Holger nach Gesamtbelastung<br><small>netto / brutto</small></th></tr></thead><tbody id="holger-rows"></tbody><tfoot id="holger-total"></tfoot></table></div>
      </div>

      <div id="rekon-content" hidden>
        <div id="rekon-scroll-top" class="settlement-scroll-top" aria-label="Rekon-Abrechnungstabelle horizontal verschieben" tabindex="0"><div id="rekon-scroll-width"></div></div>
        <div id="rekon-table-wrap" class="settlement-table-wrap"><table id="rekon-table"><thead><tr><th>Monat</th><th>ID</th><th>Schadennummer</th><th>Versicherer</th><th>Regulierer</th><th>Rechnungsdatum</th><th>Ortstermin</th><th>Rechnung</th><th class="num">Auftragssumme<br><small>100 % · netto / brutto</small></th><th class="num">Rekon<br><small>40 % · netto / brutto</small></th><th class="num">SV-Büro<br><small>60 % · netto / brutto</small></th></tr></thead><tbody id="rekon-rows"></tbody><tfoot id="rekon-total"></tfoot></table></div>
      </div>
    </div>
  </section>
</InternalLayout>
<style is:global>
.settlement-app{padding:24px;min-height:calc(100vh - 112px);box-sizing:border-box;color:#17324a}.settlement-head{display:flex;justify-content:space-between;align-items:flex-end;gap:20px;margin-bottom:14px}.settlement-kicker{margin:0;color:#f59a23;font-weight:900}.settlement-head h1{margin:3px 0}.settlement-head p{margin:0;color:#647789}.settlement-head button{padding:10px 14px;border:1px solid #17324a;background:#17324a;color:#fff;font-weight:800;cursor:pointer}.settlement-refresh{display:grid;gap:4px;text-align:center}.settlement-refresh small{color:#647789}.settlement-profile-tabs{display:flex;align-items:center;flex-wrap:wrap;gap:8px;margin:0 0 16px}.settlement-profile-tabs span{margin-left:12px;color:#647789;font-weight:900}.settlement-profile-tabs span:first-child{margin-left:0}.settlement-profile-tabs a{padding:10px 22px;border:1px solid #17324a;background:#fff;color:#17324a;text-decoration:none;font-weight:900}.settlement-profile-tabs a.active{background:#17324a;color:#fff}.settlement-state{padding:14px;border:1px solid #f0d4a8;background:#fff8ec}.settlement-state.bad{color:#8b2525;border-color:#e4bcbc;background:#fff0f0}.settlement-summary{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px}.settlement-card{border:1px solid #d2dae0;border-top:4px solid #f59a23;background:#fff;padding:16px}.settlement-card h2{margin:0 0 12px;font-size:1.05rem}.settlement-card dl{display:grid;grid-template-columns:1fr auto;gap:8px 16px;margin:0}.settlement-card dt{color:#607486}.settlement-card dd{margin:0;font-weight:900;text-align:right}.settlement-card dd small,.settlement-table-wrap td small{color:#687b8a;font-weight:700}.settlement-note{padding:12px 14px;border-left:4px solid #f59a23;background:#fff;margin:16px 0}.settlement-tools{display:flex;gap:14px;align-items:end;margin:16px 0}.settlement-tools label{display:grid;gap:5px;font-weight:800}.settlement-tools select,.settlement-tools input{min-width:180px;padding:9px;border:1px solid #bfcbd4;background:#fff}.settlement-tools input{min-width:310px}.settlement-scroll-top{overflow-x:auto;overflow-y:hidden;height:18px;margin-bottom:4px;border:1px solid #cdd6dd;background:#f6f8f9}.settlement-scroll-top>div{height:1px}.settlement-table-wrap{overflow:auto;border:1px solid #cdd6dd;background:#fff}.settlement-table-wrap table{width:100%;border-collapse:collapse;font-size:.84rem;white-space:nowrap}.settlement-table-wrap th{position:sticky;top:0;background:#17324a;color:#fff;text-align:left;padding:10px 9px}.settlement-table-wrap th small{font-weight:500}.settlement-table-wrap td{padding:8px 9px;border-bottom:1px solid #e1e6ea}.settlement-table-wrap tbody tr:nth-child(even){background:#f6f8f9}.settlement-table-wrap .num{text-align:right}.settlement-table-wrap tfoot td{padding:10px 9px;background:#ffe2b7;font-weight:900;border-top:2px solid #f59a23}.private-section{margin-top:28px}.private-section h2{margin-bottom:4px}.private-section>p{margin-top:0;color:#647789}@media(max-width:850px){.settlement-app{padding:14px}.settlement-head{align-items:flex-start;flex-direction:column}.settlement-summary{grid-template-columns:1fr}.settlement-tools{align-items:stretch;flex-direction:column}.settlement-tools input,.settlement-tools select{min-width:0;width:100%;box-sizing:border-box}}
</style>
<script is:inline>
(() => {
  const API='/intern/api/revenue-summary-v2.php';
  const requestedProfile=new URLSearchParams(location.search).get('profile')||'christian';
  const profile=['christian','holger','rekon_marc','rekon_holger'].includes(requestedProfile)?requestedProfile:'christian';
  const isRekon=profile.startsWith('rekon_');
  const label=profile==='holger'?'Holger Claims':profile==='rekon_marc'?'Marc Rekon':profile==='rekon_holger'?'Holger Rekon':'Christian Claims';
  const state=document.getElementById('settlement-state'),content=document.getElementById('settlement-content'),summary=document.getElementById('settlement-summary'),meta=document.getElementById('settlement-meta'),refresh=document.getElementById('settlement-refresh'),refreshHelp=document.getElementById('settlement-refresh-help'),file=document.getElementById('settlement-file'),year=document.getElementById('settlement-year'),search=document.getElementById('settlement-search');
  const christianContent=document.getElementById('christian-content'),christianNote=document.getElementById('christian-note'),rows=document.getElementById('settlement-rows'),total=document.getElementById('settlement-total'),privateRows=document.getElementById('private-rows'),privateTotal=document.getElementById('private-total');
  const holgerContent=document.getElementById('holger-content'),holgerNote=document.getElementById('holger-note'),holgerRows=document.getElementById('holger-rows'),holgerTotal=document.getElementById('holger-total');
  const rekonContent=document.getElementById('rekon-content'),rekonNote=document.getElementById('rekon-note'),rekonRows=document.getElementById('rekon-rows'),rekonTotal=document.getElementById('rekon-total');
  const topScroll=document.getElementById('settlement-scroll-top'),scrollWidth=document.getElementById('settlement-scroll-width'),tableWrap=document.getElementById('settlement-table-wrap'),table=document.getElementById('settlement-table'),holgerTopScroll=document.getElementById('holger-scroll-top'),holgerScrollWidth=document.getElementById('holger-scroll-width'),holgerTableWrap=document.getElementById('holger-table-wrap'),holgerTable=document.getElementById('holger-table');
  const rekonTopScroll=document.getElementById('rekon-scroll-top'),rekonScrollWidth=document.getElementById('rekon-scroll-width'),rekonTableWrap=document.getElementById('rekon-table-wrap'),rekonTable=document.getElementById('rekon-table');
  document.getElementById(`profile-${profile}`).classList.add('active');christianContent.hidden=profile!=='christian';christianNote.hidden=profile!=='christian';holgerContent.hidden=profile!=='holger';holgerNote.hidden=profile!=='holger';rekonContent.hidden=!isRekon;rekonNote.hidden=!isRekon;search.placeholder=isRekon?'ID, Schadennummer, Versicherer oder Regulierer':profile==='holger'?'Leistungszeitraum oder Gutschriftdatum':'Auftragsnummer, VN, Ort oder Versicherer';file.multiple=isRekon;
  const esc=value=>String(value??'').replace(/[&<>"']/g,char=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[char]));
  const money=value=>new Intl.NumberFormat('de-DE',{style:'currency',currency:'EUR',minimumFractionDigits:2,maximumFractionDigits:2}).format(Number(value)||0);
  const number=value=>new Intl.NumberFormat('de-DE',{maximumFractionDigits:2}).format(Number(value)||0);
  let data={entries:[],private_entries:[]};
  function pair(net,gross){const netValue=Number(net)||0,grossValue=gross==null?netValue*1.19:Number(gross)||0;return `${money(netValue)} netto<br><small>${money(grossValue)} brutto</small>`}
  function optionalPair(net,gross){return net==null?'–':pair(net,gross)}
  function kilometer(row){const distance=row.distance_km==null?'–':`${number(row.distance_km)} km`,amount=optionalPair(row.km_amount_net,row.km_amount_gross);return `${distance}<br>${amount}`}
  function christianCard(item){return `<article class="settlement-card"><h2>${esc(item.period||item.year)}</h2><dl><dt>Auszahlung an SV-Büro (60 %)</dt><dd>${pair(item.ytd_net,item.ytd_gross)}</dd><dt>Tatsächliche Auftragssumme (100 %)</dt><dd>${pair(item.actual_order_net,item.actual_order_gross)}</dd><dt>Anteil Die Regulierer (40 %)</dt><dd>${pair(item.regulierer_net,item.regulierer_gross)}</dd><dt>Durchschnitt Auszahlung</dt><dd>${money(item.average_net)} netto</dd><dt>Hochrechnung Auftragssumme/Jahr</dt><dd>${pair(item.annualized_actual_order_net,item.annualized_actual_order_gross)}</dd></dl></article>`}
  function holgerCard(item){if(!item?.year)return '<article class="settlement-card"><h2>Noch keine Holger-Datei eingelesen</h2><p>Susanne kann die aktuelle Umsatzdatei über „Holger aktualisieren“ einlesen.</p></article>';return `<article class="settlement-card"><h2>${esc(item.period)}</h2><dl><dt>Tatsächliche Auftragssumme (100 %)</dt><dd>${pair(item.actual_order_net,item.actual_order_gross)}</dd><dt>Anteil Die Regulierer (40 %)</dt><dd>${pair(item.regulierer_net,item.regulierer_gross)}</dd><dt>Claims-Gutschrift (60 %)</dt><dd>${pair(item.income_net,item.income_gross)}</dd><dt>10 % an SV-Büro</dt><dd>${pair(item.our_share_net,item.our_share_gross)}</dd><dt>Office 365</dt><dd>${pair(item.office_net,item.office_gross)}</dd><dt>Gesamt an SV-Büro</dt><dd>${pair(item.our_total_net,item.our_total_gross)}</dd><dt>Holger nach Gesamtbelastung</dt><dd>${pair(item.holger_after_total_net,item.holger_after_total_gross)}</dd></dl></article>`}
  function rekonCard(item){if(!item?.year)return `<article class="settlement-card"><h2>Noch keine ${esc(label)}-Datei eingelesen</h2><p>Katja oder Susanne kann die aktuellen Rekon-Einzelpostenlisten über „${esc(label)} aktualisieren“ einlesen.</p></article>`;return `<article class="settlement-card"><h2>${esc(item.period)}</h2><dl><dt>Tatsächliche Auftragssumme (100 %)</dt><dd>${pair(item.actual_order_net,item.actual_order_gross)}</dd><dt>Anteil Rekon (40 %)</dt><dd>${pair(item.rekon_net,item.rekon_gross)}</dd><dt>Auszahlung SV-Büro (60 %)</dt><dd>${pair(item.payout_net,item.payout_gross)}</dd><dt>Durchschnitt Auszahlung</dt><dd>${money(item.average_net)} netto</dd><dt>Hochrechnung Auszahlung/Jahr</dt><dd>${pair(item.annualized_payout_net,item.annualized_payout_gross)}</dd></dl></article>`}
  function renderChristian(selected,needle){
    const list=(data.entries||[]).filter(row=>Number(row.year)===selected&&(!needle||[row.order_no,row.customer,row.place,row.insurer].join(' ').toLocaleLowerCase('de').includes(needle)));
    rows.innerHTML=list.map(row=>`<tr><td>${esc(row.month_label)}</td><td>${esc(row.order_no)}</td><td>${esc(row.customer)}</td><td>${esc(row.performed)}</td><td>${esc(row.billed)}</td><td>${esc(row.insurer)}</td><td class="num">${kilometer(row)}</td><td class="num">${optionalPair(row.work_time_net,row.work_time_gross)}</td><td class="num">${optionalPair(row.travel_time_net,row.travel_time_gross)}</td><td class="num">${pair(row.payout_net,row.payout_gross)}</td><td class="num">${pair(row.actual_order_net,row.actual_order_gross)}</td><td class="num">${pair(row.regulierer_net,row.regulierer_gross)}</td><td class="num">${row.damage_amount==null?'–':money(row.damage_amount)}</td></tr>`).join('')||'<tr><td colspan="13">Keine Buchungen für diese Auswahl vorhanden.</td></tr>';
    const sums=list.reduce((out,row)=>{out.distance+=Number(row.distance_km)||0;out.km+=Number(row.km_amount_net)||0;out.kmGross+=Number(row.km_amount_gross)||0;out.work+=Number(row.work_time_net)||0;out.workGross+=Number(row.work_time_gross)||0;out.travel+=Number(row.travel_time_net)||0;out.travelGross+=Number(row.travel_time_gross)||0;out.payout+=Number(row.payout_net)||0;out.payoutGross+=Number(row.payout_gross)||0;out.actual+=Number(row.actual_order_net)||0;out.actualGross+=Number(row.actual_order_gross)||0;out.regulierer+=Number(row.regulierer_net)||0;out.reguliererGross+=Number(row.regulierer_gross)||0;return out},{distance:0,km:0,kmGross:0,work:0,workGross:0,travel:0,travelGross:0,payout:0,payoutGross:0,actual:0,actualGross:0,regulierer:0,reguliererGross:0});
    total.innerHTML=`<tr><td colspan="6">Summe (${list.length} Buchungen)</td><td class="num">${number(sums.distance)} km<br>${pair(sums.km,sums.kmGross)}</td><td class="num">${pair(sums.work,sums.workGross)}</td><td class="num">${pair(sums.travel,sums.travelGross)}</td><td class="num">${pair(sums.payout,sums.payoutGross)}</td><td class="num">${pair(sums.actual,sums.actualGross)}</td><td class="num">${pair(sums.regulierer,sums.reguliererGross)}</td><td></td></tr>`;
    const privateList=(data.private_entries||[]).filter(row=>Number(row.year)===selected);privateRows.innerHTML=privateList.map(row=>`<tr><td>${esc(row.year)}</td><td>${esc(row.customer)}</td><td>${esc(row.place)}</td><td>${esc(row.appointment)}</td><td class="num">${money(row.gross)}</td></tr>`).join('')||'<tr><td colspan="5">Keine Privataufträge für dieses Jahr vorhanden.</td></tr>';privateTotal.innerHTML=`<tr><td colspan="4">Summe (${privateList.length} Buchungen)</td><td class="num">${money(privateList.reduce((sum,row)=>sum+(Number(row.gross)||0),0))}</td></tr>`;
  }
  function renderHolger(selected,needle){
    const list=(data.entries||[]).filter(row=>Number(row.year)===selected&&(!needle||[row.service_period,row.credit_date].join(' ').toLocaleLowerCase('de').includes(needle)));
    holgerRows.innerHTML=list.map(row=>`<tr><td>${esc(row.month_label)}</td><td>${esc(row.service_period)}</td><td>${esc(row.credit_date)}</td><td class="num">${pair(row.actual_order_net,row.actual_order_gross)}</td><td class="num">${pair(row.regulierer_net,row.regulierer_gross)}</td><td class="num">${pair(row.income_net,row.income_gross)}</td><td class="num">${pair(row.our_share_net,row.our_share_gross)}</td><td class="num">${pair(row.office_net,row.office_gross)}</td><td class="num">${pair(row.our_total_net,row.our_total_gross)}</td><td class="num">${pair(row.holger_after_share_net,row.holger_after_share_gross)}</td><td class="num">${pair(row.holger_after_total_net,row.holger_after_total_gross)}</td></tr>`).join('')||'<tr><td colspan="11">Keine Buchungen für diese Auswahl vorhanden.</td></tr>';
    const keys=['actual_order','regulierer','income','our_share','office','our_total','holger_after_share','holger_after_total'];const sums=Object.fromEntries(keys.flatMap(key=>[[`${key}_net`,0],[`${key}_gross`,0]]));for(const row of list)for(const key of keys){sums[`${key}_net`]+=Number(row[`${key}_net`])||0;sums[`${key}_gross`]+=Number(row[`${key}_gross`])||0}holgerTotal.innerHTML=`<tr><td colspan="3">Summe (${list.length} Gutschriften)</td><td class="num">${pair(sums.actual_order_net,sums.actual_order_gross)}</td><td class="num">${pair(sums.regulierer_net,sums.regulierer_gross)}</td><td class="num">${pair(sums.income_net,sums.income_gross)}</td><td class="num">${pair(sums.our_share_net,sums.our_share_gross)}</td><td class="num">${pair(sums.office_net,sums.office_gross)}</td><td class="num">${pair(sums.our_total_net,sums.our_total_gross)}</td><td class="num">${pair(sums.holger_after_share_net,sums.holger_after_share_gross)}</td><td class="num">${pair(sums.holger_after_total_net,sums.holger_after_total_gross)}</td></tr>`;
  }
  function renderRekon(selected,needle){
    const list=(data.entries||[]).filter(row=>Number(row.year)===selected&&(!needle||[row.id,row.claim_no,row.insurer,row.regulator,row.invoice_type].join(' ').toLocaleLowerCase('de').includes(needle)));
    rekonRows.innerHTML=list.map(row=>`<tr><td>${esc(row.month_label)}</td><td>${esc(row.id)}</td><td>${esc(row.claim_no)}</td><td>${esc(row.insurer)}</td><td>${esc(row.regulator)}</td><td>${esc(row.invoice_date)}</td><td>${esc(row.appointment)}</td><td>${esc(row.invoice_type)}</td><td class="num">${pair(row.actual_order_net,row.actual_order_gross)}</td><td class="num">${pair(row.rekon_net,row.rekon_gross)}</td><td class="num">${pair(row.payout_net,row.payout_gross)}</td></tr>`).join('')||'<tr><td colspan="11">Keine Rekon-Buchungen für diese Auswahl vorhanden.</td></tr>';
    const sums=list.reduce((out,row)=>{for(const key of['actual_order','rekon','payout']){out[`${key}_net`]+=Number(row[`${key}_net`])||0;out[`${key}_gross`]+=Number(row[`${key}_gross`])||0}return out},{actual_order_net:0,actual_order_gross:0,rekon_net:0,rekon_gross:0,payout_net:0,payout_gross:0});rekonTotal.innerHTML=`<tr><td colspan="8">Summe (${list.length} Einzelposten)</td><td class="num">${pair(sums.actual_order_net,sums.actual_order_gross)}</td><td class="num">${pair(sums.rekon_net,sums.rekon_gross)}</td><td class="num">${pair(sums.payout_net,sums.payout_gross)}</td></tr>`;
  }
  function render(){const selected=Number(year.value),needle=String(search.value||'').trim().toLocaleLowerCase('de');if(isRekon)renderRekon(selected,needle);else if(profile==='holger')renderHolger(selected,needle);else renderChristian(selected,needle);requestAnimationFrame(syncScrollWidths)}
  function connectScroll(top,width,wrap,target){let syncing=false;top.addEventListener('scroll',()=>{if(syncing)return;syncing=true;wrap.scrollLeft=top.scrollLeft;syncing=false});wrap.addEventListener('scroll',()=>{if(syncing)return;syncing=true;top.scrollLeft=wrap.scrollLeft;syncing=false});return()=>{width.style.width=`${target.scrollWidth}px`;top.scrollLeft=wrap.scrollLeft}}
  const syncChristian=connectScroll(topScroll,scrollWidth,tableWrap,table),syncHolger=connectScroll(holgerTopScroll,holgerScrollWidth,holgerTableWrap,holgerTable),syncRekon=connectScroll(rekonTopScroll,rekonScrollWidth,rekonTableWrap,rekonTable);function syncScrollWidths(){syncChristian();syncHolger();syncRekon()}window.addEventListener('resize',syncScrollWidths);
  async function load(action='settlement',workbooks=[]){
    state.hidden=false;state.className='settlement-state';state.textContent=action==='refresh'?`${label}s Umsatzdatei wird neu eingelesen …`:`${label}s Abrechnungsdaten werden geladen …`;
    try{const body=action==='refresh'&&workbooks.length?new FormData():undefined;if(body){if(isRekon)for(const workbook of workbooks)body.append('workbooks[]',workbook,workbook.name);else body.append('workbook',workbooks[0],workbooks[0].name)}const response=await fetch(`${API}?action=${action}&profile=${profile}`,{method:action==='refresh'?'POST':'GET',body,credentials:'same-origin',cache:'no-store'});const next=await response.json().catch(()=>({}));if(!response.ok||!next.ok)throw Error(next.error||'Abrechnung konnte nicht geladen werden.');if(!next.visible){if(next.default_profile){location.replace(`?profile=${encodeURIComponent(next.default_profile)}`);return}location.replace('/intern/versicherungsfaelle/');return}data=next;meta.textContent=`${label} · Quelle: ${next.source_provider||'Datenquelle'} · ${next.source||'Umsatzaufstellung'} · Stand ${next.source_updated_at||'–'}`;summary.innerHTML=isRekon?rekonCard(next.current)+rekonCard(next.previous):profile==='holger'?holgerCard(next.current)+holgerCard(next.previous):christianCard(next.current||{})+christianCard(next.previous||{});const years=(next.available_years?.length?next.available_years:[...new Set((next.entries||[]).map(row=>row.year))]).filter(Boolean);year.innerHTML=years.map(value=>`<option value="${esc(value)}">${esc(value)}</option>`).join('');year.disabled=!years.length;refresh.hidden=!next.can_refresh;refreshHelp.hidden=!next.can_refresh;refresh.textContent=`${label} aktualisieren`;refreshHelp.textContent=isRekon?'Aktuelle Rekon-Einzelpostenlisten auswählen (mehrere möglich)':`Gespeicherte Umsatzdatei für ${label} auswählen`;content.hidden=false;state.hidden=true;render()}catch(error){state.className='settlement-state bad';state.textContent=error.message||'Abrechnung konnte nicht geladen werden.'}
  }
  year.addEventListener('change',render);search.addEventListener('input',render);refresh.addEventListener('click',()=>file.click());file.addEventListener('change',async()=>{const workbooks=[...(file.files||[])];if(!workbooks.length)return;refresh.disabled=true;await load('refresh',workbooks);refresh.disabled=false;file.value=''});load();
})();
</script>
