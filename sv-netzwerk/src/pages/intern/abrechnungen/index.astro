---
import InternalLayout from '../../../layouts/InternalLayout.astro';
---
<InternalLayout title="Abrechnungen" description="Geschützte 60/40-Abrechnung Die Regulierer für Christian und Susanne." currentPath="/intern/abrechnungen/">
  <section class="settlement-app">
    <header class="settlement-head">
      <div><p class="settlement-kicker">Die Regulierer</p><h1>Abrechnungen</h1><p id="settlement-meta">Abrechnungsdaten werden geladen …</p></div>
      <button id="settlement-refresh" type="button" hidden>Jetzt aktualisieren</button>
    </header>
    <div id="settlement-state" class="settlement-state">Abrechnungsdaten werden geladen …</div>
    <div id="settlement-content" hidden>
      <section id="settlement-summary" class="settlement-summary" aria-label="Abrechnungssummen"></section>
      <p class="settlement-note">Berechnungsgrundlage: Der in der Umsatzaufstellung ausgewiesene Nettobetrag entspricht dem an das SV-Büro ausgezahlten Anteil von 60 %. Die tatsächliche Netto-Auftragssumme wird durch 0,60 geteilt; der verbleibende Anteil von 40 % wird „Die Regulierer“ zugerechnet. Die Bruttowerte enthalten 19 % Umsatzsteuer.</p>
      <div class="settlement-tools"><label>Jahr <select id="settlement-year"></select></label><label>Suche <input id="settlement-search" type="search" placeholder="Auftragsnummer, VN, Ort oder Versicherer" /></label></div>
      <div class="settlement-table-wrap"><table><thead><tr><th>Monat</th><th>Auftragsnummer</th><th>VN / Objekt</th><th>erbracht</th><th>abgerechnet</th><th>Versicherer</th><th class="num">Kilometer<br><small>km · Betrag netto / brutto</small></th><th class="num">Arbeitszeit<br><small>Betrag netto / brutto</small></th><th class="num">Fahrzeit<br><small>Betrag netto / brutto</small></th><th class="num">Auszahlung SV<br><small>60 % · netto / brutto</small></th><th class="num">Auftragssumme<br><small>100 % · netto / brutto</small></th><th class="num">Die Regulierer<br><small>40 % · netto / brutto</small></th><th class="num">Schadenhöhe ca.<br><small>laut Quelle</small></th></tr></thead><tbody id="settlement-rows"></tbody><tfoot id="settlement-total"></tfoot></table></div>
      <section class="private-section"><h2>Privataufträge</h2><p>Diese Bruttowerte werden unverändert aus dem Blatt „Privataufträge“ übernommen und nicht nach 60/40 umgerechnet.</p><div class="settlement-table-wrap"><table><thead><tr><th>Jahr</th><th>Auftraggeber</th><th>Ort</th><th>Ersttermin</th><th class="num">Brutto</th></tr></thead><tbody id="private-rows"></tbody><tfoot id="private-total"></tfoot></table></div></section>
    </div>
  </section>
</InternalLayout>
<style is:global>
.settlement-app{padding:24px;min-height:calc(100vh - 112px);box-sizing:border-box;color:#17324a}.settlement-head{display:flex;justify-content:space-between;align-items:flex-end;gap:20px;margin-bottom:18px}.settlement-kicker{margin:0;color:#f59a23;font-weight:900}.settlement-head h1{margin:3px 0}.settlement-head p{margin:0;color:#647789}.settlement-head button{padding:10px 14px;border:1px solid #17324a;background:#17324a;color:#fff;font-weight:800;cursor:pointer}.settlement-state{padding:14px;border:1px solid #f0d4a8;background:#fff8ec}.settlement-state.bad{color:#8b2525;border-color:#e4bcbc;background:#fff0f0}.settlement-summary{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px}.settlement-card{border:1px solid #d2dae0;border-top:4px solid #f59a23;background:#fff;padding:16px}.settlement-card h2{margin:0 0 12px;font-size:1.05rem}.settlement-card dl{display:grid;grid-template-columns:1fr auto;gap:8px 16px;margin:0}.settlement-card dt{color:#607486}.settlement-card dd{margin:0;font-weight:900;text-align:right}.settlement-note{padding:12px 14px;border-left:4px solid #f59a23;background:#fff;margin:16px 0}.settlement-tools{display:flex;gap:14px;align-items:end;margin:16px 0}.settlement-tools label{display:grid;gap:5px;font-weight:800}.settlement-tools select,.settlement-tools input{min-width:180px;padding:9px;border:1px solid #bfcbd4;background:#fff}.settlement-tools input{min-width:310px}.settlement-table-wrap{overflow:auto;border:1px solid #cdd6dd;background:#fff}.settlement-table-wrap table{width:100%;border-collapse:collapse;font-size:.84rem;white-space:nowrap}.settlement-table-wrap th{position:sticky;top:0;background:#17324a;color:#fff;text-align:left;padding:10px 9px}.settlement-table-wrap th small{font-weight:500}.settlement-table-wrap td{padding:8px 9px;border-bottom:1px solid #e1e6ea}.settlement-table-wrap tbody tr:nth-child(even){background:#f6f8f9}.settlement-table-wrap .num{text-align:right}.settlement-table-wrap tfoot td{padding:10px 9px;background:#ffe2b7;font-weight:900;border-top:2px solid #f59a23}.private-section{margin-top:28px}.private-section h2{margin-bottom:4px}.private-section>p{margin-top:0;color:#647789}@media(max-width:850px){.settlement-app{padding:14px}.settlement-head{align-items:flex-start;flex-direction:column}.settlement-summary{grid-template-columns:1fr}.settlement-tools{align-items:stretch;flex-direction:column}.settlement-tools input,.settlement-tools select{min-width:0;width:100%;box-sizing:border-box}}
.settlement-card dd small,.settlement-table-wrap td small{color:#687b8a;font-weight:700}
</style>
<script is:inline>
(() => {
  const API='/intern/api/revenue-summary-v2.php';
  const state=document.getElementById('settlement-state'),content=document.getElementById('settlement-content'),summary=document.getElementById('settlement-summary'),meta=document.getElementById('settlement-meta'),refresh=document.getElementById('settlement-refresh'),year=document.getElementById('settlement-year'),search=document.getElementById('settlement-search'),rows=document.getElementById('settlement-rows'),total=document.getElementById('settlement-total'),privateRows=document.getElementById('private-rows'),privateTotal=document.getElementById('private-total');
  const esc=value=>String(value??'').replace(/[&<>"']/g,char=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[char]));
  const money=value=>new Intl.NumberFormat('de-DE',{style:'currency',currency:'EUR',minimumFractionDigits:2,maximumFractionDigits:2}).format(Number(value)||0);
  const number=value=>new Intl.NumberFormat('de-DE',{maximumFractionDigits:2}).format(Number(value)||0);
  let data={entries:[],private_entries:[]};
  function pair(net,gross){const netValue=Number(net)||0,grossValue=gross==null?netValue*1.19:Number(gross)||0;return `${money(netValue)} netto<br><small>${money(grossValue)} brutto</small>`}
  function optionalPair(net,gross){return net==null?'–':pair(net,gross)}
  function kilometer(row){const distance=row.distance_km==null?'–':`${number(row.distance_km)} km`,amount=optionalPair(row.km_amount_net,row.km_amount_gross);return `${distance}<br>${amount}`}
  function card(item){return `<article class="settlement-card"><h2>${esc(item.period||item.year)}</h2><dl><dt>Auszahlung an SV-Büro (60 %)</dt><dd>${pair(item.ytd_net,item.ytd_gross)}</dd><dt>Tatsächliche Auftragssumme (100 %)</dt><dd>${pair(item.actual_order_net,item.actual_order_gross)}</dd><dt>Anteil Die Regulierer (40 %)</dt><dd>${pair(item.regulierer_net,item.regulierer_gross)}</dd><dt>Durchschnitt Auszahlung</dt><dd>${money(item.average_net)} netto</dd><dt>Hochrechnung Auftragssumme/Jahr</dt><dd>${pair(item.annualized_actual_order_net,item.annualized_actual_order_gross)}</dd></dl></article>`}
  function render(){
    const selected=Number(year.value),needle=String(search.value||'').trim().toLocaleLowerCase('de');const list=(data.entries||[]).filter(row=>Number(row.year)===selected&&(!needle||[row.order_no,row.customer,row.place,row.insurer].join(' ').toLocaleLowerCase('de').includes(needle)));
    rows.innerHTML=list.map(row=>`<tr><td>${esc(row.month_label)}</td><td>${esc(row.order_no)}</td><td>${esc(row.customer)}</td><td>${esc(row.performed)}</td><td>${esc(row.billed)}</td><td>${esc(row.insurer)}</td><td class="num">${kilometer(row)}</td><td class="num">${optionalPair(row.work_time_net,row.work_time_gross)}</td><td class="num">${optionalPair(row.travel_time_net,row.travel_time_gross)}</td><td class="num">${pair(row.payout_net,row.payout_gross)}</td><td class="num">${pair(row.actual_order_net,row.actual_order_gross)}</td><td class="num">${pair(row.regulierer_net,row.regulierer_gross)}</td><td class="num">${row.damage_amount==null?'–':money(row.damage_amount)}</td></tr>`).join('')||'<tr><td colspan="13">Keine Buchungen für diese Auswahl vorhanden.</td></tr>';
    const sums=list.reduce((out,row)=>{out.distance+=Number(row.distance_km)||0;out.km+=Number(row.km_amount_net)||0;out.kmGross+=Number(row.km_amount_gross)||0;out.work+=Number(row.work_time_net)||0;out.workGross+=Number(row.work_time_gross)||0;out.travel+=Number(row.travel_time_net)||0;out.travelGross+=Number(row.travel_time_gross)||0;out.payout+=Number(row.payout_net)||0;out.payoutGross+=Number(row.payout_gross)||0;out.actual+=Number(row.actual_order_net)||0;out.actualGross+=Number(row.actual_order_gross)||0;out.regulierer+=Number(row.regulierer_net)||0;out.reguliererGross+=Number(row.regulierer_gross)||0;return out},{distance:0,km:0,kmGross:0,work:0,workGross:0,travel:0,travelGross:0,payout:0,payoutGross:0,actual:0,actualGross:0,regulierer:0,reguliererGross:0});total.innerHTML=`<tr><td colspan="6">Summe (${list.length} Buchungen)</td><td class="num">${number(sums.distance)} km<br>${pair(sums.km,sums.kmGross)}</td><td class="num">${pair(sums.work,sums.workGross)}</td><td class="num">${pair(sums.travel,sums.travelGross)}</td><td class="num">${pair(sums.payout,sums.payoutGross)}</td><td class="num">${pair(sums.actual,sums.actualGross)}</td><td class="num">${pair(sums.regulierer,sums.reguliererGross)}</td><td></td></tr>`;
    const privateList=(data.private_entries||[]).filter(row=>Number(row.year)===selected);privateRows.innerHTML=privateList.map(row=>`<tr><td>${esc(row.year)}</td><td>${esc(row.customer)}</td><td>${esc(row.place)}</td><td>${esc(row.appointment)}</td><td class="num">${money(row.gross)}</td></tr>`).join('')||'<tr><td colspan="5">Keine Privataufträge für dieses Jahr vorhanden.</td></tr>';privateTotal.innerHTML=`<tr><td colspan="4">Summe (${privateList.length} Buchungen)</td><td class="num">${money(privateList.reduce((sum,row)=>sum+(Number(row.gross)||0),0))}</td></tr>`;
  }
  async function load(action='summary'){
    state.hidden=false;state.className='settlement-state';state.textContent=action==='refresh'?'Umsatzdatei wird neu eingelesen …':'Abrechnungsdaten werden geladen …';
    try{const response=await fetch(API+(action==='refresh'?'?action=refresh':'?action=settlement'),{method:action==='refresh'?'POST':'GET',credentials:'same-origin',cache:'no-store'});const next=await response.json().catch(()=>({}));if(!response.ok||!next.ok)throw Error(next.error||'Abrechnung konnte nicht geladen werden.');if(!next.visible){location.replace('/intern/versicherungsfaelle/');return}data=next;meta.textContent=`Quelle: ${next.source_provider||'Datenquelle'} · ${next.source||'Umsatzaufstellung'} · Stand ${next.source_updated_at||'–'}`;summary.innerHTML=card(next.current||{})+card(next.previous||{});const years=(next.available_years?.length?next.available_years:[...new Set((next.entries||[]).map(row=>row.year))]).filter(Boolean);year.innerHTML=years.map(value=>`<option value="${esc(value)}">${esc(value)}</option>`).join('');refresh.hidden=!next.can_refresh;content.hidden=false;state.hidden=true;render()}catch(error){state.className='settlement-state bad';state.textContent=error.message||'Abrechnung konnte nicht geladen werden.'}
  }
  year.addEventListener('change',render);search.addEventListener('input',render);refresh.addEventListener('click',async()=>{refresh.disabled=true;await load('refresh');refresh.disabled=false});load();
})();
</script>
