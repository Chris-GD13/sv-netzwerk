---
import InternalLayout from '../../../layouts/InternalLayout.astro';
---
<InternalLayout title="Zeiterfassung" description="Arbeitszeit, Überstunden und Urlaub im SV-Netzwerk-Portal." currentPath="/intern/zeiterfassung/">
  <main class="tt-app">
    <header class="tt-head">
      <div><p class="tt-kicker">SV-Netzwerk</p><h1>Zeiterfassung</h1><p id="tt-identity">Anmeldung wird geprüft …</p></div>
      <div class="tt-head-actions"><button id="tt-lexware-export" class="secondary" type="button" hidden>Daten für Lexware/Buchhaltung</button><button id="tt-refresh" type="button">Aktualisieren</button></div>
    </header>
    <section class="tt-card tt-clock tt-clock-top">
      <div><h2>Meine Arbeitszeit</h2><p>Mit deinem Konto ein- und ausbuchen. Eine offene Buchung kann nicht doppelt gestartet werden.</p></div>
      <div class="tt-actions"><button id="tt-clock-in" type="button">Einbuchen</button><button id="tt-pause" class="secondary" type="button">Pause</button><button id="tt-clock-out" class="secondary" type="button">Ausbuchen</button></div>
      <p id="tt-clock-state" class="tt-state" role="status" aria-live="polite"></p>
    </section>
    <section class="tt-summary" aria-label="Arbeitszeitkonto">
      <article><span>Offene Buchung</span><strong id="tt-open">–</strong><small id="tt-open-detail">Noch keine Daten geladen</small></article>
      <article class="tt-overtime"><span>Überstunden / Saldo</span><strong id="tt-balance">–</strong><small>Positive Salden können durch Zeitausgleich abgefeiert werden.</small></article>
      <article><span>Zeitausgleich genommen</span><strong id="tt-compensated">–</strong><small>Genehmigte Stunden im laufenden Jahr</small></article>
      <article class="tt-payout"><span>Auszahlung laufender Monat</span><strong id="tt-payout-total">0,00 €</strong><small>Arbeitszeit <b id="tt-payout-work">0,00 €</b> · Urlaub <b id="tt-payout-vacation">0,00 €</b> · Krank <b id="tt-payout-sick">0,00 €</b> · Feiertag <b id="tt-payout-holiday">0,00 €</b></small></article>
    </section>
    <section class="tt-card tt-vacation" aria-label="Urlaubsübersicht">
      <div class="tt-section-head"><div><h2>Urlaubsübersicht <span id="tt-vacation-year"></span></h2><p>Genommener Urlaub wird aus genehmigten Anträgen und TimeMoto übernommen. Resturlaub wird erst nach Hinterlegung des Anspruchs berechnet.</p></div></div>
      <div class="tt-vacation-cards">
        <article><span>Anspruch inkl. Übertrag</span><strong id="tt-vacation-entitlement">–</strong></article>
        <article><span>Genommen</span><strong id="tt-vacation-taken">–</strong></article>
        <article><span>Resturlaub</span><strong id="tt-vacation-remaining">–</strong></article>
        <article><span>Offene Anträge</span><strong id="tt-vacation-pending">–</strong></article>
      </div>
      <p id="tt-vacation-note" class="tt-state" role="status"></p>
      <div id="tt-vacation-team" class="tt-table-wrap" hidden><table><thead><tr><th>Person</th><th>Anspruch</th><th>Genommen</th><th>Rest</th><th>Offen</th></tr></thead><tbody id="tt-vacation-users"></tbody></table></div>
    </section>
    <section id="tt-overview" class="tt-card" hidden>
      <div class="tt-section-head"><div><h2>Teamübersicht</h2><p>Christian, Katja, Sanne und Marc sehen die für sie freigegebenen Kontostände. Marc hat Lesezugriff und darf Urlaube genehmigen.</p></div></div>
      <div class="tt-table-wrap"><table><thead><tr><th>Person</th><th>Gearbeitet</th><th>Überstunden / Saldo</th><th>Zeitausgleich</th><th>Status</th></tr></thead><tbody id="tt-users"></tbody></table></div>
    </section>
    <div class="tt-columns">
      <section class="tt-card">
        <h2>Urlaub oder Zeitausgleich beantragen</h2>
        <form id="tt-leave-form" class="tt-form">
          <label>Art<select id="tt-leave-type"><option value="urlaub">Urlaub</option><option value="zeitausgleich">Zeitausgleich aus Überstunden</option><option value="krank">Krankheit</option><option value="sonderurlaub">Sonderurlaub</option></select></label>
          <div class="tt-form-row"><label>Von<input id="tt-leave-from" type="date" required /></label><label>Bis<input id="tt-leave-to" type="date" required /></label></div>
          <label>Stunden (optional, für Zeitausgleich)<input id="tt-leave-hours" type="number" min="0" step="0.25" placeholder="z. B. 5" /></label>
          <label>Hinweis<textarea id="tt-leave-note" rows="3" maxlength="2000" placeholder="Optionaler Hinweis"></textarea></label>
          <button type="submit">Antrag speichern</button><p id="tt-leave-state" class="tt-state" role="status"></p>
        </form>
      </section>
      <section id="tt-approvals" class="tt-card" hidden><h2>Offene Genehmigungen</h2><p id="tt-approval-note">Urlaubsanträge werden hier nachvollziehbar entschieden.</p><div id="tt-approval-list" class="tt-list"></div></section>
    </div>
    <section id="tt-approved-future" class="tt-card"><h2>Genehmigter noch ausstehender Urlaub <span class="tt-subtitle">(im Urlaubskonto bereits berücksichtigt)</span></h2><p>Bereits genehmigte zukünftige Urlaubstage werden hier separat angezeigt und bleiben im Resturlaub berücksichtigt.</p><div id="tt-approved-future-list" class="tt-list"></div></section>
    <section id="tt-admin" class="tt-card" hidden>
      <div class="tt-section-head"><div><h2>Administration</h2><p>Nur Christian kann Buchungen nachtragen, ändern, Abwesenheiten erfassen und TimeMoto-Dateien importieren.</p><a class="tt-admin-link" href="/intern/fensterpruefung-bonn/admin/">Mitarbeiter anlegen, bearbeiten, ausblenden oder löschen</a></div></div>
      <form id="tt-entry-form" class="tt-form tt-admin-form"><input id="tt-entry-id" type="hidden" /><label>Mitarbeiter<select id="tt-entry-user"></select></label><div class="tt-form-row"><label>Datum<input id="tt-entry-date" type="date" required /></label><label>Pause in Minuten<input id="tt-entry-break" type="number" min="0" step="1" value="0" /></label></div><div class="tt-form-row"><label>Beginn<input id="tt-entry-start" type="time" required /></label><label>Ende<input id="tt-entry-end" type="time" /></label></div><div class="tt-form-row"><label>Sollzeit in Minuten<input id="tt-entry-planned" type="number" min="0" step="1" placeholder="optional" /></label><label>Saldo in Minuten<input id="tt-entry-balance" type="number" step="1" placeholder="automatisch berechnen" /></label></div><label>Notiz<input id="tt-entry-note" maxlength="2000" /></label><div class="tt-actions"><button type="submit">Buchung speichern</button><button id="tt-entry-reset" class="secondary" type="button">Leeren</button></div><p id="tt-entry-state" class="tt-state" role="status"></p></form>
      <form id="tt-entitlement-form" class="tt-form tt-admin-form"><h3>Mitarbeiterdaten und Urlaubsanspruch</h3><div class="tt-form-row"><label>Mitarbeiter<select id="tt-entitlement-user"></select></label><label>Jahresanspruch in Tagen<input id="tt-entitlement-annual" type="number" min="0" max="365" step="0.5" placeholder="z. B. 30" /></label></div><div class="tt-form-row"><label>Übertrag aus Vorjahr in Tagen<input id="tt-entitlement-carryover" type="number" min="0" max="365" step="0.5" value="0" /></label><label>Stundenlohn in €<input id="tt-entitlement-wage" type="number" min="0" max="10000" step="0.01" placeholder="z. B. 36,00" /></label></div><div class="tt-form-row"><label>Vereinbarte Wochenstunden<input id="tt-entitlement-weekly" type="number" min="0" max="168" step="0.25" placeholder="z. B. 40" /></label><label>Tägliche Sollzeit in Minuten<input id="tt-entitlement-daily" type="number" min="0" max="1440" step="1" placeholder="z. B. 480" /></label></div><div class="tt-form-row"><label>Feiertagskalender<select id="tt-entitlement-holiday-region"><option value="BW">Baden-Württemberg</option><option value="NRW">Nordrhein-Westfalen</option></select></label><label>Überstunden-Saldo nach Zeitausgleich<input id="tt-entitlement-balance-target" type="number" step="0.01" placeholder="z. B. 165" /></label></div><label>Resturlaub laufendes Jahr<input id="tt-entitlement-vacation-target" type="number" step="0.5" placeholder="z. B. 3" /></label><label class="tt-check"><input id="tt-entitlement-enabled" type="checkbox" checked /> Für die Zeiterfassung berücksichtigen</label><p class="tt-help">Samstage und Sonntage zählen nicht als Arbeitszeit. Manuell nachgetragene Wochenendzeiten werden als Überstunden gebucht. Feiertage werden bezahlt und nicht vom Urlaub abgezogen. Saldo- und Resturlaubsziele gelten als protokollierte Korrektur für das laufende Jahr.</p><div class="tt-actions"><button type="submit">Mitarbeiterdaten speichern</button></div><p id="tt-entitlement-state" class="tt-state" role="status"></p></form>
      <form id="tt-admin-leave-form" class="tt-form tt-admin-form"><h3>Abwesenheit nachtragen</h3><p>Für vergessene Anträge oder nachträgliche Korrekturen. Der Eintrag wird als genehmigt gespeichert und in der Urlaubsübersicht berücksichtigt.</p><label>Mitarbeiter<select id="tt-admin-leave-user"></select></label><label>Art<select id="tt-admin-leave-type"><option value="urlaub">Urlaub genommen</option><option value="krank">Krankheit</option><option value="zeitausgleich">Zeitausgleich</option><option value="sonderurlaub">Sonderurlaub</option></select></label><div class="tt-form-row"><label>Von<input id="tt-admin-leave-from" type="date" required /></label><label>Bis<input id="tt-admin-leave-to" type="date" required /></label></div><label>Stunden (optional)<input id="tt-admin-leave-hours" type="number" min="0" step="0.25" placeholder="z. B. 8" /></label><label>Notiz<input id="tt-admin-leave-note" maxlength="2000" placeholder="z. B. nachgetragen nach TimeMoto-Bericht" /></label><div class="tt-actions"><button type="submit">Abwesenheit speichern</button><button id="tt-admin-leave-reset" class="secondary" type="button">Leeren</button></div><p id="tt-admin-leave-state" class="tt-state" role="status"></p></form>
      <form id="tt-import-form" class="tt-import"><label>TimeMoto-Zeitbericht (.xlsx)<input id="tt-import-file" type="file" accept=".xlsx,.xlsm" required /></label><button type="submit">TimeMoto importieren</button><p id="tt-import-state" class="tt-state" role="status"></p></form>
      <details class="tt-disclosure"><summary>Abwesenheiten</summary><p>Nachgetragene, beantragte und importierte Abwesenheiten bleiben nachvollziehbar.</p><div class="tt-table-wrap"><table><thead><tr><th>Person</th><th>Art</th><th>Zeitraum</th><th>Stunden</th><th>Status</th><th>Quelle</th><th>Notiz</th><th>Aktionen</th></tr></thead><tbody id="tt-leave-history"></tbody></table></div></details>
    </section>
    <details class="tt-card tt-disclosure"><summary>Meine und freigegebene Buchungen</summary><p>Änderungen werden protokolliert. Der Saldo bleibt sichtbar und wird nicht stillschweigend ausgezahlt.</p><div class="tt-table-wrap"><table><thead><tr><th>Person</th><th>Datum</th><th>Beginn</th><th>Ende</th><th>Gearbeitet</th><th>Saldo</th><th>Quelle</th><th>Notiz</th></tr></thead><tbody id="tt-entries"></tbody></table></div></details>
  </main>
</InternalLayout>
<style is:global>
.tt-app{min-height:calc(100vh - 112px);box-sizing:border-box;padding:26px;color:#17324a}.tt-head{display:flex;align-items:flex-end;justify-content:space-between;gap:18px;margin-bottom:18px}.tt-head-actions{display:flex;align-items:center;gap:8px}.tt-kicker{margin:0;color:#f59a23;font-size:.8rem;font-weight:900;letter-spacing:.06em;text-transform:uppercase}.tt-head h1{margin:3px 0;font-size:2.1rem;color:#071a2e}.tt-head p{margin:0;color:#647789}.tt-head button,.tt-actions button,.tt-form button,.tt-import button{border:1px solid #17324a;background:#17324a;color:#fff;padding:10px 14px;font:inherit;font-weight:800;cursor:pointer}.tt-actions .secondary,.tt-form button.secondary,.tt-head-actions .secondary{background:#fff;color:#17324a}.tt-summary{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:10px;margin-bottom:14px}.tt-summary article{min-height:98px;padding:14px 15px;border-top:4px solid #f59a23;background:#fff;box-sizing:border-box}.tt-summary article.tt-overtime{border-top-color:#2f8a4b}.tt-summary span,.tt-summary small{display:block;color:#647789}.tt-summary span{font-size:.76rem;font-weight:800}.tt-summary strong{display:block;margin:7px 0 4px;color:#071a2e;font-size:1.55rem}.tt-summary small{font-size:.72rem;line-height:1.35}.tt-card{margin-bottom:14px;padding:18px;border:1px solid #d5dde3;background:#fff}.tt-card h2{margin:0 0 6px;color:#071a2e;font-size:1.12rem}.tt-card p{margin:0;color:#647789;line-height:1.45}.tt-clock{display:flex;align-items:center;justify-content:space-between;gap:16px}.tt-actions{display:flex;flex-wrap:wrap;gap:8px}.tt-state{min-height:1.2em;margin-top:10px!important;color:#647789;font-size:.78rem}.tt-state.ok{color:#24713c}.tt-state.bad{color:#ae382f}.tt-columns{display:grid;grid-template-columns:minmax(280px,1fr) minmax(300px,1fr);gap:14px}.tt-form{display:grid;gap:10px;margin-top:14px}.tt-form label,.tt-import label{display:grid;gap:5px;color:#52697a;font-size:.78rem;font-weight:800}.tt-form input,.tt-form select,.tt-form textarea,.tt-import input{box-sizing:border-box;width:100%;border:1px solid #bac7d0;background:#fff;color:#17324a;padding:9px;font:inherit}.tt-form textarea{resize:vertical}.tt-form-row{display:grid;grid-template-columns:1fr 1fr;gap:10px}.tt-section-head{display:flex;justify-content:space-between;gap:14px;margin-bottom:10px}.tt-table-wrap{overflow:auto;border:1px solid #cdd6dd;margin-top:10px}.tt-table-wrap table{width:100%;border-collapse:collapse;font-size:.82rem;white-space:nowrap}.tt-table-wrap th{padding:9px;background:#17324a;color:#fff;text-align:left}.tt-table-wrap td{padding:8px;border-bottom:1px solid #e1e6ea}.tt-table-wrap tbody tr:nth-child(even){background:#f6f8f9}.tt-list{display:grid;gap:8px;margin-top:12px}.tt-list article{display:flex;justify-content:space-between;align-items:center;gap:10px;padding:10px;background:#f3f6f8;border-left:4px solid #f59a23}.tt-list article strong,.tt-list article small{display:block}.tt-list article small{margin-top:3px;color:#647789}.tt-inline-edit{margin-left:7px;border:1px solid #17324a;background:#fff;color:#17324a;padding:3px 6px;font:inherit;font-size:.7rem;font-weight:800;cursor:pointer}.tt-list button{border:1px solid #17324a;background:#fff;color:#17324a;padding:7px 9px;font:inherit;font-weight:800;cursor:pointer}.tt-admin-form{max-width:750px}.tt-import{display:grid;grid-template-columns:minmax(260px,1fr) auto;align-items:end;gap:10px;margin-top:20px;padding-top:16px;border-top:1px solid #d5dde3}.tt-import .tt-state{grid-column:1/-1}.tt-empty{padding:14px;color:#718291;background:#f3f6f8}.tt-disclosure{padding:0;overflow:hidden}.tt-disclosure>summary{cursor:pointer;list-style:none;padding:18px;font-size:1.05rem;font-weight:800;color:#071a2e}.tt-disclosure>summary::-webkit-details-marker{display:none}.tt-disclosure>summary::after{content:'＋';float:right;color:#f59a23}.tt-disclosure[open]>summary::after{content:'−'}.tt-disclosure>p,.tt-disclosure>.tt-table-wrap{margin:0 18px 18px}.tt-disclosure>.tt-table-wrap{margin-top:0}@media(max-width:950px){.tt-summary{grid-template-columns:repeat(2,minmax(0,1fr))}.tt-columns{grid-template-columns:1fr}}@media(max-width:650px){.tt-app{padding:14px}.tt-head,.tt-clock{align-items:flex-start;flex-direction:column}.tt-head-actions{width:100%;flex-direction:column;align-items:stretch}.tt-summary{grid-template-columns:1fr}.tt-form-row,.tt-import{grid-template-columns:1fr}.tt-import .tt-state{grid-column:auto}.tt-head button{width:100%}}
.tt-admin-link{display:inline-block;margin-top:8px;color:#17324a;font-size:.78rem;font-weight:800;text-decoration:underline}.tt-vacation{border-top:4px solid #4e7aa0}.tt-vacation h2 span{font-size:.8rem;color:#647789;font-weight:700}.tt-vacation-cards{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:10px;margin-top:12px}.tt-vacation-cards article{padding:12px;background:#f3f6f8;border-left:3px solid #4e7aa0}.tt-vacation-cards span{display:block;color:#647789;font-size:.75rem;font-weight:800}.tt-vacation-cards strong{display:block;margin-top:5px;color:#071a2e;font-size:1.35rem}.tt-form h3{margin:4px 0 0;color:#071a2e;font-size:1rem}@media(max-width:950px){.tt-vacation-cards{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:650px){.tt-vacation-cards{grid-template-columns:1fr}}
.tt-subtitle{font-size:.82rem;color:#647789;font-weight:700}.tt-approvals .tt-list{max-height:150px;overflow:auto}.tt-future-vacation{border-top:4px solid #4e7aa0}
.tt-payout small{line-height:1.55}.tt-check{display:flex!important;grid-template-columns:none!important;align-items:center;gap:8px}.tt-check input{width:auto!important}.tt-help{font-size:.75rem!important;color:#647789!important}.tt-action-button{border:1px solid #17324a;background:#fff;color:#17324a;padding:4px 7px;font:inherit;font-size:.7rem;font-weight:800;cursor:pointer}.tt-action-button.danger{border-color:#ae382f;color:#ae382f}</style>
<script is:inline>
(() => {
  const API='/intern/api/time-tracking.php';
  const $=id=>document.getElementById(id);
  const esc=value=>String(value??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
  const request=async(url,options={})=>{const response=await fetch(url,{credentials:'same-origin',cache:'no-store',...options});const data=await response.json().catch(()=>({}));if(!response.ok||data.ok===false)throw Error(data.error||`HTTP ${response.status}`);return data};
  const fmtMinutes=value=>{const n=Number(value)||0,s=n<0?'-':'',m=Math.abs(n);return `${s}${Math.floor(m/60)}:${String(m%60).padStart(2,'0')}`};
  const fmtDays=value=>value===null||value===undefined?'nicht hinterlegt':`${Number(value).toLocaleString('de-DE',{maximumFractionDigits:2})} Tage`;
  const vacationOf=user=>user?.vacation||{annual_days:null,carryover_days:0,entitlement_days:null,taken_days:0,pending_days:0,remaining_days:null};
  const dateOnly=value=>String(value||'').slice(0,10).split('-').reverse().join('.');
  const timeOnly=value=>String(value||'').slice(11,16);
  const leaveLabel=value=>({urlaub:'Urlaub',krank:'Krankheit',zeitausgleich:'Zeitausgleich',sonderurlaub:'Sonderurlaub'}[String(value||'')]||String(value||''));
  const state=(id,text,kind='')=>{const el=$(id);el.textContent=text;el.className=`tt-state ${kind}`};
  let data=null;
  function currentUser(){return (data?.all_users||data?.users||[]).find(user=>Number(user.id)===Number(data?.actor?.id))||null}
  function render(){
    const own=currentUser();const tracked=data?.users||[];const permissions=data.permissions||{};const ownEntry=(data.entries||[]).find(entry=>Number(entry.user_id)===Number(data.actor.id)&&!entry.ended_at);$('tt-identity').textContent=`Angemeldet als ${data.actor.name} · ${permissions.can_edit_all?'Administrator':permissions.can_approve_leave&&permissions.can_view_all?'Lesen und Urlaub genehmigen':'Eigene Buchungen'}`;
    const enabled=!!own?.time_tracking_enabled; const paused=!!ownEntry?.pause_started_at; $('tt-open').textContent=!enabled?'aus':(ownEntry?(paused?'Pause läuft':'läuft'):'geschlossen');$('tt-open-detail').textContent=!enabled?'Für dieses Konto ausgeschaltet':(ownEntry?`${paused?'Pause seit':'Seit'} ${new Date(String(paused?ownEntry.pause_started_at:ownEntry.started_at).replace(' ','T')+'Z').toLocaleTimeString('de-DE',{hour:'2-digit',minute:'2-digit'})} Uhr`:'Keine offene Buchung');$('tt-clock-in').disabled=!enabled||!!ownEntry;$('tt-pause').disabled=!enabled||!ownEntry;$('tt-pause').textContent=paused?'Weiterarbeiten':'Pause';$('tt-clock-out').disabled=!enabled||!ownEntry;state('tt-clock-state',enabled?'':'Die Zeiterfassung ist für dein Konto ausgeschaltet.',enabled?'':'bad');
    const ownSummary=own||{balance_minutes:0,compensated_minutes:0};$('tt-balance').textContent=fmtMinutes(Number(ownSummary.balance_minutes)-Number(ownSummary.compensated_minutes));$('tt-compensated').textContent=fmtMinutes(ownSummary.compensated_minutes);const monthly=ownSummary.monthly||{};const euro=value=>Number(value||0).toLocaleString('de-DE',{style:'currency',currency:'EUR'});$('tt-payout-total').textContent=euro(monthly.total_amount);$('tt-payout-work').textContent=euro(monthly.worked_amount);$('tt-payout-vacation').textContent=euro(monthly.vacation_amount);$('tt-payout-sick').textContent=euro(monthly.sick_amount);$('tt-payout-holiday').textContent=euro(monthly.holiday_amount);
    const ownVacation=vacationOf(own);$('tt-vacation-year').textContent=data.year?data.year:'';$('tt-vacation-entitlement').textContent=fmtDays(ownVacation.entitlement_days);$('tt-vacation-taken').textContent=fmtDays(ownVacation.taken_days);$('tt-vacation-remaining').textContent=fmtDays(ownVacation.remaining_days);$('tt-vacation-pending').textContent=fmtDays(ownVacation.pending_days);$('tt-vacation-note').textContent=ownVacation.entitlement_days===null?'Der Jahresanspruch ist noch nicht hinterlegt. Christian kann ihn unten in der Administration eintragen.':`Resturlaub berücksichtigt Arbeitstage Mo–Fr, den Feiertagskalender ${esc(own?.holiday_region||'BW')} und genehmigte zukünftige Urlaubstage.`;
    $('tt-vacation-team').hidden=!permissions.can_view_all;$('tt-vacation-users').innerHTML=tracked.map(user=>{const v=vacationOf(user);return `<tr><td><strong>${esc(user.name)}</strong></td><td>${fmtDays(v.entitlement_days)}</td><td>${fmtDays(v.taken_days)}</td><td>${fmtDays(v.remaining_days)}</td><td>${fmtDays(v.pending_days)}</td></tr>`}).join('');
    $('tt-overview').hidden=!permissions.can_view_all;$('tt-admin').hidden=!permissions.can_edit_all;$('tt-approvals').hidden=!permissions.can_approve_leave;$('tt-lexware-export').hidden=!permissions.can_view_all;
    $('tt-users').innerHTML=tracked.map(user=>`<tr><td><strong>${esc(user.name)}</strong></td><td>${user.has_entries?fmtMinutes(user.worked_minutes):'keine Daten'}</td><td><strong>${user.has_entries?fmtMinutes(Number(user.balance_minutes)-Number(user.compensated_minutes)):'keine Daten'}</strong></td><td>${user.has_entries?fmtMinutes(user.compensated_minutes):'keine Daten'}</td><td>${user.has_entries?(user.open?'offen':'geschlossen'):'nicht eingelesen'}</td></tr>`).join('')||'<tr><td colspan="5">Keine Mitarbeiterdaten verfügbar.</td></tr>';
    $('tt-entries').innerHTML=(data.entries||[]).map(entry=>`<tr><td>${esc(entry.full_name)}</td><td>${dateOnly(entry.started_at)}</td><td>${timeOnly(entry.started_at)}</td><td>${entry.ended_at?timeOnly(entry.ended_at):'offen'}</td><td>${fmtMinutes(entry.worked_minutes)}</td><td>${fmtMinutes(entry.balance_minutes)}</td><td>${esc(entry.source==='timemoto_import'?'TimeMoto':'Portal')}</td><td>${esc(entry.note||'')}${permissions.can_edit_all?` <button class="tt-inline-edit" type="button" data-entry-id="${entry.id}">Bearbeiten</button>`:''}</td></tr>`).join('')||'<tr><td colspan="8">Noch keine Zeitbuchungen vorhanden.</td></tr>';
    document.querySelectorAll('[data-entry-id]').forEach(button=>button.addEventListener('click',()=>{const entry=(data.entries||[]).find(item=>Number(item.id)===Number(button.dataset.entryId));if(!entry)return;$('tt-entry-id').value=entry.id;$('tt-entry-user').value=entry.user_id;$('tt-entry-date').value=String(entry.started_at).slice(0,10);$('tt-entry-start').value=timeOnly(entry.started_at);$('tt-entry-end').value=entry.ended_at?timeOnly(entry.ended_at):'';$('tt-entry-break').value=entry.break_minutes||0;$('tt-entry-planned').value=entry.planned_minutes??'';$('tt-entry-balance').value=entry.balance_minutes??'';$('tt-entry-note').value=entry.note||'';document.getElementById('tt-admin').scrollIntoView({behavior:'smooth',block:'start'});state('tt-entry-state',`Buchung ${entry.id} zur Bearbeitung geladen.`)}));
    $('tt-approval-list').innerHTML=(data.leaves||[]).filter(item=>item.status==='pending').map(item=>`<article><div><strong>${esc(item.full_name)} · ${esc(leaveLabel(item.leave_type))}</strong><small>${dateOnly(item.starts_on)} – ${dateOnly(item.ends_on)}${Number(item.hours)?` · ${fmtMinutes(Math.round(Number(item.hours)*60))}`:''}</small></div><div class="tt-actions"><button type="button" data-decision="approved" data-id="${item.id}">Genehmigen</button><button type="button" data-decision="rejected" data-id="${item.id}">Ablehnen</button></div></article>`).join('')||'<p class="tt-empty">Keine offenen Anträge.</p>';
    $('tt-approval-list').querySelectorAll('[data-decision]').forEach(button=>button.addEventListener('click',async()=>{button.disabled=true;try{await request(`${API}?action=leave_decide`,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({id:Number(button.dataset.id),status:button.dataset.decision})});await load()}catch(error){state('tt-approval-note',error.message,'bad')}}));
    const futureUsers=permissions.can_view_all?tracked:[own].filter(Boolean);const futureRows=[];futureUsers.forEach(user=>{const v=vacationOf(user);(v.future_approved||[]).forEach(item=>futureRows.push(`<article><div><strong>${esc(user.name)}</strong><small>${dateOnly(item.starts_on)} – ${dateOnly(item.ends_on)}</small></div><strong>${fmtDays(item.days)}</strong></article>`))});$('tt-approved-future-list').innerHTML=futureRows.join('')||'<p class="tt-empty">Kein genehmigter zukünftiger Urlaub hinterlegt.</p>';
    $('tt-leave-history').innerHTML=(data.leaves||[]).map(item=>`<tr><td>${esc(item.full_name)}</td><td>${esc(leaveLabel(item.leave_type))}</td><td>${dateOnly(item.starts_on)} – ${dateOnly(item.ends_on)}</td><td>${Number(item.hours)?fmtMinutes(Math.round(Number(item.hours)*60)):'–'}</td><td>${esc(item.status==='approved'?'genehmigt':item.status==='rejected'?'abgelehnt':'offen')}</td><td>${esc(item.source==='timemoto_import'?'TimeMoto':item.source==='admin'?'Administration':'Portal')}</td><td>${esc(item.note||'')}</td><td>${permissions.can_edit_all?`<button class="tt-action-button" type="button" data-leave-edit="${item.id}">Bearbeiten</button> <button class="tt-action-button danger" type="button" data-leave-delete="${item.id}">Löschen</button>`:''}</td></tr>`).join('')||'<tr><td colspan="8">Noch keine Abwesenheiten erfasst.</td></tr>';
    document.querySelectorAll('[data-leave-edit]').forEach(button=>button.addEventListener('click',()=>{const item=(data.leaves||[]).find(row=>Number(row.id)===Number(button.dataset.leaveEdit));if(!item)return;$('tt-admin-leave-user').value=item.user_id;$('tt-admin-leave-type').value=item.leave_type;$('tt-admin-leave-from').value=item.starts_on;$('tt-admin-leave-to').value=item.ends_on;$('tt-admin-leave-hours').value=Number(item.hours)||'';$('tt-admin-leave-note').value=item.note||'';$('tt-admin-leave-form').dataset.editId=item.id;$('tt-admin-leave-form').scrollIntoView({behavior:'smooth',block:'start'});state('tt-admin-leave-state',`Abwesenheit ${item.id} zur Bearbeitung geladen.`)}));document.querySelectorAll('[data-leave-delete]').forEach(button=>button.addEventListener('click',async()=>{if(!confirm('Diese Abwesenheit wirklich löschen?'))return;try{await request(`${API}?action=leave_admin_delete`,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({id:Number(button.dataset.leaveDelete)})});await load()}catch(error){state('tt-admin-leave-state',error.message,'bad')}}));
    if(permissions.can_edit_all){const directory=(data.all_users||tracked).filter(user=>user.time_tracking_enabled!==false);$('tt-entry-user').innerHTML=directory.map(user=>`<option value="${user.id}">${esc(user.name)}</option>`).join('');$('tt-entitlement-user').innerHTML=directory.map(user=>`<option value="${user.id}">${esc(user.name)}</option>`).join('');$('tt-admin-leave-user').innerHTML=directory.map(user=>`<option value="${user.id}">${esc(user.name)}</option>`).join('');const fillEntitlement=()=>{const user=directory.find(item=>Number(item.id)===Number($('tt-entitlement-user').value))||directory?.[0];const v=vacationOf(user);$('tt-entitlement-annual').value=v.annual_days??'';$('tt-entitlement-carryover').value=v.carryover_days??0;$('tt-entitlement-weekly').value=user?.contractual_minutes_per_week?Number(user.contractual_minutes_per_week)/60:'';$('tt-entitlement-daily').value=user?.target_minutes_per_day?Number(user.target_minutes_per_day):'';$('tt-entitlement-wage').value=user?.hourly_wage??'';$('tt-entitlement-holiday-region').value=user?.holiday_region||'BW';$('tt-entitlement-balance-target').value=user?.balance_minutes===undefined?'':Number(user.balance_minutes)-Number(user.compensated_minutes||0);$('tt-entitlement-vacation-target').value=v.remaining_days??'';$('tt-entitlement-enabled').checked=user?.time_tracking_enabled!==false&&Number(user?.time_tracking_enabled??1)!==0};$('tt-entitlement-user').onchange=fillEntitlement;fillEntitlement()}
  }
  async function load(){try{data=await request(`${API}?action=summary`);render()}catch(error){state('tt-clock-state',error.message,'bad');$('tt-identity').textContent='Zeiterfassung konnte nicht geladen werden.'}}
  $('tt-clock-in').addEventListener('click',async()=>{try{await request(`${API}?action=clock_in`,{method:'POST'});state('tt-clock-state','Eingebucht.','ok');await load()}catch(error){state('tt-clock-state',error.message,'bad')}});
  $('tt-pause').addEventListener('click',async()=>{try{const result=await request(`${API}?action=pause_toggle`,{method:'POST'});state('tt-clock-state',result.paused?'Pause gestartet.':'Pause beendet und als Unterbrechung gespeichert.','ok');await load()}catch(error){state('tt-clock-state',error.message,'bad')}});
  $('tt-clock-out').addEventListener('click',async()=>{try{const result=await request(`${API}?action=clock_out`,{method:'POST'});state('tt-clock-state',`Ausgebucht · gearbeitet ${fmtMinutes(result.worked_minutes)} · Saldo ${fmtMinutes(result.balance_minutes)}.`,'ok');await load()}catch(error){state('tt-clock-state',error.message,'bad')}});
  $('tt-lexware-export').addEventListener('click',()=>{const year=encodeURIComponent(data?.year||new Date().getFullYear());window.location.assign(`${API}?action=lexware_export&year=${year}`)});
  $('tt-refresh').addEventListener('click',load);
  $('tt-leave-form').addEventListener('submit',async event=>{event.preventDefault();try{await request(`${API}?action=leave_submit`,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({leave_type:$('tt-leave-type').value,starts_on:$('tt-leave-from').value,ends_on:$('tt-leave-to').value,hours:$('tt-leave-hours').value,note:$('tt-leave-note').value})});state('tt-leave-state','Antrag gespeichert und zur Genehmigung vorgemerkt.','ok');event.target.reset();await load()}catch(error){state('tt-leave-state',error.message,'bad')}});
  $('tt-entry-form').addEventListener('submit',async event=>{event.preventDefault();try{await request(`${API}?action=save_entry`,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({id:Number($('tt-entry-id').value)||0,user_id:Number($('tt-entry-user').value),date:$('tt-entry-date').value,start:$('tt-entry-start').value,end:$('tt-entry-end').value,break_minutes:$('tt-entry-break').value,planned_minutes:$('tt-entry-planned').value,balance_minutes:$('tt-entry-balance').value,note:$('tt-entry-note').value})});state('tt-entry-state','Buchung gespeichert und protokolliert.','ok');$('tt-entry-reset').click();await load()}catch(error){state('tt-entry-state',error.message,'bad')}});
  $('tt-entitlement-form').addEventListener('submit',async event=>{event.preventDefault();try{await request(`${API}?action=save_leave_entitlement`,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({user_id:Number($('tt-entitlement-user').value),annual_leave_days:$('tt-entitlement-annual').value,carryover_leave_days:$('tt-entitlement-carryover').value,contractual_minutes_per_week:$('tt-entitlement-weekly').value?Math.round(Number($('tt-entitlement-weekly').value)*60):'',target_minutes_per_day:$('tt-entitlement-daily').value,hourly_wage:$('tt-entitlement-wage').value,holiday_region:$('tt-entitlement-holiday-region').value,balance_target_minutes:$('tt-entitlement-balance-target').value,vacation_remaining_target:$('tt-entitlement-vacation-target').value,time_tracking_enabled:$('tt-entitlement-enabled').checked})});state('tt-entitlement-state','Mitarbeiterdaten gespeichert und protokolliert.','ok');await load()}catch(error){state('tt-entitlement-state',error.message,'bad')}});
   $('tt-admin-leave-form').addEventListener('submit',async event=>{event.preventDefault();const editing=!!event.target.dataset.editId;try{await request(`${API}?action=${editing?'leave_admin_update':'leave_admin_save'}`,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({id:Number(event.target.dataset.editId)||0,user_id:Number($('tt-admin-leave-user').value),leave_type:$('tt-admin-leave-type').value,starts_on:$('tt-admin-leave-from').value,ends_on:$('tt-admin-leave-to').value,hours:$('tt-admin-leave-hours').value,note:$('tt-admin-leave-note').value})});state('tt-admin-leave-state',editing?'Abwesenheit geändert.':'Abwesenheit gespeichert und als genehmigt berücksichtigt.','ok');delete event.target.dataset.editId;event.target.reset();await load()}catch(error){state('tt-admin-leave-state',error.message,'bad')}});
   $('tt-admin-leave-reset').addEventListener('click',()=>{delete $('tt-admin-leave-form').dataset.editId;$('tt-admin-leave-form').reset()});
  $('tt-entry-reset').addEventListener('click',()=>{$('tt-entry-id').value='';$('tt-entry-date').value='';$('tt-entry-start').value='';$('tt-entry-end').value='';$('tt-entry-break').value='0';$('tt-entry-planned').value='';$('tt-entry-balance').value='';$('tt-entry-note').value=''});
  $('tt-import-form').addEventListener('submit',async event=>{event.preventDefault();const file=$('tt-import-file').files[0];if(!file){state('tt-import-state','Bitte eine Datei auswählen.','bad');return}const form=new FormData();form.append('file',file);state('tt-import-state','Import läuft …');try{const result=await request(`${API}?action=import_timemoto`,{method:'POST',body:form});state('tt-import-state',`${result.entries_imported} Zeitbuchung(en) und ${result.leave_imported} Abwesenheit(en) importiert; ${result.skipped} Zeile(n) übersprungen.`,'ok');event.target.reset();await load()}catch(error){state('tt-import-state',error.message,'bad')}});
  load();
})();
</script>
