---
import InternalLayout from '../../../layouts/InternalLayout.astro';
---

<InternalLayout title="Telefonzentrale" description="Telefonieren mit xtelsio, GEQUDIO GZ-6 und fallbezogener Anruferkennung." currentPath="/intern/telefon/">
  <main class="ph-app">
    <header class="ph-head">
      <div><p class="ph-kicker">xtelsio · GEQUDIO GZ-6 · Sipgate</p><h1>Telefonzentrale</h1><p>Telefonieren, Gespräche steuern und Anrufer direkt dem richtigen Schadenfall zuordnen.</p></div>
      <span id="ph-status" class="ph-status">Telefonsteuerung bereit</span>
    </header>

    <section id="ph-incoming" class="ph-incoming" hidden aria-live="assertive">
      <div><small>Eingehender Anruf</small><strong id="ph-incoming-name">Unbekannter Anrufer</strong><span id="ph-incoming-number"></span><p id="ph-incoming-case">Schadenfall wird gesucht …</p></div>
      <div class="ph-incoming-actions"><button type="button" data-phone-action="answer" class="ph-answer">Annehmen</button><button type="button" data-phone-action="drop" class="ph-drop">Auflegen</button><a id="ph-open-case" href="/intern/versicherungsfaelle/" hidden>Fall öffnen</a></div>
    </section>

    <div class="ph-grid">
      <section class="ph-card ph-dialer">
        <div class="ph-title"><div><span>1</span><h2>Wählen</h2></div><small>Übergabe an xtelsio</small></div>
        <label class="ph-number-label">Telefonnummer<input id="ph-number" type="tel" inputmode="tel" autocomplete="tel" placeholder="Telefonnummer eingeben"></label>
        <div class="ph-keypad" aria-label="Wähltastatur">
          <button type="button">1</button><button type="button">2</button><button type="button">3</button>
          <button type="button">4</button><button type="button">5</button><button type="button">6</button>
          <button type="button">7</button><button type="button">8</button><button type="button">9</button>
          <button type="button">*</button><button type="button">0</button><button type="button">#</button>
        </div>
        <div class="ph-call-actions"><button id="ph-dial" type="button" class="ph-answer">Anrufen</button><button id="ph-clear" type="button" class="ph-secondary">Löschen</button></div>
        <div class="ph-control-actions"><button type="button" data-phone-action="answer" class="ph-answer">Gespräch annehmen</button><button type="button" data-phone-action="drop" class="ph-drop">Gespräch beenden</button></div>
        <p id="ph-dial-state" class="ph-note" aria-live="polite"></p>
      </section>

      <section class="ph-card">
        <div class="ph-title"><div><span>2</span><h2>Aktiver Schadenfall</h2></div><a href="/intern/versicherungsfaelle/">Fälle öffnen</a></div>
        <div id="ph-active-case" class="ph-empty">Noch kein Schadenfall geöffnet.</div>
        <div id="ph-case-contacts" class="ph-contact-list"></div>
        <div id="ph-assign" class="ph-assign" hidden>
          <strong>Aktuellen Anrufer zuordnen</strong>
          <p>Die Nummer wird dauerhaft in den Falldaten auf Google Drive gespeichert.</p>
          <input id="ph-assign-name" type="text" maxlength="160" placeholder="Name oder Ansprechpartner">
          <button id="ph-assign-save" type="button" class="ph-secondary">Rufnummer diesem Fall zuordnen</button>
          <small id="ph-assign-state"></small>
        </div>
      </section>

      <section class="ph-card ph-wide">
        <div class="ph-title"><div><span>3</span><h2>Telefonbuch und Fallsuche</h2></div><small>VN, Sanierer und weitere Ansprechpartner</small></div>
        <div class="ph-search"><input id="ph-search" type="search" placeholder="Name, Telefonnummer oder Schadennummer"><button id="ph-search-button" type="button" class="ph-secondary">Suchen</button></div>
        <div id="ph-results" class="ph-results"><p class="ph-empty">Suchbegriff eingeben oder einen Kontakt aus dem aktiven Fall wählen.</p></div>
      </section>

      <details class="ph-card ph-wide ph-setup">
        <summary>Einmalige Windows-Einrichtung für Annehmen und Auflegen</summary>
        <p>Das normale Wählen wird direkt an xtelsio übergeben. Für die beiden Steuerknöpfe „Annehmen“ und „Auflegen“ muss auf Susannes PC einmalig die lokale Portal-Verknüpfung installiert werden.</p>
        <a href="/intern/downloads/Install-SVNetzwerk-Telefon.ps1" download>Windows-Verknüpfung herunterladen</a>
        <ol><li>Datei herunterladen.</li><li>Mit der rechten Maustaste „Mit PowerShell ausführen“ wählen.</li><li>xtelsio während der Einrichtung gestartet lassen.</li></ol>
      </details>
    </div>
  </main>
</InternalLayout>

<style is:global>
.ph-app{box-sizing:border-box;min-height:calc(100vh - 112px);padding:26px;color:#17324a}.ph-head{display:flex;align-items:flex-end;justify-content:space-between;gap:20px;margin-bottom:18px}.ph-kicker{margin:0;color:#f59a23;font-size:.8rem;font-weight:900;text-transform:uppercase;letter-spacing:.05em}.ph-head h1{margin:3px 0;font-size:2.1rem}.ph-head p{margin:0;color:#647789}.ph-status{padding:8px 11px;border-left:4px solid #2f8f67;background:#edf7f2;font-size:.78rem;font-weight:800}.ph-grid{display:grid;grid-template-columns:minmax(300px,.75fr) minmax(360px,1.25fr);gap:14px}.ph-card{padding:18px;border:1px solid #d5dde3;border-top:4px solid #f59a23;background:#fff;box-shadow:0 2px 8px rgba(7,26,46,.06)}.ph-wide{grid-column:1/-1}.ph-title{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-bottom:14px}.ph-title>div{display:flex;align-items:center;gap:9px}.ph-title span{display:grid;width:28px;height:28px;place-items:center;background:#17324a;color:#fff;font-weight:900}.ph-title h2{margin:0;font-size:1.08rem}.ph-title small{color:#6b7d8d}.ph-title a,.ph-incoming a,.ph-setup a{color:#17324a;font-weight:800}.ph-number-label{display:grid;gap:5px;color:#536a7d;font-size:.78rem;font-weight:800}.ph-number-label input,.ph-search input,.ph-assign input{box-sizing:border-box;width:100%;border:1px solid #b9c7d1;border-radius:3px;padding:12px;font:inherit;color:#17324a}.ph-number-label input{font-size:1.35rem;font-weight:800;letter-spacing:.03em}.ph-keypad{display:grid;grid-template-columns:repeat(3,1fr);gap:7px;margin:12px 0}.ph-keypad button{min-height:46px;border:1px solid #c9d4dc;background:#f5f7f8;color:#17324a;font:inherit;font-size:1.1rem;font-weight:900;cursor:pointer}.ph-call-actions,.ph-control-actions{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-top:8px}.ph-answer,.ph-drop,.ph-secondary{border:1px solid transparent;border-radius:3px;padding:11px 13px;font:inherit;font-weight:900;cursor:pointer}.ph-answer{background:#2f8f67;color:#fff}.ph-drop{background:#a33434;color:#fff}.ph-secondary{border-color:#17324a;background:#fff;color:#17324a}.ph-note{min-height:1.2em;margin:9px 0 0;color:#647789;font-size:.78rem}.ph-empty{padding:13px;background:#f3f6f8;color:#6b7d8d}.ph-case-summary{padding:13px;border-left:4px solid #2f8f67;background:#edf7f2}.ph-case-summary strong,.ph-case-summary span{display:block}.ph-case-summary span{margin-top:3px;color:#607486;font-size:.8rem}.ph-contact-list{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:7px;margin-top:10px}.ph-contact{display:flex;justify-content:space-between;align-items:center;gap:9px;padding:9px;border:1px solid #d9e1e7;background:#fafbfb}.ph-contact span{min-width:0}.ph-contact strong,.ph-contact small{display:block;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.ph-contact small{margin-top:2px;color:#647789}.ph-contact button{flex:0 0 auto;border:1px solid #17324a;background:#17324a;color:#fff;padding:7px 9px;font-weight:800;cursor:pointer}.ph-search{display:grid;grid-template-columns:1fr auto;gap:8px}.ph-results{display:grid;gap:7px;margin-top:10px}.ph-result{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:10px;border:1px solid #d9e1e7}.ph-result strong,.ph-result small{display:block}.ph-result small{margin-top:2px;color:#647789}.ph-result div:last-child{display:flex;gap:6px}.ph-assign{margin-top:13px;padding:12px;border:1px solid #edc487;background:#fff8ed}.ph-assign p{margin:3px 0 9px;color:#6b7d8d;font-size:.78rem}.ph-assign button{width:100%;margin-top:7px}.ph-assign small{display:block;margin-top:6px;color:#5e7282}.ph-incoming{display:flex;align-items:center;justify-content:space-between;gap:18px;margin-bottom:14px;padding:16px;border:2px solid #f59a23;background:#fff8ed}.ph-incoming small,.ph-incoming strong,.ph-incoming span{display:block}.ph-incoming strong{margin:2px 0;font-size:1.2rem}.ph-incoming p{margin:5px 0 0;color:#647789}.ph-incoming-actions{display:flex;flex-wrap:wrap;gap:7px}.ph-incoming-actions a{align-self:center;padding:10px}.ph-setup summary{cursor:pointer;font-weight:900}.ph-setup p,.ph-setup li{color:#5e7282}.ph-setup a{display:inline-block;padding:10px 12px;border:1px solid #17324a;text-decoration:none}@media(max-width:900px){.ph-grid{grid-template-columns:1fr}.ph-wide{grid-column:auto}}@media(max-width:620px){.ph-app{padding:14px}.ph-head,.ph-incoming{align-items:flex-start;flex-direction:column}.ph-contact-list{grid-template-columns:1fr}.ph-search{grid-template-columns:1fr}.ph-control-actions{grid-template-columns:1fr}}
</style>

<script is:inline>
(() => {
  const $=id=>document.getElementById(id),API='/intern/api/google-drive-sync.php';
  const request=async(url,options={})=>{const response=await fetch(url,{credentials:'same-origin',...options}),data=await response.json().catch(()=>({}));if(!response.ok)throw Error(data.error||`HTTP ${response.status}`);return data};
  const activeCase=()=>{for(const store of[sessionStorage,localStorage])try{const value=JSON.parse(store.getItem('svnet-case')||'null');if(value?.folder_id)return value}catch{}return null};
  const keep=value=>{sessionStorage.setItem('svnet-case',JSON.stringify(value));localStorage.setItem('svnet-case',JSON.stringify(value));renderActive()};
  const mobile=()=>navigator.userAgentData?.mobile??/Android|iPhone|iPad|iPod/i.test(navigator.userAgent);
  const dial=number=>{const clean=String(number||'').trim().replace(/[^\d+*#]/g,'');if(!clean){$('ph-dial-state').textContent='Bitte eine Telefonnummer eingeben.';return}$('ph-dial-state').textContent=`${clean} wird an ${mobile()?'die Telefon-App':'xtelsio'} übergeben …`;location.href=`${mobile()?'tel':'callto'}:${clean}`};
  const contactRows=meta=>[
    ['VN Telefon',meta.telefon],['VN Mobil',meta.mobil],['Sanierer Telefon',meta.sanierer_telefon],['Sanierer Mobil',meta.sanierer_mobil],
    ...(Array.isArray(meta.telefonkontakte)?meta.telefonkontakte.map(row=>[row.name||'Ansprechpartner',row.nummer]):[])
  ].filter(([,number])=>String(number||'').trim());
  function renderActive(){const active=activeCase(),box=$('ph-active-case'),contacts=$('ph-case-contacts');contacts.innerHTML='';if(!active){box.className='ph-empty';box.textContent='Noch kein Schadenfall geöffnet.';return}const meta=active.meta||{};box.className='ph-case-summary';box.innerHTML='';const title=document.createElement('strong');title.textContent=meta.schaden_nr||'Fall ohne Schaden-Nr.';const detail=document.createElement('span');detail.textContent=[meta.vn_objekt,meta.schaden_ort||meta.ort].filter(Boolean).join(' · ');box.append(title,detail);contactRows(meta).forEach(([label,number])=>{const row=document.createElement('div');row.className='ph-contact';const text=document.createElement('span');const strong=document.createElement('strong');strong.textContent=label;const small=document.createElement('small');small.textContent=number;text.append(strong,small);const button=document.createElement('button');button.type='button';button.textContent='Anrufen';button.onclick=()=>dial(number);row.append(text,button);contacts.append(row)})}
  document.querySelectorAll('.ph-keypad button').forEach(button=>button.onclick=()=>{$('ph-number').value+=button.textContent});
  $('ph-clear').onclick=()=>{$('ph-number').value='';$('ph-number').focus()};$('ph-dial').onclick=()=>dial($('ph-number').value);$('ph-number').onkeydown=event=>{if(event.key==='Enter'){event.preventDefault();dial(event.currentTarget.value)}};
  document.querySelectorAll('[data-phone-action]').forEach(button=>button.onclick=()=>{const action=button.dataset.phoneAction;$('ph-status').textContent=action==='answer'?'Gespräch wird über xtelsio angenommen …':'Gespräch wird über xtelsio beendet …';location.href=`svnet-xtelsio://${action}`});
  async function openCase(row){const data=await request(`${API}?action=load_case&id=${encodeURIComponent(row.id)}`),selected={folder_id:data.case?.id||row.id,meta:{...(row.meta||{}),...(data.case?.meta||{})}};keep(selected);return selected}
  const renderResults=rows=>{const box=$('ph-results');box.innerHTML='';if(!rows.length){box.innerHTML='<p class="ph-empty">Kein passender Schadenfall gefunden.</p>';return}rows.forEach(row=>{const card=document.createElement('div');card.className='ph-result';const text=document.createElement('div');const title=document.createElement('strong');title.textContent=row.meta?.schaden_nr||row.name||'Versicherungsfall';const detail=document.createElement('small');detail.textContent=[row.meta?.vn_objekt,row.meta?.ort].filter(Boolean).join(' · ');text.append(title,detail);const actions=document.createElement('div');const open=document.createElement('button');open.type='button';open.className='ph-secondary';open.textContent='Öffnen';open.onclick=()=>openCase(row);actions.append(open);card.append(text,actions);box.append(card)})};
  async function search(){const query=$('ph-search').value.trim();if(query.length<2)return;$('ph-results').innerHTML='<p class="ph-empty">Suche läuft …</p>';try{const data=await request(`${API}?action=search_cases&q=${encodeURIComponent(query)}`);renderResults(data.results||[])}catch(error){$('ph-results').textContent=error.message}}
  $('ph-search-button').onclick=search;$('ph-search').onkeydown=event=>{if(event.key==='Enter'){event.preventDefault();search()}};
  async function incoming(){const params=new URLSearchParams(location.search),number=params.get('anrufer')?.trim(),name=params.get('anrufername')?.trim()||'';if(!number)return;$('ph-incoming').hidden=false;$('ph-incoming-number').textContent=number;$('ph-incoming-name').textContent=name||'Unbekannter Anrufer';$('ph-number').value=number;sessionStorage.setItem('svnet-incoming-phone',number);if(name)sessionStorage.setItem('svnet-incoming-name',name);try{const data=await request(`${API}?action=incoming_phone&number=${encodeURIComponent(number)}`),rows=data.results||[];if(rows.length===1){const selected=await openCase(rows[0]);$('ph-incoming-case').textContent=`Erkannt: ${selected.meta?.schaden_nr||'Schadenfall'} · ${selected.meta?.vn_objekt||''}`;$('ph-open-case').hidden=false}else if(rows.length>1){$('ph-incoming-case').textContent=`${rows.length} mögliche Schadenfälle gefunden. Bitte unten auswählen.`;renderResults(rows)}else{$('ph-incoming-case').textContent='Nummer noch keinem Fall zugeordnet. Fall über Schadennummer suchen und anschließend zuordnen.';$('ph-assign').hidden=!activeCase();$('ph-assign-name').value=name}}catch(error){$('ph-incoming-case').textContent=error.message}}
  $('ph-assign-save').onclick=async()=>{const active=activeCase(),number=new URLSearchParams(location.search).get('anrufer')||sessionStorage.getItem('svnet-incoming-phone')||'',name=$('ph-assign-name').value.trim(),state=$('ph-assign-state');if(!active){state.textContent='Bitte zuerst den richtigen Schadenfall öffnen.';return}if(!name){state.textContent='Bitte Namen oder Ansprechpartner eingeben.';return}try{const data=await request(`${API}?action=save_phone_contact`,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({folder_id:active.folder_id,number,name})});keep({...active,meta:data.meta});state.textContent=`${name} wurde gespeichert und wird beim nächsten Anruf automatisch erkannt.`;sessionStorage.removeItem('svnet-incoming-phone');sessionStorage.removeItem('svnet-incoming-name');$('ph-assign').hidden=true}catch(error){state.textContent=error.message}};
  new MutationObserver(()=>{$('ph-assign').hidden=!(activeCase()&&(new URLSearchParams(location.search).get('anrufer')||sessionStorage.getItem('svnet-incoming-phone')))}).observe($('ph-active-case'),{childList:true,subtree:true});
  renderActive();incoming();
})();
</script>
