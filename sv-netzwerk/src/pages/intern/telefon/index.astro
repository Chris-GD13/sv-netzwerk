---
import InternalLayout from '../../../layouts/InternalLayout.astro';
---

<InternalLayout title="Telefonzentrale" description="Telefonieren mit xtelsio, GEQUDIO GZ-6 und fallbezogener Anruferkennung." currentPath="/intern/telefon/">
  <main class="ph-app">
    <header class="ph-head">
      <div><p class="ph-kicker">xtelsio · GEQUDIO GZ-6 · Sipgate</p><h1>Telefonzentrale</h1><p>Telefonieren, Gespräche steuern und Anrufer direkt dem richtigen Schadenfall zuordnen.</p></div>
      <span id="ph-status" class="ph-status">Telefonsteuerung bereit</span>
    </header>

    <section id="ph-incoming" class="ph-incoming" hidden aria-live="assertive">
      <div><small>Eingehender Anruf</small><strong id="ph-incoming-name">Unbekannter Anrufer</strong><span id="ph-incoming-number"></span><p id="ph-incoming-case">Schadenfall wird gesucht …</p></div>
      <div class="ph-incoming-actions"><button type="button" data-phone-action="answer" class="ph-answer">Annehmen</button><button type="button" data-phone-action="drop" class="ph-drop">Auflegen</button><a id="ph-open-case" href="/intern/versicherungsfaelle/" hidden>Fall öffnen</a></div>
    </section>

    <div class="ph-grid">
      <section class="ph-card ph-dialer">
        <div class="ph-title"><div><span>1</span><h2>Wählen</h2></div><small>Übergabe an xtelsio</small></div>
        <label class="ph-number-label">Telefonnummer<input id="ph-number" type="tel" inputmode="tel" autocomplete="tel" placeholder="Telefonnummer eingeben"></label>
        <div class="ph-keypad" aria-label="Wähltastatur">
          <button type="button">1</button><button type="button">2</button><button type="button">3</button>
          <button type="button">4</button><button type="button">5</button><button type="button">6</button>
          <button type="button">7</button><button type="button">8</button><button type="button">9</button>
          <button type="button">*</button><button type="button">0</button><button type="button">#</button>
        </div>
        <div class="ph-call-actions"><button id="ph-dial" type="button" class="ph-answer">Anrufen</button><button id="ph-clear" type="button" class="ph-secondary">Löschen</button></div>
        <div class="ph-control-actions"><button type="button" data-phone-action="answer" class="ph-answer">Gespräch annehmen</button><button type="button" data-phone-action="drop" class="ph-drop">Gespräch beenden</button></div>
        <p id="ph-dial-state" class="ph-note" aria-live="polite"></p>
      </section>

      <section class="ph-card">
        <div class="ph-title"><div><span>2</span><h2>Aktiver Schadenfall</h2></div><a href="/intern/versicherungsfaelle/">Fälle öffnen</a></div>
        <div id="ph-active-case" class="ph-empty">Noch kein Schadenfall geöffnet.</div>
        <div id="ph-case-contacts" class="ph-contact-list"></div>
        <div id="ph-assign" class="ph-assign" hidden>
          <strong>Aktuellen Anrufer zuordnen</strong>
          <p>Die Nummer wird dauerhaft in den Falldaten auf Google Drive gespeichert.</p>
          <input id="ph-assign-name" type="text" maxlength="160" placeholder="Name oder Ansprechpartner">
          <button id="ph-assign-save" type="button" class="ph-secondary">Rufnummer diesem Fall zuordnen</button>
          <small id="ph-assign-state"></small>
        </div>
      </section>

      <section class="ph-card ph-wide">
        <div class="ph-title"><div><span>3</span><h2>Telefonbuch und Fallsuche</h2></div><small>VN, Sanierer und weitere Ansprechpartner</small></div>
        <div class="ph-search"><input id="ph-search" type="search" placeholder="Name, Telefonnummer oder Schadennummer"><button id="ph-search-button" type="button" class="ph-secondary">Suchen</button></div>
        <details id="ph-phonebook-maintenance" class="ph-maintenance">
          <summary>Telefonbuch pflegen und Kontakte importieren</summary>
          <div class="ph-maintenance-grid">
            <form id="ph-contact-form" class="ph-contact-form">
              <input id="ph-contact-id" type="hidden">
              <label>Name oder Firma<input id="ph-contact-name" type="text" maxlength="150" required placeholder="z. B. Marc Handy"></label>
              <label>Telefonnummer<input id="ph-contact-phone" type="tel" maxlength="80" required placeholder="z. B. 0170 1234567"></label>
              <label>Notiz<input id="ph-contact-note" type="text" maxlength="255" placeholder="z. B. Funktion oder Firma"></label>
              <div class="ph-form-actions"><button type="submit" class="ph-answer">Kontakt speichern</button><button id="ph-contact-cancel" type="button" class="ph-secondary" hidden>Abbrechen</button></div>
            </form>
            <div class="ph-import">
              <strong>Kontaktliste importieren</strong>
              <p>CSV-Dateien (Name, Telefonnummer, Notiz) und VCF/vCard-Dateien aus Outlook oder Google werden unterstützt. Vorhandene identische Kontakte werden aktualisiert.</p>
              <label class="ph-import-button">CSV oder VCF auswählen<input id="ph-contact-import" type="file" accept=".csv,.vcf,text/csv,text/vcard,text/x-vcard" hidden></label>
            </div>
          </div>
          <p id="ph-contact-state" class="ph-note" aria-live="polite"></p>
        </details>
        <div id="ph-results" class="ph-results"><p class="ph-empty">Telefonbuch wird geladen …</p></div>
      </section>

      <details class="ph-card ph-wide ph-setup">
        <summary>Einmalige Windows-Einrichtung für Annehmen und Auflegen</summary>
        <p>Für „Wählen“, „Annehmen“ und „Auflegen“ muss auf dem jeweiligen Windows-PC die aktuelle lokale Portal-Verknüpfung installiert sein. Wurde die Datei vor dem 05.09.2026 installiert, bitte erneut herunterladen und ausführen.</p>
        <a href="/intern/downloads/Install-SVNetzwerk-Telefon.ps1" download>Windows-Verknüpfung herunterladen</a>
        <ol><li>Datei herunterladen.</li><li>Mit der rechten Maustaste „Mit PowerShell ausführen“ wählen.</li><li>xtelsio während der Einrichtung gestartet lassen.</li></ol>
      </details>
    </div>
  </main>
</InternalLayout>

<style is:global>
.ph-app{box-sizing:border-box;min-height:calc(100vh - 112px);padding:26px;color:#17324a}.ph-head{display:flex;align-items:flex-end;justify-content:space-between;gap:20px;margin-bottom:18px}.ph-kicker{margin:0;color:#f59a23;font-size:.8rem;font-weight:900;text-transform:uppercase;letter-spacing:.05em}.ph-head h1{margin:3px 0;font-size:2.1rem}.ph-head p{margin:0;color:#647789}.ph-status{padding:8px 11px;border-left:4px solid #2f8f67;background:#edf7f2;font-size:.78rem;font-weight:800}.ph-grid{display:grid;grid-template-columns:minmax(300px,.75fr) minmax(360px,1.25fr);gap:14px}.ph-card{padding:18px;border:1px solid #d5dde3;border-top:4px solid #f59a23;background:#fff;box-shadow:0 2px 8px rgba(7,26,46,.06)}.ph-wide{grid-column:1/-1}.ph-title{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-bottom:14px}.ph-title>div{display:flex;align-items:center;gap:9px}.ph-title span{display:grid;width:28px;height:28px;place-items:center;background:#17324a;color:#fff;font-weight:900}.ph-title h2{margin:0;font-size:1.08rem}.ph-title small{color:#6b7d8d}.ph-title a,.ph-incoming a,.ph-setup a{color:#17324a;font-weight:800}.ph-number-label,.ph-contact-form label{display:grid;gap:5px;color:#536a7d;font-size:.78rem;font-weight:800}.ph-number-label input,.ph-search input,.ph-assign input,.ph-contact-form input{box-sizing:border-box;width:100%;border:1px solid #b9c7d1;border-radius:3px;padding:12px;font:inherit;color:#17324a}.ph-number-label input{font-size:1.35rem;font-weight:800;letter-spacing:.03em}.ph-keypad{display:grid;grid-template-columns:repeat(3,1fr);gap:7px;margin:12px 0}.ph-keypad button{min-height:46px;border:1px solid #c9d4dc;background:#f5f7f8;color:#17324a;font:inherit;font-size:1.1rem;font-weight:900;cursor:pointer}.ph-call-actions,.ph-control-actions{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-top:8px}.ph-answer,.ph-drop,.ph-secondary,.ph-import-button{border:1px solid transparent;border-radius:3px;padding:11px 13px;font:inherit;font-weight:900;cursor:pointer}.ph-answer{background:#2f8f67;color:#fff}.ph-drop{background:#a33434;color:#fff}.ph-secondary,.ph-import-button{border-color:#17324a;background:#fff;color:#17324a}.ph-note{min-height:1.2em;margin:9px 0 0;color:#647789;font-size:.78rem}.ph-empty{padding:13px;background:#f3f6f8;color:#6b7d8d}.ph-case-summary{padding:13px;border-left:4px solid #2f8f67;background:#edf7f2}.ph-case-summary strong,.ph-case-summary span{display:block}.ph-case-summary span{margin-top:3px;color:#607486;font-size:.8rem}.ph-contact-list{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:7px;margin-top:10px}.ph-contact{display:flex;justify-content:space-between;align-items:center;gap:9px;padding:9px;border:1px solid #d9e1e7;background:#fafbfb}.ph-contact span{min-width:0}.ph-contact strong,.ph-contact small{display:block;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.ph-contact small{margin-top:2px;color:#647789}.ph-contact button{flex:0 0 auto;border:1px solid #17324a;background:#17324a;color:#fff;padding:7px 9px;font-weight:800;cursor:pointer}.ph-search{display:grid;grid-template-columns:1fr auto;gap:8px}.ph-results{display:grid;gap:7px;margin-top:10px}.ph-result{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:10px;border:1px solid #d9e1e7}.ph-result strong,.ph-result small{display:block}.ph-result small{margin-top:2px;color:#647789}.ph-result-actions{display:flex;flex-wrap:wrap;justify-content:flex-end;gap:6px}.ph-result-actions button{padding:8px 10px}.ph-result-actions .ph-delete{border-color:#a33434;color:#a33434}.ph-result-group{margin:10px 0 2px;padding-bottom:5px;border-bottom:2px solid #f59a23;font-size:.88rem}.ph-maintenance{margin-top:10px;border:1px solid #d9e1e7;background:#f7f9fa}.ph-maintenance summary{padding:12px;cursor:pointer;font-weight:900}.ph-maintenance[open] summary{border-bottom:1px solid #d9e1e7}.ph-maintenance-grid{display:grid;grid-template-columns:minmax(0,1.3fr) minmax(260px,.7fr);gap:16px;padding:14px}.ph-contact-form{display:grid;grid-template-columns:1.1fr .8fr 1fr;gap:9px}.ph-form-actions{display:flex;gap:8px;grid-column:1/-1}.ph-import{padding:12px;border-left:4px solid #f59a23;background:#fff8ed}.ph-import p{margin:5px 0 14px;color:#617587;font-size:.78rem}.ph-import-button{display:inline-block}.ph-maintenance>.ph-note{margin:0;padding:0 14px 12px}.ph-assign{margin-top:13px;padding:12px;border:1px solid #edc487;background:#fff8ed}.ph-assign p{margin:3px 0 9px;color:#6b7d8d;font-size:.78rem}.ph-assign button{width:100%;margin-top:7px}.ph-assign small{display:block;margin-top:6px;color:#5e7282}.ph-incoming{display:flex;align-items:center;justify-content:space-between;gap:18px;margin-bottom:14px;padding:16px;border:2px solid #f59a23;background:#fff8ed}.ph-incoming small,.ph-incoming strong,.ph-incoming span{display:block}.ph-incoming strong{margin:2px 0;font-size:1.2rem}.ph-incoming p{margin:5px 0 0;color:#647789}.ph-incoming-actions{display:flex;flex-wrap:wrap;gap:7px}.ph-incoming-actions a{align-self:center;padding:10px}.ph-setup summary{cursor:pointer;font-weight:900}.ph-setup p,.ph-setup li{color:#5e7282}.ph-setup a{display:inline-block;padding:10px 12px;border:1px solid #17324a;text-decoration:none}@media(max-width:900px){.ph-grid{grid-template-columns:1fr}.ph-wide{grid-column:auto}.ph-maintenance-grid,.ph-contact-form{grid-template-columns:1fr}}@media(max-width:620px){.ph-app{padding:14px}.ph-head,.ph-incoming,.ph-result{align-items:flex-start;flex-direction:column}.ph-contact-list{grid-template-columns:1fr}.ph-search{grid-template-columns:1fr}.ph-control-actions{grid-template-columns:1fr}.ph-result-actions{justify-content:flex-start}}
</style>

<script is:inline src="/intern/phonebook-import.js?v=20260905-1"></script>
<script is:inline>
(() => {
  const $=id=>document.getElementById(id),API='/intern/api/google-drive-sync.php',PHONEBOOK_API='/intern/api/phonebook.php',SPEED_DIAL_KEY='svnet-phone-speed-dials-v1';
  const request=async(url,options={})=>{const response=await fetch(url,{credentials:'same-origin',cache:'no-store',...options}),data=await response.json().catch(()=>({}));if(!response.ok||data.ok===false)throw Error(data.error||`HTTP ${response.status}`);return data};
  const activeCase=()=>{for(const store of[sessionStorage,localStorage])try{const value=JSON.parse(store.getItem('svnet-case')||'null');if(value?.folder_id)return value}catch{}return null};
  const keep=value=>{sessionStorage.setItem('svnet-case',JSON.stringify(value));localStorage.setItem('svnet-case',JSON.stringify(value));renderActive()};
  const mobile=()=>navigator.userAgentData?.mobile??/Android|iPhone|iPad|iPod/i.test(navigator.userAgent);
  const dial=number=>{const clean=String(number||'').trim().replace(/[^\d+*#]/g,'');if(!clean){$('ph-dial-state').textContent='Bitte eine Telefonnummer eingeben.';return}$('ph-dial-state').textContent=`${clean} wird an ${mobile()?'die Telefon-App':'xtelsio'} übergeben …`;location.href=mobile()?`tel:${clean}`:`svnet-xtelsio://dial?number=${encodeURIComponent(clean)}`};
  const contactRows=meta=>[
    ['VN Telefon',meta.telefon],['VN Mobil',meta.mobil],['Sanierer Telefon',meta.sanierer_telefon],['Sanierer Mobil',meta.sanierer_mobil],
    ...(Array.isArray(meta.telefonkontakte)?meta.telefonkontakte.map(row=>[row.name||'Ansprechpartner',row.nummer]):[])
  ].filter(([,number])=>String(number||'').trim());
  function renderActive(){const active=activeCase(),box=$('ph-active-case'),contacts=$('ph-case-contacts');contacts.innerHTML='';if(!active){box.className='ph-empty';box.textContent='Noch kein Schadenfall geöffnet.';return}const meta=active.meta||{};box.className='ph-case-summary';box.innerHTML='';const title=document.createElement('strong');title.textContent=meta.schaden_nr||'Fall ohne Schaden-Nr.';const detail=document.createElement('span');detail.textContent=[meta.vn_objekt,meta.schaden_ort||meta.ort].filter(Boolean).join(' · ');box.append(title,detail);contactRows(meta).forEach(([label,number])=>{const row=document.createElement('div');row.className='ph-contact';const text=document.createElement('span');const strong=document.createElement('strong');strong.textContent=label;const small=document.createElement('small');small.textContent=number;text.append(strong,small);const button=document.createElement('button');button.type='button';button.textContent='Anrufen';button.onclick=()=>dial(number);row.append(text,button);contacts.append(row)})}
  document.querySelectorAll('.ph-keypad button').forEach(button=>button.onclick=()=>{$('ph-number').value+=button.textContent});
  $('ph-clear').onclick=()=>{$('ph-number').value='';$('ph-number').focus()};$('ph-dial').onclick=()=>dial($('ph-number').value);$('ph-number').onkeydown=event=>{if(event.key==='Enter'){event.preventDefault();dial(event.currentTarget.value)}};
  document.querySelectorAll('[data-phone-action]').forEach(button=>button.onclick=()=>{const action=button.dataset.phoneAction;$('ph-status').textContent=action==='answer'?'Gespräch wird über xtelsio angenommen …':'Gespräch wird über xtelsio beendet …';location.href=`svnet-xtelsio://${action}`});
  async function openCase(row){const data=await request(`${API}?action=load_case&id=${encodeURIComponent(row.id)}`),selected={folder_id:data.case?.id||row.id,meta:{...(row.meta||{}),...(data.case?.meta||{})}};keep(selected);return selected}
  const groupTitle=text=>{const heading=document.createElement('h3');heading.className='ph-result-group';heading.textContent=text;return heading};
  const actionButton=(label,handler,className='ph-secondary')=>{const button=document.createElement('button');button.type='button';button.className=className;button.textContent=label;button.onclick=handler;return button};
  function addToSpeedDial(contact){let rows=[];try{const saved=JSON.parse(localStorage.getItem(SPEED_DIAL_KEY)||'[]');if(Array.isArray(saved))rows=saved}catch{}const phone=String(contact.phone||'').trim(),key=phone.replace(/\D/g,'');const index=rows.findIndex(row=>String(row?.number||'').replace(/\D/g,'')===key||String(row?.name||'').trim().toLocaleLowerCase('de-DE')===String(contact.name||'').trim().toLocaleLowerCase('de-DE'));const entry={name:String(contact.name||'').trim(),number:phone};if(index>=0)rows[index]=entry;else rows.push(entry);localStorage.setItem(SPEED_DIAL_KEY,JSON.stringify(rows.slice(0,30)));$('ph-contact-state').textContent=`${entry.name} wurde zur persönlichen Kurzwahl hinzugefügt.`}
  function editContact(contact){$('ph-contact-id').value=String(contact.id||'');$('ph-contact-name').value=contact.name||'';$('ph-contact-phone').value=contact.phone||'';$('ph-contact-note').value=contact.note||'';$('ph-contact-cancel').hidden=false;$('ph-phonebook-maintenance').open=true;$('ph-contact-name').focus();$('ph-contact-state').textContent=`Kontakt „${contact.name}“ wird bearbeitet.`}
  function resetContactForm(){ $('ph-contact-form').reset();$('ph-contact-id').value='';$('ph-contact-cancel').hidden=true }
  async function deleteContact(contact){if(!confirm(`Kontakt „${contact.name}“ wirklich aus dem gemeinsamen Telefonbuch löschen?`))return;try{await request(`${PHONEBOOK_API}?action=delete`,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({id:contact.id})});$('ph-contact-state').textContent=`${contact.name} wurde gelöscht.`;await search()}catch(error){$('ph-contact-state').textContent=error.message}}
  function renderContact(contact,box){const card=document.createElement('div');card.className='ph-result';const text=document.createElement('div');const title=document.createElement('strong');title.textContent=contact.name||'Kontakt';const detail=document.createElement('small');detail.textContent=[contact.phone,contact.note].filter(Boolean).join(' · ');text.append(title,detail);const actions=document.createElement('div');actions.className='ph-result-actions';actions.append(actionButton('Anrufen',()=>dial(contact.phone),'ph-answer'),actionButton('Kurzwahl',()=>addToSpeedDial(contact)),actionButton('Ändern',()=>editContact(contact)),actionButton('Löschen',()=>deleteContact(contact),'ph-secondary ph-delete'));card.append(text,actions);box.append(card)}
  function renderCase(row,box){const card=document.createElement('div');card.className='ph-result';const text=document.createElement('div');const title=document.createElement('strong');title.textContent=row.meta?.schaden_nr||row.name||'Versicherungsfall';const detail=document.createElement('small');detail.textContent=[row.meta?.vn_objekt,row.meta?.ort].filter(Boolean).join(' · ');text.append(title,detail);const actions=document.createElement('div');actions.className='ph-result-actions';actions.append(actionButton('Öffnen',()=>openCase(row)));card.append(text,actions);box.append(card)}
  const renderResults=(contacts,cases,query)=>{const box=$('ph-results');box.innerHTML='';if(contacts.length){box.append(groupTitle(`Telefonbuch · ${contacts.length}`));contacts.forEach(row=>renderContact(row,box))}else{const empty=document.createElement('p');empty.className='ph-empty';empty.textContent=query?'Kein passender Telefonbuchkontakt gefunden.':'Das gemeinsame Telefonbuch ist noch leer.';box.append(empty)}if(query.length>=2){box.append(groupTitle(`Schadenfälle · ${cases.length}`));if(cases.length)cases.forEach(row=>renderCase(row,box));else{const empty=document.createElement('p');empty.className='ph-empty';empty.textContent='Kein passender Schadenfall gefunden.';box.append(empty)}}};
  async function search(){const query=$('ph-search').value.trim();$('ph-results').innerHTML='<p class="ph-empty">Suche läuft …</p>';const [phonebookResult,casesResult]=await Promise.allSettled([request(`${PHONEBOOK_API}?action=list&q=${encodeURIComponent(query)}`),query.length>=2?request(`${API}?action=search_cases&q=${encodeURIComponent(query)}`):Promise.resolve({results:[]})]);const contacts=phonebookResult.status==='fulfilled'?(phonebookResult.value.contacts||[]):[],cases=casesResult.status==='fulfilled'?(casesResult.value.results||[]):[];renderResults(contacts,cases,query);const errors=[phonebookResult,casesResult].filter(result=>result.status==='rejected').map(result=>result.reason?.message||'Suche fehlgeschlagen.');if(errors.length){const warning=document.createElement('p');warning.className='ph-empty';warning.textContent=`Hinweis: ${errors.join(' · ')}`;$('ph-results').append(warning)}}
  $('ph-search-button').onclick=search;$('ph-search').onkeydown=event=>{if(event.key==='Enter'){event.preventDefault();search()}};
  $('ph-contact-cancel').onclick=()=>{resetContactForm();$('ph-contact-state').textContent='Bearbeitung abgebrochen.'};
  $('ph-contact-form').onsubmit=async event=>{event.preventDefault();const state=$('ph-contact-state'),payload={id:Number($('ph-contact-id').value)||0,name:$('ph-contact-name').value.trim(),phone:$('ph-contact-phone').value.trim(),note:$('ph-contact-note').value.trim()};state.textContent='Kontakt wird gespeichert …';try{await request(`${PHONEBOOK_API}?action=save`,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(payload)});resetContactForm();state.textContent=`${payload.name} wurde im gemeinsamen Telefonbuch gespeichert.`;await search()}catch(error){state.textContent=error.message}};
  $('ph-contact-import').onchange=async event=>{const file=event.currentTarget.files?.[0],state=$('ph-contact-state');if(!file)return;state.textContent=`${file.name} wird eingelesen …`;try{const text=await file.text(),parser=window.SVNetPhonebookImport;if(!parser?.parse)throw Error('Kontaktimport konnte nicht geladen werden.');const contacts=parser.parse(text,file.name);if(!contacts.length)throw Error('Keine Kontakte mit Name und Telefonnummer gefunden.');const data=await request(`${PHONEBOOK_API}?action=import`,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({contacts})});state.textContent=`${data.imported} Kontakte wurden importiert${data.skipped?`, ${data.skipped} unvollständige oder doppelte Zeilen übersprungen`:''}.`;await search()}catch(error){state.textContent=error.message}finally{event.currentTarget.value=''}};
  async function incoming(){const params=new URLSearchParams(location.search),number=params.get('anrufer')?.trim(),name=params.get('anrufername')?.trim()||'';if(!number)return;$('ph-incoming').hidden=false;$('ph-incoming-number').textContent=number;$('ph-incoming-name').textContent=name||'Unbekannter Anrufer';$('ph-number').value=number;sessionStorage.setItem('svnet-incoming-phone',number);if(name)sessionStorage.setItem('svnet-incoming-name',name);try{const data=await request(`${API}?action=incoming_phone&number=${encodeURIComponent(number)}`),rows=data.results||[];if(rows.length===1){const selected=await openCase(rows[0]);$('ph-incoming-case').textContent=`Erkannt: ${selected.meta?.schaden_nr||'Schadenfall'} · ${selected.meta?.vn_objekt||''}`;$('ph-open-case').hidden=false}else if(rows.length>1){$('ph-incoming-case').textContent=`${rows.length} mögliche Schadenfälle gefunden. Bitte unten auswählen.`;renderResults([],rows,'Anrufer')}else{$('ph-incoming-case').textContent='Nummer noch keinem Fall zugeordnet. Fall über Schadennummer suchen und anschließend zuordnen.';$('ph-assign').hidden=!activeCase();$('ph-assign-name').value=name}}catch(error){$('ph-incoming-case').textContent=error.message}}
  $('ph-assign-save').onclick=async()=>{const active=activeCase(),number=new URLSearchParams(location.search).get('anrufer')||sessionStorage.getItem('svnet-incoming-phone')||'',name=$('ph-assign-name').value.trim(),state=$('ph-assign-state');if(!active){state.textContent='Bitte zuerst den richtigen Schadenfall öffnen.';return}if(!name){state.textContent='Bitte Namen oder Ansprechpartner eingeben.';return}try{const data=await request(`${API}?action=save_phone_contact`,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({folder_id:active.folder_id,number,name})});keep({...active,meta:data.meta});state.textContent=`${name} wurde gespeichert und wird beim nächsten Anruf automatisch erkannt.`;sessionStorage.removeItem('svnet-incoming-phone');sessionStorage.removeItem('svnet-incoming-name');$('ph-assign').hidden=true}catch(error){state.textContent=error.message}};
  new MutationObserver(()=>{$('ph-assign').hidden=!(activeCase()&&(new URLSearchParams(location.search).get('anrufer')||sessionStorage.getItem('svnet-incoming-phone')))}).observe($('ph-active-case'),{childList:true,subtree:true});
  renderActive();incoming();search();
})();
</script>
