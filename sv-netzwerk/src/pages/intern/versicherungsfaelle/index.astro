  async function saveDraft(){const current=activeCase(),content=result.value.trim(),task=document.getElementById('vf-instructions')?.value?.trim()||'';if(!current?.folder_id){message('Bitte zuerst einen Fall öffnen.',true);return null}if(!content){message('Bitte zuerst das Ergebnis aus ChatGPT Work einfügen.',true);return null}const title=`ChatGPT-Work-Entwurf · ${current.meta?.schaden_nr||'Fall'}`;const saved=await request(`${API}?action=save`,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({folder_id:current.folder_id,title,task,content})});message('Der Text wurde als ungeprüfter Entwurf im aktiven Fall gespeichert.');await loadDrafts();return saved}
  async function loadDrafts(){const current=activeCase();if(!current?.folder_id){drafts.innerHTML='';return}try{const data=await request(`${API}?action=list&folder_id=${encodeURIComponent(current.folder_id)}`);drafts.innerHTML=(data.items||[]).map(item=>`<div class="vf-chatgpt-draft"><strong>${esc(item.title)}</strong><div class="vf-meta">${esc(item.created_at)} · ${item.source==='chatgpt_work'?'direkt aus ChatGPT Work':'im Portal eingefügt'}</div><button class="vf-secondary" type="button" data-draft="${item.id}">Entwurf übernehmen</button><textarea hidden data-content="${item.id}">${esc(item.content)}</textarea></div>`).join('');drafts.querySelectorAll('[data-draft]').forEach(button=>button.addEventListener('click',()=>{const text=drafts.querySelector(`[data-content="${button.dataset.draft}"]`)?.value||'';result.value=text;message('Entwurf wurde in das Ergebnisfeld übernommen.')}))}catch(error){message(error.message,true)}}
  packageButton?.addEventListener('click',makePackage);copyButton?.addEventListener('click',copyPackage);saveButton?.addEventListener('click',()=>saveDraft().catch(error=>message(error.message,true)));
  transferButton?.addEventListener('click',async()=>{try{if(!result.value.trim()){message('Bitte zuerst das Ergebnis aus ChatGPT Work einfügen.',true);return}await saveDraft();const instructions=document.getElementById('vf-instructions');instructions.value=result.value.trim();instructions.dispatchEvent(new Event('input',{bubbles:true}));const processing=document.querySelector('.vf-processing');if(processing)processing.open=true;message('Der ChatGPT-Entwurf wurde gespeichert und in den Arbeitsauftrag der Portal-KI übernommen. Gewünschte Ausgabe auswählen und anschließend Arbeitsauftrag ausführen.');processing?.scrollIntoView({behavior:'smooth',block:'center'})}catch(error){message(error.message,true)}});
  new MutationObserver(()=>loadDrafts()).observe(document.getElementById('vf-active'),{attributes:true,attributeFilter:['class'],childList:true,subtree:true});window.addEventListener('focus',loadDrafts);loadDrafts();
})();
</script>
<script is:inline>
document.getElementById('vf-recent')?.addEventListener('click',async()=>{
  const box=document.getElementById('vf-results');
  const esc=s=>String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
  box.innerHTML='<p class="vf-meta">Letzte Fälle werden geladen …</p>';
  try{
    const response=await fetch('/intern/api/google-drive-sync.php?action=recent_cases',{credentials:'same-origin'});
    const data=await response.json();
    if(!response.ok)throw new Error(data.error||`HTTP ${response.status}`);
    const rows=data.results||[];
    box.innerHTML=rows.map((row,index)=>`<div class="vf-result"><strong>${esc(row.meta?.schaden_nr||row.name)}</strong><div class="vf-meta">${esc([row.meta?.vn_objekt,row.meta?.ort].filter(Boolean).join(' · '))}</div><button class="vf-secondary" data-recent="${index}">Öffnen</button></div>`).join('')||'<p class="vf-meta">Noch keine Fälle vorhanden.</p>';
    box.querySelectorAll('[data-recent]').forEach(button=>button.addEventListener('click',()=>{
      const row=rows[Number(button.dataset.recent)];
      const input=document.getElementById('vf-search-input');
      input.value=row.name;
      const observer=new MutationObserver(()=>{const open=box.querySelector('[data-index]');if(open){observer.disconnect();open.click();}});
      observer.observe(box,{childList:true,subtree:true});
      document.getElementById('vf-search-btn')?.click();
    }));
  }catch(error){box.innerHTML=`<p class="vf-meta">${esc(error.message)}</p>`;}
});
</script>
