(()=>{const button=document.getElementById('vf-claims-import'),settings=document.getElementById('vf-claims-settings'),state=document.getElementById('vf-claims-state'),progress=document.getElementById('vf-claims-progress'),target=document.getElementById('vf-claims-target');if(!button)return;let ready=false,running=false;const names={christian:'Christian Wächter',holger:'Holger Roth',marc:'Marc Schütt',jens:'Jens Maurer'},supported=Object.keys(names);Promise.resolve(window.svnetDriveStatus?window.svnetDriveStatus():fetch('/intern/api/google-drive-sync.php?action=status',{credentials:'same-origin'}).then(response=>response.json())).then(context=>{const raw=String(context.backoffice?(context.selected_expert||'christian'):context.claims_profile||'').trim().toLowerCase();if(!supported.includes(raw))throw Error('Kein gültiges Bearbeiterprofil ausgewählt.');button.dataset.claimsProfile=raw;const folder=String(context.folders?.cases?.name||'').trim();target.textContent=`Import für ${names[raw]}${folder?` · Ziel: ${folder}`:''}`}).catch(error=>{button.disabled=true;state.textContent=error.message;state.className='vf-meta vf-claims-bad'});const activeProfile=()=>{const profile=String(button.dataset.claimsProfile||'').trim().toLowerCase();if(!supported.includes(profile))throw Error('Kein gültiges Bearbeiterprofil ausgewählt.');return profile};const finish=(ok,text)=>{running=false;button.disabled=false;state.textContent=text;state.className='vf-meta '+(ok?'vf-claims-ok':'vf-claims-bad');if(ok){progress.classList.add('done');progress.querySelector('span').style.width='100%'}window.dispatchEvent(new CustomEvent('svnet:cases-changed'))};window.addEventListener('message',event=>{if(event.source!==window||event.origin!==location.origin)return;const data=event.data||{};if(data.type==='SVNET_CLAIMS_BRIDGE_READY'){ready=true;state.textContent='Browser-Brücke bereit. Gespeicherte Zugänge werden automatisch verwendet.'}if(data.type==='SVNET_CLAIMS_IMPORT_PROGRESS'){progress.hidden=false;progress.querySelector('p').textContent=data.text||'Import läuft …';if(data.total)progress.querySelector('span').style.width=Math.round((data.current||0)/data.total*100)+'%';state.textContent=data.text||'Import läuft …'}if(data.type==='SVNET_CLAIMS_IMPORT_DONE'){const result=data.result||{},updated=Number(result.updated||0),skipped=Number(result.skipped||0);finish(true,`${result.claims||0} Aufträge geprüft · ${updated} aktualisiert · ${skipped} unverändert übersprungen.`)}if(data.type==='SVNET_CLAIMS_IMPORT_ERROR')finish(false,data.error||'ClaimsForce-Import fehlgeschlagen.')});button.addEventListener('click',()=>{if(running)return;try{const profile=activeProfile();if(!ready){state.textContent='Browser-Brücke fehlt. Bitte herunterladen, entpacken und einmalig in Chrome installieren.';state.className='vf-meta vf-claims-bad';return}running=true;button.disabled=true;progress.hidden=false;progress.classList.remove('done');progress.querySelector('span').style.width='2%';progress.querySelector('p').textContent='Import wird gestartet …';window.postMessage({type:'SVNET_CLAIMS_IMPORT_START',profile},location.origin)}catch(error){state.textContent=error.message;state.className='vf-meta vf-claims-bad'}});settings.addEventListener('click',()=>{try{const profile=activeProfile();if(!ready){state.textContent='Bitte zuerst die Browser-Brücke installieren.';return}window.postMessage({type:'SVNET_CLAIMS_OPEN_OPTIONS',profile},location.origin)}catch(error){state.textContent=error.message;state.className='vf-meta vf-claims-bad'}});setTimeout(()=>{if(!ready&&!running)state.textContent='Browser-Brücke noch nicht installiert. Bitte herunterladen, entpacken und in Chrome laden.'},1400)})();
