e.now()>=nextDispatch){dispatch();nextDispatch=Date.now()+10000}status.innerHTML=`<strong>${esc(outputName[key]||key)}: ${esc(job.message||'Bearbeitung läuft …')}</strong>`}}
   async function runSelection(event){event.preventDefault();event.stopImmediatePropagation();const current=activeCase(),status=$('vf-job'),button=$('vf-start'),instructions=$('vf-instructions').value.trim();status.hidden=false;if(!current){status.className='vf-job bad';status.textContent='Bitte zuerst einen Fall öffnen.';return}if(!instructions){status.className='vf-job bad';status.textContent='Bitte zuerst die Notiz oder den Arbeitsauftrag eingeben.';return}const queue=selectedOutputs();if(!queue.length){status.className='vf-job bad';status.textContent='Bitte mindestens ein Dokument auswählen.';return}button.disabled=true;status.className='vf-job';const created=[];try{for(let index=0;index<queue.length;index++){status.innerHTML=`<strong>${index+1} von ${queue.length}: ${esc(outputName[queue[index]]||queue[index])}</strong><br><span class="vf-meta">Unterlagen werden ausgewertet; die Ausgabe wird im Portal geprüft und im aktiven Fall gespeichert.</span>`;created.push(...await runOne(current.folder_id,queue[index],instructions,status));await loadGenerated()}status.className='vf-job ok';status.innerHTML=`<strong>Alle ${queue.length} ausgewählten Ausgaben wurden erstellt und gespeichert.</strong>`+(created.length?'<ul>'+created.map(file=>{const name=esc(file.name||'Dokument'),link=String(file.webViewLink||'');return `<li>${link?`<a href="${esc(link)}" target="_blank" rel="noreferrer">${name}</a>`:name}</li>`}).join('')+'</ul>':'');}catch(error){status.className='vf-job bad';status.innerHTML=`<strong>Bearbeitung angehalten.</strong><br>${esc(error.message)}<br><span class="vf-meta">Bereits fertiggestellte Dokumente bleiben im Fall gespeichert.</span>`}finally{button.disabled=false;await loadGenerated()}}
  $('vf-start')?.addEventListener('click',runSelection,true);
