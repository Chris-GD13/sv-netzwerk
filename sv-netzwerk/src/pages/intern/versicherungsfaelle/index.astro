<script is:inline>
(() => {
  document.querySelectorAll('.vf-app section.vf-card:not(.vf-processing)').forEach((card,index)=>{
    const trigger=card.querySelector(':scope > .vf-step, :scope > .vf-title, :scope > .vf-plaud-head');
    if(!trigger)return;
    const initiallyExpanded=card.id==='vf-form';
    card.classList.add('vf-collapsible');
    if(!initiallyExpanded)card.classList.add('is-collapsed');
    trigger.classList.add('vf-collapse-trigger');
    trigger.tabIndex=0;
    trigger.setAttribute('role','button');
    trigger.setAttribute('aria-expanded',String(initiallyExpanded));
    if(!trigger.id)trigger.id=`vf-collapse-${index+1}`;
    const toggle=()=>{const collapsed=card.classList.toggle('is-collapsed');trigger.setAttribute('aria-expanded',String(!collapsed));};
    trigger.addEventListener('click',event=>{if(!event.target.closest('button,a,input,select,textarea'))toggle()});
    trigger.addEventListener('keydown',event=>{if(event.key==='Enter'||event.key===' '){event.preventDefault();toggle()}});
    if(initiallyExpanded)new MutationObserver(()=>{if(!card.hidden){card.classList.remove('is-collapsed');trigger.setAttribute('aria-expanded','true')}}).observe(card,{attributes:true,attributeFilter:['hidden']});
  });
})();
</script>
<script is:inline>
(() => {
  const input=document.getElementById('vf-search-input'),button=document.getElementById('vf-search-btn'),results=document.getElementById('vf-results');
  if(!input||!button||!results)return;
  let delay=0,lastQuery='';
  input.addEventListener('input',()=>{
    window.clearTimeout(delay);
    const query=input.value.trim();
    if(!query){lastQuery='';results.innerHTML='';return}
    if(query.length<3)return;
    delay=window.setTimeout(()=>{if(query!==lastQuery){lastQuery=query;button.click()}},350);
  });
  button.addEventListener('click',()=>{lastQuery=input.value.trim()});
})();
</script>
<script is:inline>
(() => {
  const AI='/intern/api/gf-ai-generate.php?legacy=1';
  const currentCase=()=>{for(const storage of[sessionStorage,localStorage])try{const value=JSON.parse(storage.getItem('svnet-case')||'null');if(value?.folder_id)return value}catch{}return null};
  const ensureStarted=async()=>{
    const current=currentCase();
    if(!current?.folder_id)return;
    for(let attempt=0;attempt<12;attempt++){
      await new Promise(resolve=>setTimeout(resolve,500));
      try{
        const latestResponse=await fetch(AI,{method:'POST',credentials:'same-origin',headers:{'Content-Type':'application/json'},body:JSON.stringify({action:'latest',folder_id:current.folder_id})});
        const latest=await latestResponse.json();
        const jobId=Number(latest.job_id||0);
        if(jobId<=0)continue;
        fetch(AI,{method:'POST',credentials:'same-origin',keepalive:true,headers:{'Content-Type':'application/json'},body:JSON.stringify({action:'run',job_id:jobId})}).catch(()=>{});
        return;
      }catch{}
    }
  };
  document.getElementById('vf-start')?.addEventListener('click',()=>ensureStarted());
  const job=document.getElementById('vf-job');
  if(job)new MutationObserver(()=>{const strong=job.querySelector('strong');if(strong){const cleaned=strong.textContent.replace(/^\s*\d+%\s*[·-]\s*/,'');if(cleaned!==strong.textContent)strong.textContent=cleaned}}).observe(job,{childList:true,subtree:true,characterData:true});
})();
</script>
