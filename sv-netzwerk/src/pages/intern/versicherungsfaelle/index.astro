<script is:inline>
(() => {
  document.querySelectorAll('.vf-app section.vf-card:not(.vf-processing)').forEach((card,index)=>{
    const trigger=card.querySelector(':scope > .vf-step, :scope > .vf-title, :scope > .vf-plaud-head');
    if(!trigger)return;
    const initiallyExpanded=card.id==='vf-form';
    card.classList.add('vf-collapsible');
    if(!initiallyExpanded)card.classList.add('is-collapsed');
    trigger.classList.add('vf-collapse-trigger');
    trigger.tabIndex=0;
    trigger.setAttribute('role','button');
    trigger.setAttribute('aria-expanded',String(initiallyExpanded));
    if(!trigger.id)trigger.id=`vf-collapse-${index+1}`;
    const toggle=()=>{const collapsed=card.classList.toggle('is-collapsed');trigger.setAttribute('aria-expanded',String(!collapsed));};
    trigger.addEventListener('click',event=>{if(!event.target.closest('button,a,input,select,textarea'))toggle()});
    trigger.addEventListener('keydown',event=>{if(event.key==='Enter'||event.key===' '){event.preventDefault();toggle()}});
    if(initiallyExpanded)new MutationObserver(()=>{if(!card.hidden){card.classList.remove('is-collapsed');trigger.setAttribute('aria-expanded','true')}}).observe(card,{attributes:true,attributeFilter:['hidden']});
  });
})();
</script>
