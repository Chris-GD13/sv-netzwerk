---
import InternalLayout from '../../../layouts/InternalLayout.astro';
---
<InternalLayout title="Versicherungsfälle" description="Automatische, fallzentrierte Schadenbearbeitung.">
<section slot="sidebar-extra" id="vf-expert-panel" class="intern-sidebar__expert" hidden><label class="vf-order-label" for="vf-expert-select"><strong>Bearbeitung für</strong><small>Fallordner und ClaimsForce-Anmeldung des ausgewählten Profils</small></label><select id="vf-expert-select"><option value="christian">Christian Wächter</option><option value="holger">Holger Roth</option><option value="marc">Marc Schütt</option><option value="jens">Jens Maurer</option></select></section>
<main class="vf-app">
  <section id="vf-active" class="vf-active"><div><i></i><strong>Noch kein Fall geöffnet</strong><small>Fall suchen, neu anlegen oder Unterlagen zur automatischen Anlage hochladen.</small></div></section>
  <div class="vf-grid">
    <aside>
                  <section class="vf-card vf-claims-import"><header class="vf-step"><b>↻</b><div><strong>ClaimsForce-Aufträge</strong><small id="vf-claims-target">Import in den eigenen Fallordner</small></div></header><button type="button" id="vf-claims-import" class="vf-primary vf-full">Aufträge aus Claims einlesen</button><button type="button" id="vf-claims-settings" class="vf-secondary vf-full">Claims-Zugangsdaten verwalten</button><a id="vf-claims-download" class="vf-secondary vf-full" href="/intern/downloads/svnet-claimsforce-bridge.zip" download>Browser-Brücke herunterladen</a><p id="vf-claims-state" class="vf-meta" aria-live="polite">Die Browser-Brücke und ClaimsForce-Anmeldung werden geprüft.</p><div id="vf-claims-progress" class="vf-progress" hidden><div><span></span></div><p></p></div></section>
      <section class="vf-card"><header class="vf-step"><b>1</b><div><strong>Fall auswählen</strong><small>Öffnen oder neu beginnen</small></div></header><div class="vf-search"><input id="vf-search-input" placeholder="Schaden-Nr., Name, Straße oder Ort" autocomplete="off" aria-label="Versicherungsfall suchen"><button id="vf-search-btn">Suchen</button></div><p class="vf-search-hint">Ab 3 Zeichen erscheinen passende Fälle automatisch.</p><button id="vf-recent" class="vf-secondary vf-full">Letzte 10 Fälle</button><div id="vf-results" aria-live="polite"></div><button id="vf-new" class="vf-secondary vf-full">Neuen Fall anlegen</button></section>
      <section id="vf-form" class="vf-card" hidden><div class="vf-title"><div><strong>Falldaten</strong><small>Werden aus Unterlagen ergänzt</small></div><span>automatisch</span></div><div class="vf-fields"><label>Schaden-Nr.<input id="vf-schaden"></label><label>Versicherungsschein-Nr.<input id="vf-vsnr"></label><label class="wide">VN / Objekt<input id="vf-object"></label><label class="wide">VN-Straße<input id="vf-strasse"></label><label>VN-PLZ<input id="vf-plz"></label><label>VN-Ort<input id="vf-ort"></label><label class="wide">Schadenort – Straße<input id="vf-schaden-strasse"></label><label>Schadenort – PLZ<input id="vf-schaden-plz"></label><label>Schadenort – Ort<input id="vf-schaden-ort"></label><label>Schadenart<input id="vf-art"></label><label>Reserve EUR<input id="vf-reserve"></label><label>VN-Telefon<input id="vf-telefon" type="tel"></label><label>VN-Mobil<input id="vf-mobil" type="tel"></label><label class="wide">VN-E-Mail<input id="vf-email" type="email"></label><div class="vf-field-group wide"><strong>Kontaktdaten des Sanierers</strong><small>Firma und verantwortliche Kontaktperson, z. B. Objekt- oder Bauleitung</small></div><button type="button" id="vf-sanierer-refresh" class="vf-secondary vf-full wide">Saniererdaten aus KVA neu einlesen</button><p id="vf-sanierer-refresh-state" class="vf-meta wide" aria-live="polite"></p><label class="wide">Sanierer / Firma<input id="vf-sanierer-firma"></label><label class="wide">Ansprechpartner<input id="vf-sanierer-ansprechpartner"></label><label class="wide">Funktion / Rolle<input id="vf-sanierer-funktion" placeholder="z. B. Objektleiter oder Bauleiter"></label><label>Sanierer-Telefon<input id="vf-sanierer-telefon" type="tel"></label><label>Sanierer-Mobil<input id="vf-sanierer-mobil" type="tel"></label><label class="wide">Sanierer-E-Mail<input id="vf-sanierer-email" type="email"></label><label class="wide">Sanierer-Straße<input id="vf-sanierer-strasse"></label><label>Sanierer-PLZ<input id="vf-sanierer-plz"></label><label>Sanierer-Ort<input id="vf-sanierer-ort"></label><label>Sanierer-Fax<input id="vf-sanierer-fax" type="tel"></label><label>Sanierer-Website<input id="vf-sanierer-website" type="url"></label></div><button id="vf-save" class="vf-primary vf-full">Fall speichern</button><p id="vf-save-state" class="vf-meta"></p></section>

    </aside>
    <section class="vf-work">
      <div class="vf-command-grid">
        <div class="vf-command-main">
          <section class="vf-card vf-upload-card"><header class="vf-step"><b>2</b><div><strong>Unterlagen hochladen</strong><small>PDF, Word, Excel, E-Mail, Bilder oder komplette Fallakte</small></div></header><input id="vf-files" type="file" multiple hidden accept=".pdf,.doc,.docx,.xls,.xlsx,.xlsm,.csv,.txt,.md,.rtf,.msg,.eml,.jpg,.jpeg,.png,.webp,.tif,.tiff,.zip"><div id="vf-drop" class="vf-drop" tabindex="0"><span>⇧</span><strong>Unterlagen hier hineinziehen</strong><small>oder zum Auswählen klicken</small><em>Die Bearbeitung startet nach dem Upload automatisch.</em></div><div id="vf-file-list"></div><div id="vf-progress" class="vf-progress" hidden><div><span></span></div><p>Unterlagen werden vorbereitet.</p></div></section>
        </div>
        <section class="vf-card vf-plaud">
          <header class="vf-plaud-head"><span>PLAUD</span><div><strong>Ortstermin einlesen</strong><small>Zusammenfassung dem aktiven Fall zuordnen</small></div></header>
          <div class="vf-source-actions"><label class="vf-plaud-file" for="vf-plaud-file"><b>PLAUD-Datei hochladen</b><small id="vf-plaud-name">PDF, Word oder TXT</small></label><a class="vf-secondary" href="https://web.plaud.ai/file-list?categoryId=allFiles" target="_blank" rel="noopener noreferrer">Aus PLAUD laden</a></div>
          <input id="vf-plaud-file" type="file" hidden accept=".pdf,.doc,.docx,.txt,.md,.rtf">
          <label class="vf-plaud-label">Gewünschtes Ergebnis<select id="vf-plaud-target"><option value="auto">Automatisch erkennen</option><option value="erstbericht">Erstbericht</option><option value="erstbericht_sv_gf">TF-/GF-Schadenbericht</option><option value="rekon_schaden">Rekon-Schaden</option><option value="zwischenbericht">Zwischenbericht</option><option value="nachtrag_stellungnahme">Nachtrag / Stellungnahme</option><option value="schlusserklaerung">Schlusserklärung</option><option value="schlussbericht">Schlussbericht</option></select></label>
          <button id="vf-plaud-check" class="vf-primary vf-full" disabled>Einlesen und prüfen</button>
          <div id="vf-plaud-preview" class="vf-plaud-preview" hidden></div>
          <button id="vf-plaud-accept" class="vf-secondary vf-full" hidden>Übernehmen und Dokument erstellen</button>
          <p class="vf-meta">Das Original bleibt im Fall. Vor der Dokumenterstellung werden Ziel, erkannte Falldaten und Arbeitsauftrag angezeigt.</p>
        </section>
        <section class="vf-card vf-polycam">
          <header class="vf-plaud-head"><span>3D</span><div><strong>Polycam-Aufmaß auswerten</strong><small>PDF, Bild oder ZIP prüfen und dem aktiven Fall zuordnen</small></div></header>
          <div class="vf-source-actions"><label class="vf-plaud-file" for="vf-polycam-file"><b>Polycam-Datei hochladen</b><small id="vf-polycam-name">PDF, JPEG, PNG, WEBP oder ZIP · max. 25 MB</small></label><a class="vf-secondary" href="https://poly.cam/library?feed=captures&amp;layout=grid&amp;tags=all&amp;sort=created" target="_blank" rel="noopener noreferrer">Aus Polycam laden</a></div>
          <input id="vf-polycam-file" type="file" hidden accept=".pdf,.jpg,.jpeg,.png,.webp,.zip,application/pdf,image/jpeg,image/png,image/webp,application/zip">
          <button id="vf-polycam-read" class="vf-primary vf-full" disabled>Aufmaß auslesen</button>
          <div id="vf-polycam-state" class="vf-plaud-preview" hidden></div>
          <div id="vf-polycam-review" hidden><p class="vf-meta"><strong>Prüfung erforderlich:</strong> Erkannte Werte kontrollieren und bei Bedarf berichtigen.</p><div class="vf-measure-table"><table><thead><tr><th>Raum</th><th>Bauteil / Maß</th><th>Wert</th><th>Einheit</th><th>Status</th><th></th></tr></thead><tbody id="vf-polycam-rows"></tbody></table></div><button id="vf-polycam-add" class="vf-secondary vf-full">Messwert ergänzen</button><button id="vf-polycam-accept" class="vf-primary vf-full">Geprüft übernehmen</button></div>
          <p class="vf-meta">Das Original bleibt in der Fallakte. Nur der ausdrücklich geprüfte Datensatz wird für Berichte verwendet.</p>
        </section>
      </div>
            <section class="vf-card vf-calendar"><header class="vf-step"><b>3</b><div><strong>Ortstermin planen</strong><small id="vf-cal-target">Kalender wird anhand der Anmeldung gewählt</small></div></header><div class="vf-calendar-grid"><label>Datum<input id="vf-cal-date" type="date"></label><label>Uhrzeit<input id="vf-cal-time" type="time" step="900"></label><label>Dauer<select id="vf-cal-duration"><option value="30" selected>30 Minuten</option><option value="60">60 Minuten</option><option value="90">90 Minuten</option><option value="120">120 Minuten</option><option value="180">180 Minuten</option></select></label><label class="wide">Besichtigungsadresse<input id="vf-cal-address" readonly></label><label class="wide">Bemerkungen / Notizen<textarea id="vf-cal-notes" rows="2" placeholder="Hinweise zur Anfahrt, Ansprechpartner, Rückruf oder Besonderheiten"></textarea></label><label class="wide vf-check"><input id="vf-cal-invite" type="checkbox"> VN per E-Mail zum Termin einladen</label><label class="wide">Weitere Anhänge<input id="vf-cal-files" type="file" multiple></label></div><p class="vf-meta">Beauftragung und vorhandene KVA werden automatisch aus dem Fallordner angehängt. Manuelle Anhänge sind bis 3 MB je Datei möglich. Einladungen werden von ws@sv-schuett.eu versendet.</p><div class="vf-calendar-actions"><button id="vf-cal-check" class="vf-secondary" disabled>Verfügbarkeit prüfen</button><button id="vf-cal-create" class="vf-primary" disabled>Termin in Outlook anlegen</button></div><div id="vf-cal-state" class="vf-job" hidden></div></section>
            <section class="vf-card vf-mail"><header class="vf-step"><b>4</b><div><strong>E-Mail schreiben</strong><small>Direkt aus dem aktiven Schadenfall senden</small></div></header><div class="vf-mail-grid"><label>An<div class="vf-mail-recipient-row"><input id="vf-mail-to" type="email" placeholder="Empfänger"><div id="vf-mail-presets" class="vf-mail-presets" aria-label="Standardempfänger auswählen">
<label><input type="checkbox" value="service.schaden@sparkassenversicherung.de"> Schadenservice</label>
<label><input type="checkbox" value="archiv@sparkassenversicherung.de"> Archiv</label>
<label><input type="checkbox" value="backoffice@meygeneralbau.de"> Mey Generalbau</label>
<label><input type="checkbox" value="info@rainbow-sanierungen.de"> Rainbow</label>
<label><input type="checkbox" value="service@polygon-deutschland.de"> POLYGON</label>
</div></div></label><label>CC<input id="vf-mail-cc" type="text" placeholder="optional, mehrere mit ; trennen"></label><label class="wide">Betreff<input id="vf-mail-subject" type="text" readonly></label><label class="wide">Nachricht<textarea id="vf-mail-body" rows="5" placeholder="E-Mail-Text eingeben"></textarea></label><label class="wide">Anhänge<input id="vf-mail-files" type="file" multiple></label></div><div class="vf-mail-actions"><button id="vf-mail-send" class="vf-primary" disabled>E-Mail senden</button><span id="vf-mail-sender" class="vf-meta"></span></div><div id="vf-mail-state" class="vf-job" hidden></div></section>
            <section class="vf-card vf-kva"><header class="vf-step"><b>5</b><div><strong>KVA-Freigabe</strong><small>Kostenvoranschlag prüfen und Freigabe-E-Mail vorbereiten</small></div></header><div class="vf-kva-source"><label>Aus dem aktiven Fall<select id="vf-kva-select" disabled><option value="">Bitte zuerst einen Fall öffnen</option></select></label><span>oder</span><label id="vf-kva-drop" class="vf-drop" tabindex="0">KVA hier hineinziehen oder auswählen<input id="vf-kva-file" type="file" hidden accept=".pdf,.doc,.docx,.jpg,.jpeg,.png,.webp"></label></div><button id="vf-kva-read" class="vf-secondary vf-full" disabled>KVA auslesen und Freigabe vorbereiten</button><div id="vf-kva-state" class="vf-job" hidden></div><div id="vf-kva-review" hidden><div class="vf-kva-grid"><label>Firma<input id="vf-kva-company"></label><label>E-Mail-Adresse<input id="vf-kva-email" type="email"></label><label>KVA-Nummer<input id="vf-kva-number"></label><label>Versicherer<input id="vf-kva-insurer"></label><label>Gesamt netto<input id="vf-kva-net" inputmode="decimal"></label><label>Gesamt brutto<input id="vf-kva-gross" inputmode="decimal"></label><label>Absender<input value="cw@sv-netzwerk.eu" readonly></label><label>CC<input id="vf-kva-cc" type="text" value="ws@sv-schuett.eu" placeholder="Mehrere Adressen mit Komma trennen"></label><label>Blindkopie<input id="vf-kva-bcc" readonly></label><label class="wide">Betreff<input id="vf-kva-subject"></label><label class="wide">Freigabetext<textarea id="vf-kva-body" rows="7"></textarea></label></div><p id="vf-kva-contacts" class="vf-meta"></p><p class="vf-meta">Die ausgelesenen Angaben können korrigiert werden. Änderungen an KVA-Nummer und Beträgen werden in den Freigabetext übernommen. Die E-Mail wird erst mit dem folgenden ausdrücklichen Klick versendet.</p><button id="vf-kva-send" class="vf-primary vf-full" disabled>Geprüfte Freigabe-E-Mail senden</button><button id="vf-kva-check-sent" class="vf-secondary vf-full" type="button">Letzten Versand zu diesem Fall prüfen</button><div id="vf-kva-send-state" class="vf-job" role="status" aria-live="polite" hidden></div></div></section>
      <details class="vf-card vf-processing"><summary>Berichte und Dokumente erstellen</summary>
        <label class="vf-order-label" for="vf-instructions"><strong>Meine Notiz / Arbeitsauftrag</strong><small>Schreiben Sie frei, was festgestellt wurde und welches Dokument entstehen soll. Enter erzeugt einen Zeilenumbruch.</small></label>
        <textarea id="vf-instructions" rows="7" placeholder="Hier Arbeitsauftrag, Feststellungen oder Diktat eingeben …"></textarea>
        <small id="vf-instruction-state" class="vf-meta" aria-live="polite"></small>
        <fieldset class="vf-output-group"><legend>Bericht auswählen – genau einer</legend><div id="vf-primary-outputs"><label><input type="radio" name="vf-primary-output" value="erstbericht"> Schadenbericht</label><label><input type="radio" name="vf-primary-output" value="erstbericht_sv_gf"> TF-/GF-Schadenbericht</label><label><input type="radio" name="vf-primary-output" value="rekon_schaden"> Rekon-Schaden <small>(ohne Bilder)</small></label></div></fieldset>
        <fieldset class="vf-output-group"><legend>Weitere Dokumente – werden danach einzeln erstellt</legend><div id="vf-outputs"><label><input type="checkbox" value="dokumentenindex"> Dokumentenindex</label><label><input type="checkbox" value="rechnungsregister"> Rechnungsregister</label><label title="KI-Erstentwurf auf der editierbaren Kalkulationsseite"><input type="checkbox" value="kalkulation"> Kalkulation</label><label><input type="checkbox" value="zwischenbericht"> Zwischenbericht</label><label><input type="checkbox" value="schlusserklaerung"> Schlusserklärung</label><label><input type="checkbox" value="schlussbericht"> Schlussbericht</label><label><input type="checkbox" value="nachtrag_stellungnahme"> Nachtrag / Stellungnahme</label><label><input type="checkbox" value="zahlungsbefuerwortung"> Zahlungsbefürwortung</label><label><input type="checkbox" value="query_form"> Rückfrageformular</label></div></fieldset>
        <fieldset class="vf-output-group"><legend>Schadenprotokoll – höchstens eines</legend><div id="vf-protocol-outputs"><label><input type="radio" name="vf-protocol-output" value=""> Kein Schadenprotokoll</label><label><input type="radio" name="vf-protocol-output" value="schadenprotokoll_privat"> Schadenprotokoll Privat</label><label><input type="radio" name="vf-protocol-output" value="schadenprotokoll_gewerbe"> Schadenprotokoll Gewerbe</label></div></fieldset>
        <section class="vf-work-handoff" aria-labelledby="vf-work-title">
          <label class="vf-work-choice"><input id="vf-work-enabled" type="checkbox"> <strong id="vf-work-title">Jetzt in Work bearbeiten</strong></label>
          <div id="vf-work-content" hidden>
            <p class="vf-meta">Der Auftrag wird aus dem geöffneten Fall, Ihrer Notiz und den angehakten Dokumenten gebildet. In das Textfeld oder auf den Button klicken, danach in Work einfügen.</p>
            <textarea id="vf-work-prompt" rows="12" readonly aria-label="Fertiger Auftrag für Work"></textarea>
            <div class="vf-work-actions"><button id="vf-work-copy" class="vf-secondary" type="button">Work-Auftrag kopieren</button><a id="vf-work-open" class="vf-primary" href="https://chatgpt.com/" target="_blank" rel="noreferrer">Work öffnen</a></div>
            <p id="vf-work-copy-state" class="vf-meta" role="status" aria-live="polite"></p>
          </div>
        </section>
        <p class="vf-meta">Berichte, Formulare und Kalkulationen werden nacheinander im Portal erstellt, geprüft und im aktiven Fall gespeichert. Originalvorlagen bleiben unverändert.</p>
        <button id="vf-excel-originals" class="vf-secondary vf-start" disabled>Excel-Originale im Fall öffnen</button><div id="vf-excel-links" class="vf-meta"></div><button id="vf-start" class="vf-primary vf-start" disabled>Auswahl bearbeiten</button><div id="vf-job" class="vf-job" hidden></div>
        <section id="vf-generated" class="vf-generated"><h3>Erstellte Dokumente</h3><div id="vf-generated-list"><p class="vf-meta">Nach dem Öffnen eines Falls werden vorhandene Ausgaben hier angezeigt.</p></div></section>
      </details>
    </section>
  </div><span id="vf-system-home" hidden></span><details id="vf-system-panel" class="vf-card vf-system vf-system-bottom"><summary>Verbindung und Vorlagen</summary><p id="vf-system-state" class="vf-meta">Google Drive sowie Word- und Excel-Originale werden geprüft.</p><button id="vf-sync" class="vf-secondary vf-full">Jetzt prüfen</button><button id="vf-organize-all" class="vf-secondary vf-full">Bestehende Fallakten einsortieren</button><p id="vf-organize-state" class="vf-meta"></p></details><input id="vf-folder" type="hidden">
</main>
<style is:global>
.vf-field-group{display:grid;gap:2px;margin-top:8px;padding-top:12px;border-top:1px solid var(--vfl);color:var(--vfi)}
.vf-field-group strong{font-size:.82rem}
.vf-field-group small{color:var(--vfm);font-size:.74rem;font-weight:500}
:root{--vfi:#17324a;--vfm:#697d8e;--vfl:#dce5ec;--vfo:#f59a23;--vfg:#2f8f67}.vf-app{max-width:1440px;margin:auto;padding:12px 24px 56px;color:var(--vfi)}.vf-head{display:flex;justify-content:space-between;gap:28px;align-items:flex-start;margin-bottom:18px}.vf-kicker{margin:0 0 5px;color:var(--vfo);font-size:.78rem;font-weight:800;letter-spacing:.1em;text-transform:uppercase}.vf-head h1{font-size:clamp(1.8rem,3vw,2.8rem);margin:0 0 7px}.vf-head p{margin:0;color:var(--vfm)}.vf-types{display:flex;background:#eef3f6;padding:4px;border-radius:12px;gap:3px}.vf-types button{border:0;background:transparent;padding:10px 13px;border-radius:9px;color:#526779;font-weight:700;white-space:nowrap}.vf-types button.on{background:#fff;color:var(--vfi);box-shadow:0 1px 6px #17324a22}.vf-active{display:flex;justify-content:space-between;border:1px solid var(--vfl);border-left:4px solid #acbac6;border-radius:12px;padding:12px 16px;margin-bottom:18px;background:#fff}.vf-active>div{display:grid;grid-template-columns:auto 1fr;column-gap:10px}.vf-active i{width:9px;height:9px;border-radius:50%;background:#acbac6;margin-top:6px}.vf-active small{grid-column:2;color:var(--vfm)}.vf-active.on{border-left-color:var(--vfg)}.vf-active.on i{background:var(--vfg)}.vf-active-actions{display:flex;align-items:center;gap:8px}.vf-active-actions a,.vf-active-actions button{display:inline-flex;align-items:center;justify-content:center;box-sizing:border-box;border:1px solid #aeb8c0;background:#f1f3f5;border-radius:3px;padding:7px 10px;text-decoration:none;color:var(--vfi);font:inherit;line-height:1.2;cursor:pointer}.vf-active-actions a:hover,.vf-active-actions button:hover{background:#e3e7ea;border-color:#8e9aa4}.vf-grid{display:grid;grid-template-columns:340px minmax(0,1fr);gap:18px;align-items:start}.vf-grid aside,.vf-work{display:grid;gap:16px}.vf-card{background:#fff;border:1px solid var(--vfl);border-radius:15px;padding:20px;box-shadow:0 5px 18px #17324a0b}.vf-step{display:flex;gap:12px;margin-bottom:16px}.vf-step>b{display:grid;place-items:center;width:30px;height:30px;border-radius:9px;background:var(--vfi);color:#fff;font-size:.82rem}.vf-step strong,.vf-title strong{display:block}.vf-step small,.vf-title small{display:block;color:var(--vfm);margin-top:2px}.vf-search{display:grid;grid-template-columns:1fr auto;gap:7px}.vf-search input,.vf-fields input,textarea{width:100%;box-sizing:border-box;border:1px solid #bdcbd6;border-radius:9px;padding:10px 11px;font:inherit;outline:none}.vf-search input:focus,.vf-fields input:focus,textarea:focus{border-color:var(--vfo);box-shadow:0 0 0 3px #f59a2322}.vf-search button,.vf-primary{border:1px solid var(--vfi);background:var(--vfi);color:#fff;border-radius:9px;padding:10px 13px;font-weight:750}.vf-primary:disabled{opacity:.4}.vf-secondary{border:1px solid #bac8d3;background:#fff;color:var(--vfi);border-radius:9px;padding:10px 13px;font-weight:750}.vf-full{width:100%;margin-top:10px}.vf-result{border:1px solid var(--vfl);border-radius:9px;padding:10px;margin-top:7px}.vf-result button{margin-top:7px}.vf-draft-actions{display:flex;flex-wrap:wrap;gap:8px;align-items:center;margin-top:7px}.vf-draft-actions button{margin-top:0}.vf-danger{border:1px solid #b42318;background:#fff;color:#b42318;border-radius:9px;padding:10px 13px;font-weight:800;cursor:pointer}.vf-danger:hover{background:#b42318;color:#fff}.vf-title{display:flex;justify-content:space-between;margin-bottom:12px}.vf-title>span{font-size:.72rem;font-weight:800;color:var(--vfg);background:#eaf6f0;padding:4px 7px;border-radius:20px;height:max-content}.vf-fields{display:grid;grid-template-columns:1fr 1fr;gap:9px}.vf-fields label{font-size:.78rem;font-weight:750;color:#536a7d}.vf-fields input{margin-top:4px}.vf-fields .wide{grid-column:1/-1}.vf-meta{font-size:.8rem;color:var(--vfm)}.vf-system summary,.vf-options summary{cursor:pointer;font-weight:750}.vf-system-bottom{width:min(100%,640px);margin:16px auto 0;box-sizing:border-box}.vf-drop{border:2px dashed #b9c9d5;border-r