---
import InternalLayout from '../../../layouts/InternalLayout.astro';
---
<InternalLayout title="Versicherungsfälle" description="Automatische, fallzentrierte Schadenbearbeitung.">
<main class="vf-app">
  <section id="vf-active" class="vf-active"><div><i></i><strong>Noch kein Fall geöffnet</strong><small>Fall suchen, neu anlegen oder Unterlagen zur automatischen Anlage hochladen.</small></div></section>
  <div class="vf-grid">
    <aside>
      <section class="vf-card"><header class="vf-step"><b>1</b><div><strong>Fall auswählen</strong><small>Öffnen oder neu beginnen</small></div></header><div class="vf-search"><input id="vf-search-input" placeholder="Schaden-Nr., VN, Objekt oder Ort"><button id="vf-search-btn">Suchen</button></div><button id="vf-recent" class="vf-secondary vf-full">Letzte 10 Fälle</button><div id="vf-results"></div><button id="vf-new" class="vf-secondary vf-full">Neuen Fall anlegen</button></section>
      <section id="vf-form" class="vf-card" hidden><div class="vf-title"><div><strong>Falldaten</strong><small>Werden aus Unterlagen ergänzt</small></div><span>automatisch</span></div><div class="vf-fields"><label>Schaden-Nr.<input id="vf-schaden"></label><label>Versicherungsschein-Nr.<input id="vf-vsnr"></label><label class="wide">VN / Objekt<input id="vf-object"></label><label class="wide">VN-Straße<input id="vf-strasse"></label><label>VN-PLZ<input id="vf-plz"></label><label>VN-Ort<input id="vf-ort"></label><label class="wide">Schadenort – Straße<input id="vf-schaden-strasse"></label><label>Schadenort – PLZ<input id="vf-schaden-plz"></label><label>Schadenort – Ort<input id="vf-schaden-ort"></label><label>Schadenart<input id="vf-art"></label><label>Reserve EUR<input id="vf-reserve"></label><label>Telefon<input id="vf-telefon"></label><label>E-Mail<input id="vf-email"></label></div><button id="vf-save" class="vf-primary vf-full">Fall speichern</button><p id="vf-save-state" class="vf-meta"></p></section>

    </aside>
    <section class="vf-work">
      <div class="vf-command-grid">
        <div class="vf-command-main">
          <section class="vf-card vf-upload-card"><header class="vf-step"><b>2</b><div><strong>Unterlagen hochladen</strong><small>PDF, Word, Excel, E-Mail, Bilder oder komplette Fallakte</small></div></header><input id="vf-files" type="file" multiple hidden accept=".pdf,.doc,.docx,.xls,.xlsx,.xlsm,.csv,.txt,.md,.rtf,.msg,.eml,.jpg,.jpeg,.png,.webp,.tif,.tiff,.zip"><div id="vf-drop" class="vf-drop" tabindex="0"><span>⇧</span><strong>Unterlagen hier hineinziehen</strong><small>oder zum Auswählen klicken</small><em>Die Bearbeitung startet nach dem Upload automatisch.</em></div><div id="vf-file-list"></div><div id="vf-progress" class="vf-progress" hidden><div><span></span></div><p>Unterlagen werden vorbereitet.</p></div></section>
          <section class="vf-card"><header class="vf-step"><b>3</b><div><strong>Arbeitsauftrag / Berichtswunsch</strong><small>Hier frei beschreiben, welcher Text oder welches Dokument aus der Fallakte erstellt werden soll.</small></div></header><textarea id="vf-instructions" rows="3" placeholder="z. B. Am 24.08.2026 fand ein weiterer Ortstermin gemeinsam mit … statt. Bitte erstelle daraus einen Nachtragstext für den Versicherer und gleiche die Angaben mit der Fallakte ab."></textarea><div class="vf-note"><span>Enter = Zeilenumbruch · Strg + Enter = Arbeitsauftrag ausführen. Der Text wird zusammen mit den Fallunterlagen ausgewertet.</span><span id="vf-instruction-state"></span></div><button id="vf-instruction-run" class="vf-primary vf-instruction-run" disabled>Ausgewählten Arbeitsauftrag ausführen</button></section>
          <details class="vf-card vf-chatgpt-work">
            <summary>ChatGPT Work – komplexe Bearbeitung</summary>
            <p class="vf-meta">Der aktive Fall und der Arbeitsauftrag werden als Arbeitspaket vorbereitet. Originalunterlagen und Falldaten bleiben unverändert.</p>
            <div class="vf-chatgpt-actions">
              <button id="vf-chatgpt-package" class="vf-secondary" type="button">Arbeitspaket erstellen</button>
              <button id="vf-chatgpt-copy" class="vf-secondary" type="button" disabled>Arbeitspaket kopieren</button>
              <a id="vf-chatgpt-open" class="vf-primary" href="https://chatgpt.com/" target="_blank" rel="noreferrer">ChatGPT Work öffnen</a>
            </div>
            <label class="vf-chatgpt-label">Vorbereitetes Arbeitspaket<textarea id="vf-chatgpt-package-text" rows="8" readonly placeholder="Zuerst einen Fall öffnen und das Arbeitspaket erstellen."></textarea></label>
            <label class="vf-chatgpt-label">Ergebnis aus ChatGPT Work<textarea id="vf-chatgpt-result" rows="8" placeholder="Den in ChatGPT Work erstellten Text hier einfügen. Alternativ kann ChatGPT den Entwurf über die App direkt an den Fall zurückgeben."></textarea></label>
            <div class="vf-chatgpt-actions">
              <button id="vf-chatgpt-save" class="vf-secondary" type="button">Als Fallentwurf speichern</button>
              <button id="vf-chatgpt-transfer" class="vf-primary" type="button">An Portal-KI übergeben</button>
            </div>
            <div id="vf-chatgpt-state" class="vf-job" hidden></div>
            <div id="vf-chatgpt-drafts" class="vf-chatgpt-drafts"></div>
          </details>
        </div>
        <section class="vf-card vf-plaud">
          <header class="vf-plaud-head"><span>PLAUD</span><div><strong>Ortstermin einlesen</strong><small>Zusammenfassung dem aktiven Fall zuordnen</small></div></header>
          <label class="vf-plaud-file" for="vf-plaud-file"><b>PLAUD-Datei auswählen</b><small id="vf-plaud-name">PDF, Word oder TXT</small></label>
          <input id="vf-plaud-file" type="file" hidden accept=".pdf,.doc,.docx,.txt,.md,.rtf">
          <label class="vf-plaud-label">Gewünschtes Ergebnis<select id="vf-plaud-target"><option value="auto">Automatisch erkennen</option><option value="erstbericht">Erstbericht</option><option value="zwischenbericht">Zwischenbericht</option><option value="nachtrag_stellungnahme">Nachtrag / Stellungnahme</option><option value="schlusserklaerung">Schlusserklärung</option><option value="schlussbericht">Schlussbericht</option></select></label>
          <button id="vf-plaud-check" class="vf-primary vf-full" disabled>Einlesen und prüfen</button>
          <div id="vf-plaud-preview" class="vf-plaud-preview" hidden></div>
          <button id="vf-plaud-accept" class="vf-secondary vf-full" hidden>Übernehmen und Dokument erstellen</button>
          <p class="vf-meta">Das Original bleibt im Fall. Vor der Dokumenterstellung werden Ziel, erkannte Falldaten und Arbeitsauftrag angezeigt.</p>
        </section>
        <section class="vf-card vf-polycam">
          <header class="vf-plaud-head"><span>3D</span><div><strong>Polycam-Aufmaß auswerten</strong><small>PDF oder Bild prüfen und dem aktiven Fall zuordnen</small></div></header>
          <label class="vf-plaud-file" for="vf-polycam-file"><b>Polycam-Datei auswählen</b><small id="vf-polycam-name">PDF, JPEG, PNG oder WEBP · max. 25 MB</small></label>
          <input id="vf-polycam-file" type="file" hidden accept=".pdf,.jpg,.jpeg,.png,.webp,application/pdf,image/jpeg,image/png,image/webp">
          <button id="vf-polycam-read" class="vf-primary vf-full" disabled>Aufmaß auslesen</button>
          <div id="vf-polycam-state" class="vf-plaud-preview" hidden></div>
          <div id="vf-polycam-review" hidden><p class="vf-meta"><strong>Prüfung erforderlich:</strong> Erkannte Werte kontrollieren und bei Bedarf berichtigen.</p><div class="vf-measure-table"><table><thead><tr><th>Raum</th><th>Bauteil / Maß</th><th>Wert</th><th>Einheit</th><th>Status</th><th></th></tr></thead><tbody id="vf-polycam-rows"></tbody></table></div><button id="vf-polycam-add" class="vf-secondary vf-full">Messwert ergänzen</button><button id="vf-polycam-accept" class="vf-primary vf-full">Geprüft übernehmen</button></div>
          <p class="vf-meta">Das Original bleibt in der Fallakte. Nur der ausdrücklich geprüfte Datensatz wird für Berichte verwendet.</p>
        </section>
      </div>
      <section class="vf-card vf-calendar"><header class="vf-step"><b>4</b><div><strong>Ortstermin planen</strong><small id="vf-cal-target">Kalender wird anhand der Anmeldung gewählt</small></div></header><div class="vf-calendar-grid"><label>Datum<input id="vf-cal-date" type="date"></label><label>Uhrzeit<input id="vf-cal-time" type="time" step="900"></label><label>Dauer<select id="vf-cal-duration"><option value="30" selected>30 Minuten</option><option value="60">60 Minuten</option><option value="90">90 Minuten</option><option value="120">120 Minuten</option><option value="180">180 Minuten</option></select></label><label class="wide">Besichtigungsadresse<input id="vf-cal-address" readonly></label><label class="wide">Bemerkungen / Notizen<textarea id="vf-cal-notes" rows="2" placeholder="Hinweise zur Anfahrt, Ansprechpartner, Rückruf oder Besonderheiten"></textarea></label><label class="wide vf-check"><input id="vf-cal-invite" type="checkbox"> VN per E-Mail zum Termin einladen</label><label class="wide">Weitere Anhänge<input id="vf-cal-files" type="file" multiple></label></div><p class="vf-meta">Beauftragung und vorhandene KVA werden automatisch aus dem Fallordner angehängt. Manuelle Anhänge sind bis 3 MB je Datei möglich. Einladungen werden von ws@sv-schuett.eu versendet.</p><div class="vf-calendar-actions"><button id="vf-cal-check" class="vf-secondary" disabled>Verfügbarkeit prüfen</button><button id="vf-cal-create" class="vf-primary" disabled>Termin in Outlook anlegen</button></div><div id="vf-cal-state" class="vf-job" hidden></div></section>
      <section class="vf-card vf-mail"><header class="vf-step"><b>5</b><div><strong>E-Mail schreiben</strong><small>Direkt aus dem aktiven Schadenfall senden</small></div></header><div class="vf-mail-grid"><label>An<div class="vf-mail-recipient-row"><input id="vf-mail-to" type="email" placeholder="Empfänger"><div id="vf-mail-presets" class="vf-mail-presets" aria-label="Standardempfänger auswählen">
<label><input type="checkbox" value="service.schaden@sparkassenversicherung.de"> Schadenservice</label>
<label><input type="checkbox" value="archiv@sparkassenversicherung.de"> Archiv</label>
<label><input type="checkbox" value="backoffice@meygeneralbau.de"> Mey Generalbau</label>
<label><input type="checkbox" value="info@rainbow-sanierungen.de"> Rainbow</label>
<label><input type="checkbox" value="service@polygon-deutschland.de"> POLYGON</label>
</div></div></label><label>CC<input id="vf-mail-cc" type="text" placeholder="optional, mehrere mit ; trennen"></label><label class="wide">Betreff<input id="vf-mail-subject" type="text" readonly></label><label class="wide">Nachricht<textarea id="vf-mail-body" rows="5" placeholder="E-Mail-Text eingeben"></textarea></label><label class="wide">Anhänge<input id="vf-mail-files" type="file" multiple></label></div><div class="vf-mail-actions"><button id="vf-mail-send" class="vf-primary" disabled>E-Mail senden</button><span id="vf-mail-sender" class="vf-meta"></span></div><div id="vf-mail-state" class="vf-job" hidden></div></section>
      <details class="vf-card vf-processing"><summary>Bearbeitung & Ausgaben</summary><details class="vf-options"><summary>Gewünschte Ausgabe auswählen</summary><div id="vf-outputs"><label><input type="checkbox" value="dokumentenindex"> Dokumentenindex</label><label><input type="checkbox" value="rechnungsregister"> Rechnungsregister</label><label><input type="checkbox" value="zwischenbericht"> Zwischenbericht</label><label><input type="checkbox" value="schlusserklaerung"> Schlusserklärung</label><label><input type="checkbox" value="schlussbericht"> Schlussbericht</label><label><input type="checkbox" value="nachtrag_stellungnahme"> Nachtrag / Stellungnahme</label><label><input type="checkbox" value="zahlungsbefuerwortung"> Zahlungsbefürwortung</label><label><input type="checkbox" value="query_form"> Rückfrageformular</label></div></details><button id="vf-excel-originals" class="vf-secondary vf-start" disabled>Excel-Originale im Fall öffnen</button><div id="vf-excel-links" class="vf-meta"></div><button id="vf-start" class="vf-primary vf-start" disabled>Arbeitsauftrag ausführen</button><div id="vf-job" class="vf-job" hidden></div></details>
    </section>
  </div><span id="vf-system-home" hidden></span><details id="vf-system-panel" class="vf-card vf-system vf-system-bottom"><summary>Verbindung und Vorlagen</summary><p id="vf-system-state" class="vf-meta">Google Drive sowie Word- und Excel-Originale werden geprüft.</p><button id="vf-sync" class="vf-secondary vf-full">Jetzt prüfen</button><button id="vf-organize-all" class="vf-secondary vf-full">Bestehende Fallakten einsortieren</button><p id="vf-organize-state" class="vf-meta"></p></details><input id="vf-folder" type="hidden">
</main>
<style is:global>
:root{--vfi:#17324a;--vfm:#697d8e;--vfl:#dce5ec;--vfo:#f59a23;--vfg:#2f8f67}.vf-app{max-width:1440px;margin:auto;padding:12px 24px 56px;color:var(--vfi)}.vf-head{display:flex;justify-content:space-between;gap:28px;align-items:flex-start;margin-bottom:18px}.vf-kicker{margin:0 0 5px;color:var(--vfo);font-size:.78rem;font-weight:800;letter-spacing:.1em;text-transform:uppercase}.vf-head h1{font-size:clamp(1.8rem,3vw,2.8rem);margin:0 0 7px}.vf-head p{margin:0;color:var(--vfm)}.vf-types{display:flex;background:#eef3f6;padding:4px;border-radius:12px;gap:3px}.vf-types button{border:0;background:transparent;padding:10px 13px;border-radius:9px;color:#526779;font-weight:700;white-space:nowrap}.vf-types button.on{background:#fff;color:var(--vfi);box-shadow:0 1px 6px #17324a22}.vf-active{display:flex;justify-content:space-between;border:1px solid var(--vfl);border-left:4px solid #acbac6;border-radius:12px;padding:12px 16px;margin-bottom:18px;background:#fff}.vf-active>div{display:grid;grid-template-columns:auto 1fr;column-gap:10px}.vf-active i{width:9px;height:9px;border-radius:50%;background:#acbac6;margin-top:6px}.vf-active small{grid-column:2;color:var(--vfm)}.vf-active.on{border-left-color:var(--vfg)}.vf-active.on i{background:var(--vfg)}.vf-active-actions{display:flex;align-items:center;gap:8px}.vf-active-actions a,.vf-active-actions button{display:inline-flex;align-items:center;justify-content:center;box-sizing:border-box;border:1px solid #aeb8c0;background:#f1f3f5;border-radius:3px;padding:7px 10px;text-decoration:none;color:var(--vfi);font:inherit;line-height:1.2;cursor:pointer}.vf-active-actions a:hover,.vf-active-actions button:hover{background:#e3e7ea;border-color:#8e9aa4}.vf-grid{display:grid;grid-template-columns:340px minmax(0,1fr);gap:18px;align-items:start}.vf-grid aside,.vf-work{display:grid;gap:16px}.vf-card{background:#fff;border:1px solid var(--vfl);border-radius:15px;padding:20px;box-shadow:0 5px 18px #17324a0b}.vf-step{display:flex;gap:12px;margin-bottom:16px}.vf-step>b{display:grid;place-items:center;width:30px;height:30px;border-radius:9px;background:var(--vfi);color:#fff;font-size:.82rem}.vf-step strong,.vf-title strong{display:block}.vf-step small,.vf-title small{display:block;color:var(--vfm);margin-top:2px}.vf-search{display:grid;grid-template-columns:1fr auto;gap:7px}.vf-search input,.vf-fields input,textarea{width:100%;box-sizing:border-box;border:1px solid #bdcbd6;border-radius:9px;padding:10px 11px;font:inherit;outline:none}.vf-search input:focus,.vf-fields input:focus,textarea:focus{border-color:var(--vfo);box-shadow:0 0 0 3px #f59a2322}.vf-search button,.vf-primary{border:1px solid var(--vfi);background:var(--vfi);color:#fff;border-radius:9px;padding:10px 13px;font-weight:750}.vf-primary:disabled{opacity:.4}.vf-secondary{border:1px solid #bac8d3;background:#fff;color:var(--vfi);border-radius:9px;padding:10px 13px;font-weight:750}.vf-full{width:100%;margin-top:10px}.vf-result{border:1px solid var(--vfl);border-radius:9px;padding:10px;margin-top:7px}.vf-result button{margin-top:7px}.vf-title{display:flex;justify-content:space-between;margin-bottom:12px}.vf-title>span{font-size:.72rem;font-weight:800;color:var(--vfg);background:#eaf6f0;padding:4px 7px;border-radius:20px;height:max-content}.vf-fields{display:grid;grid-template-columns:1fr 1fr;gap:9px}.vf-fields label{font-size:.78rem;font-weight:750;color:#536a7d}.vf-fields input{margin-top:4px}.vf-fields .wide{grid-column:1/-1}.vf-meta{font-size:.8rem;color:var(--vfm)}.vf-system summary,.vf-options summary{cursor:pointer;font-weight:750}.vf-system-bottom{width:min(100%,640px);margin:16px auto 0;box-sizing:border-box}.vf-drop{border:2px dashed #b9c9d5;border-radius:14px;padding:16px 18px;text-align:center;background:#f5f8fa;display:flex;flex-direction:column;align-items:center;gap:3px;cursor:pointer}.vf-drop:hover,.vf-drop.drag{border-color:var(--vfo);background:#fff8ed}.vf-drop>span{display:grid;place-items:center;width:32px;height:32px;border-radius:50%;background:#fff;color:var(--vfo);font-size:1.15rem}.vf-drop small{color:var(--vfm)}.vf-drop em{color:var(--vfg);font-size:.9rem;font-style:normal;font-weight:700}.vf-file{display:flex;justify-content:space-between;border:1px solid var(--vfl);border-radius:8px;padding:8px 10px;margin-top:6px;font-size:.86rem}.vf-progress{margin-top:14px}.vf-progress>div{height:7px;background:#e8eef2;border-radius:9px;overflow:hidden}.vf-progress>div span{display:block;height:100%;width:0;background:linear-gradient(90deg,var(--vfo),#ffbc5d);transition:.3s}.vf-progress p{color:var(--vfm);font-size:.84rem}textarea{min-height:44px;max-height:260px;resize:none;overflow-y:auto;line-height:1.45}.vf-note{display:flex;justify-content:space-between;color:var(--vfm);font-size:.78rem;margin-top:6px}.vf-calendar-grid{display:grid;grid-template-columns:1fr 1fr 1fr;gap:10px}.vf-calendar-grid label{font-size:.78rem;font-weight:750;color:#536a7d}.vf-calendar-grid input,.vf-calendar-grid select,.vf-calendar-grid textarea{width:100%;box-sizing:border-box;border:1px solid #bdcbd6;border-radius:9px;padding:10px 11px;font:inherit;margin-top:4px}.vf-calendar-grid .wide{grid-column:1/-1}.vf-calendar-grid .vf-check{display:flex;align-items:center;gap:8px}.vf-calendar-grid .vf-check input{width:auto;margin:0}.vf-calendar-actions{display:flex;gap:9px;margin-top:12px}.vf-mail-grid{display:grid;grid-template-columns:1fr 1fr;gap:10px}.vf-mail-grid label{font-size:.78rem;font-weight:750;color:#536a7d}.vf-mail-grid input,.vf-mail-grid textarea{width:100%;box-sizing:border-box;border:1px solid #bdcbd6;border-radius:9px;padding:10px 11px;font:inherit;margin-top:4px}.vf-mail-recipient-row{display:grid;grid-template-columns:1fr;gap:7px}.vf-mail-presets{display:flex;flex-wrap:wrap;gap:6px 10px;margin-top:6px}.vf-mail-presets label{display:flex;align-items:center;gap:5px;border:1px solid #d5e0e7;border-radius:8px;padding:6px 8px;background:#f8fafb;font-size:.78rem;font-weight:700}.vf-mail-presets input{width:auto;margin:0}.vf-mail-recipient-row select{box-sizing:border-box;border:1px solid #bdcbd6;border-radius:9px;padding:10px 11px;font:inherit;margin-top:4px;background:#fff;color:#17324a;max-width:260px}.vf-mail-grid .wide{grid-column:1/-1}.vf-mail-grid input[readonly]{background:#f3f6f8;color:#405568}.vf-mail-actions{display:flex;align-items:center;gap:12px;margin-top:12px}.vf-processing>summary{cursor:pointer;font-weight:800}.vf-processing .vf-options{margin-top:12px}.vf-pipeline{list-style:none;padding:0;margin:0;display:grid;grid-template-columns:repeat(4,1fr);gap:9px}.vf-pipeline li{border:1px solid var(--vfl);border-radius:11px;padding:13px;background:#fbfcfd}.vf-pipeline li>b{display:block;color:var(--vfo);font-size:.72rem;margin-bottom:7px}.vf-pipeline li>strong,.vf-pipeline li>small{display:block}.vf-pipeline li>small{color:var(--vfm);margin-top:4px;line-height:1.35}.vf-options{margin-top:14px;border-top:1px solid var(--vfl);padding-top:12px}#vf-outputs{display:grid;grid-template-columns:repeat(3,1fr);gap:7px;margin-top:11px}#vf-outputs label{border:1px solid var(--vfl);border-radius:8px;padding:8px;font-size:.84rem}.vf-start{margin-top:16px;min-width:260px}.vf-job{margin-top:12px;border-radius:10px;padding:12px;background:#eef5f9}.vf-job.ok{background:#eaf6f0}.vf-job.bad{background:#fff4e6}@media(max-width:1050px){.vf-grid{grid-template-columns:1fr}.vf-grid aside{grid-template-columns:1fr 1fr}.vf-pipeline{grid-template-columns:1fr 1fr}}@media(max-width:760px){.vf-upload-card{padding:12px}.vf-upload-card .vf-step{margin-bottom:8px}.vf-upload-card .vf-drop{padding:9px 10px;min-height:0;gap:2px}.vf-upload-card .vf-drop>span{width:26px;height:26px;font-size:.95rem}.vf-upload-card .vf-drop>strong{font-size:.94rem;line-height:1.2}.vf-upload-card .vf-drop small{font-size:.78rem}.vf-upload-card .vf-drop em{font-size:.72rem}.vf-upload-card .vf-file{padding:6px 8px}.vf-calendar-grid{grid-template-columns:1fr}.vf-head{display:block}.vf-types{margin-top:14px;overflow:auto}.vf-grid aside{grid-template-columns:1fr}.vf-pipeline,#vf-outputs{grid-template-columns:1fr}.vf-app{padding:18px 12px 42px}}
.vf-progress.done>div span{background:linear-gradient(90deg,var(--vfg),#55bd8d)}.vf-progress.done p{color:var(--vfg);font-weight:750}
/* Freigegebene Windows-11-Hybridoptik: helle Navigation, kantige Arbeitskarten. */
