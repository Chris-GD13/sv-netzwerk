---
import InternalLayout from '../../../layouts/InternalLayout.astro';
---
<InternalLayout title="Versicherungsfälle" description="Automatische, fallzentrierte Schadenbearbeitung.">
<main class="vf-app">
  <header class="vf-head"><div><p class="vf-kicker">SV-Netzwerk Prüfportal</p><h1>Versicherungsfall bearbeiten</h1><p>Unterlagen hochladen. Versicherer und Fallart werden selbstständig erkannt; anschließend wird der Fall automatisch geordnet, geprüft und in die richtigen Word- und Excel-Originale übertragen.</p></div><span class="vf-auto-type">Fallart wird automatisch erkannt</span></header>
  <section id="vf-active" class="vf-active"><div><i></i><strong>Noch kein Fall geöffnet</strong><small>Fall suchen, neu anlegen oder Unterlagen zur automatischen Anlage hochladen.</small></div></section>
  <div class="vf-grid">
    <aside>
      <section class="vf-card"><header class="vf-step"><b>1</b><div><strong>Fall auswählen</strong><small>Öffnen oder neu beginnen</small></div></header><div class="vf-search"><input id="vf-search-input" placeholder="Schaden-Nr., VN, Objekt oder Ort"><button id="vf-search-btn">Suchen</button></div><div id="vf-results"></div><button id="vf-new" class="vf-secondary vf-full">Neuen Fall anlegen</button></section>
      <section id="vf-form" class="vf-card" hidden><div class="vf-title"><div><strong>Falldaten</strong><small>Werden aus Unterlagen ergänzt</small></div><span>automatisch</span></div><div class="vf-fields"><label>Schaden-Nr.<input id="vf-schaden"></label><label>Versicherungsschein-Nr.<input id="vf-vsnr"></label><label class="wide">VN / Objekt<input id="vf-object"></label><label class="wide">Straße<input id="vf-strasse"></label><label>PLZ<input id="vf-plz"></label><label>Ort<input id="vf-ort"></label><label>Schadenart<input id="vf-art"></label><label>Reserve EUR<input id="vf-reserve"></label><label>Telefon<input id="vf-telefon"></label><label>E-Mail<input id="vf-email"></label></div><button id="vf-save" class="vf-primary vf-full">Fall speichern</button><p id="vf-save-state" class="vf-meta"></p></section>
      <details class="vf-card vf-system"><summary>Verbindung und Vorlagen</summary><p id="vf-system-state" class="vf-meta">Google Drive sowie Word- und Excel-Originale werden geprüft.</p><button id="vf-sync" class="vf-secondary vf-full">Jetzt prüfen</button></details>
    </aside>
    <section class="vf-work">
      <section class="vf-card"><header class="vf-step"><b>2</b><div><strong>Unterlagen hochladen</strong><small>PDF, Word, Excel, E-Mail, Bilder oder komplette Fallakte</small></div></header><input id="vf-files" type="file" multiple hidden accept=".pdf,.doc,.docx,.xls,.xlsx,.xlsm,.csv,.txt,.md,.rtf,.msg,.eml,.jpg,.jpeg,.png,.webp,.tif,.tiff,.zip"><div id="vf-drop" class="vf-drop" tabindex="0"><span>⇧</span><strong>Unterlagen hier hineinziehen</strong><small>oder zum Auswählen klicken</small><em>Die Bearbeitung startet nach dem Upload automatisch.</em></div><div id="vf-file-list"></div><div id="vf-progress" class="vf-progress" hidden><div><span></span></div><p>Unterlagen werden vorbereitet.</p></div></section>
      <section class="vf-card"><header class="vf-step"><b>3</b><div><strong>Zusätzliche Anweisung</strong><small>Nur Besonderheiten eintragen. Die Standardprüfung läuft immer vollständig.</small></div></header><textarea id="vf-instructions" rows="1" placeholder="z. B. Letzten Nachtrag beachten, Rechnung prüfen und Schlussbericht erstellen."></textarea><div class="vf-note"><span>Das Feld wächst beim Schreiben automatisch mit.</span><span id="vf-instruction-state"></span></div></section>
      <section class="vf-card vf-calendar"><header class="vf-step"><b>4</b><div><strong>Ortstermin planen</strong><small>Kalender „Calendar Christian“ · cw@sv-schuett.eu</small></div></header><div class="vf-calendar-grid"><label>Datum<input id="vf-cal-date" type="date"></label><label>Uhrzeit<input id="vf-cal-time" type="time" step="900"></label><label>Dauer<select id="vf-cal-duration"><option value="30" selected>30 Minuten</option><option value="60">60 Minuten</option><option value="90">90 Minuten</option><option value="120">120 Minuten</option><option value="180">180 Minuten</option></select></label><label class="wide">Besichtigungsadresse<input id="vf-cal-address" readonly></label><label class="wide">Bemerkungen / Notizen<textarea id="vf-cal-notes" rows="2" placeholder="Hinweise zur Anfahrt, Ansprechpartner, Rückruf oder Besonderheiten"></textarea></label><label class="wide vf-check"><input id="vf-cal-invite" type="checkbox"> VN per E-Mail zum Termin einladen</label><label class="wide">Weitere Anhänge<input id="vf-cal-files" type="file" multiple></label></div><p class="vf-meta">Beauftragung und vorhandene KVA werden automatisch aus dem Fallordner angehängt. Manuelle Anhänge sind bis 3 MB je Datei möglich.</p><div class="vf-calendar-actions"><button id="vf-cal-check" class="vf-secondary" disabled>Verfügbarkeit prüfen</button><button id="vf-cal-create" class="vf-primary" disabled>Termin in Outlook anlegen</button></div><div id="vf-cal-state" class="vf-job" hidden></div></section>
      <section class="vf-card"><header class="vf-step"><b>5</b><div><strong>Automatische Bearbeitung</strong><small>Verbindliche Prüfreihenfolge für jeden Fall</small></div></header><ol class="vf-pipeline"><li><b>01</b><strong>Fallzuordnung</strong><small>Schaden-Nr., VN, Objekt, Dokumentart und Fremdakten</small></li><li><b>02</b><strong>Belegprüfung</strong><small>Rechnung/KVA trennen, Bruttobeträge, Dubletten und Zahlungen</small></li><li><b>03</b><strong>Bewertung</strong><small>Schadenbezug, Abzüge, offene Punkte, Regress und Reserve</small></li><li><b>04</b><strong>Originalformulare</strong><small>Word und Excel auswählen, formatgetreu befüllen und speichern</small></li></ol><details class="vf-options"><summary>Ausgaben bei Bedarf anpassen</summary><div id="vf-outputs"><label><input type="checkbox" value="dokumentenindex" checked> Dokumentenindex</label><label><input type="checkbox" value="rechnungsregister" checked> Rechnungsregister</label><label><input type="checkbox" value="zwischenbericht" checked> Zwischenbericht</label><label><input type="checkbox" value="schlusserklaerung" checked> Schlusserklärung</label><label><input type="checkbox" value="schlussbericht"> Schlussbericht</label><label><input type="checkbox" value="nachtrag_stellungnahme"> Nachtrag / Stellungnahme</label><label><input type="checkbox" value="zahlungsbefuerwortung"> Zahlungsbefürwortung</label><label><input type="checkbox" value="query_form"> Rückfrageformular</label></div></details><button id="vf-excel-originals" class="vf-secondary vf-start" disabled>Excel-Originale im Fall öffnen</button><div id="vf-excel-links" class="vf-meta"></div><button id="vf-start" class="vf-primary vf-start" disabled>Fall automatisch bearbeiten</button><div id="vf-job" class="vf-job" hidden></div></section>
    </section>
  </div><input id="vf-folder" type="hidden">
</main>
<style>
:root{--vfi:#17324a;--vfm:#697d8e;--vfl:#dce5ec;--vfo:#f59a23;--vfg:#2f8f67}.vf-app{max-width:1440px;margin:auto;padding:28px 24px 56px;color:var(--vfi)}.vf-head{display:flex;justify-content:space-between;gap:28px;align-items:flex-start;margin-bottom:18px}.vf-kicker{margin:0 0 5px;color:var(--vfo);font-size:.78rem;font-weight:800;letter-spacing:.1em;text-transform:uppercase}.vf-head h1{font-size:clamp(1.8rem,3vw,2.8rem);margin:0 0 7px}.vf-head p{margin:0;color:var(--vfm)}.vf-types{display:flex;background:#eef3f6;padding:4px;border-radius:12px;gap:3px}.vf-types button{border:0;background:transparent;padding:10px 13px;border-radius:9px;color:#526779;font-weight:700;white-space:nowrap}.vf-types button.on{background:#fff;color:var(--vfi);box-shadow:0 1px 6px #17324a22}.vf-active{display:flex;justify-content:space-between;border:1px solid var(--vfl);border-left:4px solid #acbac6;border-radius:12px;padding:12px 16px;margin-bottom:18px;background:#fff}.vf-active>div{display:grid;grid-template-columns:auto 1fr;column-gap:10px}.vf-active i{width:9px;height:9px;border-radius:50%;background:#acbac6;margin-top:6px}.vf-active small{grid-column:2;color:var(--vfm)}.vf-active.on{border-left-color:var(--vfg)}.vf-active.on i{background:var(--vfg)}.vf-active-actions{display:flex;align-items:center;gap:14px}.vf-active-actions a,.vf-active button{border:0;background:none;text-decoration:underline;color:var(--vfm);font:inherit;cursor:pointer}.vf-grid{display:grid;grid-template-columns:340px minmax(0,1fr);gap:18px;align-items:start}.vf-grid aside,.vf-work{display:grid;gap:16px}.vf-card{background:#fff;border:1px solid var(--vfl);border-radius:15px;padding:20px;box-shadow:0 5px 18px #17324a0b}.vf-step{display:flex;gap:12px;margin-bottom:16px}.vf-step>b{display:grid;place-items:center;width:30px;height:30px;border-radius:9px;background:var(--vfi);color:#fff;font-size:.82rem}.vf-step strong,.vf-title strong{display:block}.vf-step small,.vf-title small{display:block;color:var(--vfm);margin-top:2px}.vf-search{display:grid;grid-template-columns:1fr auto;gap:7px}.vf-search input,.vf-fields input,textarea{width:100%;box-sizing:border-box;border:1px solid #bdcbd6;border-radius:9px;padding:10px 11px;font:inherit;outline:none}.vf-search input:focus,.vf-fields input:focus,textarea:focus{border-color:var(--vfo);box-shadow:0 0 0 3px #f59a2322}.vf-search button,.vf-primary{border:1px solid var(--vfi);background:var(--vfi);color:#fff;border-radius:9px;padding:10px 13px;font-weight:750}.vf-primary:disabled{opacity:.4}.vf-secondary{border:1px solid #bac8d3;background:#fff;color:var(--vfi);border-radius:9px;padding:10px 13px;font-weight:750}.vf-full{width:100%;margin-top:10px}.vf-result{border:1px solid var(--vfl);border-radius:9px;padding:10px;margin-top:7px}.vf-result button{margin-top:7px}.vf-title{display:flex;justify-content:space-between;margin-bottom:12px}.vf-title>span{font-size:.72rem;font-weight:800;color:var(--vfg);background:#eaf6f0;padding:4px 7px;border-radius:20px;height:max-content}.vf-fields{display:grid;grid-template-columns:1fr 1fr;gap:9px}.vf-fields label{font-size:.78rem;font-weight:750;color:#536a7d}.vf-fields input{margin-top:4px}.vf-fields .wide{grid-column:1/-1}.vf-meta{font-size:.8rem;color:var(--vfm)}.vf-system summary,.vf-options summary{cursor:pointer;font-weight:750}.vf-drop{border:2px dashed #b9c9d5;border-radius:14px;padding:34px 20px;text-align:center;background:#f5f8fa;display:flex;flex-direction:column;align-items:center;gap:5px;cursor:pointer}.vf-drop:hover,.vf-drop.drag{border-color:var(--vfo);background:#fff8ed}.vf-drop>span{display:grid;place-items:center;width:42px;height:42px;border-radius:50%;background:#fff;color:var(--vfo);font-size:1.5rem}.vf-drop small{color:var(--vfm)}.vf-drop em{color:var(--vfg);font-size:.9rem;font-style:normal;font-weight:700}.vf-file{display:flex;justify-content:space-between;border:1px solid var(--vfl);border-radius:8px;padding:8px 10px;margin-top:6px;font-size:.86rem}.vf-progress{margin-top:14px}.vf-progress>div{height:7px;background:#e8eef2;border-radius:9px;overflow:hidden}.vf-progress>div span{display:block;height:100%;width:0;background:linear-gradient(90deg,var(--vfo),#ffbc5d);transition:.3s}.vf-progress p{color:var(--vfm);font-size:.84rem}textarea{min-height:44px;max-height:260px;resize:none;overflow-y:auto;line-height:1.45}.vf-note{display:flex;justify-content:space-between;color:var(--vfm);font-size:.78rem;margin-top:6px}.vf-calendar-grid{display:grid;grid-template-columns:1fr 1fr 1fr;gap:10px}.vf-calendar-grid label{font-size:.78rem;font-weight:750;color:#536a7d}.vf-calendar-grid input,.vf-calendar-grid select,.vf-calendar-grid textarea{width:100%;box-sizing:border-box;border:1px solid #bdcbd6;border-radius:9px;padding:10px 11px;font:inherit;margin-top:4px}.vf-calendar-grid .wide{grid-column:1/-1}.vf-calendar-grid .vf-check{display:flex;align-items:center;gap:8px}.vf-calendar-grid .vf-check input{width:auto;margin:0}.vf-calendar-actions{display:flex;gap:9px;margin-top:12px}.vf-pipeline{list-style:none;padding:0;margin:0;display:grid;grid-template-columns:repeat(4,1fr);gap:9px}.vf-pipeline li{border:1px solid var(--vfl);border-radius:11px;padding:13px;background:#fbfcfd}.vf-pipeline li>b{display:block;color:var(--vfo);font-size:.72rem;margin-bottom:7px}.vf-pipeline li>strong,.vf-pipeline li>small{display:block}.vf-pipeline li>small{color:var(--vfm);margin-top:4px;line-height:1.35}.vf-options{margin-top:14px;border-top:1px solid var(--vfl);padding-top:12px}#vf-outputs{display:grid;grid-template-columns:repeat(3,1fr);gap:7px;margin-top:11px}#vf-outputs label{border:1px solid var(--vfl);border-radius:8px;padding:8px;font-size:.84rem}.vf-start{margin-top:16px;min-width:260px}.vf-job{margin-top:12px;border-radius:10px;padding:12px;background:#eef5f9}.vf-job.ok{background:#eaf6f0}.vf-job.bad{background:#fff4e6}@media(max-width:1050px){.vf-grid{grid-template-columns:1fr}.vf-grid aside{grid-template-columns:1fr 1fr}.vf-pipeline{grid-template-columns:1fr 1fr}}@media(max-width:760px){.vf-calendar-grid{grid-template-columns:1fr}.vf-head{display:block}.vf-types{margin-top:14px;overflow:auto}.vf-grid aside{grid-template-columns:1fr}.vf-pipeline,#vf-outputs{grid-template-columns:1fr}.vf-app{padding:18px 12px 42px}}
</style>
<script is:inline>
(()=>{const API='/intern/api/google-drive-sync.php',EX='/intern/api/insurance-case-extract.php',AI='/intern/api/gf-ai-generate.php',CAL='/intern/api/outlook-case-calendar.php',$=id=>document.getElementById(id);let type='',active=null,files=[],timer;const e=s=>String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));async function api(u,o={}){const r=await fetch(u,{credentials:'same-origin',...o}),j=await r.json().catch(()=>({}));if(!r.ok)throw Error(j.error||`HTTP ${r.status}`);return j}function read(){for(const s of[sessionStorage,localStorage])try{const d=JSON.parse(s.getItem('svnet-case')||'null');if(d?.folder_id)return d}catch{}return null}function keep(d){active=d;$('vf-form').hidden=!d?.folder_id;sessionStorage.setItem('svnet-case',JSON.stringify(d));localStorage.setItem('svnet-case',JSON.stringify(d));show();fill(d.meta||{})}function show(){const n=$('vf-active'),m=active?.meta||{};n.classList.toggle('on',!!active?.folder_id);n.innerHTML=active?.folder_id?`<div><i></i><strong>${e(m.schaden_nr||'Fall ohne Schaden-Nr.')}${m.vn_objekt?' · '+e(m.vn_objekt):''}</strong><small>${e([m.strasse,m.plz,m.ort,m.fallart].filter(Boolean).join(' · '))}</small></div><div class="vf-active-actions"><a href="https://drive.google.com/drive/folders/${encodeURIComponent(active.folder_id)}" target="_blank" rel="noreferrer">Dokumente</a><button id="vf-close">Fall schließen</button></div>`:'<div><i></i><strong>Noch kein Fall geöffnet</strong><small>Fall suchen, neu anlegen oder Unterlagen zur automatischen Anlage hochladen.</small></div>';n.querySelector('#vf-close')?.addEventListener('click',()=>{sessionStorage.removeItem('svnet-case');localStorage.removeItem('svnet-case');active=null;files=[];$('vf-file-list').innerHTML='';$('vf-excel-links').innerHTML='';$('vf-form').hidden=true;show()});$('vf-start').disabled=!active?.folder_id;$('vf-excel-originals').disabled=!active?.folder_id;$('vf-cal-check').disabled=!active?.folder_id;$('vf-cal-create').disabled=!active?.folder_id;$('vf-cal-address').value=[m.strasse,m.plz,m.ort].filter(Boolean).join(' ');const ce=m.calendar_event;$('vf-cal-state').hidden=!ce;if(ce)$('vf-cal-state').innerHTML='<strong>Outlook-Termin angelegt.</strong>'+(ce.webLink?' <a href="'+e(ce.webLink)+'" target="_blank" rel="noreferrer">Termin öffnen</a>':'')}const map={schaden_nr:'vf-schaden',versicherungsschein_nr:'vf-vsnr',vn_objekt:'vf-object',strasse:'vf-strasse',plz:'vf-plz',ort:'vf-ort',schadenart:'vf-art',reserve:'vf-reserve',telefon:'vf-telefon',email:'vf-email'};function fill(m){Object.entries(map).forEach(([k,id])=>$(id).value=m[k]||'');$('vf-instructions').value=m.anweisung||'';grow()}function data(){const o={...(active?.meta||{}),fallart:type||active?.meta?.fallart||'',anweisung:$('vf-instructions').value.trim()};Object.entries(map).forEach(([k,id])=>o[k]=$(id).value.trim());return o}function defaults(keys){document.querySelectorAll('#vf-outputs input').forEach(n=>n.checked=keys.includes(n.value))}function applyType(value){if(!['SV','SV-GF','Andere Versicherer'].includes(value))return;type=value;defaults(type==='SV-GF'?['dokumentenindex','rechnungsregister','zwischenbericht','schlusserklaerung']:type==='SV'?['dokumentenindex','rechnungsregister','zahlungsbefuerwortung','schlusserklaerung']:['dokumentenindex','rechnungsregister','nachtrag_stellungnahme'])}$('vf-new').onclick=()=>$('vf-form').hidden=!$('vf-form').hidden;$('vf-search-btn').onclick=search;$('vf-search-input').onkeydown=x=>{if(x.key==='Enter'){x.preventDefault();search()}};async function search(){const b=$('vf-results');b.innerHTML='<p class="vf-meta">Suche läuft …</p>';try{const d=await api(`${API}?action=search_cases&q=${encodeURIComponent($('vf-search-input').value.trim())}`);b.innerHTML=(d.results||[]).map(r=>`<div class="vf-result"><strong>${e(r.meta?.schaden_nr||r.name)}</strong><div class="vf-meta">${e([r.meta?.vn_objekt,r.meta?.ort].filter(Boolean).join(' · '))}</div><button class="vf-secondary" data-id="${e(r.id)}">Öffnen</button></div>`).join('')||'<p class="vf-meta">Kein Fall gefunden.</p>';b.querySelectorAll('button').forEach(x=>x.onclick=async()=>{const d=await api(`${API}?action=load_case&id=${encodeURIComponent(x.dataset.id)}`);applyType(d.case.meta?.fallart||'');keep({folder_id:d.case.id,meta:d.case.meta||{}});b.innerHTML=''})}catch(x){b.innerHTML=`<p class="vf-meta">${e(x.message)}</p>`}}$('vf-save').onclick=save;async function save(){const s=$('vf-save-state');s.textContent='Wird gespeichert …';try{const d=await api(`${API}?action=save_case`,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({folder_id:active?.folder_id||'',case:data()})});keep({folder_id:d.folder_id,meta:data()});s.textContent='Fall gespeichert.';$('vf-form').hidden=false;return d.folder_id}catch(x){s.textContent=x.message;throw x}}const ta=$('vf-instructions');function grow(){ta.style.height='auto';ta.style.height=Math.min(260,ta.scrollHeight)+'px'}ta.oninput=()=>{grow();$('vf-instruction-state').textContent='wird übernommen'};const fi=$('vf-files'),drop=$('vf-drop');drop.onclick=()=>fi.click();drop.onkeydown=x=>{if(x.key==='Enter'||x.key===' '){x.preventDefault();fi.click()}};fi.onchange=()=>receive(fi.files);['dragenter','dragover'].forEach(t=>drop.addEventListener(t,x=>{x.preventDefault();drop.classList.add('drag')}));['dragleave','drop'].forEach(t=>drop.addEventListener(t,x=>{x.preventDefault();drop.classList.remove('drag')}));drop.addEventListener('drop',x=>receive(x.dataTransfer.files));async function receive(list){files=[...list];if(!files.length)return;$('vf-file-list').innerHTML=files.map(f=>`<div class="vf-file"><span>${e(f.name)}</span><span>${Math.max(1,Math.round(f.size/1024))} KB</span></div>`).join('');$('vf-form').hidden=false;try{if(!active?.folder_id)await extract();await upload();await start()}catch(x){const b=$('vf-job');b.hidden=false;b.className='vf-job bad';b.textContent=x.message}}async function extract(){const m={};for(const f of files.slice(0,5)){const fd=new FormData();fd.append('file',f);try{const d=await api(EX,{method:'POST',body:fd});Object.entries(d.fields||{}).forEach(([k,v])=>{if(v&&!m[k])m[k]=v})}catch{}}applyType(m.fallart);fill({...data(),...m,fallart:type});await save()}async function upload(){const p=$('vf-progress');p.hidden=false;let i=0;for(const f of files){p.querySelector('p').textContent=`Unterlage ${i+1}/${files.length}: ${f.name}`;const fd=new FormData();fd.append('folder_id',active.folder_id);fd.append('kind','fallakte');fd.append('mode','ki');fd.append('file',f);await api(`${API}?action=upload_case_document`,{method:'POST',body:fd});i++;p.querySelector('span').style.width=Math.round(i/files.length*70)+'%'}active.meta={...active.meta,...data()};keep(active)}async function calAvailability(){const n=$('vf-cal-state');n.hidden=false;n.className='vf-job';n.textContent='Kalender wird geprüft …';try{const d=await api(CAL+'?action=availability',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({date:$('vf-cal-date').value,time:$('vf-cal-time').value,duration:$('vf-cal-duration').value})});n.className='vf-job '+(d.available?'ok':'bad');n.textContent=d.available?'Der Zeitraum ist im Kalender frei.':'Der Zeitraum überschneidet sich mit einem bestehenden Termin.'}catch(x){n.className='vf-job bad';n.textContent=x.message}}async function calCreate(){const n=$('vf-cal-state');n.hidden=false;n.className='vf-job';n.textContent='Outlook-Termin wird angelegt …';const fd=new FormData();fd.append('folder_id',active.folder_id);fd.append('date',$('vf-cal-date').value);fd.append('time',$('vf-cal-time').value);fd.append('duration',$('vf-cal-duration').value);fd.append('notes',$('vf-cal-notes').value.trim());fd.append('invite_vn',$('vf-cal-invite').checked?'1':'0');[...$('vf-cal-files').files].forEach((f,i)=>fd.append('manual_'+i,f));try{const d=await api(CAL+'?action=create',{method:'POST',body:fd});active.meta={...(active.meta||{}),calendar_event:d.event};await save();n.className='vf-job ok';n.innerHTML='<strong>Termin wurde in Calendar Christian angelegt.</strong>'+(d.event?.webLink?' <a href="'+e(d.event.webLink)+'" target="_blank" rel="noreferrer">In Outlook öffnen</a>':'')}catch(x){n.className='vf-job bad';n.textContent=x.message}}$('vf-cal-check').onclick=calAvailability;$('vf-cal-create').onclick=calCreate;$('vf-excel-originals').onclick=async()=>{const n=$('vf-excel-links');n.textContent='Excel-Originale werden bereitgestellt …';try{const d=await api(`${API}?action=case_excel_forms`,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({folder_id:active.folder_id})});n.innerHTML=(d.files||[]).map(f=>`<a href="${e(f.webViewLink||'#')}" target="_blank" rel="noreferrer">${e(f.name)}</a>`).join(' · ')}catch(x){n.textContent=x.message}};$('vf-start').onclick=start;async function start(){if(!active?.folder_id)return;const outputs=[...document.querySelectorAll('#vf-outputs input:checked')].map(n=>n.value),instructions=ta.value.trim()||'Fall vollständig nach dem verbindlichen SV-Arbeitsstandard aufarbeiten. Unterlagen indexieren, Rechnungen und Kostenvoranschläge trennen, Original-Bruttobeträge erfassen, Dubletten und Zahlungen prüfen, schadenbedingte Positionen bewerten, offene Punkte kennzeichnen und die ausgewählten Word- und Excel-Originalformulare vollständig sowie formatgetreu befüllen.';const b=$('vf-job');b.hidden=false;b.className='vf-job';b.innerHTML='<strong>Bearbeitung wird gestartet.</strong>';const d=await api(AI,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({action:'start',folder_id:active.folder_id,order:{instructions,work_mode:'vollpruefung',open_points:'beides',outputs,automatic:true,case_type:type}})});poll(d.job_id)}async function poll(id){clearTimeout(timer);const b=$('vf-job');try{const d=await api(AI,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({action:'status',job_id:id})}),j=d.job;if(j.status==='done'){b.className='vf-job ok';b.innerHTML='<strong>Fallbearbeitung abgeschlossen.</strong><ul>'+((j.result?.created||[]).map(f=>`<li><a href="${e(f.webViewLink||'#')}" target="_blank" rel="noreferrer">${e(f.name)}</a></li>`).join(''))+'</ul>';$('vf-progress').querySelector('span').style.width='100%';$('vf-progress').querySelector('p').textContent='Unterlagen geprüft und Dokumente gespeichert.';return}if(j.status==='failed'){b.className='vf-job bad';b.textContent=j.error_text||j.message;return}b.innerHTML=`<strong>${j.progress||0}% · ${e(j.message||'Bearbeitung läuft')}</strong>`;timer=setTimeout(()=>poll(id),2500)}catch{x=>x;timer=setTimeout(()=>poll(id),5000)}}$('vf-sync').onclick=async()=>{const n=$('vf-system-state');try{const s=await api(`${API}?action=status`),c=await api(CAL+'?action=status');n.textContent=`Google Drive verbunden · ${s.folders?.cases?.items||0} Fälle · Outlook: ${c.calendar?.name||c.mailbox}`}catch(x){n.textContent=x.message}};active=read();if(active){applyType(active.meta?.fallart||'');keep(active)}else show()})();
