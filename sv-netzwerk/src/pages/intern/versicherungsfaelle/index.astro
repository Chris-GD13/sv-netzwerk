<script is:inline>
(() => {
  const run=document.getElementById('vf-instruction-run');
  const instructions=document.getElementById('vf-instructions');
  const original=document.getElementById('vf-start');
  const active=document.getElementById('vf-active');
  const processing=document.querySelector('.vf-processing');
  const options=document.querySelector('.vf-options');
  const outputs=[...document.querySelectorAll('#vf-outputs input')];
  if(!run||!instructions||!original||!active)return;
  const sync=()=>{run.disabled=!active.classList.contains('on')||!instructions.value.trim()};
  instructions.addEventListener('input',sync);
  outputs.forEach(input=>input.addEventListener('change',sync));
  new MutationObserver(sync).observe(active,{attributes:true,attributeFilter:['class'],childList:true,subtree:true});
  run.addEventListener('click',()=>{
    if(!outputs.some(input=>input.checked)){
      if(processing)processing.open=true;
      if(options)options.open=true;
      const job=document.getElementById('vf-job');
      if(job){job.hidden=false;job.className='vf-job bad';job.textContent='Bitte zuerst die gewünschte Ausgabe auswählen.'}
      document.getElementById('vf-outputs')?.scrollIntoView({behavior:'smooth',block:'center'});
      return;
    }
    original.click();
  });
  sync();
})();
</script>
<script is:inline>
(() => {
  const panel=document.getElementById('vf-system-panel'),home=document.getElementById('vf-system-home'),sidebar=document.querySelector('.intern-sidebar'),logout=document.getElementById('intern-logout'),desktop=window.matchMedia('(min-width:901px)');
