---
import InternalLayout from '../../../layouts/InternalLayout.astro';
---

<InternalLayout title="Versicherungsfälle" description="Zentrale Fallakte und Bearbeitung für Versicherungsfälle.">
  <main class="intern-app" style="max-width:1320px;margin:0 auto;padding:24px">
    <section class="intern-card">
      <p class="sv-eyebrow">SV-Netzwerk Prüfportal</p>
      <h1>Versicherungsfälle</h1>
      <p>Zentrale Fallakte für alle Versicherungsfälle. Fallanlage, Google-Drive-Ablage, Suche und Dokumenteingang sind für alle Fallarten identisch; nur die fachlichen Prüf- und Ausgabeformulare unterscheiden sich.</p>
      <div class="intern-actions" style="margin-top:16px;gap:10px;flex-wrap:wrap">
        <button class="sv-button sv-button-primary vf-tab is-active" type="button" data-vf-tab="sv">SV Schäden</button>
        <button class="sv-button sv-button-secondary vf-tab" type="button" data-vf-tab="gf">SV-GF Schäden</button>
        <button class="sv-button sv-button-secondary vf-tab" type="button" data-vf-tab="andere">Andere Versicherer</button>
        <a class="sv-button sv-button-secondary" href="/intern/">Zur Prüfportal-Übersicht</a>
      </div>
    </section>

    <section class="intern-card" style="margin-top:16px">
      <p class="sv-eyebrow">0 · Zentrale Google-Drive-Verbindung</p>
      <h2>Fallakte laden, suchen oder neu anlegen</h2>
      <p class="intern-meta">Zentrale Ablage: <strong>Meine Ablage / Schadenfälle Christian Wächter</strong>. Gesucht wird nach Schaden-Nr., Versicherungsschein-Nr., VN/Name, Ort oder Straße.</p>
      <div style="display:grid;grid-template-columns:minmax(280px,1fr) auto auto;gap:10px;align-items:end">
        <label><strong>Fallsuche</strong><input id="vf-case-search" class="vf-input" type="search" placeholder="Schaden-Nr., Name, Ort oder Straße" /></label>
        <button id="vf-case-search-btn" class="sv-button sv-button-primary" type="button">Suchen</button>
        <button id="vf-drive-sync" class="sv-button sv-button-secondary" type="button">Google Drive synchronisieren</button>
      </div>
      <div id="vf-drive-status" class="intern-alert intern-alert--info" style="margin-top:12px">Google-Drive-Verbindung wird beim ersten Zugriff geprüft.</div>
      <div id="vf-case-results" style="margin-top:12px"></div>
      <input id="vf-folder-id" type="hidden" value="" />
    </section>

    <section class="intern-card" style="margin-top:16px">
      <p class="sv-eyebrow">1 · Gemeinsame Falldaten</p>
      <h2>Fall anlegen / bearbeiten</h2>
      <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(230px,1fr));gap:12px">
        <label><strong>Schaden-Nr.</strong><input class="vf-input" id="vf-schaden" type="text" placeholder="z. B. 26-123456-7" /></label>
        <label><strong>Versicherungsschein-Nr.</strong><input class="vf-input" id="vf-vsnr" type="text" /></label>
        <label><strong>VN / Objekt</strong><input class="vf-input" id="vf-object" type="text" /></label>
        <label><strong>Ort</strong><input class="vf-input" id="vf-ort" type="text" /></label>
        <label><strong>Straße</strong><input class="vf-input" id="vf-strasse" type="text" /></label>
        <label><strong>Schadenart</strong><input class="vf-input" id="vf-type" type="text" placeholder="Leitungswasser, Sturm, Feuer ..." /></label>
        <label><strong>Aktuelle Schadenhöhe / Reserve</strong><input class="vf-input" id="vf-reserve" type="text" placeholder="EUR" /></label>
        <label><strong>Auftrag / Ansprechpartner</strong><input class="vf-input" id="vf-contact" type="text" /></label>
      </div>
      <div class="intern-actions" style="margin-top:14px;gap:10px;flex-wrap:wrap">
        <button id="vf-save-case" class="sv-button sv-button-primary" type="button">Fall in Google Drive speichern</button>
        <span id="vf-save-status" class="intern-meta"></span>
      </div>
    </section>

    <section class="intern-card" style="margin-top:16px">
      <div style="display:flex;justify-content:space-between;gap:16px;align-items:flex-start;flex-wrap:wrap">
        <div>
          <p class="sv-eyebrow">2 · Gemeinsamer Dokumenteingang</p>
          <h2 id="vf-title" style="margin-top:0">SV Schäden</h2>
          <p id="vf-description" class="intern-meta">Eingang und strukturierte Erfassung eines SV-Schadenfalls.</p>
        </div>
        <div class="intern-alert intern-alert--info" style="margin:0;max-width:470px">Diese sechs Eingänge sind für alle drei Fallarten identisch und werden immer derselben zentralen Fallakte zugeordnet.</div>
      </div>

      <div class="vf-grid" style="display:grid;grid-template-columns:repeat(auto-fit,minmax(360px,1fr));gap:14px;margin-top:18px">
        {[
          ['fallakte','Fallakte einlesen','Vollständige Fallakte KI-gestützt analysieren und strukturieren.'],
          ['kva','KVA einlesen','Kostenvoranschläge erkennen, Positionen strukturieren und für die spätere Prüfung bereitstellen.'],
          ['rechnungen','Rechnungen einlesen','Rechnungen erfassen und für Beleg-, Mengen- und Kostenprüfung vorbereiten.'],
          ['schriftverkehr','Schriftverkehr einlesen','Schreiben, Stellungnahmen und sonstige Korrespondenz fallbezogen erfassen.'],
          ['mails','Mails einlesen','E-Mail-Verkehr übernehmen und der Fallchronologie zuordnen.'],
          ['anweisungen','Anweisungen ausführen','Arbeits-, Regulierungs- und Auftraggeberanweisungen einlesen und fallbezogen ausführen.'],
        ].map(([key,title,text]) => (
          <article class="intern-card" style="margin:0;border:1px solid rgba(15,45,70,.13);box-shadow:none">
            <h3 style="margin-top:0">{title}</h3>
            <p class="intern-meta" style="min-height:44px">{text}</p>
            <label style="display:block;font-weight:700;margin-top:12px" for={`mode-${key}`}>Verarbeitung</label>
            <select id={`mode-${key}`} class="vf-select" style="width:100%;margin-top:6px;padding:11px 12px;border:1px solid #b8c8d6;border-radius:10px;background:#fff">
              <option value="ki">KI-gestützt auswerten und zur Fallakte</option>
              <option value="ablage">Nur in Fallakte ablegen</option>
              <option value="nachtrag">Als Nachtrag / neue Fassung auswerten</option>
              <option value="manuell">Manuell prüfen / zuordnen</option>
            </select>
            <input id={`file-${key}`} class="vf-file" data-kind={key} type="file" multiple hidden />
            <div class="intern-actions" style="margin-top:12px;gap:8px;align-items:center;flex-wrap:wrap">
              <button class="sv-button sv-button-primary vf-upload" type="button" data-file-target={`file-${key}`}>Hier hochladen</button>
              <span id={`status-${key}`} class="intern-meta">Noch keine Datei ausgewählt.</span>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="intern-card" style="margin-top:16px">
      <p class="sv-eyebrow">3 · Fallartspezifische Bearbeitung</p>
      <h2>Formulare und Ausgaben</h2>
      <div id="vf-output-info" class="intern-alert intern-alert--info"><strong>SV Schäden:</strong> Die spezifischen Prüf- und Ausgabeformulare werden hier separat ergänzt.</div>
      <div id="gf-entry" class="intern-actions" style="margin-top:14px" hidden>
        <a class="sv-button sv-button-primary" href="/intern/versicherungsfaelle/sv-gf/">SV-GF Formulare und Ausgaben öffnen</a>
      </div>
    </section>
  </main>

  <style>
    .vf-input{width:100%;margin-top:6px;padding:11px 12px;border:1px solid #b8c8d6;border-radius:10px;background:#fff;box-sizing:border-box}
    .vf-result{border:1px solid rgba(15,45,70,.14);border-radius:10px;padding:12px;margin-top:8px;display:flex;justify-content:space-between;gap:12px;align-items:center;flex-wrap:wrap}
  </style>

  <script is:inline>
    (() => {
      const API='/intern/api/google-drive-sync.php';
      const el=(id)=>document.getElementById(id);
      let activeType='SV';
      const labels={
        sv:{title:'SV Schäden',description:'Eingang und strukturierte Erfassung eines SV-Schadenfalls.',fallart:'SV'},
        gf:{title:'SV-GF Schäden',description:'Sparkassenversicherung GF / Großschäden nach QS-/Engel-Vorgaben.',fallart:'SV-GF'},
        andere:{title:'Andere Versicherer',description:'Eingang und strukturierte Erfassung von Schadenfällen anderer Versicherer.',fallart:'Andere Versicherer'}
      };
      async function api(url,options={}){const r=await fetch(url,{credentials:'same-origin',...options});const j=await r.json().catch(()=>({}));if(!r.ok)throw new Error(j.error||`HTTP ${r.status}`);return j;}
      const setDriveStatus=(text,type='info')=>{const n=el('vf-drive-status');if(!n)return;n.className=`intern-alert intern-alert--${type}`;n.textContent=text;};
      const caseData=()=>({
        schaden_nr:el('vf-schaden')?.value?.trim()||'',versicherungsschein_nr:el('vf-vsnr')?.value?.trim()||'',vn_objekt:el('vf-object')?.value?.trim()||'',ort:el('vf-ort')?.value?.trim()||'',strasse:el('vf-strasse')?.value?.trim()||'',schadenart:el('vf-type')?.value?.trim()||'',reserve:el('vf-reserve')?.value?.trim()||'',kontakt:el('vf-contact')?.value?.trim()||'',fallart:activeType
      });
      const fillCase=(meta={})=>{const map={schaden_nr:'vf-schaden',versicherungsschein_nr:'vf-vsnr',vn_objekt:'vf-object',ort:'vf-ort',strasse:'vf-strasse',schadenart:'vf-type',reserve:'vf-reserve',kontakt:'vf-contact'};Object.entries(map).forEach(([k,id])=>{const n=el(id);if(n)n.value=meta[k]||'';});if(meta.fallart)activeType=meta.fallart;};
      async function syncSources(){setDriveStatus('Google Drive wird geprüft …');try{const status=await api(`${API}?action=status`);const src=await api(`${API}?action=sync_sources`);const k=Object.keys(src.sources?.knowledge||{}).length;const b=Object.keys(src.sources?.blanco||{}).length;setDriveStatus(`Google Drive verbunden · Fälle: ${status.folders?.cases?.items??0} · Wissensbasis: ${k} Kernquellen · Blanco: ${b} Vorlagen`,'success');}catch(e){setDriveStatus(e.message,'warning');}}
      async function searchCases(){const q=el('vf-case-search')?.value?.trim()||'';const box=el('vf-case-results');if(box)box.innerHTML='<span class="intern-meta">Suche läuft …</span>';try{const data=await api(`${API}?action=search_cases&q=${encodeURIComponent(q)}`);if(!box)return;if(!data.results?.length){box.innerHTML='<div class="intern-alert intern-alert--info">Kein passender Fall gefunden.</div>';return;}box.innerHTML=data.results.map(r=>`<div class="vf-result"><div><strong>${r.meta?.schaden_nr||r.name}</strong><br><span class="intern-meta">${[r.meta?.vn_objekt,r.meta?.strasse,r.meta?.ort,r.meta?.fallart].filter(Boolean).join(' · ')}</span></div><button class="sv-button sv-button-secondary vf-load" data-id="${r.id}">Fall laden</button></div>`).join('');box.querySelectorAll('.vf-load').forEach(btn=>btn.addEventListener('click',async()=>{const d=await api(`${API}?action=load_case&id=${encodeURIComponent(btn.dataset.id)}`);el('vf-folder-id').value=d.case.id;fillCase(d.case.meta||{});sessionStorage.setItem('svnet-case',JSON.stringify({folder_id:d.case.id,meta:d.case.meta||{}}));setDriveStatus(`Fall geladen: ${d.case.meta?.schaden_nr||d.case.id}`,'success');}));}catch(e){if(box)box.innerHTML=`<div class="intern-alert intern-alert--warning">${e.message}</div>`;}}
      el('vf-case-search-btn')?.addEventListener('click',searchCases);el('vf-case-search')?.addEventListener('keydown',e=>{if(e.key==='Enter'){e.preventDefault();searchCases();}});el('vf-drive-sync')?.addEventListener('click',syncSources);
      el('vf-save-case')?.addEventListener('click',async()=>{const s=el('vf-save-status');if(s)s.textContent='Speichern …';try{const body={folder_id:el('vf-folder-id')?.value||'',case:caseData()};const d=await api(`${API}?action=save_case`,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(body)});el('vf-folder-id').value=d.folder_id;sessionStorage.setItem('svnet-case',JSON.stringify({folder_id:d.folder_id,meta:caseData()}));if(s)s.textContent='In Google Drive gespeichert.';setDriveStatus(`Aktiver Fall: ${caseData().schaden_nr||d.name}`,'success');}catch(e){if(s)s.textContent=e.message;}});
      document.querySelectorAll('.vf-tab').forEach(button=>button.addEventListener('click',()=>{const key=button.getAttribute('data-vf-tab')||'sv';const item=labels[key]||labels.sv;activeType=item.fallart;document.querySelectorAll('.vf-tab').forEach(b=>{b.classList.remove('is-active','sv-button-primary');b.classList.add('sv-button-secondary');});button.classList.add('is-active','sv-button-primary');button.classList.remove('sv-button-secondary');if(el('vf-title'))el('vf-title').textContent=item.title;if(el('vf-description'))el('vf-description').textContent=item.description;if(el('gf-entry'))el('gf-entry').hidden=key!=='gf';if(el('vf-output-info'))el('vf-output-info').innerHTML=key==='gf'?'<strong>SV-GF:</strong> Gemeinsame Fallakte bleibt hier. Im nächsten Schritt werden ausschließlich die Engel-/QS-spezifischen Formulare und Ausgaben gewählt.':`<strong>${item.title}:</strong> Die spezifischen Prüf- und Ausgabeformulare werden separat ergänzt.`;}));
      document.querySelectorAll('.vf-upload').forEach(button=>button.addEventListener('click',()=>{const target=button.getAttribute('data-file-target');if(target)el(target)?.click();}));
      document.querySelectorAll('.vf-file').forEach(input=>input.addEventListener('change',()=>{const kind=input.getAttribute('data-kind');const status=kind?el(`status-${kind}`):null;const count=input.files?.length||0;if(status)status.textContent=count?`${count} Datei/-en ausgewählt`:'Noch keine Datei ausgewählt.';}));
      try{const saved=JSON.parse(sessionStorage.getItem('svnet-case')||'null');if(saved?.meta){el('vf-folder-id').value=saved.folder_id||'';fillCase(saved.meta);}}catch{}
      syncSources();
    })();
  </script>
</InternalLayout>
