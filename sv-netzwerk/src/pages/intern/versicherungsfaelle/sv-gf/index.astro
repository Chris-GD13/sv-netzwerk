---
import InternalLayout from '../../../../layouts/InternalLayout.astro';
---

<InternalLayout title="SV-GF Schäden" description="Arbeitsablauf für Sparkassen-GF- und Großschäden.">
  <main class="intern-app" style="max-width:1320px;margin:0 auto;padding:24px">
    <section class="intern-card gf-head">
      <div><p class="sv-eyebrow">SV-GF Schäden</p><h1 style="margin-bottom:6px">GF-Fall bearbeiten</h1><div id="gf-current-case" class="intern-alert intern-alert--info">Aktiver Fall wird übernommen.</div></div>
      <a class="sv-button sv-button-secondary" href="/intern/versicherungsfaelle/?tab=gf">← Zur Fallakte</a>
    </section>

    <section class="intern-card" style="margin-top:16px">
      <p class="sv-eyebrow">1 · Neue Unterlagen</p><h2>Unterlagen zum aktiven Fall ergänzen</h2>
      <div class="gf-upload-row">
        <label><strong>Dokumentart</strong><select id="gf-document-kind" class="gf-select"><option value="gutachten">Gutachten</option><option value="kva">Kostenvoranschlag</option><option value="rechnungen">Rechnung / Beleg</option><option value="schriftverkehr">Schriftverkehr</option><option value="mails">E-Mail</option><option value="fallakte">Sonstige Fallunterlage</option></select></label>
        <label><strong>Verarbeitung</strong><select id="gf-document-mode" class="gf-select"><option value="nachtrag">Als neue Unterlage / Nachtrag berücksichtigen</option><option value="ki">KI-gestützt auswerten</option><option value="ablage">Nur zur Fallakte ablegen</option></select></label>
      </div>
      <input id="gf-document-files" type="file" multiple hidden />
      <div id="gf-document-drop" class="gf-drop" tabindex="0"><strong>Dateien hier hineinziehen</strong><span>oder klicken · direkt im aktiven Google-Drive-Fall speichern</span></div>
      <div id="gf-document-status" class="intern-meta" style="margin-top:8px">Noch keine neue Unterlage.</div>
    </section>

    <section class="intern-card" style="margin-top:16px">
      <p class="sv-eyebrow">2 · Arbeitsauftrag</p><h2>Was soll die KI mit den Unterlagen tun?</h2>
      <textarea id="gf-instructions" class="gf-textarea" placeholder="Beispiel: Auf Grundlage des nun vorliegenden Gutachtens ist der bereits angezweifelte KVA abzulehnen. Bitte einen Nachtrag mit nachvollziehbarer Begründung erstellen und darauf hinweisen, dass der VN durch die SV über die Ablehnung zu unterrichten ist."></textarea>
      <div class="gf-upload-row" style="margin-top:10px">
        <label><strong>Bearbeitungsart</strong><select id="gf-work-mode" class="gf-select"><option value="nachtrag">Nachtrag / neue Unterlagen prüfen</option><option value="vollpruefung">Vollständige Fallprüfung</option><option value="belegpruefung">Beleg- / Rechnungsprüfung</option><option value="abschluss">Abschluss / Schlussbearbeitung</option><option value="rueckfrage">Nur Rückfrage / offene Punkte</option></select></label>
        <label><strong>Offene Punkte</strong><select id="gf-open-points" class="gf-select"><option value="kennzeichnen">Klar kennzeichnen</option><option value="rueckfrage">Rückfragen formulieren</option><option value="beides">Kennzeichnen und Rückfragen</option></select></label>
      </div>
      <div class="intern-actions" style="margin-top:10px"><button id="gf-save-instructions" class="sv-button sv-button-secondary" type="button">Arbeitsauftrag speichern</button><span id="gf-instruction-status" class="intern-meta"></span></div>
    </section>

    <section class="intern-card" style="margin-top:16px">
      <p class="sv-eyebrow">3 · Dokumentpaket</p><h2>Was soll erstellt werden?</h2>
      <div class="gf-output-grid">
        {[
          ['erstbericht','Erstbericht'],['schadenprotokoll','Schadenprotokoll'],['schlusserklaerung','Schlusserklärung'],['zahlungsbefuerwortung','Zahlungsbefürwortung'],['nachtrag_stellungnahme','Nachtrag / Stellungnahme'],['zwischenbericht','Zwischenbericht'],['schlussbericht','Schlussbericht'],['vorauszahlung','Vorauszahlung / Freigabe'],['query_form','Rückfrageformular'],
        ].map(([key,title]) => (<label class="gf-output-item"><input class="gf-output" type="checkbox" value={key} /><strong>{title}</strong></label>))}
      </div>
      <div class="intern-alert intern-alert--info" style="margin-top:12px">Vor dem Start wird geprüft, ob Fall, Arbeitsauftrag und Google-Drive-Regelwerke tatsächlich verfügbar sind. Danach läuft die Dokumenterstellung serverseitig weiter; Browser- oder Proxy-Timeouts beenden den Auftrag nicht mehr.</div>
      <div class="intern-actions" style="margin-top:14px;gap:10px;flex-wrap:wrap"><button id="gf-prepare" class="sv-button sv-button-secondary" type="button">Auftrag prüfen</button><button id="gf-generate" class="sv-button sv-button-primary" type="button" disabled>KI-Dokumente erzeugen</button></div>
      <div id="gf-manifest" class="intern-alert intern-alert--info" style="margin-top:12px" hidden></div>
    </section>

    <details class="intern-card" style="margin-top:16px">
      <summary style="cursor:pointer;font-weight:800">Regelwerk und Vorlagen</summary>
      <div id="gf-source-state" class="intern-alert intern-alert--info" style="margin-top:12px">Google-Drive-Masterquellen werden geprüft.</div>
      <div id="gf-source-list" class="intern-meta" style="margin-top:10px"></div>
      <div class="intern-actions" style="margin-top:10px;gap:10px;flex-wrap:wrap"><a class="sv-button sv-button-secondary" href="https://drive.google.com/drive/folders/1QeJ4Dz6Upg_W5rahWmKE_7KbC4MMgSGe" target="_blank" rel="noreferrer">Wissensbasis</a><a class="sv-button sv-button-secondary" href="https://drive.google.com/drive/folders/1_3p6moLBt3cD5Gzy9jvPw3BXpqnAvl2k" target="_blank" rel="noreferrer">Blanco-Vorlagen</a></div>
    </details>
    <div class="intern-actions" style="margin-top:16px"><a class="sv-button sv-button-secondary" href="/intern/versicherungsfaelle/?tab=gf">← Zur Fallakte</a></div>
  </main>

  <style>
    .gf-head{display:flex;justify-content:space-between;gap:18px;align-items:flex-start}.gf-head>div{flex:1}.gf-upload-row{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}.gf-select{width:100%;margin-top:6px;padding:10px 11px;border:1px solid #b8c8d6;border-radius:10px;background:#fff}.gf-drop{margin-top:12px;border:2px dashed #b8c8d6;border-radius:12px;padding:18px;text-align:center;cursor:pointer;background:#f8fbfd;display:flex;flex-direction:column;gap:3px}.gf-drop.is-dragging{border-color:#ff970f;background:#fff7eb}.gf-drop span{font-size:.92rem;color:#63768a}.gf-textarea{width:100%;min-height:150px;box-sizing:border-box;padding:12px;border:1px solid #b8c8d6;border-radius:10px;resize:vertical;font:inherit;line-height:1.45}.gf-output-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(210px,1fr));gap:8px}.gf-output-item{display:flex;align-items:center;gap:9px;border:1px solid rgba(15,45,70,.14);border-radius:10px;padding:11px 12px;background:#fff;cursor:pointer;min-height:44px}.gf-output-item input{transform:scale(1.15)}@media(max-width:760px){.gf-head{display:block}.gf-head>a{margin-top:12px}.gf-upload-row{grid-template-columns:1fr}}
  </style>

  <script is:inline>
    (()=>{
      const API='/intern/api/google-drive-sync.php',AI_API='/intern/api/gf-ai-generate.php',SOURCE_API='/intern/api/gf-ai-sources.php',el=id=>document.getElementById(id),current=el('gf-current-case'),state=el('gf-source-state'),sourceList=el('gf-source-list'),generate=el('gf-generate'),instructions=el('gf-instructions'),workMode=el('gf-work-mode'),openPoints=el('gf-open-points'),instructionStatus=el('gf-instruction-status');
      let caseData=null,sources={knowledge:[],blanco:[]},sourcesReady=false,prepared=false,pollTimer=null;
      for(const store of [sessionStorage,localStorage]){try{const d=JSON.parse(store.getItem('svnet-case')||'null');if(d?.folder_id){caseData=d;break;}}catch{}}
      localStorage.setItem('svnet-vf-tab','gf');if(caseData){sessionStorage.setItem('svnet-case',JSON.stringify(caseData));localStorage.setItem('svnet-case',JSON.stringify(caseData));}
      const orderKey=()=>`svnet-gf-order:${caseData?.folder_id||caseData?.meta?.schaden_nr||'draft'}`,jobKey=()=>`svnet-gf-job:${caseData?.folder_id||'none'}`;
      function readOrder(){try{return JSON.parse(localStorage.getItem(orderKey())||'null');}catch{return null;}}
      function collectOrder(){return{instructions:instructions?.value?.trim()||'',work_mode:workMode?.value||'nachtrag',open_points:openPoints?.value||'kennzeichnen',outputs:[...document.querySelectorAll('.gf-output:checked')].map(n=>n.value),saved_at:new Date().toISOString(),case_folder_id:caseData?.folder_id||'',schaden_nr:caseData?.meta?.schaden_nr||''};}
      function saveOrder(show=true){const o=collectOrder();localStorage.setItem(orderKey(),JSON.stringify(o));sessionStorage.setItem('svnet-gf-order',JSON.stringify(o));prepared=false;if(generate)generate.disabled=true;if(show&&instructionStatus)instructionStatus.textContent='Arbeitsauftrag gespeichert.';return o;}
      const stored=readOrder();if(stored){instructions.value=stored.instructions||'';if(stored.work_mode)workMode.value=stored.work_mode;if(stored.open_points)openPoints.value=stored.open_points;document.querySelectorAll('.gf-output').forEach(n=>n.checked=Array.isArray(stored.outputs)&&stored.outputs.includes(n.value));}else if(caseData?.meta?.anweisung){instructions.value=caseData.meta.anweisung;}
      if(current){if(caseData?.folder_id){const m=caseData.meta||{};current.className='intern-alert intern-alert--success';current.innerHTML=`<strong>Aktiver Fall:</strong> ${m.schaden_nr||'ohne Schaden-Nr.'}${m.vn_objekt?` · ${m.vn_objekt}`:''}${m.ort?` · ${m.ort}`:''}`;}else{current.className='intern-alert intern-alert--warning';current.innerHTML='<strong>Kein aktiver Fall.</strong> Bitte über „Zur Fallakte“ zuerst einen Fall öffnen oder anlegen.';}}
      async function api(url,options={}){const r=await fetch(url,{credentials:'same-origin',...options});const j=await r.json().catch(()=>({}));if(!r.ok)throw new Error(j.error||`HTTP ${r.status}`);return j;}
      async function uploadFiles(files){const status=el('gf-document-status');if(!caseData?.folder_id){status.textContent='Bitte zuerst einen Fall öffnen oder anlegen.';return;}if(!files?.length)return;let done=0;for(const file of files){status.textContent=`${done+1}/${files.length} wird in den aktiven Fall geladen: ${file.name}`;const fd=new FormData();fd.append('folder_id',caseData.folder_id);fd.append('kind',el('gf-document-kind')?.value||'fallakte');fd.append('mode',el('gf-document-mode')?.value||'nachtrag');fd.append('file',file);try{await api(`${API}?action=upload_case_document`,{method:'POST',body:fd});done++;}catch(e){status.textContent=`Upload fehlgeschlagen: ${e.message}`;return;}}status.textContent=`${done} Datei/-en im aktiven Google-Drive-Fall gespeichert.`;prepared=false;if(generate)generate.disabled=true;}
      const fileInput=el('gf-document-files'),drop=el('gf-document-drop');drop?.addEventListener('click',()=>fileInput?.click());fileInput?.addEventListener('change',()=>uploadFiles(fileInput.files));['dragenter','dragover'].forEach(t=>drop?.addEventListener(t,e=>{e.preventDefault();drop.classList.add('is-dragging');}));['dragleave','drop'].forEach(t=>drop?.addEventListener(t,e=>{e.preventDefault();drop.classList.remove('is-dragging');}));drop?.addEventListener('drop',e=>uploadFiles(e.dataTransfer?.files));
      el('gf-save-instructions')?.addEventListener('click',()=>saveOrder(true));document.querySelectorAll('.gf-output').forEach(n=>n.addEventListener('change',()=>saveOrder(false)));workMode?.addEventListener('change',()=>saveOrder(false));openPoints?.addEventListener('change',()=>saveOrder(false));instructions?.addEventListener('input',()=>{prepared=false;if(generate)generate.disabled=true;});

      async function loadSources(){try{const src=await api(SOURCE_API);sources.knowledge=src.knowledge||[];sources.blanco=src.blanco||[];sourcesReady=sources.knowledge.length>0;state.className=`intern-alert ${sourcesReady?'intern-alert--success':'intern-alert--warning'}`;state.textContent=sourcesReady?`Regelwerk verbunden · ${sources.knowledge.length} Wissensquellen · ${sources.blanco.length} Vorlagen.`:'Keine Wissensquellen gefunden. KI-Erstellung bleibt gesperrt.';const names=sources.knowledge.slice(0,12).map(f=>`<li>${String(f.path||f.name||'').replace(/[<>&]/g,'')}</li>`).join('');sourceList.innerHTML=names?`<strong>Erkannte Regelwerke:</strong><ul>${names}</ul>${sources.knowledge.length>12?`<div>… und ${sources.knowledge.length-12} weitere.</div>`:''}`:'';}catch(e){sourcesReady=false;state.className='intern-alert intern-alert--warning';state.textContent=e.message;}}
      async function preflight(){const o=saveOrder(false),box=el('gf-manifest'),errors=[];if(!caseData?.folder_id)errors.push('kein aktiver Fall');if(!o.instructions)errors.push('Arbeitsauftrag fehlt');if(!o.outputs.length)errors.push('kein Dokument ausgewählt');if(!sourcesReady)errors.push('keine Regelwerke verbunden');box.hidden=false;if(errors.length){prepared=false;generate.disabled=true;box.className='intern-alert intern-alert--warning';box.innerHTML=`<strong>Auftrag noch nicht startklar:</strong> ${errors.join(' · ')}`;return false;}prepared=true;generate.disabled=false;const names=[...document.querySelectorAll('.gf-output:checked')].map(n=>n.closest('label')?.querySelector('strong')?.textContent||n.value);box.className='intern-alert intern-alert--success';box.innerHTML=`<strong>Startklar.</strong> Fall: ${caseData?.meta?.schaden_nr||''} · Ausgaben: ${names.join(', ')} · ${sources.knowledge.length} Regelwerke erkannt.`;return true;}
      el('gf-prepare')?.addEventListener('click',preflight);

      function renderDone(result){const box=el('gf-manifest'),links=(result?.created||[]).map(f=>`<li><a href="${f.webViewLink||'#'}" target="_blank" rel="noreferrer"><strong>${String(f.name||'Dokument').replace(/[<>&]/g,'')}</strong></a></li>`).join('');box.hidden=false;box.className='intern-alert intern-alert--success';box.innerHTML=`<strong>${result?.count||0} KI-Dokument(e) erstellt und im Fallordner gespeichert.</strong><br><span class="intern-meta">Fallunterlagen: ${(result?.sources||[]).length} · Regelwerke: ${(result?.rules||[]).length}${result?.bki_used?' · BKI verwendet':''}</span>${links?`<ul>${links}</ul>`:''}`;generate.disabled=false;generate.textContent='KI-Dokumente erzeugen';}
      async function pollJob(jobId){if(pollTimer)clearTimeout(pollTimer);try{const r=await api(AI_API,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({action:'status',job_id:jobId})}),job=r.job,box=el('gf-manifest');box.hidden=false;if(job.status==='done'){localStorage.removeItem(jobKey());renderDone(job.result||{});return;}if(job.status==='failed'){localStorage.removeItem(jobKey());box.className='intern-alert intern-alert--warning';box.innerHTML=`<strong>KI-Auftrag fehlgeschlagen.</strong> ${String(job.error_text||job.message||'Unbekannter Fehler').replace(/[<>&]/g,'')}`;generate.disabled=false;generate.textContent='KI-Dokumente erzeugen';return;}box.className='intern-alert intern-alert--info';box.innerHTML=`<strong>KI-Auftrag läuft serverseitig: ${job.progress||0}%</strong><br>${String(job.message||'Verarbeitung läuft.').replace(/[<>&]/g,'')}<br><span class="intern-meta">Du kannst die Seite geöffnet lassen; ein Proxy-Timeout beendet den Auftrag nicht.</span>`;generate.disabled=true;generate.textContent=`KI läuft · ${job.progress||0}%`;pollTimer=setTimeout(()=>pollJob(jobId),2500);}catch(e){el('gf-manifest').innerHTML=`<strong>Statusabfrage vorübergehend fehlgeschlagen.</strong> ${e.message}`;pollTimer=setTimeout(()=>pollJob(jobId),5000);}}
      generate?.addEventListener('click',async()=>{if(!prepared&&!(await preflight()))return;const o=saveOrder(false),box=el('gf-manifest');generate.disabled=true;generate.textContent='KI-Auftrag wird gestartet …';try{const result=await api(AI_API,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({action:'start',folder_id:caseData.folder_id,order:o})});if(!result.job_id)throw new Error('Kein KI-Auftrag angelegt.');localStorage.setItem(jobKey(),String(result.job_id));box.hidden=false;box.className='intern-alert intern-alert--info';box.innerHTML='<strong>KI-Auftrag angenommen.</strong> Die Verarbeitung läuft jetzt serverseitig.';pollJob(result.job_id);}catch(e){box.hidden=false;box.className='intern-alert intern-alert--warning';box.textContent=e.message;generate.disabled=false;generate.textContent='KI-Dokumente erzeugen';}});
      (async()=>{await loadSources();const oldJob=Number(localStorage.getItem(jobKey())||0);if(oldJob>0)pollJob(oldJob);})();
    })();
  </script>
</InternalLayout>
