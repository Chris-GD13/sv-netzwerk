---
import InternalLayout from '../../../layouts/InternalLayout.astro';
---
<InternalLayout title="Spesen & Reisekosten" description="Spesen erfassen, genehmigen und monatlich im DATEV-kompatiblen Format versenden." currentPath="/intern/spesen/">
  <main class="spesen-page">
    <header class="spesen-head">
      <div><p class="eyebrow">SV-Netzwerk · internes Portal</p><h1>Spesen & Reisekosten</h1><p>Reisen, Belege und Kilometer zentral erfassen, prüfen und als DATEV-kompatible Spesenfuchs-Datei ausgeben.</p></div>
      <div class="head-actions"><button class="primary" data-view="trip" data-new="true">+ Reise erfassen</button><button data-view="expense">+ Beleg erfassen</button></div>
    </header>
    <div id="sp-state" class="state" hidden></div>
    <section class="stats" aria-label="Spesenübersicht">
      <article><span>Monat gesamt</span><strong id="sp-stat-month">–</strong><small>Erfasste Beträge</small></article>
      <article><span>Offene Entwürfe</span><strong id="sp-stat-drafts">–</strong><small>Reisen zur Bearbeitung</small></article>
      <article><span>Zur Prüfung</span><strong id="sp-stat-pending">–</strong><small>Eingereichte Reisen</small></article>
    </section>
    <nav class="tabs" aria-label="Spesenbereiche"><button class="active" data-view="dashboard">Übersicht</button><button data-view="trip">Reise</button><button data-view="expense">Beleg</button><button data-view="approvals" id="sp-approval-tab" hidden>Freigaben</button><button data-view="export">Export</button></nav>

    <section class="view active" data-panel="dashboard"><div class="section-head"><div><h2>Meine Reisen</h2><p>Entwürfe können ergänzt und anschließend eingereicht werden.</p></div><button class="primary" data-view="trip" data-new="true">Neue Reise</button></div><div class="table-wrap"><table><thead><tr><th>Reise</th><th>Zeitraum</th><th>Route</th><th>Status</th><th class="num">Summe</th><th></th></tr></thead><tbody id="sp-trips"><tr><td colspan="6">Wird geladen …</td></tr></tbody></table></div></section>

    <section class="view" data-panel="trip" hidden><div class="section-head"><div><h2 id="trip-heading">Reise erfassen</h2><p>Angaben nach der Vorlage von Spesenfuchs. Pauschalen bleiben je Reise anpassbar.</p></div><button data-view="dashboard">Zur Übersicht</button></div><form id="trip-form" class="form-grid">
      <input id="trip-id" type="hidden" />
      <label class="wide">Bezeichnung *<input id="trip-title" required maxlength="190" placeholder="z. B. Kundenbesuche Oktober" /></label>
      <label>Zweck<input id="trip-purpose" maxlength="500" placeholder="Kundenbesuche, Projekttermin …" /></label><label>Kostenstelle<input id="trip-cost-center" maxlength="120" placeholder="optional" /></label>
      <label>Startort<input id="trip-origin" maxlength="190" /></label><label>Zielorte<input id="trip-destination" maxlength="190" /></label><label class="wide">Zwischenstopps<input id="trip-stops" maxlength="1000" placeholder="optional, mit Komma trennen" /></label>
      <label>Beginn *<input id="trip-start" type="date" required /></label><label>Ende *<input id="trip-end" type="date" required /></label><div class="wide calendar-prefill"><button type="button" id="trip-calendar-fill">Outlook-Kalender übernehmen</button><small id="trip-calendar-state">Besuche und Reisezeiten können danach jederzeit geändert werden.</small></div><label>Startzeit<input id="trip-start-time" type="time" /></label><label>Endzeit<input id="trip-end-time" type="time" /></label>
      <label>Land<input id="trip-country" value="DE" maxlength="2" /></label><label>Übernachtungspauschale<input id="trip-overnight" type="number" step="0.01" value="20.00" /></label><label class="overnight-check"><input id="trip-overnight-enabled" type="checkbox" checked /> Übernachtungspauschale ansetzen</label><label>Volle Tagespauschale<input id="trip-full" type="number" step="0.01" value="28.00" /></label><label>Teilpauschale<input id="trip-partial" type="number" step="0.01" value="14.00" /></label><label>Kilometer<input id="trip-km" type="number" step="0.1" value="0" /></label><label>Km-Satz<input id="trip-km-rate" type="number" step="0.001" value="0.30" /></label>
      <fieldset class="wide meals"><legend>Gestellte Mahlzeiten</legend><label><input id="meal-breakfast" type="checkbox" /> Frühstück</label><label><input id="meal-lunch" type="checkbox" /> Mittagessen</label><label><input id="meal-dinner" type="checkbox" /> Abendessen</label></fieldset>
      <label class="wide">Notiz<input id="trip-notes" maxlength="2000" placeholder="optional" /></label>
      <aside class="estimate wide"><strong>Vorschau</strong><span><b id="est-days">0</b> Tage</span><span>Tagespauschalen <b id="est-perdiem">0,00 €</b></span><span>Kilometer <b id="est-mileage">0,00 €</b></span><span>Belege <b id="est-expenses">0,00 €</b></span><span class="total">Gesamt <b id="est-total">0,00 €</b></span></aside>
      <div class="form-actions wide"><button class="primary" type="submit">Reise speichern</button><button type="button" id="trip-submit" hidden>Reise einreichen</button></div>
    </form><section id="trip-expenses" class="embedded" hidden><div class="section-head"><div><h3>Belege dieser Reise</h3><p>Belege werden erst mit der Reise eingereicht.</p></div><button data-view="expense" id="trip-add-expense">Beleg hinzufügen</button></div><div id="trip-expense-list"></div></section></section>

    <section class="view" data-panel="expense" hidden><div class="section-head"><div><h2>Beleg erfassen</h2><p>Rechnung, Bewirtung, Fahrt, Parken oder sonstiger Aufwand.</p></div><button data-view="dashboard">Zur Übersicht</button></div><form id="expense-form" class="form-grid"><input id="expense-id" type="hidden" /><label class="wide">Reise<select id="expense-trip"><option value="">Ohne Reise</option></select></label><label>Belegdatum *<input id="expense-date" type="date" required /></label><label>Art<select id="expense-category"><option value="hotel">Übernachtung</option><option value="verpflegung">Verpflegung</option><option value="fahrt">Fahrt</option><option value="parkmaut">Parken / Maut</option><option value="bewirtung">Bewirtung</option><option value="sonstiges">Sonstiges</option></select></label><label>Händler / Empfänger<input id="expense-merchant" maxlength="190" /></label><label>Zahlungsart<select id="expense-payment"><option value="privat">Privat ausgelegt</option><option value="karte">Firmenkarte</option><option value="bar">Barkasse</option><option value="direkt">Direkt bezahlt</option></select></label><label>Betrag *<input id="expense-amount" type="number" step="0.01" required /></label><label>Währung<input id="expense-currency" value="EUR" maxlength="3" /></label><label>Kurs<input id="expense-rate" type="number" step="0.000001" value="1" /></label><label>MwSt. %<input id="expense-vat" type="number" step="0.01" placeholder="z. B. 19" /></label><label>Kilometer<input id="expense-km" type="number" step="0.1" value="0" /></label><label>Km-Satz<input id="expense-km-rate" type="number" step="0.001" value="0.30" /></label><label class="wide">Beschreibung<input id="expense-description" maxlength="500" /></label><div class="wide receipt-picker"><strong>Belegdatei</strong><div class="receipt-actions"><button type="button" id="receipt-file">Datei auswählen</button><button type="button" id="receipt-photo">Foto auswählen</button><button type="button" id="receipt-camera" class="primary">Kamera öffnen</button></div><input id="receipt-file-input" type="file" accept="application/pdf,image/jpeg,image/png,image/webp" hidden /><input id="receipt-photo-input" type="file" accept="image/*" hidden /><input id="receipt-camera-input" type="file" accept="image/*" capture="environment" hidden /><small id="receipt-name">Noch kein Beleg ausgewählt. Nach dem Speichern wird er hochgeladen und verarbeitet. PDF, JPG, PNG oder WEBP, maximal 15 MB.</small></div><div class="form-actions wide"><button class="primary" type="submit">Beleg speichern</button><button type="button" id="expense-new">Neuer Beleg</button></div></form></section>

    <section class="view" data-panel="approvals" hidden><div class="section-head"><div><h2>Freigaben</h2><p>Eingereichte Reisen prüfen und mit einer Notiz entscheiden.</p></div></div><div class="table-wrap"><table><thead><tr><th>Reise</th><th>Person</th><th>Zeitraum</th><th class="num">Summe</th><th></th></tr></thead><tbody id="sp-approvals"><tr><td colspan="5">Keine offenen Freigaben.</td></tr></tbody></table></div></section>

    <section class="view" data-panel="export" hidden><div class="section-head"><div><h2>Export & Versand</h2><p>Die Monatsdatei entspricht dem geprüften Spesenfuchs-Export: UTF‑8 mit BOM, Semikolon, CSV und TXT im ZIP.</p></div></div><div class="export-card"><div class="form-grid"><label>Von<input id="export-from" type="date" /></label><label>Bis<input id="export-to" type="date" /></label><label>Status<select id="export-status"><option value="approved">Freigegeben</option><option value="submitted">Eingereicht</option><option value="">Alle</option></select></label></div><div class="form-actions"><a id="export-csv" class="button primary" href="#">CSV herunterladen</a><button id="export-monthly" class="primary" type="button" hidden>DATEV-ZIP jetzt senden</button></div><p id="export-result" class="state" hidden></p></div><div class="note"><strong>Automatik:</strong> Am letzten Kalendertag wird die freigegebene Monatsdatei an <b>ms@sv-schuett.eu</b> und mit CC an <b>cw@sv-schuett.eu</b> gesendet. Der Versand ist idempotent und wird pro Monat nur einmal ausgelöst.</div></section>
  </main>
</InternalLayout>
<style is:global>
.spesen-page{padding:28px;max-width:1500px;margin:0 auto;color:#17324a}.spesen-head{display:flex;justify-content:space-between;gap:22px;align-items:flex-end}.eyebrow{margin:0;color:#ef941d;font-weight:900}.spesen-head h1{margin:5px 0;font-size:clamp(1.8rem,4vw,2.7rem)}.spesen-head p{margin:0;color:#607486;max-width:760px}.head-actions,.form-actions{display:flex;gap:9px;flex-wrap:wrap}.spesen-page button,.spesen-page .button{border:1px solid #17324a;background:#fff;color:#17324a;padding:10px 14px;font:inherit;font-weight:800;cursor:pointer;text-decoration:none}.spesen-page button.primary,.spesen-page .button.primary{background:#17324a;color:#fff}.state{padding:11px 14px;border-left:4px solid #ef941d;background:#fff8ec;margin:16px 0}.state.error{border-color:#b33a3a;background:#fff0f0}.stats{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;margin:24px 0}.stats article{background:#fff;border:1px solid #d4dce2;border-top:4px solid #ef941d;padding:16px}.stats span,.stats small{display:block;color:#607486}.stats strong{display:block;margin:8px 0;font-size:1.65rem}.tabs{display:flex;gap:7px;flex-wrap:wrap;border-bottom:1px solid #d4dce2;margin-bottom:22px}.tabs button{border-bottom:0}.tabs button.active{background:#17324a;color:#fff}.view{background:#fff;border:1px solid #d4dce2;padding:20px}.section-head{display:flex;align-items:flex-start;justify-content:space-between;gap:18px;margin-bottom:16px}.section-head h2,.section-head h3{margin:0 0 4px}.section-head p{margin:0;color:#607486}.table-wrap{overflow:auto;border:1px solid #d4dce2}.table-wrap table{width:100%;border-collapse:collapse;min-width:720px}.table-wrap th{background:#17324a;color:#fff;text-align:left;padding:10px}.table-wrap td{padding:10px;border-bottom:1px solid #e5eaed}.table-wrap tbody tr:nth-child(even){background:#f7f9fa}.num{text-align:right}.status{display:inline-block;padding:4px 7px;border-radius:999px;font-size:.8rem;font-weight:800;background:#edf1f4}.status.approved{background:#e6f4e9;color:#246b36}.status.submitted{background:#fff1d8;color:#8c5c00}.status.rejected{background:#fde7e7;color:#963636}.form-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:14px}.form-grid label{display:grid;gap:6px;font-weight:800}.form-grid input,.form-grid select{box-sizing:border-box;width:100%;padding:10px;border:1px solid #bcc8d1;background:#fff;color:#17324a;font:inherit}.wide{grid-column:1/-1}.meals{border:1px solid #d4dce2;padding:12px;display:flex;gap:16px;flex-wrap:wrap}.overnight-check{display:flex!important;align-items:center;gap:6px}.overnight-check input{width:auto}.calendar-prefill{display:flex;align-items:center;gap:10px;flex-wrap:wrap}.calendar-prefill small{color:#607486}.meals legend{font-weight:800}.meals label{display:flex;align-items:center;gap:6px;font-weight:600}.estimate{display:flex;gap:16px;align-items:center;flex-wrap:wrap;border-left:4px solid #ef941d;background:#fff8ec;padding:14px}.estimate strong{margin-right:auto}.estimate .total{font-size:1.1rem}.embedded{border-top:1px solid #d4dce2;margin-top:26px;padding-top:22px}.expense-row{display:flex;justify-content:space-between;gap:16px;padding:11px;border:1px solid #d4dce2;margin:7px 0}.expense-row small{display:block;color:#607486}.receipt-picker{display:grid;gap:9px;padding:14px;border:1px solid #d4dce2;background:#f8fafb}.receipt-picker strong{font-weight:800}.receipt-actions{display:flex;gap:9px;flex-wrap:wrap}.receipt-actions button{min-height:44px}.receipt-picker small{color:#607486}.note{margin-top:18px;padding:14px;background:#f5f7f8;border-left:4px solid #ef941d}.export-card{border:1px solid #d4dce2;padding:18px}.export-card .form-grid{grid-template-columns:repeat(3,1fr);margin-bottom:18px}.export-card .state{margin-bottom:0}@media(max-width:900px){.spesen-page{padding:16px}.spesen-head{flex-direction:column;align-items:flex-start}.stats{grid-template-columns:1fr}.form-grid,.export-card .form-grid{grid-template-columns:1fr}.wide{grid-column:auto}.meals,.estimate{align-items:flex-start;flex-direction:column}.estimate strong{margin-right:0}.receipt-actions{display:grid;grid-template-columns:1fr}.receipt-actions button{width:100%}}
</style>
<script is:inline>
(() => {
  const API='/intern/api/spesen.php';
  const $=id=>document.getElementById(id); const esc=v=>String(v??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
  const money=v=>new Intl.NumberFormat('de-DE',{style:'currency',currency:'EUR'}).format(Number(v)||0);
  const state=$('sp-state'); let summary=null, currentTrip=null, selectedReceipt=null;
  const msg=(text,error=false,target=state)=>{target.textContent=text;target.hidden=!text;target.classList.toggle('error',error)};
  async function request(url,options={}){const r=await fetch(url,{credentials:'same-origin',...options});let j={};try{j=await r.json()}catch{}if(!r.ok||j.ok===false)throw new Error(j.error||`Fehler ${r.status}`);return j}
  function status(s){return `<span class="status ${esc(s)}">${({draft:'Entwurf',submitted:'Eingereicht',approved:'Freigegeben',rejected:'Abgelehnt'}[s]||s)}</span>`}
  function view(name){document.querySelectorAll('[data-panel]').forEach(p=>p.hidden=p.dataset.panel!==name);document.querySelectorAll('.tabs button').forEach(b=>b.classList.toggle('active',b.dataset.view===name));if(name==='export')updateExportLink()}
  document.querySelectorAll('[data-view]').forEach(b=>b.addEventListener('click',()=>{if(b.dataset.new==='true'){tripForm();fillFromCalendar()}view(b.dataset.view)}));
  function set(id,v=''){ $(id).value=v??'' };
  const CAL='/intern/api/outlook-case-calendar.php';
  const pad=n=>String(n).padStart(2,'0'); const localIso=d=>`${d.getFullYear()}-${pad(d.getMonth()+1)}-${pad(d.getDate())}`;
  const monday=d=>{const x=new Date(d);x.setHours(12,0,0,0);const day=x.getDay()||7;x.setDate(x.getDate()-day+1);return x};
  function easter(y){const a=y%19,b=Math.floor(y/100),c=y%100,d=Math.floor(b/4),e=b%4,f=Math.floor((b+8)/25),g=Math.floor((b-f+1)/3),h=(19*a+b-d-g+15)%30,i=Math.floor(c/4),k=c%4,l=(32+2*e+2*i-h-k)%7,m=Math.floor((a+11*h+22*l)/451),month=Math.floor((h+l-7*m+114)/31),day=((h+l-7*m+114)%31)+1;return new Date(y,month-1,day)}
  function holiday(d){const y=d.getFullYear(),key=localIso(d),e=easter(y),fixed=[`${y}-01-01`,`${y}-01-06`,`${y}-05-01`,`${y}-10-03`,`${y}-11-01`,`${y}-12-25`,`${y}-12-26`];return fixed.includes(key)||[ -2,1,39,50,60].some(n=>{const x=new Date(e);x.setDate(x.getDate()+n);return localIso(x)===key})}
  async function fillFromCalendar(){const state=$('trip-calendar-state');state.textContent='Outlook-Termine werden geladen …';try{const m=monday(new Date()),d=await request(`${CAL}?action=list&start=${encodeURIComponent(localIso(m))}`),events=(d.events||[]).filter(e=>e.start&&!e.all_day);let end=new Date(m);end.setDate(end.getDate()+4);while(holiday(end)&&end>m)end.setDate(end.getDate()-1);const inWeek=events.filter(e=>{const x=new Date(e.start);return x>=m&&x<new Date(end.getFullYear(),end.getMonth(),end.getDate()+1)});if(inWeek.length){const first=new Date(Math.min(...inWeek.map(e=>new Date(e.start).getTime()))),last=new Date(Math.max(...inWeek.map(e=>new Date(e.end||e.start).getTime())));set('trip-start',localIso(m));set('trip-end',localIso(end));set('trip-start-time',`${pad(first.getHours())}:${pad(first.getMinutes())}`);set('trip-end-time',`${pad(last.getHours())}:${pad(last.getMinutes())}`);set('trip-destination',inWeek.map(e=>e.location||e.subject).filter(Boolean).join(', '));set('trip-stops',inWeek.map(e=>e.subject).filter(Boolean).join(', '));set('trip-title',`Kalenderwoche ${m.toLocaleDateString('de-DE',{week:'numeric'})}`)}else{set('trip-start',localIso(m));set('trip-end',localIso(end));set('trip-start-time','07:43');set('trip-end-time','16:17')}state.textContent=`${inWeek.length} Outlook-Besuche übernommen. Alle Felder bleiben änderbar.`}catch(e){state.textContent=`Outlook konnte nicht geladen werden: ${e.message}`}}
  function tripForm(t=null){currentTrip=t; $('trip-heading').textContent=t?'Reise bearbeiten':'Reise erfassen'; set('trip-id',t?.id||''); set('trip-title',t?.title||'');set('trip-purpose',t?.purpose||'');set('trip-cost-center',t?.cost_center||'');set('trip-origin',t?.origin||'');set('trip-destination',t?.destination||'');set('trip-stops',t?.intermediate_stops||'');set('trip-start',t?.starts_on||'');set('trip-end',t?.ends_on||'');set('trip-start-time',t?.start_time||'');set('trip-end-time',t?.end_time||'');set('trip-country',t?.country_code||'DE');set('trip-overnight',t?.overnight_rate??20);$('trip-overnight-enabled').checked=t?.overnight_enabled!==0;set('trip-full',t?.per_diem_full??28);set('trip-partial',t?.per_diem_partial??14);set('trip-km',t?.mileage_km??0);set('trip-km-rate',t?.mileage_rate??.3);set('trip-notes',t?.notes||'');$('meal-breakfast').checked=!!Number(t?.meal_breakfast);$('meal-lunch').checked=!!Number(t?.meal_lunch);$('meal-dinner').checked=!!Number(t?.meal_dinner);$('trip-submit').hidden=!t||!['draft','rejected'].includes(t.status);$('trip-expenses').hidden=!t;renderExpenses(t?.expenses||[]);calc()}
  async function loadSummary(){try{summary=await request(`${API}?action=summary`);$('sp-stat-month').textContent=money(summary.stats.month_total);$('sp-stat-drafts').textContent=summary.stats.drafts;$('sp-stat-pending').textContent=summary.stats.pending;$('sp-approval-tab').hidden=!summary.is_approver;renderTrips();renderApprovals();populateTripSelect();msg('')}catch(e){msg(e.message,true)}}
  function renderTrips(){const rows=summary?.trips||[];$('sp-trips').innerHTML=rows.length?rows.map(t=>`<tr><td><b>${esc(t.title)}</b><br><small>${esc(t.user_name||'')}</small></td><td>${esc(t.starts_on)}<br>${esc(t.ends_on)}</td><td>${esc([t.origin,t.destination].filter(Boolean).join(' → '))}</td><td>${status(t.status)}</td><td class="num">${money(t.estimate?.total)}</td><td><button data-open="${t.id}">Öffnen</button></td></tr>`).join(''):'<tr><td colspan="6">Noch keine Reisen erfasst.</td></tr>';document.querySelectorAll('[data-open]').forEach(b=>b.addEventListener('click',()=>openTrip(b.dataset.open)))}
  function renderApprovals(){const rows=(summary?.trips||[]).filter(t=>t.status==='submitted');$('sp-approvals').innerHTML=rows.length?rows.map(t=>`<tr><td>${esc(t.title)}</td><td>${esc(t.user_name||'')}</td><td>${esc(t.starts_on)} – ${esc(t.ends_on)}</td><td class="num">${money(t.estimate?.total)}</td><td><button data-decide="${t.id}" data-choice="approved">Freigeben</button> <button data-decide="${t.id}" data-choice="rejected">Ablehnen</button></td></tr>`).join(''):'<tr><td colspan="5">Keine offenen Freigaben.</td></tr>';document.querySelectorAll('[data-decide]').forEach(b=>b.addEventListener('click',()=>decide(b.dataset.decide,b.dataset.choice)))}
  function populateTripSelect(){const trips=summary?.trips||[]; $('expense-trip').innerHTML='<option value="">Ohne Reise</option>'+trips.filter(t=>['draft','rejected'].includes(t.status)).map(t=>`<option value="${t.id}">${esc(t.title)} · ${esc(t.starts_on)}</option>`).join('')}
  async function openTrip(id){try{const j=await request(`${API}?action=trip&id=${encodeURIComponent(id)}`);tripForm(j.trip);view('trip')}catch(e){msg(e.message,true)}}
  function renderExpenses(items){$('trip-expense-list').innerHTML=items.length?items.map(e=>`<div class="expense-row"><div><b>${esc(e.category)}</b> · ${esc(e.expense_date)}<small>${esc(e.merchant||e.description||'')}</small></div><strong>${money(e.amount_eur)}</strong></div>`).join(''):'<p>Noch keine Belege zu dieser Reise.</p>'}
  function calc(){const a=$('trip-start').value,b=$('trip-end').value;if(!a||!b)return;const days=Math.max(0,Math.floor((new Date(b)-new Date(a))/86400000)+1),full=Math.max(0,days-2),partial=Math.min(2,days),fullRate=Number($('trip-full').value)||0,partialRate=Number($('trip-partial').value)||0,meal=fullRate*(($('meal-breakfast').checked?.2:0)+($('meal-lunch').checked?.4:0)+($('meal-dinner').checked?.4:0)),per=Math.max(0,full*fullRate+partial*partialRate-meal*Math.max(1,days)),km=(Number($('trip-km').value)||0)*(Number($('trip-km-rate').value)||0);$('est-days').textContent=days;$('est-perdiem').textContent=money(per);$('est-mileage').textContent=money(km);$('est-expenses').textContent=money(currentTrip?.estimate?.expenses||0);$('est-total').textContent=money(per+km+(currentTrip?.estimate?.expenses||0))}
  document.querySelectorAll('#trip-form input,#trip-form select').forEach(e=>e.addEventListener('input',calc));
  $('trip-form').addEventListener('submit',async e=>{e.preventDefault();try{const body={id:Number($('trip-id').value)||0,title:$('trip-title').value,purpose:$('trip-purpose').value,cost_center:$('trip-cost-center').value,origin:$('trip-origin').value,destination:$('trip-destination').value,intermediate_stops:$('trip-stops').value,starts_on:$('trip-start').value,ends_on:$('trip-end').value,start_time:$('trip-start-time').value,end_time:$('trip-end-time').value,country_code:$('trip-country').value,per_diem_full:$('trip-full').value,per_diem_partial:$('trip-partial').value,mileage_km:$('trip-km').value,mileage_rate:$('trip-km-rate').value,meal_breakfast:$('meal-breakfast').checked,meal_lunch:$('meal-lunch').checked,meal_dinner:$('meal-dinner').checked,notes:$('trip-notes').value,overnight_enabled:$('trip-overnight-enabled').checked,overnight_rate:$('trip-overnight').value};const j=await request(`${API}?action=save_trip`,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(body)});tripForm(j.trip);await loadSummary();msg('Reise gespeichert.')}catch(x){msg(x.message,true)}});
  $('trip-calendar-fill').addEventListener('click',fillFromCalendar);
  $('trip-submit').addEventListener('click',async()=>{try{await request(`${API}?action=submit_trip`,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({id:Number($('trip-id').value)})});await loadSummary();await openTrip($('trip-id').value);msg('Reise eingereicht.')}catch(e){msg(e.message,true)}});
  $('trip-add-expense').addEventListener('click',()=>{view('expense');set('expense-trip',currentTrip?.id||'')});
  function chooseReceipt(inputId){$(inputId).click()}
  [['receipt-file','receipt-file-input'],['receipt-photo','receipt-photo-input'],['receipt-camera','receipt-camera-input']].forEach(([button,input])=>{$(button).addEventListener('click',()=>chooseReceipt(input));$(input).addEventListener('change',()=>{selectedReceipt=$(input).files?.[0]||null;$('receipt-name').textContent=selectedReceipt?`Ausgewählt: ${selectedReceipt.name}`:'Noch kein Beleg ausgewählt.'})});
  $('expense-form').addEventListener('submit',async e=>{e.preventDefault();try{let body={id:Number($('expense-id').value)||0,trip_id:Number($('expense-trip').value)||0,expense_date:$('expense-date').value,category:$('expense-category').value,merchant:$('expense-merchant').value,payment_method:$('expense-payment').value,amount:$('expense-amount').value,currency:$('expense-currency').value,exchange_rate:$('expense-rate').value,vat_rate:$('expense-vat').value,mileage_km:$('expense-km').value,mileage_rate:$('expense-km-rate').value,description:$('expense-description').value};const j=await request(`${API}?action=save_expense`,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(body)});if(selectedReceipt){const form=new FormData();form.append('expense_id',j.expense_id);form.append('receipt',selectedReceipt);const receipt=await request(`${API}?action=upload_receipt`,{method:'POST',body:form});const x=receipt.extracted||{};if(x.expense_date)set('expense-date',x.expense_date);if(x.merchant)set('expense-merchant',x.merchant);if(x.amount)set('expense-amount',x.amount);if(x.currency)set('expense-currency',x.currency);if(x.vat_rate)set('expense-vat',x.vat_rate);if(x.description)set('expense-description',x.description);if(x.category)set('expense-category',x.category);body={...body,expense_date:x.expense_date||body.expense_date,merchant:x.merchant||body.merchant,amount:x.amount||body.amount,currency:x.currency||body.currency,vat_rate:x.vat_rate||body.vat_rate,description:x.description||body.description,category:x.category||body.category};if(!receipt.analysis_error){await request(`${API}?action=save_expense`,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(body)})}msg(receipt.analysis_error?'Beleg gespeichert. Automatische Auslesung war nicht möglich, bitte die Felder prüfen.':'Beleg gespeichert und automatisch ausgelesen.');}else msg('Beleg gespeichert.');$('expense-form').reset();selectedReceipt=null;$('receipt-name').textContent='Noch kein Beleg ausgewählt.';$('expense-currency').value='EUR';$('expense-rate').value='1';await loadSummary();if(body.trip_id)await openTrip(body.trip_id)}catch(x){msg(x.message,true)}});
  $('expense-new').addEventListener('click',()=>{ $('expense-form').reset(); selectedReceipt=null; $('receipt-name').textContent='Noch kein Beleg ausgewählt.'; });
  async function decide(id,decision){const note=decision==='rejected'?prompt('Begründung (optional):')||'':'';try{await request(`${API}?action=decide_trip`,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({id:Number(id),decision,decision_note:note})});await loadSummary();msg(decision==='approved'?'Reise freigegeben.':'Reise abgelehnt.')}catch(e){msg(e.message,true)}}
  function updateExportLink(){const from=$('export-from').value||'2000-01-01',to=$('export-to').value||'2099-12-31',status=$('export-status').value; $('export-csv').href=`${API}?action=export_csv&from=${from}&to=${to}&status=${encodeURIComponent(status)}`}
  ['export-from','export-to','export-status'].forEach(id=>$(id).addEventListener('input',updateExportLink));
  $('export-monthly').addEventListener('click',async()=>{const month=($('export-from').value||new Date().toISOString().slice(0,7)+'-01').slice(0,7);try{const j=await request(`${API}?action=monthly_export`,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({month})});msg(`ZIP versendet: ${j.filename}`,false,$('export-result'))}catch(e){msg(e.message,true,$('export-result'))}});
  $('sp-approval-tab').addEventListener('click',()=>{});
  loadSummary().then(()=>{if(summary?.is_approver)$('export-monthly').hidden=false;const now=new Date(),first=new Date(now.getFullYear(),now.getMonth(),1),last=new Date(now.getFullYear(),now.getMonth()+1,0);$('export-from').value=first.toISOString().slice(0,10);$('export-to').value=last.toISOString().slice(0,10);updateExportLink()});
})();
</script>
