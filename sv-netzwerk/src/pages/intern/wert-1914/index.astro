---
import InternalLayout from '../../../layouts/InternalLayout.astro';
import CalculationTypeNav from '../../../components/internal/CalculationTypeNav.astro';
const factor = 22.6;
const surchargeOptions = [
  ['natural_stone_roof','Naturstein, Kupferdach',4],['premium_facade','Naturstein-, Keramik-, Kunststeinverkleidung, Handstrichklinker',5],
  ['stucco_wood_panelling','Stuckarbeiten, Edelholzverkleidung',6],['premium_floors','Natursteinböden, Parkett- oder Teppichböden in hochwertiger Qualität',4],
  ['mullioned_windows','Leichtmetall- oder Holzsprossenfenster',4],['hardwood_doors','Edelholztüren',3],
  ['premium_sanitary','Hochwertige Sanitäreinrichtungen',6],['heating_solar','Wärmepumpen, Solaranlagen, Fußboden- und Deckenheizungen',6],
  ['premium_kitchen','Hochwertige Einbauküchen',4]
];
---
<InternalLayout title="Wert 1914" description="Versicherungssumme 1914 und aktuellen Gebäudeneuwert ermitteln." currentPath="/intern/wert-1914/">
<main class="v14-app" data-factor={factor}>
  <a class="v14-back" href="/intern/versicherungsfaelle/">← Zurück zum Versicherungsportal</a><CalculationTypeNav active="value1914" />
  <header class="v14-head"><div><p class="kicker">Gebäudeversicherung</p><h1>Ermittlung der Versicherungssumme 1914</h1><p>Für Wohngebäude der Bauartklassen I und II sowie Fertighausgruppen 1 und 2.</p></div><div><span>Baupreisindex 2026</span><strong>22,6</strong></div></header>
  <div id="v14-case" class="v14-case">Keine Fallakte geöffnet – Speichern unter und PDF-Download stehen zur Verfügung.</div>
  <section class="card"><h2><b>1</b> Gebäudetyp ermitteln</h2><div class="grid three">
    <label>Unterkellerung<select id="v14-basement"><option value="">Bitte wählen</option><option value="no_basement">Ohne Unterkellerung</option><option value="basement">Mit Unterkellerung / Teilunterkellerung</option></select></label>
    <label>Dachausführung<select id="v14-roof"><option value="">Bitte wählen</option><option value="flat">Flachdach</option><option value="attic_unfinished">Dachgeschoss nicht ausgebaut</option><option value="attic_finished">Dachgeschoss ausgebaut</option></select></label>
    <label>Anzahl Geschosse<input id="v14-floors" type="number" min="1" max="7" step="1" inputmode="numeric"></label>
  </div><div class="rate">Wert Gebäudetyp: <strong id="v14-rate">–</strong></div></section>
  <section class="card"><h2><b>2</b> Zuschläge für gehobene Bauausführungen/-ausstattungen</h2><div class="checks">{surchargeOptions.map(([key,label,value])=><label><input type="checkbox" name="v14-surcharge" value={key}><span>{label}</span><strong>+ {value} Mark</strong></label>)}</div><div class="rate">Summe Zuschläge: <strong id="v14-surcharge-total">0 Mark</strong></div></section>
  <section class="card"><h2><b>3</b> Berechnung</h2><div class="grid three">
    <label>Wohn-/Gewerbefläche ohne Keller (m²)<input id="v14-area" type="number" min="0" step="0.01" inputmode="decimal"></label>
    <label>Bewohnte Keller-/Hobbyfläche (m²)<input id="v14-basement-area" type="number" min="0" step="0.01" inputmode="decimal"></label>
    <label>Garagenstellplätze<input id="v14-garages" type="number" min="0" step="1" value="0"></label>
    <label>Carportstellplätze<input id="v14-carports" type="number" min="0" step="1" value="0"></label>
    <label>Tiefgaragenstellplätze<input id="v14-underground" type="number" min="0" step="1" value="0"></label>
    <label>Baupreisindex / Faktor<input id="v14-factor" type="number" min="0.1" step="0.1" value={factor}></label>
  </div><label>Sonderausstattungen – Beschreibung<textarea id="v14-special-note" rows="2" placeholder="z. B. Sauna, Kamin, nachträgliche Wärmedämmung, Schwimmbecken"></textarea></label><label>Neubauwert Sonderausstattungen (€)<input id="v14-special-value" type="number" min="0" step="0.01"></label>
  <div class="grid three"><label>Nutzung Nebengebäude<input id="v14-outbuilding-use"></label><label>Größe (m²)<input id="v14-outbuilding-size" type="number" min="0" step="0.01"></label><label>Außenwände / Dachung<input id="v14-outbuilding-construction"></label></div><label>Neubauwert Nebengebäude (€)<input id="v14-outbuilding-value" type="number" min="0" step="0.01"></label>
  <button id="v14-calculate" class="primary" type="button">Versicherungssumme berechnen</button><p id="v14-state" role="status"></p></section>
  <section id="v14-result" class="card result" hidden><h2><b>4</b> Ergebnis und Rechenweg</h2><div id="v14-lines"></div><div class="totals"><p>Versicherungssumme 1914 <strong id="v14-total"></strong></p><p>Gebäudewert 2026 <strong id="v14-current"></strong></p></div><div class="actions"><button id="v14-print" type="button">Drucken</button><button id="v14-pdf" type="button">PDF herunterladen</button><button id="v14-save-as" type="button">Speichern unter</button><button id="v14-reset" type="button">Neue Berechnung</button></div><p id="v14-save-state"></p></section>
  <aside class="notice"><strong>Fachlicher Hinweis</strong><p>Das vereinfachte Verfahren gilt nur für den genannten Anwendungsbereich. Maßgeblich bleiben Vertrag, Versicherungsbedingungen, Änderungen am Gebäude und die Wertermittlung des Versicherers.</p></aside>
</main>
</InternalLayout>
<style is:global>
:root{--v14:#17324a;--orange:#f39200;--line:#d5dfe6;--muted:#667b8d}.v14-app{max-width:1320px;margin:auto;padding:18px 24px 60px;color:var(--v14)}.v14-back{font-weight:800;color:var(--v14);text-decoration:none}.v14-head{display:flex;justify-content:space-between;gap:20px;margin:16px 0}.v14-head h1{margin:.1rem 0}.v14-head p{margin:.3rem 0;color:var(--muted)}.v14-head>div:last-child{border-left:4px solid var(--orange);background:white;padding:12px 18px}.v14-head span,.v14-head strong{display:block}.v14-head strong{font-size:1.5rem}.kicker{color:var(--orange)!important;font-weight:900;text-transform:uppercase}.v14-case{padding:12px 15px;margin-bottom:14px;border:1px solid var(--line);background:#f5f8fa}.v14-case.on{border-left:4px solid #2e775b;background:#edf7f2}.card{padding:18px;margin-bottom:16px;border:1px solid var(--line);background:#fff}.card h2{display:flex;align-items:center;gap:10px;margin:0 0 16px}.card h2 b{display:grid;place-items:center;width:30px;height:30px;background:var(--v14);color:white}.grid{display:grid;gap:12px}.grid.three{grid-template-columns:repeat(3,1fr)}label{display:grid;gap:5px;margin-bottom:12px;font-size:.82rem;font-weight:800;color:#526a7d}input,select,textarea{box-sizing:border-box;width:100%;padding:10px;border:1px solid #b7c7d2;border-radius:3px;background:white;color:var(--v14);font:inherit}.checks{display:grid;grid-template-columns:1fr 1fr;gap:7px 18px}.checks label{grid-template-columns:auto 1fr auto;align-items:center;margin:0;padding:9px;border-bottom:1px solid #e5ebef}.checks input{width:auto}.rate{padding:12px;margin-top:12px;text-align:right;background:#f5f8fa}.primary,.actions button{padding:11px 15px;border:1px solid var(--v14);border-radius:3px;background:var(--v14);color:white;font-weight:850;cursor:pointer}.result{border-top:4px solid var(--orange)}.result-line{display:grid;grid-template-columns:1fr auto;gap:12px;padding:8px;border-bottom:1px solid #e5ebef}.totals{margin-top:14px;padding:12px 16px;border:1px solid #a9d1bf;background:#edf7f2}.totals p{display:flex;justify-content:space-between;font-size:1.05rem}.actions{display:flex;flex-wrap:wrap;gap:8px;margin-top:14px}.actions button:nth-child(n+2){background:white;color:var(--v14)}.notice{padding:14px 16px;border:1px solid #e7c48e;border-left:4px solid var(--orange);background:#fff8ed}.notice p{margin:.3rem 0 0}@media(max-width:800px){.grid.three,.checks{grid-template-columns:1fr}.v14-head{display:block}.v14-head>div:last-child{margin-top:12px}}@media(max-width:620px){.v14-app{padding:12px 10px 40px}.actions button{width:100%}}@media print{.intern-header,.intern-sidebar,.calculation-type-nav,.v14-back,.actions,.notice,#v14-case,#v14-calculate{display:none!important}.intern-portal-shell{display:block!important}.v14-app{max-width:none;padding:0}.card{break-inside:avoid;box-shadow:none}}
</style>
<script type="module" is:inline>
import { buildingRate, calculateBuildingValuation, SURCHARGES } from '/intern/value-1914.js';
(()=>{const $=id=>document.getElementById(id),num=v=>new Intl.NumberFormat('de-DE',{maximumFractionDigits:2}).format(Number(v)||0),money=v=>new Intl.NumberFormat('de-DE',{style:'currency',currency:'EUR'}).format(Number(v)||0);let last=null,active=null;
for(const s of[sessionStorage,localStorage])try{const d=JSON.parse(s.getItem('svnet-case')||'null');if(d?.folder_id){active=d;break}}catch{}
if(active){const m=active.meta||{};$('v14-case').classList.add('on');$('v14-case').textContent=`Aktiver Fall: ${m.schaden_nr||'ohne Schaden-Nr.'} · ${m.vn_objekt||m.ort||''} · Die fertige Berechnung wird automatisch in der Fallakte gespeichert.`}
const value=id=>$(id).value,selected=()=>[...document.querySelectorAll('[name="v14-surcharge"]:checked')].map(x=>x.value);function preview(){const rate=buildingRate(value('v14-basement'),value('v14-roof'),value('v14-floors'));$('v14-rate').textContent=rate?`${num(rate)} Mark/m²`:'–';$('v14-surcharge-total').textContent=`${num(selected().reduce((s,k)=>s+(SURCHARGES[k]||0),0))} Mark/m²`}
['v14-basement','v14-roof','v14-floors'].forEach(id=>$(id).onchange=preview);document.querySelectorAll('[name="v14-surcharge"]').forEach(x=>x.onchange=preview);
function input(){return{basement:value('v14-basement'),roof:value('v14-roof'),floors:value('v14-floors'),area:value('v14-area'),basementArea:value('v14-basement-area'),garages:value('v14-garages'),carports:value('v14-carports'),underground:value('v14-underground'),specialValue:value('v14-special-value'),outbuildingValue:value('v14-outbuilding-value'),factor:value('v14-factor'),surcharges:selected()}}
function details(){const m=active?.meta||{};return{createdAt:new Date().toLocaleString('de-DE'),caseNo:m.schaden_nr||'',policyNo:m.versicherungsschein_nr||'',object:m.vn_objekt||'',address:[m.schaden_strasse||m.strasse,m.schaden_plz||m.plz,m.schaden_ort||m.ort].filter(Boolean).join(' '),specialNote:value('v14-special-note'),outbuildingUse:value('v14-outbuilding-use'),outbuildingSize:value('v14-outbuilding-size'),outbuildingConstruction:value('v14-outbuilding-construction')}}
function rows(r){return[['Grundwert Gebäudetyp',`${num(r.rate)} Mark/m²`],['Zuschläge',`${num(r.surcharge)} Mark/m²`],[`Wohn-/Gewerbefläche: ${num(r.area)} m² × ${num(r.rateWithSurcharge)} Mark`,`${num(r.mainValue1914)} Mark`],[`Bewohnte Kellerfläche: ${num(r.basementArea)} m² × 20 Mark`,`${num(r.basementValue1914)} Mark`],[`Garage: ${r.garages} × 700 Mark`,`${num(r.garageValue1914)} Mark`],[`Carport: ${r.carports} × 350 Mark`,`${num(r.carportValue1914)} Mark`],[`Tiefgarage: ${r.underground} × 1.000 Mark`,`${num(r.undergroundValue1914)} Mark`],[`Sonderausstattung: ${money(r.specialValue)} ÷ ${num(r.factor)}`,`${num(r.specialValue1914)} Mark`],[`Nebengebäude: ${money(r.outbuildingValue)} ÷ ${num(r.factor)}`,`${num(r.outbuildingValue1914)} Mark`]]}
function render(r){$('v14-lines').innerHTML=rows(r).map(([a,b])=>`<div class="result-line"><span>${a}</span><strong>${b}</strong></div>`).join('');$('v14-total').textContent=`${num(r.total1914)} Mark`;$('v14-current').textContent=money(r.currentValue);$('v14-result').hidden=false}
const safe=s=>String(s||'').replace(/[^a-z0-9äöüß-]+/gi,'-').replace(/^-|-$/g,'').slice(0,80)||'Berechnung';function pdfLines(){const d=details(),r=last;return['SV-NETZWERK – ERMITTLUNG DER VERSICHERUNGSSUMME 1914','',d.caseNo&&`Schaden-Nr.: ${d.caseNo}`,d.policyNo&&`Versicherungsschein-Nr.: ${d.policyNo}`,d.object&&`VN / Objekt: ${d.object}`,d.address&&`Versicherungsgrundstück: ${d.address}`,`Erstellt: ${d.createdAt}`,'',...rows(r).map(([a,b])=>`${a}: ${b}`),'',`Versicherungssumme 1914: ${num(r.total1914)} Mark`,`Gebäudewert 2026 (Faktor ${num(r.factor)}): ${money(r.currentValue)}`,d.specialNote&&`Sonderausstattung: ${d.specialNote}`,d.outbuildingUse&&`Nebengebäude: ${d.outbuildingUse}; ${d.outbuildingSize||0} m²; ${d.outbuildingConstruction||''}`,'','Hinweis: Vereinfachtes Wertermittlungsverfahren für den angegebenen Anwendungsbereich.'].filter(x=>x!==false&&x!==undefined&&x!==null)}
function pdfBlob(lines){const clean=s=>String(s).normalize('NFKD').replace(/[–—]/g,'-').replace(/[^ -~äöüÄÖÜß€]/g,'').replace(/([\\()])/g,'\\$1').replace(/€/g,'EUR');const pages=[];for(let i=0;i<lines.length;i+=42)pages.push(lines.slice(i,i+42));let objects=['','<< /Type /Catalog /Pages 2 0 R >>',''];const pageIds=[],contentIds=[];pages.forEach(()=>{pageIds.push(objects.length);objects.push('');contentIds.push(objects.length);objects.push('')});const fontId=objects.length;objects.push('<< /Type /Font /Subtype /Type1 /BaseFont /Helvetica >>');objects[2]=`<< /Type /Pages /Count ${pages.length} /Kids [${pageIds.map(id=>`${id} 0 R`).join(' ')}] >>`;pages.forEach((page,i)=>{const stream=['BT','/F1 10 Tf','48 790 Td','14 TL',...page.flatMap((line,n)=>[n?'T*':'',`(${clean(line)}) Tj`]).filter(Boolean),'ET'].join('\n');objects[pageIds[i]]=`<< /Type /Page /Parent 2 0 R /MediaBox [0 0 595 842] /Resources << /Font << /F1 ${fontId} 0 R >> >> /Contents ${contentIds[i]} 0 R >>`;objects[contentIds[i]]=`<< /Length ${stream.length} >>\nstream\n${stream}\nendstream`});let out='%PDF-1.4\n',offsets=[0];for(let i=1;i<objects.length;i++){offsets[i]=out.length;out+=`${i} 0 obj\n${objects[i]}\nendobj\n`}const xref=out.length;out+=`xref\n0 ${objects.length}\n0000000000 65535 f \n${offsets.slice(1).map(n=>String(n).padStart(10,'0')+' 00000 n ').join('\n')}\ntrailer << /Size ${objects.length} /Root 1 0 R >>\nstartxref\n${xref}\n%%EOF`;return new Blob([new TextEncoder().encode(out)],{type:'application/pdf'})}
function fileName(){const d=details(),date=new Date().toISOString().slice(0,10);return `${safe(d.caseNo||d.object||'Wert-1914')}_Wertermittlung-1914_${date}.pdf`}
function download(blob,name=fileName()){const a=document.createElement('a');a.href=URL.createObjectURL(blob);a.download=name;a.click();setTimeout(()=>URL.revokeObjectURL(a.href),1000)}
async function saveToCase(blob){if(!active?.folder_id)return false;const fd=new FormData();fd.append('folder_id',active.folder_id);fd.append('last_modified',String(Date.now()));fd.append('file',new File([blob],fileName(),{type:'application/pdf'}));const response=await fetch('/intern/api/google-drive-sync.php?action=upload_case_document',{method:'POST',credentials:'same-origin',body:fd});const data=await response.json().catch(()=>({}));if(!response.ok)throw Error(data.error||`HTTP ${response.status}`);return true}
$('v14-calculate').onclick=async()=>{const r=calculateBuildingValuation(input());if(!r.valid){$('v14-state').textContent=r.error;return}last=r;render(r);$('v14-state').textContent='Berechnung abgeschlossen.';$('v14-save-state').textContent='';if(active){$('v14-save-state').textContent='Berechnung wird automatisch in der Fallakte gespeichert …';try{await saveToCase(pdfBlob(pdfLines()));$('v14-save-state').textContent='Automatisch in der Fallakte gespeichert.'}catch(e){$('v14-save-state').textContent=`Automatische Speicherung fehlgeschlagen: ${e.message}. PDF kann weiterhin heruntergeladen werden.`}}$('v14-result').scrollIntoView({behavior:'smooth',block:'start'})};
$('v14-print').onclick=()=>window.print();$('v14-pdf').onclick=()=>last&&download(pdfBlob(pdfLines()));$('v14-save-as').onclick=()=>{if(!last)return;const suggested=fileName(),name=prompt('Dateiname für die PDF:',suggested);if(name)download(pdfBlob(pdfLines()),name.toLowerCase().endsWith('.pdf')?name:`${name}.pdf`)};$('v14-reset').onclick=()=>location.reload();preview()})();
</script>
