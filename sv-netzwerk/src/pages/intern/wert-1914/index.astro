---
import InternalLayout from '../../../layouts/InternalLayout.astro';
import CalculationTypeNav from '../../../components/internal/CalculationTypeNav.astro';

const indices = [
  [2026,2263.6],[2025,2192.4],[2024,2134.5],[2023,1961.4],[2022,1668.2],[2021,1568.3],[2020,1523.0],
  [2019,1454.3],[2018,1396.7],[2017,1358.3],[2016,1330.7],[2015,1310.3],[2014,1289.4],[2013,1263.0],
  [2012,1230.4],[2011,1232.8],[2010,1199.6]
];
const sourceUrl = 'https://www.versicherung-commercon.de/wert-1914-umrechnen-online-rechner-fuer-die-versicherungssumme/';
const gdvUrl = 'https://www.gdv.de/resource/blob/37086/f47b12926546495dd7b6133f9dbf58aa/allgemeine-wohngebaeude-versicherungsbedingungen-vgb-2022-wert-1914-gleitender-neuwert-plus--data.pdf';
---
<InternalLayout title="Wert 1914" description="Wert 1914, Neubauwert und mögliche Unterversicherung nachvollziehbar berechnen." currentPath="/intern/wert-1914/">
  <main class="v14-app" data-indices={JSON.stringify(indices)}>
    <a class="v14-back" href="/intern/versicherungsfaelle/">← Zurück zum Versicherungsportal</a>
    <CalculationTypeNav active="value1914" />
    <section class="v14-head"><div><p class="v14-kicker">Gebäudeversicherung</p><h1>Wert 1914 umrechnen</h1><p>Historischen Versicherungswert und Neubauwert in beide Richtungen berechnen.</p></div><div class="v14-current"><span>Baupreisindex 2026</span><strong>2.263,6</strong></div></section>

    <section class="v14-notice"><strong>Fachlicher Hinweis</strong><p>Der Rechner liefert eine rechnerische Orientierung. Maßgeblich bleiben Versicherungsschein, vereinbarte Bedingungen, die Wertermittlung des Versicherers und wertsteigernde bauliche Veränderungen. Baupreisindex und Anpassungsfaktor sind nicht identisch.</p></section>

    <div class="v14-layout">
      <section class="v14-card">
        <div class="v14-title"><p class="v14-step">1</p><h2>Umrechnung</h2></div>
        <label>Berechnungsrichtung<select id="v14-direction"><option value="toCurrent">Wert 1914 → Neubauwert in Euro</option><option value="to1914">Neubauwert in Euro → Wert 1914</option></select></label>
        <label id="v14-amount-label">Wert 1914 in Mark<input id="v14-amount" type="number" min="0" step="0.01" inputmode="decimal" placeholder="z. B. 20.000"></label>
        <div class="v14-grid"><label>Bezugsjahr<select id="v14-year">{indices.map(([year,index]) => <option value={year} data-index={index}>{year}</option>)}</select></label><label>Baupreisindex<input id="v14-index" type="number" min="0.1" step="0.1" value="2263.6"></label></div>
        <button id="v14-calculate" class="v14-primary" type="button">Umrechnen</button><p id="v14-state" class="v14-state" role="status"></p>
      </section>
      <section class="v14-card v14-result-card">
        <div class="v14-title"><p class="v14-step">2</p><h2>Ergebnis</h2></div>
        <div id="v14-empty" class="v14-empty">Bitte Ausgangswert eingeben.</div>
        <div id="v14-result" hidden><dl class="v14-results"><div><dt id="v14-input-title">Wert 1914</dt><dd id="v14-input-result"></dd></div><div><dt>Baupreisindex</dt><dd id="v14-index-result"></dd></div><div class="v14-highlight"><dt id="v14-output-title">Neubauwert</dt><dd id="v14-output-result"></dd></div></dl><div class="v14-formula"><strong>Rechenweg</strong><p id="v14-formula"></p></div><label>Dokumentation<textarea id="v14-text" rows="8"></textarea></label><button id="v14-copy" class="v14-secondary" type="button">Text kopieren</button><span id="v14-copy-state"></span></div>
      </section>
    </div>

    <section class="v14-card">
      <div class="v14-title"><p class="v14-step">3</p><h2>Unterversicherungs-Check</h2></div>
      <p class="v14-muted">Nur als Rechenhilfe, sofern nach dem konkreten Vertrag überhaupt ein Unterversicherungsabzug in Betracht kommt.</p>
      <div class="v14-three"><label>Versicherter Wert 1914<input id="v14-insured" type="number" min="0" step="0.01"></label><label>Erforderlicher Wert 1914<input id="v14-required" type="number" min="0" step="0.01"></label><label>Teilschaden brutto<input id="v14-claim" type="number" min="0" step="0.01"></label></div>
      <button id="v14-check" class="v14-primary" type="button">Quote prüfen</button><p id="v14-under-result" class="v14-under-result"></p>
    </section>

    <section class="v14-card v14-transfer">
      <div class="v14-title"><p class="v14-step">4</p><h2>In den Bericht übernehmen</h2></div>
      <p class="v14-muted">Der geprüfte Rechen- und Begründungstext wird in den Arbeitsauftrag des geöffneten Schadenfalls übernommen.</p>
      <button id="v14-transfer" class="v14-primary" type="button" disabled>Berechnung in Bericht übernehmen</button><p id="v14-transfer-state" class="v14-state" role="status"></p>
    </section>

    <section class="v14-sources"><strong>Grundlagen</strong><a href={sourceUrl} target="_blank" rel="noreferrer">Rechenansatz und Indexreihe</a><a href={gdvUrl} target="_blank" rel="noreferrer">GDV-Musterbedingungen VGB 2022 – Wert 1914</a></section>
  </main>
</InternalLayout>

<style is:global>
:root{--v14-navy:#17324a;--v14-muted:#687b8c;--v14-orange:#ff970f;--v14-line:#d7e1e8;--v14-green:#2e775b}.v14-app{max-width:1420px;margin:auto;padding:18px 24px 56px;color:var(--v14-navy)}.v14-back{display:inline-block;margin-bottom:12px;color:var(--v14-navy);font-weight:800;text-decoration:none}.v14-head{display:flex;justify-content:space-between;gap:24px;margin-bottom:16px}.v14-head h1{margin:.15rem 0}.v14-head p{margin:.2rem 0;color:var(--v14-muted)}.v14-kicker{color:var(--v14-orange)!important;font-weight:900;text-transform:uppercase}.v14-current{min-width:190px;padding:12px 16px;border-left:4px solid var(--v14-orange);background:#fff}.v14-current span,.v14-current strong{display:block}.v14-current strong{font-size:1.5rem}.v14-notice{margin-bottom:16px;padding:14px 16px;border:1px solid #e7c48e;border-left:4px solid var(--v14-orange);background:#fff8ed}.v14-notice p{margin:.35rem 0 0;line-height:1.5}.v14-layout{display:grid;grid-template-columns:1fr 1fr;gap:16px}.v14-card{margin-bottom:16px;padding:18px;border:1px solid var(--v14-line);background:#fff;box-shadow:0 2px 8px rgba(7,26,46,.05)}.v14-title{display:flex;align-items:center;gap:10px;margin-bottom:14px}.v14-title h2{margin:0}.v14-step{display:grid;place-items:center;width:30px;height:30px;margin:0;background:var(--v14-navy);color:#fff;font-weight:900}.v14-card label{display:grid;gap:5px;margin-bottom:11px;color:#526a7d;font-size:.8rem;font-weight:800}.v14-card input,.v14-card select,.v14-card textarea{box-sizing:border-box;width:100%;padding:10px;border:1px solid #b9c8d3;border-radius:3px;background:#fff;color:#172f44;font:inherit}.v14-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px}.v14-three{display:grid;grid-template-columns:repeat(3,1fr);gap:12px}.v14-primary,.v14-secondary{padding:10px 14px;border-radius:3px;font-weight:850;cursor:pointer}.v14-primary{border:1px solid var(--v14-navy);background:var(--v14-navy);color:#fff}.v14-primary:disabled{cursor:not-allowed;opacity:.45}.v14-secondary{border:1px solid #aebfcb;background:#fff;color:var(--v14-navy)}.v14-state{min-height:1.3em;color:var(--v14-muted)}.v14-empty{display:grid;min-height:260px;place-items:center;border:1px dashed #b9c8d3;background:#f8fafb;color:var(--v14-muted)}.v14-results{display:grid;gap:9px;margin:0}.v14-results>div{display:grid;grid-template-columns:1fr auto;gap:12px;padding:10px 12px;border-bottom:1px solid #e5ebef}.v14-results dd{margin:0;font-weight:900}.v14-results .v14-highlight{border:1px solid #a9d1bf;background:#edf7f2}.v14-formula{margin:14px 0;padding:12px;border-left:4px solid var(--v14-orange);background:#fff8ed}.v14-formula p{margin:.35rem 0}.v14-muted{color:var(--v14-muted)}.v14-under-result{padding:12px;background:#f5f8fa;line-height:1.55}.v14-transfer{border-top:4px solid var(--v14-orange)}.v14-sources{display:flex;flex-wrap:wrap;gap:14px;padding:14px 16px;border:1px solid var(--v14-line);background:#fff}.v14-sources a{color:var(--v14-navy);font-weight:800}@media(max-width:850px){.v14-layout{grid-template-columns:1fr}.v14-three{grid-template-columns:1fr}}@media(max-width:620px){.v14-app{padding:12px 10px 40px}.v14-head{display:block}.v14-current{margin-top:12px}.v14-grid{grid-template-columns:1fr}.v14-primary,.v14-secondary{width:100%}.v14-card input,.v14-card select,.v14-card textarea{font-size:16px}}@media print{.intern-header,.intern-sidebar,.calculation-type-nav,.v14-back,.v14-sources,.v14-primary,.v14-secondary,.skip-link{display:none!important}.intern-portal-shell{display:block!important}.v14-app{max-width:none;padding:0}.v14-card{box-shadow:none;break-inside:avoid}}
</style>

<script type="module" is:inline>
import { calculateValue1914, calculateUnderinsurance } from '/intern/value-1914.js';
(()=>{const $=id=>document.getElementById(id),money=v=>new Intl.NumberFormat('de-DE',{style:'currency',currency:'EUR'}).format(v),num=v=>new Intl.NumberFormat('de-DE',{maximumFractionDigits:2}).format(v),pct=v=>new Intl.NumberFormat('de-DE',{style:'percent',maximumFractionDigits:2}).format(v);function syncDirection(){const reverse=$('v14-direction').value==='to1914';$('v14-amount-label').childNodes[0].textContent=reverse?'Neubauwert in Euro':'Wert 1914 in Mark';$('v14-input-title').textContent=reverse?'Neubauwert':'Wert 1914';$('v14-output-title').textContent=reverse?'Wert 1914':'Neubauwert'}function calculate(){const r=calculateValue1914({amount:$('v14-amount').value,index:$('v14-index').value,direction:$('v14-direction').value});if(!r.valid){$('v14-state').textContent=r.error;return}$('v14-state').textContent='Umrechnung durchgeführt.';$('v14-empty').hidden=true;$('v14-result').hidden=false;const reverse=r.direction==='to1914',year=$('v14-year').value;$('v14-input-result').textContent=reverse?money(r.amount):`${num(r.amount)} Mark`;$('v14-index-result').textContent=`${num(r.index)} (${year})`;$('v14-output-result').textContent=reverse?`${num(r.result)} Mark`:money(r.result);$('v14-formula').textContent=reverse?`${money(r.amount)} × 100 ÷ ${num(r.index)} = ${num(r.result)} Mark`:`${num(r.amount)} Mark × ${num(r.index)} ÷ 100 = ${money(r.result)}`;$('v14-text').value=reverse?`Ausgehend von einem Neubauwert von ${money(r.amount)} und dem Baupreisindex ${num(r.index)} für das Jahr ${year} ergibt sich rechnerisch ein Wert 1914 von ${num(r.result)} Mark. Rechenweg: Neubauwert × 100 ÷ Baupreisindex.`:`Ausgehend von einem Wert 1914 von ${num(r.amount)} Mark und dem Baupreisindex ${num(r.index)} für das Jahr ${year} ergibt sich rechnerisch ein Neubauwert von ${money(r.result)}. Rechenweg: Wert 1914 × Baupreisindex ÷ 100.`;$('v14-transfer').disabled=false}function check(){const r=calculateUnderinsurance({insured:$('v14-insured').value,required:$('v14-required').value,claim:$('v14-claim').value}),text=r.valid?`Deckungsquote: ${pct(r.ratio)} · rechnerische Unterdeckung: ${pct(r.shortfallRate)} · bei dem eingegebenen Teilschaden rechnerische Entschädigung ${money(r.estimatedCompensation)} und Kürzung ${money(r.estimatedReduction)}. Die tatsächliche Regulierung richtet sich ausschließlich nach dem konkreten Vertrag.`:r.error;$('v14-under-result').textContent=text;if(r.valid&&$('v14-text').value&&!$('v14-text').value.includes('Unterversicherungsprüfung:'))$('v14-text').value+=`\n\nUnterversicherungsprüfung: ${text}`}$('v14-year').onchange=()=>{$('v14-index').value=$('v14-year').selectedOptions[0].dataset.index};$('v14-direction').onchange=syncDirection;$('v14-calculate').onclick=calculate;$('v14-check').onclick=check;$('v14-copy').onclick=async()=>{try{await navigator.clipboard.writeText($('v14-text').value);$('v14-copy-state').textContent=' Text kopiert.'}catch{$('v14-text').select();$('v14-copy-state').textContent=' Text markiert.'}};$('v14-transfer').onclick=()=>{const text=$('v14-text').value.trim();if(!text){$('v14-transfer-state').textContent='Bitte zuerst eine Berechnung durchführen.';return}sessionStorage.setItem('svnet-report-text-transfer',JSON.stringify({source:'Wert-1914-Rechner',heading:'Versicherungswert / Wert 1914',text,createdAt:new Date().toISOString()}));window.location.assign('/intern/versicherungsfaelle/?berichtstext=wert1914#vf-instructions')};syncDirection()})();
</script>
