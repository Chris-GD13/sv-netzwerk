---
import InternalLayout from '../../layouts/InternalLayout.astro';
---

<InternalLayout title="Intern" description="Geschützter Projektbereich für das SV-Netzwerk Prüfportal.">
  <section class="sv-section">
    <div class="sv-container">
      <div class="intern-card intern-login" aria-live="polite">
        <p class="sv-eyebrow">Prüfportal</p>
        <h1>Anmeldung wird geöffnet …</h1>
        <p><a class="sv-button sv-button-primary" href="/intern/login/">Zur Anmeldung</a></p>
      </div>
    </div>
  </section>
  <script is:inline>
    location.replace('/intern/login/');
  </script>
</InternalLayout>
