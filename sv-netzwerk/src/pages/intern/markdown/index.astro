---
import InternalLayout from '../../../layouts/InternalLayout.astro';
---

<InternalLayout title="Markdown-Konverter" description="Interner Konverter für PDF-, Word-, PowerPoint-, Excel- und CSV-Dateien.">
  <main class="md-app">
    <header class="md-head">
      <div>
        <p class="md-kicker">Interne Arbeitsunterlage</p>
        <h1>Dateien in Markdown umwandeln</h1>
        <p>Dokumente bleiben auf dem SV-Netzwerk-Server. Die Umwandlung läuft nur nach Anmeldung und erzeugt eine kopierbare Markdown-Fassung.</p>
      </div>
      <div class="md-badge">Geschützt · keine öffentliche Route</div>
    </header>

    <section class="md-card">
      <form id="md-form">
        <label class="md-drop" id="md-drop" for="md-file">
          <input id="md-file" type="file" accept=".pdf,.docx,.pptx,.xlsx,.csv">
          <span class="md-drop-icon">↥</span>
          <strong id="md-picked">Datei hierher ziehen oder auswählen</strong>
          <small>PDF · DOCX · PPTX · XLSX · CSV · bis 30 MB</small>
        </label>
        <div class="md-actions">
          <button id="md-submit" class="md-primary" type="submit">Umwandeln</button>
          <span id="md-status" role="status"></span>
        </div>
      </form>
    </section>

    <section id="md-result" class="md-card md-result" hidden>
      <div class="md-result-head"><div><p class="md-kicker">Ergebnis</p><h2 id="md-meta">Markdown</h2></div><div class="md-actions"><button id="md-copy" type="button">Kopieren</button><button id="md-download" type="button">Download .md</button></div></div>
      <div class="md-tabs"><button id="md-preview-tab" class="active" type="button">Vorschau</button><button id="md-raw-tab" type="button">Markdown</button></div>
      <article id="md-preview" class="md-preview"></article>
      <pre id="md-raw" hidden></pre>
    </section>
  </main>
</InternalLayout>

<style is:global>
  .md-app{max-width:1180px;padding:28px 34px 60px;color:#17324a}.md-head{display:flex;align-items:flex-end;justify-content:space-between;gap:18px;margin-bottom:16px}.md-kicker{margin:0 0 4px;color:#d67d00;font-size:.75rem;font-weight:900;letter-spacing:.06em;text-transform:uppercase}.md-head h1,.md-result h2{margin:0;color:#071a2e}.md-head p{max-width:760px;margin:7px 0 0;color:#627486}.md-badge{padding:9px 12px;border:1px solid #d9a34d;background:#fff8e9;color:#7b4a00;font-size:.78rem;font-weight:800;white-space:nowrap}.md-card{padding:18px;border:1px solid #d6dde2;border-top:4px solid #f59a23;background:#fff;box-shadow:0 2px 8px rgba(7,26,46,.06)}.md-drop{display:grid;place-items:center;gap:6px;min-height:220px;border:2px dashed #aebdca;background:#f7f9fa;text-align:center;cursor:pointer}.md-drop:hover,.md-drop.is-over{border-color:#17324a;background:#eef4f7}.md-drop input{position:absolute;inline-size:1px;block-size:1px;opacity:0}.md-drop-icon{display:grid;place-items:center;width:50px;height:50px;border-radius:50%;background:#17324a;color:#fff;font-size:1.8rem}.md-drop strong{font-size:1rem}.md-drop small{color:#6a7c8b}.md-actions{display:flex;align-items:center;gap:8px;margin-top:13px}.md-actions button{border:1px solid #17324a;background:#fff;color:#17324a;padding:9px 12px;font:inherit;font-weight:800;cursor:pointer}.md-actions .md-primary{background:#17324a;color:#fff}.md-actions button:disabled{cursor:wait;opacity:.6}.md-actions span{color:#687a89;font-size:.8rem}.md-result{margin-top:16px}.md-result-head{display:flex;align-items:center;justify-content:space-between;gap:12px}.md-result-head .md-actions{margin-top:0}.md-tabs{display:flex;gap:6px;margin:14px 0;border-bottom:1px solid #d6dde2}.md-tabs button{border:1px solid #c7d2da;border-bottom:0;background:#f7f9fa;color:#17324a;padding:8px 11px;font:inherit;font-size:.78rem;font-weight:800;cursor:pointer}.md-tabs button.active{background:#17324a;color:#fff}.md-preview,.md-raw{min-height:220px;max-height:680px;overflow:auto;padding:16px;background:#fbfcfc;border:1px solid #dfe5e9}.md-preview h1,.md-preview h2,.md-preview h3{color:#071a2e}.md-preview table{border-collapse:collapse;width:100%;font-size:.85rem}.md-preview th,.md-preview td{border:1px solid #cbd5dc;padding:7px;text-align:left;vertical-align:top}.md-preview th{background:#edf2f5}.md-preview code,.md-raw{font-family:ui-monospace,SFMono-Regular,Consolas,monospace}.md-raw{white-space:pre-wrap;font-size:.82rem;line-height:1.5}.md-error{color:#ae382f}.md-ok{color:#24713c}@media(max-width:720px){.md-app{padding:18px 12px 44px}.md-head,.md-result-head{align-items:flex-start;flex-direction:column}.md-badge{white-space:normal}.md-result-head .md-actions{margin-top:10px}}
</style>

<script is:inline>
  const $ = (id) => document.getElementById(id);
  const form = $('md-form'), input = $('md-file'), drop = $('md-drop'), picked = $('md-picked'), submit = $('md-submit'), status = $('md-status');
  const result = $('md-result'), preview = $('md-preview'), raw = $('md-raw'), meta = $('md-meta');
  const previewTab = $('md-preview-tab'), rawTab = $('md-raw-tab');
  let markdown = '', filename = '';
  const escapeHtml = (text) => String(text).replace(/[&<>"']/g, (c) => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
  const setStatus = (text, error = false) => { status.textContent = text; status.className = error ? 'md-error' : 'md-ok'; };
  const showPicked = () => { const file = input.files[0]; picked.textContent = file ? `${file.name} · ${(file.size / 1024 / 1024).toFixed(1)} MB` : 'Datei hierher ziehen oder auswählen'; };
  input.addEventListener('change', showPicked);
  ['dragenter','dragover'].forEach((event) => drop.addEventListener(event, (e) => { e.preventDefault(); drop.classList.add('is-over'); }));
  ['dragleave','drop'].forEach((event) => drop.addEventListener(event, (e) => { e.preventDefault(); drop.classList.remove('is-over'); }));
  drop.addEventListener('drop', (e) => { if (e.dataTransfer.files.length === 1) { input.files = e.dataTransfer.files; showPicked(); } });
  const renderMarkdown = (text) => {
    const lines = text.split(/\r?\n/), html = []; let inTable = false;
    for (const line of lines) {
      if (/^\|.*\|$/.test(line)) {
        const cells = line.slice(1,-1).split('|').map((cell) => `<td>${escapeHtml(cell.trim())}</td>`).join('');
        if (/^\|\s*:?-{3,}/.test(line)) continue;
        if (!inTable) { html.push('<table>'); inTable = true; }
        html.push(`<tr>${cells}</tr>`); continue;
      }
      if (inTable) { html.push('</table>'); inTable = false; }
      if (!line.trim()) continue;
      const heading = /^(#{1,3})\s+(.*)$/.exec(line); if (heading) { html.push(`<h${heading[1].length}>${escapeHtml(heading[2])}</h${heading[1].length}>`); continue; }
      if (/^[-*]\s+/.test(line)) { html.push(`<li>${escapeHtml(line.replace(/^[-*]\s+/,''))}</li>`); continue; }
      html.push(`<p>${escapeHtml(line)}</p>`);
    }
    if (inTable) html.push('</table>'); return html.join('');
  };
  const setView = (showRaw) => { raw.hidden = !showRaw; preview.hidden = showRaw; rawTab.classList.toggle('active', showRaw); previewTab.classList.toggle('active', !showRaw); };
  previewTab.onclick = () => setView(false); rawTab.onclick = () => setView(true);
  form.addEventListener('submit', async (event) => {
    event.preventDefault(); const file = input.files[0]; if (!file) return setStatus('Bitte zuerst eine Datei auswählen.', true);
    if (file.size > 30 * 1024 * 1024) return setStatus('Die Datei darf höchstens 30 MB groß sein.', true);
    submit.disabled = true; result.hidden = true; setStatus('Datei wird verarbeitet …');
    const body = new FormData(); body.append('file', file);
    try { const response = await fetch('/intern/api/markdown.php', { method: 'POST', body, credentials: 'same-origin' }); const data = await response.json(); if (!response.ok || !data.ok) throw new Error(data.error || `HTTP ${response.status}`); markdown = data.markdown; filename = data.filename; meta.textContent = `${file.name} · ${data.method || 'Markdown'}`; raw.textContent = markdown; preview.innerHTML = renderMarkdown(markdown); result.hidden = false; setView(false); setStatus('Umwandlung abgeschlossen.'); result.scrollIntoView({behavior:'smooth', block:'start'}); } catch (error) { setStatus(error.message || 'Die Umwandlung ist fehlgeschlagen.', true); } finally { submit.disabled = false; }
  });
  $('md-copy').onclick = async () => { try { await navigator.clipboard.writeText(markdown); setStatus('Markdown kopiert.'); } catch { setStatus('Kopieren nicht möglich.', true); } };
  $('md-download').onclick = () => { const a = document.createElement('a'); a.href = URL.createObjectURL(new Blob([markdown], {type:'text/markdown;charset=utf-8'})); a.download = filename || 'umwandlung.md'; a.click(); setTimeout(() => URL.revokeObjectURL(a.href), 1000); };
</script>

