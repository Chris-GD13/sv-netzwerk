---
import InternalLayout from '../../../layouts/InternalLayout.astro';
---

<InternalLayout title="Tagescockpit" description="Der tägliche Überblick über Fälle, Termine und verbundene Systeme.">
  <main class="dc-app">
    <header class="dc-head">
      <div>
        <p class="dc-kicker">Täglicher Arbeitsstand</p>
        <h1>Tagescockpit</h1>
        <p id="dc-profile">Fälle, Termine und Verbindungen werden geprüft …</p>
      </div>
      <div class="dc-head-actions">
        <span id="dc-updated">Noch nicht aktualisiert</span>
        <button id="dc-refresh" type="button">Jetzt prüfen</button>
      </div>
    </header>

    <nav class="dc-modes" aria-label="Tagescockpit Ansichten">
      <a class="active" href="/intern/tagescockpit/">Übersicht</a>
      <a href="/intern/arbeitszentrale/">Arbeitsorganisation</a>
    </nav>

    <section class="dc-summary" aria-label="Tagesübersicht">
      <a class="dc-summary-card" href="#dc-cases-section" aria-label="Fälle im Ordner anzeigen"><span>Fälle im Ordner</span><strong id="dc-case-count">–</strong><small id="dc-case-folder">Google Drive</small><em>Fälle anzeigen →</em></a>
      <a class="dc-summary-card" href="#dc-today-section" aria-label="Heutige Termine anzeigen"><span>Termine heute</span><strong id="dc-today-count">–</strong><small id="dc-next-event">Kalender wird geprüft</small><em>Termine anzeigen →</em></a>
      <a class="dc-summary-card" href="https://web.claimsforce.com/tasks" target="_blank" rel="noreferrer" aria-label="ClaimsForce-Aufgaben öffnen und bearbeiten"><span>Claims-Aufgaben</span><strong id="dc-claims-count">–</strong><small id="dc-claims-summary">ClaimsForce wird geprüft</small><em>In ClaimsForce bearbeiten ↗</em></a>
      <a class="dc-summary-card" href="#dc-cases-section" aria-label="Prüfhinweise in den zuletzt bearbeiteten Fällen anzeigen"><span>Prüfhinweise</span><strong id="dc-warning-count">–</strong><small>in den letzten 10 Fällen</small><em>Betroffene Fälle anzeigen →</em></a>
    </section>

    <div class="dc-columns">
      <section class="dc-card" id="dc-today-section">
        <div class="dc-title"><div><span class="dc-step">1</span><h2>Heute</h2></div><a href="/intern/kalender/">Kalender öffnen</a></div>
        <div id="dc-events" class="dc-list"><p class="dc-empty">Termine werden geladen …</p></div>
      </section>

      <section class="dc-card dc-reminders">
        <div class="dc-title"><div><span class="dc-step">2</span><h2>Wiedervorlagen</h2></div><small id="dc-reminder-summary">werden geladen …</small></div>
        <form id="dc-reminder-form" class="dc-reminder-form">
          <input id="dc-reminder-id" type="hidden">
          <input id="dc-reminder-title" maxlength="300" required placeholder="Neue Aufgabe">
          <input id="dc-reminder-due" type="datetime-local" required aria-label="Fällig am">
          <select id="dc-reminder-priority" aria-label="Priorität"><option value="normal">Normal</option><option value="hoch">Hoch</option><option value="dringend">Dringend</option></select>
          <textarea id="dc-reminder-note" rows="2" maxlength="10000" placeholder="Notiz (optional)"></textarea>
          <label><input id="dc-reminder-case" type="checkbox"> Mit aktivem Fall verknüpfen</label>
          <div class="dc-reminder-actions"><button type="submit">Speichern</button><button id="dc-reminder-reset" class="secondary" type="button">Leeren</button></div>
          <p id="dc-reminder-state" aria-live="polite"></p>
        </form>
        <div id="dc-reminder-list" class="dc-reminder-list"><p class="dc-empty">Wiedervorlagen werden geladen …</p></div>
      </section>

      <section class="dc-card dc-phone" id="dc-phone-section">
        <div class="dc-title"><div><span class="dc-step">3</span><h2>Telefon</h2></div><a href="/intern/telefon/">Zentrale öffnen</a></div>
        <div class="dc-phone-dial"><input id="dc-phone-number" type="tel" inputmode="tel" autocomplete="tel" placeholder="Telefonnummer"><button id="dc-phone-dial" type="button">Anrufen</button></div>
        <div class="dc-phone-control"><button type="button" data-dc-phone-action="answer">Annehmen</button><button type="button" data-dc-phone-action="drop">Auflegen</button></div>
        <p id="dc-phone-state" class="dc-phone-state" aria-live="polite">xtelsio-Steuerung bereit</p>
        <div id="dc-phone-case" class="dc-phone-case">Kein aktiver Schadenfall.</div>
        <div id="dc-phone-contacts" class="dc-phone-contacts"></div>
        <details class="dc-speed-dials" open>
          <summary>Kurzwahl</summary>
          <div id="dc-speed-dial-list" class="dc-speed-dial-list"></div>
          <form id="dc-speed-dial-form" class="dc-speed-dial-form">
            <input id="dc-speed-dial-name" type="text" autocomplete="off" placeholder="Name, z. B. Marc Handy" aria-label="Name der Kurzwahl" required>
            <input id="dc-speed-dial-number" type="tel" inputmode="tel" autocomplete="tel" placeholder="Telefonnummer" aria-label="Telefonnummer der Kurzwahl" required>
            <button id="dc-speed-dial-save" type="submit">Speichern</button>
          </form>
        </details>
      </section>
    </div>

    <section class="dc-card" id="dc-cases-section">
      <div class="dc-title"><div><span class="dc-step">4</span><h2>Zuletzt bearbeitete Fälle</h2></div><a href="/intern/versicherungsfaelle/">Alle Fälle</a></div>
      <div id="dc-cases" class="dc-case-grid"><p class="dc-empty">Fälle werden geladen …</p></div>
    </section>

    <section class="dc-card">
      <div class="dc-title"><div><span class="dc-step">5</span><h2>Schnellzugriffe</h2></div></div>
      <nav class="dc-quick" aria-label="Schnellzugriffe">
        <a href="/intern/arbeitszentrale/"><strong>Arbeitsorganisation</strong><span>Fristen, Suche, Prüfung und Vor-Ort-Notizen</span></a>
        <a href="/intern/versicherungsfaelle/"><strong>Versicherungsfälle</strong><span>Fall öffnen, Unterlagen und Berichte</span></a>
        <a href="/intern/telefon/"><strong>Telefonzentrale</strong><span>Wählen, annehmen und Anrufer zuordnen</span></a>
        <a href="/intern/kalkulation/"><strong>Kalkulation</strong><span>KVA prüfen und Schaden kalkulieren</span></a>
        <a href="/intern/zeitwertberechnung/"><strong>Zeitwert</strong><span>Neu für Alt berechnen</span></a>
        <a id="dc-quick-settlement" href="/intern/abrechnungen/" hidden><strong>Abrechnungen</strong><span>Claims und Rekon auswerten</span></a>
      </nav>
    </section>
  </main>
</InternalLayout>

<style is:global>
  .dc-app{box-sizing:border-box;min-height:calc(100vh - 112px);padding:20px;color:#17324a}.dc-head{display:flex;align-items:flex-end;justify-content:space-between;gap:16px;margin-bottom:13px}.dc-kicker{margin:0;color:#f59a23;font-size:.78rem;font-weight:900;text-transform:uppercase;letter-spacing:.05em}.dc-head h1{margin:2px 0;font-size:1.9rem}.dc-head p{margin:0;color:#647789}.dc-head-actions{display:flex;align-items:center;gap:8px;color:#647789;font-size:.75rem}.dc-head-actions button,.dc-title a{border:1px solid #17324a;background:#17324a;color:#fff;padding:8px 10px;border-radius:3px;font:inherit;font-weight:800;text-decoration:none;cursor:pointer}.dc-head-actions button:disabled{cursor:wait;opacity:.65}.dc-summary{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:9px;margin-bottom:10px}.dc-summary-card{display:block;padding:12px 14px;border-top:3px solid #f59a23;background:#fff;color:inherit;text-decoration:none;box-shadow:0 1px 3px rgba(7,26,46,.1);transition:transform .15s ease,box-shadow .15s ease}.dc-summary-card:hover,.dc-summary-card:focus-visible{outline:2px solid #17324a;outline-offset:2px;transform:translateY(-2px);box-shadow:0 5px 14px rgba(7,26,46,.16)}.dc-summary span,.dc-summary small{display:block;color:#647789}.dc-summary span{font-size:.74rem;font-weight:800}.dc-summary strong{display:block;margin:2px 0;color:#071a2e;font-size:1.45rem}.dc-summary small{overflow:hidden;font-size:.69rem;text-overflow:ellipsis;white-space:nowrap}.dc-summary em{display:block;margin-top:7px;color:#17324a;font-size:.66rem;font-style:normal;font-weight:900}.dc-columns{display:grid;grid-template-columns:minmax(0,1.05fr) minmax(320px,.95fr) minmax(280px,.8fr);gap:10px;margin-bottom:10px}.dc-card{padding:14px;border:1px solid #d5dde3;background:#fff;scroll-margin-top:18px}.dc-title{display:flex;align-items:center;justify-content:space-between;gap:10px;margin-bottom:10px}.dc-title>div{display:flex;align-items:center;gap:8px}.dc-title h2{margin:0;color:#071a2e;font-size:1.02rem}.dc-title small{color:#718291}.dc-title a{padding:6px 8px;background:#fff;color:#17324a;font-size:.7rem}.dc-step{display:grid;width:25px;height:25px;place-items:center;background:#17324a;color:#fff;font-size:.82rem;font-weight:900}.dc-list{display:grid;gap:6px}.dc-event{display:grid;grid-template-columns:68px 1fr;gap:9px;padding:8px;border-left:3px solid #f59a23;background:#f3f6f8;color:#17324a;text-decoration:none}.dc-event time{font-weight:900}.dc-event strong,.dc-event span{display:block}.dc-event span{margin-top:2px;color:#647789;font-size:.74rem}.dc-empty{margin:0;padding:14px;background:#f3f6f8;color:#718291}.dc-systems{display:grid;gap:6px}.dc-system{display:flex;align-items:center;gap:9px;padding:8px;background:#f3f6f8}.dc-system i{width:10px;height:10px;flex:0 0 auto;border-radius:50%;background:#a6b2bc;box-shadow:0 0 0 3px rgba(166,178,188,.18)}.dc-system.ok i{background:#2f8a4b;box-shadow:0 0 0 3px rgba(47,138,75,.15)}.dc-system.warn i{background:#d38a17;box-shadow:0 0 0 3px rgba(211,138,23,.16)}.dc-system.bad i{background:#b63c35;box-shadow:0 0 0 3px rgba(182,60,53,.14)}.dc-system strong,.dc-system span{display:block}.dc-system span{margin-top:1px;color:#647789;font-size:.71rem}.dc-note{margin:7px 0 0;padding:7px 8px;border-left:3px solid #f59a23;background:#fff7e9;color:#596d7d;font-size:.7rem}.dc-phone-dial{display:grid;grid-template-columns:1fr auto;gap:6px}.dc-phone-dial input{min-width:0;padding:9px;border:1px solid #b9c7d1;border-radius:3px;color:#17324a;font:inherit}.dc-phone-dial button,.dc-phone-control button,.dc-phone-contacts button,.dc-speed-dial-form button{border:1px solid #17324a;background:#17324a;color:#fff;padding:8px 9px;font:inherit;font-size:.72rem;font-weight:900;cursor:pointer}.dc-phone-control{display:grid;grid-template-columns:1fr 1fr;gap:6px;margin-top:6px}.dc-phone-control button:last-child{border-color:#a33434;background:#a33434}.dc-phone-state{margin:7px 0;color:#647789;font-size:.7rem}.dc-phone-case{padding:8px;border-left:3px solid #2f8f67;background:#edf7f2;font-size:.72rem;font-weight:800}.dc-phone-contacts{display:grid;gap:5px;margin-top:6px}.dc-phone-contacts button{display:flex;justify-content:space-between;gap:7px;width:100%;border-color:#cbd6dd;background:#f3f6f8;color:#17324a;text-align:left}.dc-phone-contacts button small{overflow:hidden;color:#647789;text-overflow:ellipsis;white-space:nowrap}.dc-speed-dials{margin-top:9px;border-top:1px solid #dbe2e7;padding-top:8px}.dc-speed-dials summary{cursor:pointer;font-size:.76rem;font-weight:900}.dc-speed-dial-list{display:grid;gap:5px;margin-top:7px}.dc-speed-dial-row{display:grid;grid-template-columns:minmax(0,1fr) auto auto;gap:4px}.dc-speed-dial-call,.dc-speed-dial-edit,.dc-speed-dial-remove{border:1px solid #cbd6dd;background:#f3f6f8;color:#17324a;padding:7px;font:inherit;font-size:.69rem;font-weight:800;cursor:pointer}.dc-speed-dial-call{display:flex;justify-content:space-between;gap:6px;overflow:hidden;text-align:left}.dc-speed-dial-call span,.dc-speed-dial-call small{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.dc-speed-dial-call small{color:#647789}.dc-speed-dial-call:disabled{cursor:default;opacity:.65}.dc-speed-dial-remove{color:#a33434}.dc-speed-dial-form{display:grid;grid-template-columns:1fr 1fr auto;gap:5px;margin-top:7px}.dc-speed-dial-form input{min-width:0;border:1px solid #b9c7d1;border-radius:3px;padding:7px;color:#17324a;font:inherit;font-size:.7rem}.dc-case-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:7px}.dc-case{display:flex;justify-content:space-between;gap:10px;padding:10px;border:1px solid #d8e0e5;background:#fafbfb}.dc-case h3{margin:0;color:#071a2e;font-size:.86rem}.dc-case p{margin:3px 0 0;color:#647789;font-size:.72rem}.dc-case ul{margin:6px 0 0;padding-left:17px;color:#a0442f;font-size:.69rem}.dc-case button{align-self:center;flex:0 0 auto;border:1px solid #17324a;background:#fff;color:#17324a;padding:6px 8px;font:inherit;font-size:.69rem;font-weight:800;cursor:pointer}.dc-quick{display:grid;grid-template-columns:repeat(6,minmax(0,1fr));gap:7px}.dc-quick a{padding:10px;border-left:3px solid #f59a23;background:#f3f6f8;color:#17324a;text-decoration:none}.dc-quick a[hidden]{display:none}.dc-quick strong,.dc-quick span{display:block}.dc-quick span{margin-top:2px;color:#647789;font-size:.69rem}@media(max-width:1400px){.dc-columns{grid-template-columns:repeat(2,minmax(0,1fr))}.dc-phone{grid-column:1/-1}.dc-phone-contacts{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:1250px){.dc-quick{grid-template-columns:repeat(3,minmax(0,1fr))}}@media(max-width:1100px){.dc-summary{grid-template-columns:repeat(2,minmax(0,1fr))}.dc-columns{grid-template-columns:1fr}.dc-phone{grid-column:auto}.dc-quick{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:680px){.dc-app{padding:12px}.dc-head{align-items:flex-start;flex-direction:column}.dc-head-actions{width:100%;justify-content:space-between}.dc-summary,.dc-case-grid,.dc-quick,.dc-phone-contacts{grid-template-columns:1fr}.dc-speed-dial-form{grid-template-columns:1fr}}
  .dc-modes{display:flex;gap:5px;margin:-2px 0 12px;border-bottom:1px solid #cbd5dc}.dc-modes a{padding:9px 13px;color:#17324a;text-decoration:none;font-weight:900}.dc-modes a.active{background:#17324a;color:#fff}.dc-reminder-form{display:grid;grid-template-columns:minmax(0,1fr) 170px 105px;gap:6px}.dc-reminder-form input,.dc-reminder-form select,.dc-reminder-form textarea{box-sizing:border-box;min-width:0;width:100%;border:1px solid #b9c7d1;border-radius:3px;padding:8px;color:#17324a;font:inherit;font-size:.76rem}.dc-reminder-form textarea{grid-column:1/-1;resize:vertical}.dc-reminder-form label{display:flex;align-items:center;gap:6px;color:#647789;font-size:.72rem}.dc-reminder-form label input{width:auto}.dc-reminder-actions{display:flex;justify-content:flex-end;gap:5px}.dc-reminder-actions button,.dc-reminder-item button{border:1px solid #17324a;background:#17324a;color:#fff;padding:7px 9px;font:inherit;font-size:.7rem;font-weight:900;cursor:pointer}.dc-reminder-actions .secondary,.dc-reminder-item button{background:#fff;color:#17324a}.dc-reminder-form p{grid-column:1/-1;min-height:1em;margin:0;color:#647789;font-size:.7rem}.dc-reminder-form p.ok{color:#24713c}.dc-reminder-form p.bad{color:#ae382f}.dc-reminder-list{display:grid;gap:5px;max-height:205px;margin-top:8px;overflow:auto}.dc-reminder-item{display:flex;align-items:center;justify-content:space-between;gap:8px;padding:8px;border-left:3px solid #93a3af;background:#f3f6f8}.dc-reminder-item[data-priority="hoch"]{border-left-color:#d38a17}.dc-reminder-item[data-priority="dringend"],.dc-reminder-item.overdue{border-left-color:#b63c35}.dc-reminder-item strong,.dc-reminder-item small{display:block}.dc-reminder-item small{margin-top:2px;color:#647789;font-size:.69rem}.dc-reminder-item div:last-child{display:flex;gap:4px;flex:0 0 auto}@media(max-width:900px){.dc-reminder-form{grid-template-columns:1fr 1fr}.dc-reminder-form input:first-of-type,.dc-reminder-form textarea{grid-column:1/-1}}@media(max-width:680px){.dc-reminder-form{grid-template-columns:1fr}.dc-reminder-form>*{grid-column:1!important}.dc-reminder-item{align-items:flex-start;flex-direction:column}}
</style>

<script is:inline>
(() => {
  const $=id=>document.getElementById(id),esc=value=>String(value??'').replace(/[&<>"']/g,char=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[char]));
  const request=async(url,options={})=>{const response=await fetch(url,{credentials:'same-origin',cache:'no-store',...options}),data=await response.json().catch(()=>({}));if(!response.ok||data.ok===false)throw Error(data.error||`HTTP ${response.status}`);return data};
  const postReminder=(action,body)=>request(`/intern/api/work-center.php?action=${action}`,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(body)});
  const profileNames={christian:'Christian Wächter',holger:'Holger Roth',marc:'Marc Schütt',jens:'Jens Maurer'};
  const setSystem=(key,kind,text)=>{const row=document.querySelector(`[data-system="${key}"]`);if(!row)return;row.className=`dc-system ${kind}`;row.querySelector('span').textContent=text};
  const localIso=date=>{const pad=n=>String(n).padStart(2,'0');return `${date.getFullYear()}-${pad(date.getMonth()+1)}-${pad(date.getDate())}`};
  const monday=value=>{const date=new Date(value);date.setHours(12,0,0,0);const day=date.getDay()||7;date.setDate(date.getDate()-day+1);return date};
  const formatTime=value=>new Intl.DateTimeFormat('de-DE',{hour:'2-digit',minute:'2-digit'}).format(new Date(value));
  const reminderInput=value=>{const date=value?new Date(String(value).replace(' ','T')+'Z'):new Date(Date.now()+86400000);return new Date(date.getTime()-date.getTimezoneOffset()*60000).toISOString().slice(0,16)};
  const reminderDate=value=>new Intl.DateTimeFormat('de-DE',{dateStyle:'medium',timeStyle:'short'}).format(new Date(String(value).replace(' ','T')+'Z'));
  const required=[['schaden_nr','Schaden-Nr.'],['vn_objekt','VN / Objekt'],['schadenart','Schadenart'],['schaden_ort','Schadenort']];
  let recentCases=[],reminders=[];
  const activeCase=()=>{for(const store of[sessionStorage,localStorage])try{const value=JSON.parse(store.getItem('svnet-case')||'null');if(value?.folder_id)return value}catch{}return null};
  const mobile=()=>navigator.userAgentData?.mobile??/Android|iPhone|iPad|iPod/i.test(navigator.userAgent);
  const dial=number=>{const clean=String(number||'').trim().replace(/[^\d+*#]/g,'');if(!clean){$('dc-phone-state').textContent='Bitte eine Telefonnummer eingeben.';return}$('dc-phone-state').textContent=`${clean} wird an ${mobile()?'die Telefon-App':'xtelsio'} übergeben …`;location.href=mobile()?`tel:${clean}`:`svnet-xtelsio://dial?number=${encodeURIComponent(clean)}`};
  const speedDialKey='svnet-phone-speed-dials-v1',defaultSpeedDials=[{name:'Christian Handy',number:'01604092134'},{name:'Marc Handy',number:''},{name:'Cedric Kalabis',number:''}];
  let speedDials=[],speedDialEdit=-1;
  const cleanPhone=number=>String(number||'').trim().replace(/[^\d+*#]/g,'');
  function readSpeedDials(){const stored=localStorage.getItem(speedDialKey);if(stored===null){localStorage.setItem(speedDialKey,JSON.stringify(defaultSpeedDials));return defaultSpeedDials.map(row=>({...row}))}try{const rows=JSON.parse(stored);if(Array.isArray(rows))return rows.map(row=>({name:String(row?.name||'').trim(),number:cleanPhone(row?.number)})).filter(row=>row.name)}catch{}return defaultSpeedDials.map(row=>({...row}))}
  const saveSpeedDials=()=>localStorage.setItem(speedDialKey,JSON.stringify(speedDials));
  function resetSpeedDialForm(){speedDialEdit=-1;$('dc-speed-dial-form').reset();$('dc-speed-dial-save').textContent='Speichern'}
  function renderSpeedDials(){const list=$('dc-speed-dial-list');list.innerHTML='';speedDials.forEach((entry,index)=>{const row=document.createElement('div'),call=document.createElement('button'),name=document.createElement('span'),number=document.createElement('small'),edit=document.createElement('button'),remove=document.createElement('button');row.className='dc-speed-dial-row';call.type=edit.type=remove.type='button';call.className='dc-speed-dial-call';edit.className='dc-speed-dial-edit';remove.className='dc-speed-dial-remove';name.textContent=entry.name;number.textContent=entry.number||'Nummer eintragen';call.append(name,number);call.disabled=!entry.number;call.onclick=()=>dial(entry.number);edit.textContent='Ändern';edit.setAttribute('aria-label',`${entry.name} ändern`);edit.onclick=()=>{speedDialEdit=index;$('dc-speed-dial-name').value=entry.name;$('dc-speed-dial-number').value=entry.number;$('dc-speed-dial-save').textContent='Änderung speichern';$('dc-speed-dial-number').focus()};remove.textContent='×';remove.setAttribute('aria-label',`${entry.name} entfernen`);remove.onclick=()=>{speedDials.splice(index,1);saveSpeedDials();renderSpeedDials();resetSpeedDialForm()};row.append(call,edit,remove);list.append(row)})}
  const phoneContacts=meta=>[['VN Telefon',meta.telefon],['VN Mobil',meta.mobil],['Sanierer Telefon',meta.sanierer_telefon],['Sanierer Mobil',meta.sanierer_mobil],...(Array.isArray(meta.telefonkontakte)?meta.telefonkontakte.map(row=>[row.name||'Ansprechpartner',row.nummer]):[])].filter(([,number])=>String(number||'').trim()).slice(0,4);
  function loadPhone(){const active=activeCase(),caseBox=$('dc-phone-case'),contacts=$('dc-phone-contacts');contacts.innerHTML='';if(!active){caseBox.textContent='Kein aktiver Schadenfall.';return}const meta=active.meta||{};caseBox.textContent=[meta.schaden_nr||'Fall ohne Schaden-Nr.',meta.vn_objekt].filter(Boolean).join(' · ');for(const [label,number] of phoneContacts(meta)){const button=document.createElement('button'),name=document.createElement('span'),value=document.createElement('small');button.type='button';name.textContent=label;value.textContent=number;button.append(name,value);button.onclick=()=>dial(number);contacts.append(button)}}

  function resetReminder(){const active=activeCase();$('dc-reminder-id').value='';$('dc-reminder-title').value='';$('dc-reminder-due').value=reminderInput();$('dc-reminder-priority').value='normal';$('dc-reminder-note').value='';$('dc-reminder-case').checked=Boolean(active)}
  async function loadReminders(){
    const data=await request('/intern/api/work-center.php?action=list'),summary=data.summary||{};reminders=Array.isArray(data.items)?data.items.filter(item=>item.status==='open'):[];
    $('dc-reminder-summary').textContent=`${summary.open||0} offen · ${summary.overdue||0} überfällig`;
    const now=Date.now();$('dc-reminder-list').innerHTML=reminders.length?reminders.map(item=>{const overdue=item.status==='open'&&new Date(String(item.due_at).replace(' ','T')+'Z').getTime()<now;return `<article class="dc-reminder-item ${overdue?'overdue':''}" data-priority="${esc(item.priority)}"><div><strong>${esc(item.title)}</strong><small>${esc(reminderDate(item.due_at))}${item.case_no?' · Fall '+esc(item.case_no):''}${item.note?' · '+esc(item.note):''}</small></div><div><button type="button" data-reminder-edit="${item.id}">Ändern</button><button type="button" data-reminder-done="${item.id}">Erledigt</button></div></article>`}).join(''):'<p class="dc-empty">Keine offenen Wiedervorlagen vorhanden.</p>';
  }

  async function loadDrive(){
    const [status,recent]=await Promise.all([request('/intern/api/google-drive-sync.php?action=status'),request('/intern/api/google-drive-sync.php?action=recent_cases')]);
    const profile=String(status.backoffice?status.selected_expert:status.claims_profile||'');
    $('dc-profile').textContent=`Arbeitsstand für ${profileNames[profile]||'das ausgewählte Profil'}`;
    $('dc-case-count').textContent=String(status.folders?.cases?.items??0);$('dc-case-folder').textContent=status.folders?.cases?.name||'Fallordner';
    setSystem('drive','ok',`${status.folders?.cases?.items??0} Fälle · ${status.cached?'geprüfter Zwischenspeicher':'direkt verbunden'}`);
    recentCases=Array.isArray(recent.results)?recent.results:[];let warnings=0;
    $('dc-cases').innerHTML=recentCases.length?recentCases.map((row,index)=>{const meta=row.meta||{},missing=required.filter(([key])=>!String(meta[key]||'').trim()).map(([,label])=>label);warnings+=missing.length;const title=meta.schaden_nr||row.name||'Fall ohne Schaden-Nr.',object=meta.vn_objekt||meta.versicherungsnehmer||'VN / Objekt noch offen',place=[meta.schaden_plz,meta.schaden_ort].filter(Boolean).join(' ');return `<article class="dc-case"><div><h3>${esc(title)}</h3><p>${esc(object)}${place?' · '+esc(place):''}</p>${missing.length?`<ul>${missing.map(item=>`<li>${esc(item)} fehlt</li>`).join('')}</ul>`:'<p>Pflichtangaben für das Cockpit vollständig.</p>'}</div><button type="button" data-open-case="${index}">Fall öffnen</button></article>`}).join(''):'<p class="dc-empty">Keine zuletzt bearbeiteten Fälle gefunden.</p>';
    $('dc-warning-count').textContent=String(warnings);
  }

  async function loadCalendar(){
    const data=await request('/intern/api/outlook-case-calendar.php?action=list&start='+encodeURIComponent(localIso(monday(new Date())))),today=localIso(new Date()),events=(data.events||[]).filter(event=>String(event.start||'').slice(0,10)===today);
    $('dc-today-count').textContent=String(events.length);$('dc-next-event').textContent=events[0]?`${formatTime(events[0].start)} · ${events[0].subject}`:'Heute keine Termine';
    $('dc-events').innerHTML=events.length?events.map(event=>{const body=`<time>${esc(event.all_day?'ganztägig':formatTime(event.start))}</time><div><strong>${esc(event.subject)}</strong>${event.location?`<span>${esc(event.location)}</span>`:''}</div>`;return event.web_link?`<a class="dc-event" href="${esc(event.web_link)}" target="_blank" rel="noreferrer">${body}</a>`:`<div class="dc-event">${body}</div>`}).join(''):'<p class="dc-empty">Heute sind keine Termine eingetragen.</p>';
    setSystem('outlook','ok',`${data.calendar||'Kalender'} · ${data.events?.length||0} Termine diese Woche`);
  }

  async function loadClaims(){
    const summary=await request('/intern/api/claimsforce-queue.php?action=summary'),items=summary.items||[],open=items.reduce((sum,item)=>sum+(Number.isFinite(Number(item.open_count))?Number(item.open_count):0),0);
    $('dc-claims-count').textContent=items.some(item=>item.open_count!==null)?String(open):'–';$('dc-claims-summary').textContent=items.map(item=>`${item.label}: ${item.open_count??'–'}`).join(' · ')||'Kein Aufgabenstand';
  }

  async function loadRevenue(){
    const data=await request('/intern/api/revenue-summary-v2.php?action=access');
    $('dc-quick-settlement').hidden=data.show_settlement_link!==true;
    if(!data.visible){setSystem('revenue','ok','Für dieses Profil nicht eingeblendet');return}
    const stamp=data.summary_type==='holger'?[data.claims?.updated_at,data.rekon?.updated_at].filter(Boolean).join(' · '):data.source_updated_at;
    setSystem('revenue',stamp?'ok':'warn',stamp?`Datenstand ${stamp}`:'Noch kein Datenstand gespeichert');
  }

  async function load(){
    const button=$('dc-refresh');button.disabled=true;$('dc-updated').textContent='Prüfung läuft …';
    const tasks=[['drive',loadDrive],['outlook',loadCalendar],['claims',loadClaims],['revenue',loadRevenue],['reminders',loadReminders]],results=await Promise.allSettled(tasks.map(([,fn])=>fn()));
    results.forEach((result,index)=>{if(result.status==='rejected'){const key=tasks[index][0];if(key==='reminders'){$('dc-reminder-summary').textContent='nicht erreichbar';$('dc-reminder-list').innerHTML=`<p class="dc-empty">${esc(result.reason?.message||'Wiedervorlagen konnten nicht geladen werden.')}</p>`;return}setSystem(key,'bad',result.reason?.message||'Verbindung fehlgeschlagen');if(key==='outlook'){$('dc-today-count').textContent='–';$('dc-next-event').textContent='Kalender nicht erreichbar';$('dc-events').innerHTML='<p class="dc-empty">Kalender konnte nicht geladen werden.</p>'}}});
    $('dc-updated').textContent='Geprüft '+new Intl.DateTimeFormat('de-DE',{hour:'2-digit',minute:'2-digit',second:'2-digit'}).format(new Date());button.disabled=false;
  }
  $('dc-refresh').addEventListener('click',load);
  $('dc-reminder-form').addEventListener('submit',async event=>{event.preventDefault();const state=$('dc-reminder-state'),active=activeCase(),meta=active?.meta||{};state.className='';state.textContent='Wird gespeichert …';try{await postReminder('save',{id:$('dc-reminder-id').value,title:$('dc-reminder-title').value,due_at:$('dc-reminder-due').value,priority:$('dc-reminder-priority').value,note:$('dc-reminder-note').value,case_folder_id:$('dc-reminder-case').checked?active?.folder_id||'':'',case_no:$('dc-reminder-case').checked?meta.schaden_nr||'':''});resetReminder();state.className='ok';state.textContent='Wiedervorlage gespeichert.';await loadReminders()}catch(error){state.className='bad';state.textContent=error.message}});
  $('dc-reminder-reset').addEventListener('click',resetReminder);
  $('dc-reminder-list').addEventListener('click',async event=>{const edit=event.target.closest('[data-reminder-edit]'),done=event.target.closest('[data-reminder-done]');if(edit){const item=reminders.find(row=>row.id===Number(edit.dataset.reminderEdit));if(!item)return;$('dc-reminder-id').value=item.id;$('dc-reminder-title').value=item.title;$('dc-reminder-due').value=reminderInput(item.due_at);$('dc-reminder-priority').value=item.priority;$('dc-reminder-note').value=item.note||'';$('dc-reminder-case').checked=Boolean(item.case_folder_id);$('dc-reminder-title').focus()}if(done){done.disabled=true;try{await postReminder('complete',{id:Number(done.dataset.reminderDone)});await loadReminders()}catch(error){done.disabled=false;alert(error.message)}}});
  $('dc-phone-dial').addEventListener('click',()=>dial($('dc-phone-number').value));$('dc-phone-number').addEventListener('keydown',event=>{if(event.key==='Enter'){event.preventDefault();dial(event.currentTarget.value)}});
  $('dc-speed-dial-form').addEventListener('submit',event=>{event.preventDefault();const name=$('dc-speed-dial-name').value.trim(),number=cleanPhone($('dc-speed-dial-number').value);if(!name||!number)return;if(speedDialEdit>=0)speedDials[speedDialEdit]={name,number};else speedDials.push({name,number});saveSpeedDials();renderSpeedDials();resetSpeedDialForm();$('dc-phone-state').textContent=`Kurzwahl „${name}“ gespeichert.`});
  document.querySelectorAll('[data-dc-phone-action]').forEach(button=>button.addEventListener('click',()=>{const action=button.dataset.dcPhoneAction;$('dc-phone-state').textContent=action==='answer'?'Gespräch wird über xtelsio angenommen …':'Gespräch wird über xtelsio beendet …';location.href=`svnet-xtelsio://${action}`}));
  $('dc-cases').addEventListener('click',event=>{const button=event.target.closest('[data-open-case]');if(!button)return;const row=recentCases[Number(button.dataset.openCase)];if(!row?.id)return;const selected={folder_id:row.id,meta:row.meta||{}};sessionStorage.setItem('svnet-case',JSON.stringify(selected));localStorage.setItem('svnet-case',JSON.stringify(selected));location.assign('/intern/versicherungsfaelle/')});
  speedDials=readSpeedDials();renderSpeedDials();resetReminder();loadPhone();load();
})();
</script>
