---
import InternalLayout from '../../../layouts/InternalLayout.astro';
---

<InternalLayout title="Tagescockpit" description="Der tägliche Überblick über Fälle, Termine und verbundene Systeme.">
  <main class="dc-app">
    <header class="dc-head">
      <div>
        <p class="dc-kicker">Täglicher Arbeitsstand</p>
        <h1>Tagescockpit</h1>
        <p id="dc-profile">Fälle, Termine und Verbindungen werden geprüft …</p>
      </div>
      <div class="dc-head-actions">
        <span id="dc-updated">Noch nicht aktualisiert</span>
        <button id="dc-refresh" type="button">Jetzt prüfen</button>
      </div>
    </header>

    <section class="dc-summary" aria-label="Tagesübersicht">
      <article><span>Fälle im Ordner</span><strong id="dc-case-count">–</strong><small id="dc-case-folder">Google Drive</small></article>
      <article><span>Termine heute</span><strong id="dc-today-count">–</strong><small id="dc-next-event">Kalender wird geprüft</small></article>
      <article><span>Claims-Aufgaben</span><strong id="dc-claims-count">–</strong><small id="dc-claims-summary">ClaimsForce wird geprüft</small></article>
      <article><span>Prüfhinweise</span><strong id="dc-warning-count">–</strong><small>in den letzten 10 Fällen</small></article>
    </section>

    <div class="dc-columns">
      <section class="dc-card">
        <div class="dc-title"><div><span class="dc-step">1</span><h2>Heute</h2></div><a href="/intern/kalender/">Kalender öffnen</a></div>
        <div id="dc-events" class="dc-list"><p class="dc-empty">Termine werden geladen …</p></div>
      </section>

      <section class="dc-card">
        <div class="dc-title"><div><span class="dc-step">2</span><h2>Systemstatus</h2></div><small>nur lesende Prüfung</small></div>
        <div class="dc-systems">
          <div class="dc-system" data-system="drive"><i></i><div><strong>Google Drive</strong><span>Prüfung läuft …</span></div></div>
          <div class="dc-system" data-system="outlook"><i></i><div><strong>Outlook-Kalender</strong><span>Prüfung läuft …</span></div></div>
          <div class="dc-system" data-system="claims"><i></i><div><strong>ClaimsForce-Warteschlange</strong><span>Prüfung läuft …</span></div></div>
          <div class="dc-system" data-system="revenue"><i></i><div><strong>Abrechnungsstand</strong><span>Prüfung läuft …</span></div></div>
        </div>
        <p id="dc-auto-run" class="dc-note">Nächster automatischer ClaimsForce-Lauf wird berechnet …</p>
      </section>
    </div>

    <section class="dc-card">
      <div class="dc-title"><div><span class="dc-step">3</span><h2>Zuletzt bearbeitete Fälle</h2></div><a href="/intern/versicherungsfaelle/">Alle Fälle</a></div>
      <div id="dc-cases" class="dc-case-grid"><p class="dc-empty">Fälle werden geladen …</p></div>
    </section>

    <section class="dc-card">
      <div class="dc-title"><div><span class="dc-step">4</span><h2>Schnellzugriffe</h2></div></div>
      <nav class="dc-quick" aria-label="Schnellzugriffe">
        <a href="/intern/arbeitszentrale/"><strong>Arbeitszentrale</strong><span>Fristen, Suche, Prüfung und Vor-Ort-Notizen</span></a>
        <a href="/intern/versicherungsfaelle/"><strong>Versicherungsfälle</strong><span>Fall öffnen, Unterlagen und Berichte</span></a>
        <a href="/intern/telefon/"><strong>Telefonzentrale</strong><span>Wählen, annehmen und Anrufer zuordnen</span></a>
        <a href="/intern/kalkulation/"><strong>Kalkulation</strong><span>KVA prüfen und Schaden kalkulieren</span></a>
        <a href="/intern/zeitwertberechnung/"><strong>Zeitwert</strong><span>Neu für Alt berechnen</span></a>
        <a id="dc-quick-settlement" href="/intern/abrechnungen/" hidden><strong>Abrechnungen</strong><span>Claims und Rekon auswerten</span></a>
      </nav>
    </section>
  </main>
</InternalLayout>

<style is:global>
  .dc-app{box-sizing:border-box;min-height:calc(100vh - 112px);padding:26px;color:#17324a}.dc-head{display:flex;align-items:flex-end;justify-content:space-between;gap:20px;margin-bottom:18px}.dc-kicker{margin:0;color:#f59a23;font-size:.82rem;font-weight:900;text-transform:uppercase;letter-spacing:.05em}.dc-head h1{margin:3px 0;font-size:2.1rem}.dc-head p{margin:0;color:#647789}.dc-head-actions{display:flex;align-items:center;gap:10px;color:#647789;font-size:.78rem}.dc-head-actions button,.dc-title a{border:1px solid #17324a;background:#17324a;color:#fff;padding:9px 12px;border-radius:3px;font:inherit;font-weight:800;text-decoration:none;cursor:pointer}.dc-head-actions button:disabled{cursor:wait;opacity:.65}.dc-summary{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:12px;margin-bottom:14px}.dc-summary article{padding:16px 17px;border-top:4px solid #f59a23;background:#fff;box-shadow:0 1px 3px rgba(7,26,46,.1)}.dc-summary span,.dc-summary small{display:block;color:#647789}.dc-summary span{font-size:.78rem;font-weight:800}.dc-summary strong{display:block;margin:3px 0;color:#071a2e;font-size:1.7rem}.dc-summary small{overflow:hidden;font-size:.72rem;text-overflow:ellipsis;white-space:nowrap}.dc-columns{display:grid;grid-template-columns:minmax(0,1.15fr) minmax(360px,.85fr);gap:14px;margin-bottom:14px}.dc-card{padding:17px;border:1px solid #d5dde3;background:#fff}.dc-title{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-bottom:14px}.dc-title>div{display:flex;align-items:center;gap:9px}.dc-title h2{margin:0;color:#071a2e;font-size:1.12rem}.dc-title small{color:#718291}.dc-title a{padding:7px 10px;background:#fff;color:#17324a;font-size:.75rem}.dc-step{display:grid;width:28px;height:28px;place-items:center;background:#17324a;color:#fff;font-weight:900}.dc-list{display:grid;gap:8px}.dc-event{display:grid;grid-template-columns:74px 1fr;gap:11px;padding:10px;border-left:4px solid #f59a23;background:#f3f6f8;color:#17324a;text-decoration:none}.dc-event time{font-weight:900}.dc-event strong,.dc-event span{display:block}.dc-event span{margin-top:2px;color:#647789;font-size:.78rem}.dc-empty{margin:0;padding:18px;background:#f3f6f8;color:#718291}.dc-systems{display:grid;gap:8px}.dc-system{display:flex;align-items:center;gap:10px;padding:10px;background:#f3f6f8}.dc-system i{width:12px;height:12px;flex:0 0 auto;border-radius:50%;background:#a6b2bc;box-shadow:0 0 0 4px rgba(166,178,188,.18)}.dc-system.ok i{background:#2f8a4b;box-shadow:0 0 0 4px rgba(47,138,75,.15)}.dc-system.warn i{background:#d38a17;box-shadow:0 0 0 4px rgba(211,138,23,.16)}.dc-system.bad i{background:#b63c35;box-shadow:0 0 0 4px rgba(182,60,53,.14)}.dc-system strong,.dc-system span{display:block}.dc-system span{margin-top:2px;color:#647789;font-size:.75rem}.dc-note{margin:10px 0 0;padding:9px 10px;border-left:3px solid #f59a23;background:#fff7e9;color:#596d7d;font-size:.75rem}.dc-case-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:9px}.dc-case{display:flex;justify-content:space-between;gap:12px;padding:12px;border:1px solid #d8e0e5;background:#fafbfb}.dc-case h3{margin:0;color:#071a2e;font-size:.9rem}.dc-case p{margin:4px 0 0;color:#647789;font-size:.76rem}.dc-case ul{margin:7px 0 0;padding-left:17px;color:#a0442f;font-size:.72rem}.dc-case button{align-self:center;flex:0 0 auto;border:1px solid #17324a;background:#fff;color:#17324a;padding:7px 9px;font:inherit;font-size:.72rem;font-weight:800;cursor:pointer}.dc-quick{display:grid;grid-template-columns:repeat(6,minmax(0,1fr));gap:9px}.dc-quick a{padding:13px;border-left:4px solid #f59a23;background:#f3f6f8;color:#17324a;text-decoration:none}.dc-quick a[hidden]{display:none}.dc-quick strong,.dc-quick span{display:block}.dc-quick span{margin-top:3px;color:#647789;font-size:.72rem}@media(max-width:1250px){.dc-quick{grid-template-columns:repeat(3,minmax(0,1fr))}}@media(max-width:1100px){.dc-summary{grid-template-columns:repeat(2,minmax(0,1fr))}.dc-columns{grid-template-columns:1fr}.dc-quick{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:680px){.dc-app{padding:14px}.dc-head{align-items:flex-start;flex-direction:column}.dc-head-actions{width:100%;justify-content:space-between}.dc-summary,.dc-case-grid,.dc-quick{grid-template-columns:1fr}}
</style>

<script is:inline>
(() => {
  const $=id=>document.getElementById(id),esc=value=>String(value??'').replace(/[&<>"']/g,char=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[char]));
  const request=async url=>{const response=await fetch(url,{credentials:'same-origin',cache:'no-store'}),data=await response.json().catch(()=>({}));if(!response.ok||data.ok===false)throw Error(data.error||`HTTP ${response.status}`);return data};
  const profileNames={christian:'Christian Wächter',holger:'Holger Roth',marc:'Marc Schütt',jens:'Jens Maurer'};
  const setSystem=(key,kind,text)=>{const row=document.querySelector(`[data-system="${key}"]`);if(!row)return;row.className=`dc-system ${kind}`;row.querySelector('span').textContent=text};
  const localIso=date=>{const pad=n=>String(n).padStart(2,'0');return `${date.getFullYear()}-${pad(date.getMonth()+1)}-${pad(date.getDate())}`};
  const monday=value=>{const date=new Date(value);date.setHours(12,0,0,0);const day=date.getDay()||7;date.setDate(date.getDate()-day+1);return date};
  const nextImport=()=>{const now=new Date(),next=new Date(now);next.setHours(3,0,0,0);if(next<=now)next.setDate(next.getDate()+1);while(next.getDay()===0||next.getDay()===6)next.setDate(next.getDate()+1);return new Intl.DateTimeFormat('de-DE',{weekday:'long',day:'2-digit',month:'2-digit',hour:'2-digit',minute:'2-digit'}).format(next)};
  const formatTime=value=>new Intl.DateTimeFormat('de-DE',{hour:'2-digit',minute:'2-digit'}).format(new Date(value));
  const credentialCheck=profile=>new Promise(resolve=>{
    if(!profile){resolve(null);return}
    const requestId=crypto.randomUUID(),finish=value=>{clearTimeout(timer);window.removeEventListener('message',receive);resolve(value)},receive=event=>{
      if(event.source!==window||event.origin!==location.origin||event.data?.type!=='SVNET_CLAIMS_CREDENTIAL_STATUS'||event.data.requestId!==requestId)return;
      finish({ok:event.data.ok===true,profile:String(event.data.profile||''),phase:String(event.data.phase||'unknown')});
    },timer=setTimeout(()=>finish(null),2500);
    window.addEventListener('message',receive);
    window.postMessage({type:'SVNET_CLAIMS_CREDENTIAL_CHECK',requestId,profile},location.origin);
  });
  const required=[['schaden_nr','Schaden-Nr.'],['vn_objekt','VN / Objekt'],['schadenart','Schadenart'],['schaden_ort','Schadenort']];
  let recentCases=[];

  async function loadDrive(){
    const [status,recent]=await Promise.all([request('/intern/api/google-drive-sync.php?action=status'),request('/intern/api/google-drive-sync.php?action=recent_cases')]);
    const profile=String(status.backoffice?status.selected_expert:status.claims_profile||'');
    $('dc-profile').textContent=`Arbeitsstand für ${profileNames[profile]||'das ausgewählte Profil'}`;
    $('dc-case-count').textContent=String(status.folders?.cases?.items??0);$('dc-case-folder').textContent=status.folders?.cases?.name||'Fallordner';
    setSystem('drive','ok',`${status.folders?.cases?.items??0} Fälle · ${status.cached?'geprüfter Zwischenspeicher':'direkt verbunden'}`);
    recentCases=Array.isArray(recent.results)?recent.results:[];let warnings=0;
    $('dc-cases').innerHTML=recentCases.length?recentCases.map((row,index)=>{const meta=row.meta||{},missing=required.filter(([key])=>!String(meta[key]||'').trim()).map(([,label])=>label);warnings+=missing.length;const title=meta.schaden_nr||row.name||'Fall ohne Schaden-Nr.',object=meta.vn_objekt||meta.versicherungsnehmer||'VN / Objekt noch offen',place=[meta.schaden_plz,meta.schaden_ort].filter(Boolean).join(' ');return `<article class="dc-case"><div><h3>${esc(title)}</h3><p>${esc(object)}${place?' · '+esc(place):''}</p>${missing.length?`<ul>${missing.map(item=>`<li>${esc(item)} fehlt</li>`).join('')}</ul>`:'<p>Pflichtangaben für das Cockpit vollständig.</p>'}</div><button type="button" data-open-case="${index}">Fall öffnen</button></article>`}).join(''):'<p class="dc-empty">Keine zuletzt bearbeiteten Fälle gefunden.</p>';
    $('dc-warning-count').textContent=String(warnings);
  }

  async function loadCalendar(){
    const data=await request('/intern/api/outlook-case-calendar.php?action=list&start='+encodeURIComponent(localIso(monday(new Date())))),today=localIso(new Date()),events=(data.events||[]).filter(event=>String(event.start||'').slice(0,10)===today);
    $('dc-today-count').textContent=String(events.length);$('dc-next-event').textContent=events[0]?`${formatTime(events[0].start)} · ${events[0].subject}`:'Heute keine Termine';
    $('dc-events').innerHTML=events.length?events.map(event=>{const body=`<time>${esc(event.all_day?'ganztägig':formatTime(event.start))}</time><div><strong>${esc(event.subject)}</strong>${event.location?`<span>${esc(event.location)}</span>`:''}</div>`;return event.web_link?`<a class="dc-event" href="${esc(event.web_link)}" target="_blank" rel="noreferrer">${body}</a>`:`<div class="dc-event">${body}</div>`}).join(''):'<p class="dc-empty">Heute sind keine Termine eingetragen.</p>';
    setSystem('outlook','ok',`${data.calendar||'Kalender'} · ${data.events?.length||0} Termine diese Woche`);
  }

  async function loadClaims(){
    const [summary,mine]=await Promise.all([request('/intern/api/claimsforce-queue.php?action=summary'),request('/intern/api/claimsforce-queue.php?action=mine')]),items=summary.items||[],open=items.reduce((sum,item)=>sum+(Number.isFinite(Number(item.open_count))?Number(item.open_count):0),0),jobs=mine.jobs||[],active=jobs.find(job=>['queued','running'].includes(job.status)),last=jobs[0];
    const profile=String(items[0]?.profile||last?.profile||''),credential=await credentialCheck(profile),profileLabel=profileNames[profile]||profile;
    $('dc-claims-count').textContent=items.some(item=>item.open_count!==null)?String(open):'–';$('dc-claims-summary').textContent=items.map(item=>`${item.label}: ${item.open_count??'–'}`).join(' · ')||'Kein Aufgabenstand';
    const staleCredentialFailure=last?.status==='failed'&&/\[CF-CRED-01\]/.test(String(last.message||''));
    if(active)setSystem('claims','warn',`${active.profile}: ${active.message||active.status}`);
    else if(staleCredentialFailure&&credential?.ok)setSystem('claims','ok',`${profileLabel}: Zugangsdaten aktuell verfügbar · vorheriger Fehler erledigt`);
    else if(last?.status==='failed')setSystem('claims','bad',`${last.profile}: ${last.message||'letzter Import fehlgeschlagen'}`);
    else if(credential?.ok)setSystem('claims','ok',`${profileLabel}: Zugangsdaten verfügbar · Warteschlange erreichbar`);
    else if(credential)setSystem('claims','bad',`${profileLabel}: Zugangsdaten nicht verfügbar [${credential.phase}]`);
    else setSystem('claims','ok',last?.finished_at?`Letzter Lauf ${last.status==='done'?'abgeschlossen':'beendet'} · ${last.profile}`:'Warteschlange erreichbar');
  }

  async function loadRevenue(){
    const data=await request('/intern/api/revenue-summary-v2.php?action=access');
    $('dc-quick-settlement').hidden=data.show_settlement_link!==true;
    if(!data.visible){setSystem('revenue','ok','Für dieses Profil nicht eingeblendet');return}
    const stamp=data.summary_type==='holger'?[data.claims?.updated_at,data.rekon?.updated_at].filter(Boolean).join(' · '):data.source_updated_at;
    setSystem('revenue',stamp?'ok':'warn',stamp?`Datenstand ${stamp}`:'Noch kein Datenstand gespeichert');
  }

  async function load(){
    const button=$('dc-refresh');button.disabled=true;$('dc-updated').textContent='Prüfung läuft …';$('dc-auto-run').textContent=`Nächster planmäßiger ClaimsForce-Lauf: ${nextImport()} Uhr`;
    const tasks=[['drive',loadDrive],['outlook',loadCalendar],['claims',loadClaims],['revenue',loadRevenue]],results=await Promise.allSettled(tasks.map(([,fn])=>fn()));
    results.forEach((result,index)=>{if(result.status==='rejected'){const key=tasks[index][0];setSystem(key,'bad',result.reason?.message||'Verbindung fehlgeschlagen');if(key==='outlook'){$('dc-today-count').textContent='–';$('dc-next-event').textContent='Kalender nicht erreichbar';$('dc-events').innerHTML='<p class="dc-empty">Kalender konnte nicht geladen werden.</p>'}}});
    $('dc-updated').textContent='Geprüft '+new Intl.DateTimeFormat('de-DE',{hour:'2-digit',minute:'2-digit',second:'2-digit'}).format(new Date());button.disabled=false;
  }
  $('dc-refresh').addEventListener('click',load);
  $('dc-cases').addEventListener('click',event=>{const button=event.target.closest('[data-open-case]');if(!button)return;const row=recentCases[Number(button.dataset.openCase)];if(!row?.id)return;const selected={folder_id:row.id,meta:row.meta||{}};sessionStorage.setItem('svnet-case',JSON.stringify(selected));localStorage.setItem('svnet-case',JSON.stringify(selected));location.assign('/intern/versicherungsfaelle/')});
  load();
})();
</script>
