---
import InternalLayout from '../../../layouts/InternalLayout.astro';
const services = [
  { id: 'evcc', title: 'Ladeübersicht', text: 'Ladestatus, Fahrzeug und Überschussladen mit evcc.', icon: '⚡' },
  { id: 'anker', title: 'Haussteuerung & Kameras', text: 'Geräte bedienen, Kamerabilder ansehen und Solarenergie im Blick behalten.', icon: '⌂' },
  { id: 'keba', title: 'KEBA-Einstellungen', text: 'Die Oberfläche deiner Wallbox für Status und Einstellungen.', icon: '⚙' },
];
---
<InternalLayout title="Energiesteuerung" description="Persönlicher Zugang zu Laden, Solarenergie und Wallbox.">
  <section class="energy-page">
    <header><p class="intern-header__eyebrow">MEIN ZUHAUSE</p><h1>Energiesteuerung</h1><p>Laden, Haussteuerung und Kameras an einem Ort.</p></header>
    <nav class="energy-tabs" aria-label="Tagescockpit Ansichten"><a href="/intern/tagescockpit/">Übersicht</a><a href="/intern/energie/" aria-current="page">Energiesteuerung</a><a href="/intern/arbeitszentrale/">Arbeitsorganisation</a></nav>
    <div class="energy-cards">
      {services.map(service => <article><span class="energy-icon" aria-hidden="true">{service.icon}</span><h2>{service.title}</h2><p>{service.text}</p><a href={`/intern/api/energy.php?service=${service.id}`} target="_blank" rel="noopener noreferrer">{service.title} öffnen <span aria-hidden="true">↗</span></a></article>)}
    </div>
    <aside class="energy-note"><strong>Zugriff von zu Hause und unterwegs</strong><p>Die Geräteoberflächen öffnen in einem neuen Tab. Dafür muss dein Gerät mit dem Heimnetz oder dem passenden VPN verbunden sein. Die Anmeldung der jeweiligen Anwendung bleibt bestehen.</p></aside>
    <section class="energy-vpn"><h2>Unterwegs verbinden</h2><p>Einmalig die kostenlose WireGuard-App installieren und die passende Konfiguration importieren. Danach WireGuard einschalten und oben die gewünschte Geräteoberfläche öffnen.</p><p>Für jedes Gerät ist eine eigene Konfiguration vorbereitet. Sie gilt nur für die Energiesteuerung und die Wallbox.</p><div class="energy-tabs"><form action="/intern/api/energy.php" method="post"><input type="hidden" name="download" value="handy" /><button type="submit">Handy einrichten</button></form><form action="/intern/api/energy.php" method="post"><input type="hidden" name="download" value="surface" /><button type="submit">Surface einrichten</button></form><form action="/intern/api/energy.php" method="post"><input type="hidden" name="download" value="laptop" /><button type="submit">Laptop einrichten</button></form><a href="https://www.wireguard.com/install/" target="_blank" rel="noopener noreferrer">WireGuard-App</a></div><p>Die Konfigurationsdateien sind persönliche Zugangsschlüssel. Bitte nicht weitergeben.</p></section>
  </section>
  <style>
    .energy-page{max-width:1200px;margin:auto;padding:28px 22px;color:#263746}.energy-page h1{margin:0;color:#071a2e}.energy-page header>p:last-child{color:#526575}.energy-tabs{display:flex;flex-wrap:wrap;gap:8px;margin:24px 0}.energy-tabs form{margin:0}.energy-tabs button{font:inherit;cursor:pointer}.energy-tabs a,.energy-tabs button{padding:10px 14px;border:1px solid #c7ccd1;border-radius:3px;color:#17324a;text-decoration:none;background:white;font-weight:700}.energy-tabs a[aria-current]{border-color:#f59a23;background:#fff3df}.energy-cards{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:18px}.energy-cards article{padding:24px;background:#fff;border:1px solid #d6dce1;border-top:4px solid #f59a23;display:flex;flex-direction:column}.energy-icon{font-size:2rem;color:#b66200}.energy-cards h2{font-size:1.2rem;color:#17324a}.energy-cards p{line-height:1.6;flex:1}.energy-cards a{display:block;padding:12px;background:#17324a;color:white;border-radius:3px;text-decoration:none;font-weight:700}.energy-cards a:hover{background:#264c6d}.energy-note{margin-top:24px;padding:18px 22px;background:#eaf0f4;border-left:4px solid #315f86}.energy-note p{line-height:1.6;margin-bottom:0}@media(max-width:850px){.energy-cards{grid-template-columns:1fr}.energy-page{padding:20px 12px}}
  </style>
</InternalLayout>

