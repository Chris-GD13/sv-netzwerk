---
import Portal2Layout from '../../../../layouts/Portal2Layout.astro';
---
<Portal2Layout title="Angebote | Portal 2.0" description="Vollständige Angebotserstellung im Portal 2.0." currentPath="/intern/portal2/angebote/">
  <section class="p2-hero"><div><p class="p2-kicker">04 · Weitere Werkzeuge</p><h1>Angebote anlegen</h1></div></section>
  <section class="mirror-shell"><iframe title="Vollständige Angebotserstellung" src="/intern/privatauftraege/angebot/" loading="eager"></iframe></section>
</Portal2Layout>
<style>
.mirror-shell{overflow:hidden;border:1px solid #d7e0e6;border-radius:5px;background:#fff;box-shadow:0 5px 18px rgba(16,42,67,.06)}iframe{display:block;width:100%;min-height:3000px;border:0;background:#fff}@media(max-width:720px){iframe{min-height:5000px}}
</style>