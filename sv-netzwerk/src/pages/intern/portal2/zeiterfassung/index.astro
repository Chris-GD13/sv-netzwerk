---
import Portal2Layout from '../../../../layouts/Portal2Layout.astro';
---
<Portal2Layout title="Zeiterfassung | Portal 2.0" description="Vollständige Zeiterfassung im Portal 2.0." currentPath="/intern/portal2/zeiterfassung/">
  <section class="p2-hero">
    <div><p class="p2-kicker">02 · Organisieren</p><h1>Zeiterfassung</h1><p>Vollständige Arbeitszeit, Urlaub, Monatswerte, Jahreswerte, DATEV-Übergabe und Ausdruck aus dem gemeinsamen Zeitkonto.</p></div>
  </section>
  <section class="time-shell">
    <iframe id="time-frame" title="Vollständige Zeiterfassung" src="/intern/zeiterfassung/" loading="eager"></iframe>
  </section>
</Portal2Layout>
<style>
.time-shell{overflow:hidden;border:1px solid #d7e0e6;border-radius:5px;background:#fff;box-shadow:0 5px 18px rgba(16,42,67,.06)}#time-frame{display:block;width:100%;min-height:3600px;border:0;background:#fff}@media(max-width:720px){#time-frame{min-height:5200px}}
</style>
<script is:inline>
const frame=document.getElementById('time-frame');
frame?.addEventListener('load',()=>{
  try{
    const doc=frame.contentDocument;
    if(!doc)return;
    const style=doc.createElement('style');
    style.textContent=`
      body{background:#f4f7f9!important;color:#14324a!important}
      .intern-header,.site-header,.portal-header{box-shadow:none!important}
      main,.tt-app,.time-app{max-width:1180px!important;margin:0 auto!important;padding:24px!important}
      .card,.panel,section{border-radius:5px!important}
      button,input,select,textarea{border-radius:4px!important}
    `;
    doc.head.appendChild(style);
    frame.contentWindow.scrollTo(0,0);
  }catch{}
});
</script>
