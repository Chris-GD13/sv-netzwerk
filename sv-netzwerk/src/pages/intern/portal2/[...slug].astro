---
import Portal2Layout from '../../../layouts/Portal2Layout.astro';

import { portal2Pages } from '../../../lib/portal2-pages';


export function getStaticPaths() {
  return Object.entries(portal2Pages).map(([slug, page]) => ({ params: { slug }, props: { page } }));
}

const { page } = Astro.props;
const cardLinks = page.kind === 'cases' ? [['Neuen Fall anlegen', '/intern/portal2/faelle/neu/'], ['Berichte öffnen', '/intern/portal2/berichte/']] : page.kind === 'reports' ? [['Neuen Bericht erstellen', '/intern/portal2/berichte/neu/'], ['Fälle öffnen', '/intern/portal2/faelle/']] : [];
---

<Portal2Layout title={`${page.title} · Portal 2.0`} description={page.intro} currentPath={`/intern/portal2/${Astro.params.slug}/`}>
  <section class="p2-hero">
    <div><p class="p2-kicker">{page.eyebrow}</p><h1>{page.title}</h1><p>{page.intro}</p></div>
    {cardLinks.length > 0 && <div class="p2-actions">{cardLinks.map(([label, href]) => <a class="p2-action" href={href}>{label}</a>)}</div>}
  </section>

  <section class="p2-card-grid" aria-label={`${page.title} Arbeitsbereiche`}>
    {page.cards.map(([heading, text], index) => <article class="p2-card"><span class="p2-card__icon">0{index + 1}</span><strong>{heading}</strong><small>{text}</small></article>)}
  </section>

  {page.kind === 'cases' && <section class="p2-panel" style="margin-top:20px"><div class="p2-actions"><input id="p2-case-search" aria-label="Fälle suchen" placeholder="Fallnummer oder Versicherungsnehmer suchen" style="flex:1;min-width:240px;padding:10px;border:1px solid #b7c6d0;border-radius:4px;font:inherit" /><button class="p2-action" id="p2-case-search-button" type="button">Suchen</button></div><div class="p2-table-wrap" style="margin-top:16px"><table class="p2-table"><thead><tr><th>Vorgang</th><th>Status</th><th>Nächster Schritt</th></tr></thead><tbody id="p2-case-results"><tr><td colspan="3"><div class="p2-empty">Fälle werden geladen …</div></td></tr></tbody></table></div></section>}
  {page.kind === 'form' && <section class="p2-panel" style="margin-top:20px"><form class="p2-form-grid" id="p2-work-form"><div class="p2-field"><label for="p2-reference">Vorgangsnummer</label><input id="p2-reference" required /></div><div class="p2-field"><label for="p2-owner">Zuständigkeit</label><input id="p2-owner" /></div><div class="p2-field p2-field--full"><label for="p2-note">Arbeitsauftrag</label><textarea id="p2-note"></textarea></div><div class="p2-actions p2-field--full"><button class="p2-action" type="submit">Entwurf speichern</button></div></form><p id="p2-work-message" class="p2-message" hidden></p></section>}
  {page.kind === 'import' && <section class="p2-panel" style="margin-top:20px"><div class="p2-form-grid"><div class="p2-field p2-field--full"><label for="p2-import-files">Originale oder Exportdateien</label><input id="p2-import-files" type="file" multiple /></div><div class="p2-field"><label for="p2-import-owner">Zuständigkeit</label><input id="p2-import-owner" placeholder="Bearbeiter oder Team" /></div><div class="p2-field"><label for="p2-import-note">Importnotiz</label><input id="p2-import-note" placeholder="Quelle und Einordnung" /></div><div class="p2-actions p2-field--full"><button class="p2-action" id="p2-import-start" type="button">Importprüfung starten</button></div></div><p id="p2-import-message" class="p2-message" hidden></p></section>}
  {page.kind === 'calculation' && <section class="p2-panel" style="margin-top:20px"><form class="p2-form-grid" id="p2-calculation-form"><div class="p2-field"><label for="p2-quantity">Menge</label><input id="p2-quantity" type="number" min="0" step="0.01" value="1" /></div><div class="p2-field"><label for="p2-rate">Einheitspreis netto</label><input id="p2-rate" type="number" min="0" step="0.01" value="0" /></div><div class="p2-field"><label for="p2-tax">Umsatzsteuer in Prozent</label><input id="p2-tax" type="number" min="0" step="0.1" value="19" /></div><div class="p2-actions p2-field--full"><button class="p2-action" type="submit">Position berechnen</button></div></form><div class="p2-table-wrap" style="margin-top:16px"><table class="p2-table"><tbody><tr><th>Netto</th><td id="p2-net-total">0,00 €</td></tr><tr><th>Steuer</th><td id="p2-tax-total">0,00 €</td></tr><tr><th>Brutto</th><td id="p2-gross-total">0,00 €</td></tr></tbody></table></div></section>}
  {page.kind === 'calculator' && <section class="p2-panel" style="margin-top:20px"><form class="p2-form-grid" id="p2-value-form"><div class="p2-field"><label for="p2-original-value">Ursprungswert</label><input id="p2-original-value" type="number" min="0" step="0.01" /></div><div class="p2-field"><label for="p2-age">Alter in Jahren</label><input id="p2-age" type="number" min="0" step="1" /></div><div class="p2-field"><label for="p2-life">Gesamtnutzungsdauer in Jahren</label><input id="p2-life" type="number" min="1" step="1" value="20" /></div><div class="p2-actions p2-field--full"><button class="p2-action" type="submit">Zeitwert berechnen</button></div></form><p id="p2-value-result" class="p2-message" hidden></p></section>}
  {page.kind === 'tasks' && <section class="p2-panel" style="margin-top:20px"><form class="p2-form-grid" id="p2-task-form"><div class="p2-field p2-field--full"><label for="p2-task-title">Neue Aufgabe</label><input id="p2-task-title" required placeholder="Was ist als Nächstes zu erledigen?" /></div><div class="p2-field"><label for="p2-task-date">Fällig am</label><input id="p2-task-date" type="date" /></div><div class="p2-field"><label for="p2-task-owner">Zuständig</label><input id="p2-task-owner" /></div><div class="p2-actions p2-field--full"><button class="p2-action" type="submit">Aufgabe vormerken</button></div></form><div id="p2-task-list" class="p2-empty" style="margin-top:16px">Noch keine neuen Aufgaben in dieser Sitzung.</div></section>}
  {page.kind === 'calendar' && <section class="p2-panel" style="margin-top:20px"><form class="p2-form-grid" id="p2-event-form"><div class="p2-field"><label for="p2-event-title">Termin</label><input id="p2-event-title" required /></div><div class="p2-field"><label for="p2-event-date">Datum und Uhrzeit</label><input id="p2-event-date" type="datetime-local" /></div><div class="p2-field p2-field--full"><label for="p2-event-location">Ort oder Videolink</label><input id="p2-event-location" /></div><div class="p2-actions p2-field--full"><button class="p2-action" type="submit">Termin vormerken</button></div></form><p id="p2-event-message" class="p2-message" hidden></p></section>}
  {page.kind === 'knowledge' && <section class="p2-panel" style="margin-top:20px"><div class="p2-actions"><input id="p2-knowledge-search" aria-label="Wissen durchsuchen" placeholder="Regel, Thema oder Schadenart" style="flex:1;min-width:240px;padding:10px;border:1px solid #b7c6d0;border-radius:4px;font:inherit" /><button class="p2-action" type="button" id="p2-knowledge-button">Suchen</button></div><div id="p2-knowledge-results" class="p2-card-grid" style="margin-top:16px"><article class="p2-card"><strong>Neuerungen</strong><small>Aktuelle Vorgaben werden für die Prüfung berücksichtigt.</small></article><article class="p2-card"><strong>Regelbestand</strong><small>Verbindliche Arbeitsvorgaben und native Vorlagen.</small></article></div></section>}
  {page.kind === 'drive' && <section class="p2-panel" style="margin-top:20px"><form class="p2-form-grid" id="p2-drive-form"><div class="p2-field p2-field--full"><label for="p2-client-id">Google OAuth Client-ID</label><input id="p2-client-id" autocomplete="off" required /></div><div class="p2-field p2-field--full"><label for="p2-client-secret">Google OAuth Client-Secret</label><input id="p2-client-secret" type="password" autocomplete="new-password" required /></div><div class="p2-actions p2-field--full"><button class="p2-action" type="submit">Konfiguration speichern</button><a class="p2-action p2-action--secondary" href="/intern/api/google-drive-oauth.php?action=start">Google Drive autorisieren</a></div></form><p id="p2-drive-message" class="p2-message" hidden></p></section>}
  {page.kind === 'drive' && <section class="p2-panel"><h2>Verbindung und Bestand</h2><div id="p2-drive-status" class="p2-empty">Verbindungsstatus wird geprüft …</div><div class="p2-actions" style="margin-top:14px"><button class="p2-action p2-action--secondary" id="p2-drive-refresh" type="button">Status aktualisieren</button><button class="p2-action" id="p2-drive-cases" type="button">2026-Fälle aus Drive lesen</button></div><div id="p2-drive-cases-result" class="p2-table-wrap" style="margin-top:16px"></div></section>}
  {page.kind === 'reports' && <section class="p2-panel"><h2>Bericht aus einer Akte vorbereiten</h2><form class="p2-form-grid" id="p2-report-form"><div class="p2-field"><label for="p2-report-case">Schadennummer</label><input id="p2-report-case" required placeholder="z. B. 26-015885-8" /></div><div class="p2-field"><label for="p2-report-type">Dokumenttyp</label><select id="p2-report-type"><option value="erstbericht">Erstbericht</option><option value="zwischenbericht">Zwischenbericht</option><option value="schadenprotokoll">Schadenprotokoll</option><option value="schlusserklaerung">Schlusserklärung</option></select></div><div class="p2-actions p2-field--full"><button class="p2-action" type="submit">Akte suchen und Entwurf anlegen</button></div></form><p id="p2-report-message" class="p2-message" hidden></p></section>}
  {page.kind === 'admin' && <section class="p2-panel"><h2>Systemstatus und Benutzer</h2><div id="p2-admin-status" class="p2-empty">Status wird geladen …</div><div id="p2-admin-users" class="p2-table-wrap" style="margin-top:16px"></div></section>}
  {page.kind === 'projects' && <section class="p2-panel"><h2>Aktive Projekte</h2><div class="p2-actions"><button class="p2-action" id="p2-project-refresh" type="button">Projekte laden</button><button class="p2-action p2-action--secondary" id="p2-project-create" type="button">Projekt anlegen</button></div><div id="p2-projects" class="p2-table-wrap" style="margin-top:16px"><div class="p2-empty">Noch nicht geladen.</div></div><p id="p2-project-message" class="p2-message" hidden></p></section>}
  {page.kind === 'partners' && <section class="p2-panel"><h2>Partnervereinbarungen</h2><div class="p2-actions"><button class="p2-action" id="p2-partner-refresh" type="button">Entwürfe laden</button><a class="p2-action p2-action--secondary" href="/intern/api/partner-contracts.php?action=template">Vorlage öffnen</a></div><div id="p2-partners" class="p2-table-wrap" style="margin-top:16px"><div class="p2-empty">Noch nicht geladen.</div></div></section>}
  {['private', 'offers', 'billing'].includes(page.kind) && <section class="p2-panel"><h2>Arbeitsbestand</h2><div class="p2-actions"><a class="p2-action" href="/intern/privatauftraege/">Bestand öffnen</a><a class="p2-action p2-action--secondary" href="/intern/api/private-business.php?action=access">Zugriff prüfen</a></div><p id="p2-business-message" class="p2-message">Der Bestand wird über die bestehende, zugriffsgeschützte Ablage geladen.</p></section>}
  {['cases', 'form', 'import', 'calculation', 'calculator', 'tasks', 'calendar', 'knowledge', 'drive', 'reports', 'admin', 'projects', 'partners', 'private', 'offers', 'billing'].indexOf(page.kind) === -1 && <section class="p2-panel" style="margin-top:20px"><h2>Arbeitsstand</h2><p>Für diesen Bereich ist noch kein zugrunde liegender Datenbestand verbunden.</p><div class="p2-actions"><button class="p2-action" type="button" id="p2-refresh">Arbeitsstand prüfen</button><span id="p2-refresh-message" class="p2-message" hidden>Prüfung angefordert.</span></div></section>}

  <script is:inline>
    const workForm = document.getElementById('p2-work-form');
    workForm?.addEventListener('submit', (event) => { event.preventDefault(); const message = document.getElementById('p2-work-message'); if (message) { message.hidden = false; message.textContent = 'Entwurf im Portal 2.0 vorgemerkt. Der Vorgang kann jetzt weiterbearbeitet werden.'; } });
    const driveForm = document.getElementById('p2-drive-form');
    driveForm?.addEventListener('submit', async (event) => { event.preventDefault(); const message = document.getElementById('p2-drive-message'); if (!message) return; message.hidden = false; message.classList.remove('is-error'); message.textContent = 'Konfiguration wird gespeichert …'; try { const response = await fetch('/intern/api/google-drive-oauth.php?action=save_client', { method: 'POST', credentials: 'same-origin', cache: 'no-store', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ client_id: document.getElementById('p2-client-id')?.value.trim(), client_secret: document.getElementById('p2-client-secret')?.value.trim() }) }); const data = await response.json().catch(() => null); if (!response.ok || !data?.ok) throw new Error(data?.error || 'Konfiguration konnte nicht gespeichert werden.'); message.textContent = 'Konfiguration gespeichert. Jetzt kann die Google-Autorisierung gestartet werden.'; const secret = document.getElementById('p2-client-secret'); if (secret) secret.value = ''; } catch (error) { message.classList.add('is-error'); message.textContent = error instanceof Error ? error.message : 'Konfiguration konnte nicht gespeichert werden.'; } });
    document.getElementById('p2-refresh')?.addEventListener('click', () => { const message = document.getElementById('p2-refresh-message'); if (message) message.hidden = false; });
    document.getElementById('p2-import-start')?.addEventListener('click', () => { const message = document.getElementById('p2-import-message'); if (message) { message.hidden = false; message.textContent = 'Importprüfung vorgemerkt. Dateien und Zuordnung werden vor der Übernahme geprüft.'; } });
    document.getElementById('p2-calculation-form')?.addEventListener('submit', (event) => { event.preventDefault(); const q = Number(document.getElementById('p2-quantity')?.value || 0); const rate = Number(document.getElementById('p2-rate')?.value || 0); const tax = Number(document.getElementById('p2-tax')?.value || 0); const net = q * rate; const format = value => new Intl.NumberFormat('de-DE', { style: 'currency', currency: 'EUR' }).format(value); document.getElementById('p2-net-total').textContent = format(net); document.getElementById('p2-tax-total').textContent = format(net * tax / 100); document.getElementById('p2-gross-total').textContent = format(net * (1 + tax / 100)); });
    document.getElementById('p2-value-form')?.addEventListener('submit', (event) => { event.preventDefault(); const original = Number(document.getElementById('p2-original-value')?.value || 0); const age = Number(document.getElementById('p2-age')?.value || 0); const life = Math.max(1, Number(document.getElementById('p2-life')?.value || 1)); const result = document.getElementById('p2-value-result'); if (result) { result.hidden = false; result.textContent = 'Linearer Zeitwert als Arbeitsentwurf: ' + new Intl.NumberFormat('de-DE', { style: 'currency', currency: 'EUR' }).format(Math.max(0, original * (1 - age / life))); } });
    const p2Esc = value => String(value ?? '').replace(/[&<>"']/g, char => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[char]));
    const p2Api = async (url, options = {}) => { const response = await fetch(url, { credentials: 'same-origin', cache: 'no-store', ...options }); const data = await response.json().catch(() => ({})); if (!response.ok) throw new Error(data.error || `HTTP ${response.status}`); return data; };
    const taskForm = document.getElementById('p2-task-form');
    taskForm?.addEventListener('submit', async (event) => { event.preventDefault(); const title = document.getElementById('p2-task-title')?.value.trim(); const list = document.getElementById('p2-task-list'); if (!title || !list) return; list.className = 'p2-message'; list.textContent = 'Aufgabe wird gespeichert …'; try { await p2Api('/intern/api/work-center.php?action=save', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ title, due_at: document.getElementById('p2-task-date')?.value || null, note: document.getElementById('p2-task-owner')?.value.trim() || '' }) }); list.textContent = `Aufgabe gespeichert: ${title}`; } catch (error) { list.className = 'p2-message is-error'; list.textContent = error instanceof Error ? error.message : 'Aufgabe konnte nicht gespeichert werden.'; } });
    document.getElementById('p2-event-form')?.addEventListener('submit', async (event) => { event.preventDefault(); const message = document.getElementById('p2-event-message'); if (!message) return; try { const data = await p2Api('/intern/api/outlook-case-calendar.php?action=list&start=' + encodeURIComponent(new Date().toISOString().slice(0, 10))); message.hidden = false; message.textContent = `${data.events?.length || 0} Outlook-Termine geladen. Für einen neuen Ortstermin zuerst einen Fall öffnen.`; } catch (error) { message.hidden = false; message.classList.add('is-error'); message.textContent = error instanceof Error ? error.message : 'Kalender konnte nicht geladen werden.'; } });
    const knowledgeButton = document.getElementById('p2-knowledge-button');
    knowledgeButton?.addEventListener('click', async () => { const input = document.getElementById('p2-knowledge-search'); const results = document.getElementById('p2-knowledge-results'); if (!input || !results) return; results.innerHTML = '<div class="p2-empty">Regelbestand wird geladen …</div>'; try { const data = await p2Api('/intern/api/insurance-knowledge.php?q=' + encodeURIComponent(input.value.trim())); const files = Array.isArray(data.files) ? data.files.slice(0, 24) : []; results.innerHTML = files.length ? files.map(file => `<article class="p2-card"><strong>${p2Esc(file.name || 'Dokument')}</strong><small>${p2Esc(file.path || file.insurer || 'Regelbestand')}</small></article>`).join('') : '<div class="p2-empty">Keine passenden Regelwerke gefunden.</div>'; } catch (error) { results.innerHTML = `<div class="p2-empty">${p2Esc(error instanceof Error ? error.message : 'Versicherungswissen konnte nicht geladen werden.')}</div>`; } });
    const driveStatus = document.getElementById('p2-drive-status');
    const loadDriveStatus = async () => { if (!driveStatus) return; driveStatus.textContent = 'Verbindungsstatus wird geprüft …'; try { const data = await p2Api('/intern/api/google-drive-sync.php?action=status&refresh=1'); driveStatus.className = 'p2-message'; driveStatus.textContent = `Google Drive verbunden · ${data.folders?.cases?.items ?? 0} Fallordner · ${data.folders?.knowledge?.items ?? 0} Wissensdateien · ${data.folders?.blanco?.items ?? 0} Vorlagen`; } catch (error) { driveStatus.className = 'p2-message is-error'; driveStatus.textContent = error instanceof Error ? error.message : 'Google-Drive-Status konnte nicht geladen werden.'; } };
    document.getElementById('p2-drive-refresh')?.addEventListener('click', loadDriveStatus);
    document.getElementById('p2-drive-cases')?.addEventListener('click', async () => { const target = document.getElementById('p2-drive-cases-result'); if (!target) return; target.innerHTML = '<div class="p2-empty">2026-Fälle werden gelesen …</div>'; try { const data = await p2Api('/intern/api/google-drive-sync.php?action=search_cases&q=26-'); const rows = (data.results || []).filter(item => /^26-/.test(String(item.meta?.schaden_nr || item.name || ''))); target.innerHTML = rows.length ? `<table class="p2-table"><thead><tr><th>Schadennummer</th><th>Objekt</th><th>Quelle</th></tr></thead><tbody>${rows.map(item => `<tr><td>${p2Esc(item.meta?.schaden_nr || item.name)}</td><td>${p2Esc(item.meta?.vn_objekt || item.meta?.ort || '')}</td><td>${p2Esc([item.meta?.claimsforce_claim_id ? 'ClaimsForce' : '', item.meta?.rekon_task_id ? 'Rekon' : 'Drive'].filter(Boolean).join(', '))}</td></tr>`).join('')}</tbody></table>` : '<div class="p2-empty">Keine 2026-Fälle im zugänglichen Portalbestand gefunden.</div>'; } catch (error) { target.innerHTML = `<div class="p2-empty">${p2Esc(error instanceof Error ? error.message : '2026-Fälle konnten nicht gelesen werden.')}</div>`; } });
    loadDriveStatus();
    document.getElementById('p2-report-form')?.addEventListener('submit', async (event) => { event.preventDefault(); const message = document.getElementById('p2-report-message'); if (!message) return; message.hidden = false; message.textContent = 'Akte wird gesucht …'; try { const query = document.getElementById('p2-report-case')?.value.trim() || ''; const type = document.getElementById('p2-report-type')?.value || 'erstbericht'; const found = await p2Api('/intern/api/google-drive-sync.php?action=search_cases&q=' + encodeURIComponent(query)); const item = found.results?.[0]; if (!item?.id) throw new Error('Keine eindeutige Akte gefunden.'); const created = await p2Api('/intern/api/google-drive-sync.php?action=generate_documents', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ folder_id: item.id, order: { outputs: [type], instructions: 'Portal 2.0: Entwurf aus der geöffneten Akte vorbereiten.' } }) }); message.textContent = `${created.count || 0} Entwurf in der Akte angelegt.`; } catch (error) { message.classList.add('is-error'); message.textContent = error instanceof Error ? error.message : 'Bericht konnte nicht angelegt werden.'; } });
    const adminStatus = document.getElementById('p2-admin-status');
    if (adminStatus) { Promise.all([p2Api('/intern/api/google-drive-oauth.php?action=status'), p2Api('/intern/api/users.php')]).then(([drive, users]) => { adminStatus.className = 'p2-message'; adminStatus.textContent = `Drive: ${drive.connected ? 'verbunden' : 'nicht verbunden'} · ${Array.isArray(users) ? users.length : 0} Benutzer`; const table = document.getElementById('p2-admin-users'); table.innerHTML = Array.isArray(users) && users.length ? `<table class="p2-table"><thead><tr><th>Name</th><th>E-Mail</th><th>Rolle</th><th>Status</th></tr></thead><tbody>${users.map(user => `<tr><td>${p2Esc(user.full_name)}</td><td>${p2Esc(user.email)}</td><td>${p2Esc(user.role)}</td><td>${user.is_active ? 'aktiv' : 'deaktiviert'}</td></tr>`).join('')}</tbody></table>` : '<div class="p2-empty">Keine Benutzer gefunden.</div>'; }).catch(error => { adminStatus.className = 'p2-message is-error'; adminStatus.textContent = error instanceof Error ? error.message : 'Verwaltung konnte nicht geladen werden.'; }); }
    const projectTarget = document.getElementById('p2-projects');
    const loadProjects = async () => { if (!projectTarget) return; projectTarget.innerHTML = '<div class="p2-empty">Projekte werden geladen …</div>'; try { const data = await p2Api('/intern/api/projects.php'); const rows = data.projects || []; projectTarget.innerHTML = rows.length ? `<table class="p2-table"><thead><tr><th>Code</th><th>Projekt</th><th>Objekt</th><th>Fenster</th></tr></thead><tbody>${rows.map(project => `<tr><td>${p2Esc(project.project_code)}</td><td>${p2Esc(project.title)}</td><td>${p2Esc(project.object_name || project.address || '')}</td><td>${p2Esc(project.window_count ?? 0)}</td></tr>`).join('')}</tbody></table>` : '<div class="p2-empty">Keine aktiven Projekte gefunden.</div>'; } catch (error) { projectTarget.innerHTML = `<div class="p2-empty">${p2Esc(error instanceof Error ? error.message : 'Projekte konnten nicht geladen werden.')}</div>`; } };
    document.getElementById('p2-project-refresh')?.addEventListener('click', loadProjects); loadProjects();
    document.getElementById('p2-project-create')?.addEventListener('click', async () => { const title = window.prompt('Projektname'); if (!title?.trim()) return; try { await p2Api('/intern/api/projects.php', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ project_code: `P2-${Date.now()}`, title: title.trim(), object_name: title.trim(), address: '', planned_window_count: 0 }) }); document.getElementById('p2-project-message').textContent = 'Projekt angelegt.'; document.getElementById('p2-project-message').hidden = false; loadProjects(); } catch (error) { const message = document.getElementById('p2-project-message'); if (message) { message.className = 'p2-message is-error'; message.hidden = false; message.textContent = error instanceof Error ? error.message : 'Projekt konnte nicht angelegt werden.'; } } });
    const partnerTarget = document.getElementById('p2-partners');
    document.getElementById('p2-partner-refresh')?.addEventListener('click', async () => { if (!partnerTarget) return; partnerTarget.innerHTML = '<div class="p2-empty">Partnerentwürfe werden geladen …</div>'; try { const data = await p2Api('/intern/api/partner-contracts.php?action=list'); const rows = data.items || []; partnerTarget.innerHTML = rows.length ? `<table class="p2-table"><thead><tr><th>Partner</th><th>Version</th><th>Geändert</th></tr></thead><tbody>${rows.map(item => `<tr><td>${p2Esc(item.name)}</td><td>${p2Esc(item.revision)}</td><td>${p2Esc(item.updated_at)}</td></tr>`).join('')}</tbody></table>` : '<div class="p2-empty">Keine eigenen Partnerentwürfe vorhanden.</div>'; } catch (error) { partnerTarget.innerHTML = `<div class="p2-empty">${p2Esc(error instanceof Error ? error.message : 'Partnerdaten konnten nicht geladen werden.')}</div>`; } });
    const results = document.getElementById('p2-case-results');
    if (results) { fetch('/intern/api/case-file-browser.php?action=summary', { credentials: 'same-origin', cache: 'no-store' }).then(response => response.json()).then(data => { if (data?.items?.length) results.innerHTML = data.items.slice(0, 12).map(item => '<tr><td>' + String(item.label || item.case_number || 'Vorgang') + '</td><td>' + String(item.status || 'offen') + '</td><td>' + String(item.next_step || 'Prüfung fortsetzen') + '</td></tr>').join(''); else results.innerHTML = '<tr><td colspan="3"><div class="p2-empty">Noch keine Fälle im aktuellen Arbeitsstand.</div></td></tr>'; }).catch(() => { results.innerHTML = '<tr><td colspan="3"><div class="p2-empty">Arbeitsstand konnte nicht geladen werden.</div></td></tr>'; }); }
  </script>
</Portal2Layout>
