---
import InternalLayout from '../../../layouts/InternalLayout.astro';
---

<InternalLayout title="Portal 2.0" description="Schlanke Arbeitszentrale für Fälle, Berichte, Kalkulation und Organisation." currentPath="/intern/portal2/">
  <main class="p2-shell">
    <header class="p2-hero">
      <div>
        <p class="p2-kicker">Portal 2.0</p>
        <h1>Arbeitszentrale</h1>
        <p class="p2-lede">Fälle zuerst. Die wichtigsten Arbeitsschritte sind nach Aufgabe und Bearbeitungsstand geordnet.</p>
      </div>
      <div class="p2-hero-actions"><a class="p2-primary" href="/intern/versicherungsfaelle/">Fall öffnen</a><a class="p2-secondary" href="/intern/tagescockpit/">Tagescockpit</a></div>
    </header>

    <section class="p2-status" aria-label="Systemstatus">
      <div><span class="p2-status-dot" data-state="pending"></span><strong id="p2-drive">Google Drive wird geprüft …</strong><small>Fallakten und Vorlagen</small></div>
      <div><span class="p2-status-dot" data-state="pending"></span><strong id="p2-claims">ClaimsForce wird geprüft …</strong><small>Importaufträge</small></div>
      <div><span class="p2-status-dot" data-state="pending"></span><strong id="p2-updated">Stand wird geladen …</strong><small>Letzte Aktualisierung</small></div>
    </section>

    <section class="p2-section" aria-labelledby="p2-cases-title">
      <div class="p2-section-head"><div><p class="p2-eyebrow">01 · Bearbeiten</p><h2 id="p2-cases-title">Fälle und Berichte</h2></div><a href="/intern/versicherungsfaelle/">Alle Fälle</a></div>
      <div class="p2-grid">
        <a class="p2-card p2-card--accent" href="/intern/versicherungsfaelle/"><span class="p2-card-icon">⌂</span><span><strong>Versicherungsfälle</strong><small>Fall öffnen, Akte prüfen und Unterlagen bearbeiten</small></span><b>→</b></a>
        <a class="p2-card" href="/intern/claimsforce/"><span class="p2-card-icon">↻</span><span><strong>ClaimsForce einlesen</strong><small>Neue Fälle und Nachrichten in die Akte übernehmen</small></span><b>→</b></a>
        <a class="p2-card" href="/intern/kalkulation/"><span class="p2-card-icon">▥</span><span><strong>Kalkulation</strong><small>Erstkalkulation, Nachkalkulation und Belege</small></span><b>→</b></a>
        <a class="p2-card" href="/intern/zeitwertberechnung/"><span class="p2-card-icon">⌛</span><span><strong>Zeitwert</strong><small>Zeitwertberechnung mit dokumentierter Herleitung</small></span><b>→</b></a>
      </div>
    </section>

    <section class="p2-section" aria-labelledby="p2-work-title">
      <div class="p2-section-head"><div><p class="p2-eyebrow">02 · Organisieren</p><h2 id="p2-work-title">Arbeitsstand</h2></div><a href="/intern/arbeitszentrale/">Arbeitsorganisation</a></div>
      <div class="p2-grid">
        <a class="p2-card" href="/intern/aufgaben/"><span class="p2-card-icon">✓</span><span><strong>Aufgaben und Wiedervorlagen</strong><small>Offene Schritte nach Priorität abarbeiten</small></span><b>→</b></a>
        <a class="p2-card" href="/intern/zeiterfassung/"><span class="p2-card-icon">◷</span><span><strong>Zeiterfassung</strong><small>Arbeitszeit fallbezogen erfassen</small></span><b>→</b></a>
        <a class="p2-card" href="/intern/kalender/"><span class="p2-card-icon">□</span><span><strong>Kalender und Termine</strong><small>Ortstermine und nächste Schritte im Blick</small></span><b>→</b></a>
        <a class="p2-card" href="/intern/telefon/"><span class="p2-card-icon">☎</span><span><strong>Telefonzentrale</strong><small>Anrufe aufnehmen und Fällen zuordnen</small></span><b>→</b></a>
      </div>
    </section>

    <section class="p2-section" aria-labelledby="p2-services-title">
      <div class="p2-section-head"><div><p class="p2-eyebrow">03 · Weitere Bereiche</p><h2 id="p2-services-title">Wissen und Aufträge</h2></div><a href="/intern/versicherungswissen/">Versicherungswissen</a></div>
      <div class="p2-grid">
        <a class="p2-card" href="/intern/versicherungswissen/"><span class="p2-card-icon">▤</span><span><strong>Versicherungswissen</strong><small>Arbeitsstandards und Fachwissen</small></span><b>→</b></a>
        <a class="p2-card" href="/intern/privatauftraege/"><span class="p2-card-icon">⌑</span><span><strong>Privat- und Fenstergutachten</strong><small>Aufträge, Angebote und Gutachten</small></span><b>→</b></a>
        <a class="p2-card" href="/intern/partner/"><span class="p2-card-icon">◇</span><span><strong>Partner</strong><small>Kontakte und Zusammenarbeit</small></span><b>→</b></a>
        <a class="p2-card" href="/intern/abrechnungen/"><span class="p2-card-icon">€</span><span><strong>Buchhaltung</strong><small>Abrechnung und offene Positionen</small></span><b>→</b></a>
      </div>
    </section>

    <footer class="p2-footer"><span>Parallel zum bestehenden Portal. Vorhandene Bereiche bleiben erreichbar.</span><a href="/intern/">Zur bisherigen Navigation</a></footer>
  </main>
</InternalLayout>

<style is:global>
  .p2-shell{min-height:calc(100vh - 112px);padding:34px clamp(18px,4vw,56px) 48px;background:#f7f8f9;color:#132b40}.p2-hero{display:flex;align-items:flex-end;justify-content:space-between;gap:24px;max-width:1180px;margin:0 auto 24px}.p2-kicker,.p2-eyebrow{margin:0;color:#d97908;font-size:.74rem;font-weight:900;letter-spacing:.12em;text-transform:uppercase}.p2-hero h1{margin:6px 0 9px;color:#071a2e;font-size:clamp(2rem,4vw,3.2rem);letter-spacing:-.03em}.p2-lede{max-width:640px;margin:0;color:#5f7180;font-size:1rem}.p2-hero-actions{display:flex;flex-wrap:wrap;gap:8px}.p2-hero-actions a,.p2-section-head a,.p2-footer a{padding:10px 14px;border:1px solid #18324a;color:#18324a;font-weight:800;text-decoration:none}.p2-hero-actions .p2-primary{background:#18324a;color:#fff}.p2-status{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:10px;max-width:1180px;margin:0 auto 34px}.p2-status>div{display:grid;grid-template-columns:10px 1fr;column-gap:9px;align-items:center;padding:13px 15px;border:1px solid #dce2e6;background:#fff}.p2-status-dot{grid-row:1/3;width:8px;height:8px;border-radius:50%;background:#9baab5}.p2-status-dot[data-state="ok"]{background:#2e8148}.p2-status-dot[data-state="bad"]{background:#bc453b}.p2-status strong{font-size:.82rem}.p2-status small{grid-column:2;color:#71818e;font-size:.7rem}.p2-section{max-width:1180px;margin:0 auto 28px}.p2-section-head{display:flex;align-items:end;justify-content:space-between;gap:16px;margin-bottom:11px}.p2-section-head h2{margin:4px 0 0;color:#071a2e;font-size:1.35rem}.p2-section-head a{padding:6px 9px;border:0;color:#587080;font-size:.78rem}.p2-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:10px}.p2-card{display:grid;grid-template-columns:auto minmax(0,1fr) auto;align-items:center;gap:11px;min-height:92px;padding:15px;border:1px solid #dce2e6;background:#fff;color:#18324a;text-decoration:none;transition:transform .16s ease,box-shadow .16s ease,border-color .16s ease}.p2-card:hover,.p2-card:focus-visible{border-color:#f59a23;box-shadow:0 7px 22px rgba(7,26,46,.09);transform:translateY(-2px)}.p2-card--accent{border-top:4px solid #f59a23}.p2-card-icon{display:grid;place-items:center;width:34px;height:34px;background:#eef2f4;color:#d97908;font-size:1.25rem;font-weight:900}.p2-card strong,.p2-card small{display:block}.p2-card strong{color:#071a2e;font-size:.9rem}.p2-card small{margin-top:4px;color:#6a7d8c;font-size:.72rem;line-height:1.35}.p2-card b{color:#d97908;font-size:1.1rem}.p2-footer{display:flex;justify-content:space-between;gap:14px;max-width:1180px;margin:10px auto 0;padding-top:18px;border-top:1px solid #dce2e6;color:#71818e;font-size:.75rem}.p2-footer a{padding:0;border:0;color:#18324a;font-size:.75rem}@media(max-width:900px){.p2-hero{align-items:flex-start;flex-direction:column}.p2-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:600px){.p2-shell{padding:24px 14px 36px}.p2-status{grid-template-columns:1fr}.p2-grid{grid-template-columns:1fr}.p2-section-head{align-items:flex-start;flex-direction:column;gap:6px}.p2-footer{align-items:flex-start;flex-direction:column}}
</style>

<script is:inline>
(() => {
  const set=(index,state,id,text)=>{const dot=document.querySelectorAll('.p2-status-dot')[index];if(dot)dot.dataset.state=state;const target=document.getElementById(id);if(target)target.textContent=text};
  const request=async url=>{const response=await fetch(url,{credentials:'same-origin',cache:'no-store'});const data=await response.json().catch(()=>({}));if(!response.ok||data.ok===false)throw Error(data.error||`HTTP ${response.status}`);return data};
  Promise.allSettled([request('/intern/api/google-drive-sync.php?action=status'),request('/intern/api/claimsforce-queue.php?action=summary')]).then(([drive,claims])=>{
    if(drive.status==='fulfilled'){const folders=drive.value.folders?.cases?.items;set(0,'ok','p2-drive',Number.isFinite(Number(folders))?`Google Drive · ${folders} Fälle`:'Google Drive erreichbar')}else set(0,'bad','p2-drive','Google Drive nicht erreichbar');
    if(claims.status==='fulfilled'){const items=claims.value.items||[];const open=items.reduce((sum,item)=>sum+(Number.isFinite(Number(item.open_count))?Number(item.open_count):0),0);set(1,'ok','p2-claims',open?`ClaimsForce · ${open} offen`:'ClaimsForce erreichbar')}else set(1,'bad','p2-claims','ClaimsForce nicht erreichbar');
    set(2,'ok','p2-updated',`Stand · ${new Intl.DateTimeFormat('de-DE',{dateStyle:'medium',timeStyle:'short'}).format(new Date())}`);
  });
})();
</script>
