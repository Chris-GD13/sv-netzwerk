---
import Portal2Layout from '../../../layouts/Portal2Layout.astro';
---

<Portal2Layout title="Portal 2.0" description="Eigenständige Arbeitszentrale für Fälle, Aufträge und Entscheidungen." currentPath="/intern/portal2/">
  <section class="p2-hero">
    <div>
      <p class="p2-kicker">Portal 2.0 · Arbeitszentrale</p>
      <h1>Der nächste sinnvolle Schritt.</h1>
      <p>Fälle, Aufträge und Ergebnisse liegen in einem eigenen Arbeitsbereich. Jeder Bereich öffnet seine eigene Portal‑2.0‑Oberfläche.</p>
    </div>
    <div class="p2-actions"><a class="p2-action" href="/intern/portal2/faelle/">Fall auswählen</a><a class="p2-action p2-action--secondary" href="/intern/portal2/import/claimsforce/">Auftrag einlesen</a></div>
  </section>

  <section class="p2-status-grid" aria-label="Systemstatus">
    <div class="p2-status"><span class="p2-status__dot" data-state="pending"></span><strong id="p2-drive-status">Google Drive wird geprüft …</strong><small>Fallakten und Vorlagen</small></div>
    <div class="p2-status"><span class="p2-status__dot" data-state="pending"></span><strong id="p2-claims-status">Importstand wird geprüft …</strong><small>ClaimsForce und Rekon</small></div>
    <div class="p2-status"><span class="p2-status__dot" data-state="pending"></span><strong id="p2-case-status">Arbeitsstand wird geladen …</strong><small>Zuletzt bearbeitete Fälle</small></div>
  </section>

  <section class="p2-panel" aria-labelledby="p2-focus-title">
    <p class="p2-eyebrow">Arbeitsfokus</p>
    <h2 id="p2-focus-title">Fälle und Entscheidungen</h2>
    <div class="p2-card-grid">
      <a class="p2-card" href="/intern/portal2/faelle/"><span class="p2-card__icon">⌂</span><strong>Versicherungsfälle</strong><small>Akten öffnen, Schadenstand prüfen und nächste Schritte festlegen.</small></a>
      <a class="p2-card" href="/intern/portal2/berichte/"><span class="p2-card__icon">▤</span><strong>Berichte und Ergebnisse</strong><small>Entwürfe, Prüfungen und nachvollziehbare Ergebnisse zusammenführen.</small></a>
      <a class="p2-card" href="/intern/portal2/kalkulation/"><span class="p2-card__icon">▥</span><strong>Kalkulation</strong><small>KVA, Nachkalkulation und Belege fallbezogen bearbeiten.</small></a>
    </div>
  </section>

  <section class="p2-panel" aria-labelledby="p2-organise-title">
    <p class="p2-eyebrow">Arbeitsorganisation</p>
    <h2 id="p2-organise-title">Aufträge ohne Umwege</h2>
    <div class="p2-card-grid">
      <a class="p2-card" href="/intern/portal2/import/claimsforce/"><span class="p2-card__icon">↻</span><strong>ClaimsForce importieren</strong><small>Neue Aufträge und Nachrichten strukturiert in den Arbeitsstand übernehmen.</small></a>
      <a class="p2-card" href="/intern/portal2/import/rekon/"><span class="p2-card__icon">◌</span><strong>Rekon importieren</strong><small>Rechnungs- und Rekonstruktionsaufträge prüfen und zuordnen.</small></a>
      <a class="p2-card" href="/intern/portal2/aufgaben/"><span class="p2-card__icon">✓</span><strong>Aufgaben</strong><small>Offene Schritte, Wiedervorlagen und Verantwortlichkeiten im Blick behalten.</small></a>
      <a class="p2-card" href="/intern/portal2/kalender/"><span class="p2-card__icon">□</span><strong>Termine</strong><small>Ortstermine, Fristen und nächste Entscheidungen gemeinsam planen.</small></a>
      <a class="p2-card" href="/intern/portal2/zeitwert/"><span class="p2-card__icon">⌛</span><strong>Zeitwert</strong><small>Berechnungen mit Herleitung und dokumentiertem Ergebnis erstellen.</small></a>
      <a class="p2-card" href="/intern/portal2/versicherungswissen/"><span class="p2-card__icon">▤</span><strong>Versicherungswissen</strong><small>Arbeitsstandards und Fachwissen direkt im Vorgang nutzen.</small></a>
    </div>
  </section>

  <section class="p2-panel" aria-labelledby="p2-system-title">
    <p class="p2-eyebrow">Verbindungen</p>
    <h2 id="p2-system-title">Portal‑2.0‑Systeme</h2>
    <div class="p2-actions"><a class="p2-action" href="/intern/portal2/google-drive/">Google Drive verbinden</a><a class="p2-action p2-action--secondary" href="/intern/portal2/verwaltung/">Benutzer und Regeln</a><a class="p2-action p2-action--secondary" href="/intern/portal2/partner/">Partner verwalten</a></div>
  </section>

  <script is:inline>
    const setStatus = (selector, state, text) => {
      const target = document.querySelector(selector);
      if (target) target.textContent = text;
      const dot = target?.parentElement?.querySelector('.p2-status__dot');
      if (dot) dot.dataset.state = state;
    };
    const getJson = async (url) => {
      const response = await fetch(url, { credentials: 'same-origin', cache: 'no-store' });
      const data = await response.json().catch(() => null);
      if (!response.ok || !data || data.ok === false) throw new Error(data?.error || ('HTTP ' + response.status));
      return data;
    };
    Promise.allSettled([
      getJson('/intern/api/google-drive-sync.php?action=status'),
      getJson('/intern/api/claimsforce-queue.php?action=summary'),
      getJson('/intern/api/google-drive-sync.php?action=recent_cases'),
    ]).then(([drive, imports, cases]) => {
      setStatus('#p2-drive-status', drive.status === 'fulfilled' ? 'ok' : 'bad', drive.status === 'fulfilled' ? 'Google Drive erreichbar' : 'Google Drive nicht erreichbar');
      if (imports.status === 'fulfilled') {
        const count = Array.isArray(imports.value.items)
          ? imports.value.items.filter(item => item && item.source_job_id !== null && item.source_job_id !== undefined).length
          : 0;
        setStatus('#p2-claims-status', 'ok', count ? count + ' Importstände vorhanden' : 'Importstand bereit');
      } else setStatus('#p2-claims-status', 'bad', 'Importstand nicht erreichbar');
      if (cases.status === 'fulfilled') setStatus('#p2-case-status', 'ok', 'Arbeitsstand verfügbar');
      else setStatus('#p2-case-status', 'bad', 'Arbeitsstand nicht erreichbar');
    });
  </script>
</Portal2Layout>
