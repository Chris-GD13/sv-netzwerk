---
import Portal2Layout from '../../../../layouts/Portal2Layout.astro';
---
<Portal2Layout title="Kalkulation | Portal 2.0" description="Vollständige Kalkulation im Portal 2.0." currentPath="/intern/portal2/kalkulation/">
  <section class="p2-hero"><div><p class="p2-kicker">02 · Organisieren</p><h1>Kalkulation</h1></div></section>
  <section class="mirror-shell"><iframe title="Vollständige Kalkulation" src="/intern/kalkulation/" loading="eager"></iframe></section>
</Portal2Layout>
<style>
.mirror-shell{overflow:hidden;border:1px solid #d7e0e6;border-radius:5px;background:#fff;box-shadow:0 5px 18px rgba(16,42,67,.06)}iframe{display:block;width:100%;min-height:3800px;border:0;background:#fff}@media(max-width:720px){iframe{min-height:6200px}}
</style>