---
import InternalLayout from '../../../layouts/InternalLayout.astro';
import CalculationTypeNav from '../../../components/internal/CalculationTypeNav.astro';
import bteCatalog from '../../../data/bte-life-expectancy.json';
import paritaetCatalog from '../../../data/paritaet-life-expectancy.json';

const sourceUrl = '/intern/api/bki-library-upload.php?action=pdf&kind=lifetime';
const catalog = [
  ...bteCatalog.map((row) => ({ ...row, source: 'bte', sourceLabel: 'BTE', sourceTitle: 'BTE-Arbeitsblatt „Lebensdauer von Bauteilen, Zeitwerte“', sourceStand: '14.03.2008' })),
  ...paritaetCatalog.map((row) => ({ ...row, source: 'paritaet', sourceLabel: 'Paritätische Tabelle', sourceTitle: 'Paritätische Lebensdauertabelle der Mieter- und Hauseigentümerverbände', sourceStand: 'PDF Lebensdauer' })),
];
---
<InternalLayout title="Zeitwertberechnung" description="Technische Zeitwertermittlung anhand anerkannter Lebensdauerkataloge." currentPath="/intern/zeitwertberechnung/">
  <main class="zw-app" data-catalog={JSON.stringify(catalog)}>
    <a class="zw-back" href="/intern/versicherungsfaelle/">← Zurück zum Versicherungsportal</a>
    <CalculationTypeNav active="timevalue" />
    <section class="zw-head">
      <div><p class="zw-kicker">Lebensdauerkataloge</p><h1>Zeitwertberechnung</h1><p>Technischen Zeitwert, Abzug „Neu für Alt“ und einen kopierfertigen Begründungstext ermitteln.</p></div>
      <div id="zw-case" class="zw-case">Freie Berechnung · keinem Fall zugeordnet</div>
    </section>

    <section class="zw-card zw-case-calc" id="zw-case-calc">
      <div class="zw-title"><div><p class="zw-step">0</p><h2>Gesamtberechnung aus einem Schadenfall</h2></div><span>Haftpflicht / Regress</span></div>
      <p class="zw-case-help">Schadennummer eingeben und die zum Fall gespeicherten Kalkulationspositionen laden. Für jede betroffene Position wird die technische Lebensdauer und das Alter geprüft. Nur vollständig belegte Positionen fließen in den Gesamtzeitwert ein.</p>
      <div class="zw-case-search"><label>Schadennummer<input id="zw-case-number" type="search" placeholder="z. B. 26-184105-2" autocomplete="off"></label><button id="zw-case-load" class="zw-primary" type="button">Fall laden</button></div>
      <p id="zw-case-load-state" class="zw-state" role="status" aria-live="polite"></p>
      <div id="zw-case-summary" class="zw-case-summary" hidden></div>
      <div id="zw-case-lines" class="zw-case-lines" hidden></div>
      <div id="zw-case-total" class="zw-case-total" hidden></div>
    </section>

    <section class="zw-notice">
      <strong>Fachlicher Rahmen</strong>
      <p>Die Werte aus dem BTE-Arbeitsblatt und der paritätischen Lebensdauertabelle sind Richtwerte. Maßgeblich bleiben der Einzelfall sowie Beanspruchung, Qualität, Pflege, Unterhaltung, Nutzbarkeit und gegebenenfalls die Schicksalsgemeinschaft verbundener Bauteile. Technische und wirtschaftliche Lebensdauer sind nicht gleichzusetzen.</p>
      <a href={sourceUrl} target="_blank" rel="noreferrer">BTE-Arbeitsblatt auf IONOS öffnen</a>
    </section>

    <div class="zw-layout">
      <section class="zw-card">
        <div class="zw-title"><div><p class="zw-step">1</p><h2>Bauteil und Ausgangswerte</h2></div><span id="zw-count"></span></div>
        <label>Lebensdauerkatalog<select id="zw-source"><option value="all">Alle Quellen</option><option value="bte">BTE-Arbeitsblatt</option><option value="paritaet">Paritätische Lebensdauertabelle</option></select></label>
        <label>Bauteil suchen<input id="zw-search" type="search" placeholder="z. B. Dachziegel, Parkett, Kupferrohr"></label>
        <label>Bauteil aus Lebensdauerkatalog<select id="zw-component"></select></label>
        <div id="zw-reference" class="zw-reference" aria-live="polite"></div>
        <div class="zw-grid">
          <label>Neuwert netto<input id="zw-new-value" type="number" min="0" step="0.01" inputmode="decimal" placeholder="0,00"></label>
          <label>Umsatzsteuer<input id="zw-vat" type="number" min="0" step="0.1" value="19"></label>
          <label>Lebensalter in Jahren<input id="zw-age" type="number" min="0" step="0.1" value="0"></label>
          <label>Technische Lebensdauer<input id="zw-lifetime" type="number" min="0.1" step="0.1"></label>
          <label>Nutzungsbeanspruchung<select id="zw-usage"><option value="1">Wohnen / keine Reduktion</option><option value="0.8">Büro −20 %</option><option value="0.75">Gewerbe, wenig beansprucht −25 %</option><option value="0.5">Gewerbe, stark beansprucht −50 %</option></select></label>
          <label>Korrekturfaktor 0,8–1,2<input id="zw-factor" type="number" min="0.8" max="1.2" step="0.05" value="1"></label>
          <label>Begrenzende Restlebensdauer optional<input id="zw-limited-life" type="number" min="0" step="0.1" placeholder="z. B. 3"></label>
        </div>
        <label class="zw-check"><input id="zw-no-extension" type="checkbox"> Teilreparatur ohne Verlängerung der Nutzungsdauer – keine Entwertung</label>
        <button id="zw-calculate" class="zw-primary" type="button">Zeitwert berechnen</button>
        <p id="zw-state" class="zw-state" role="status" aria-live="polite"></p>
      </section>

      <section class="zw-card zw-result-card">
        <div class="zw-title"><div><p class="zw-step">2</p><h2>Ergebnis</h2></div></div>
        <div id="zw-empty" class="zw-empty">Bitte Bauteil, Neuwert, Alter und Lebensdauer eingeben.</div>
        <div id="zw-result" hidden>
          <dl class="zw-results">
            <div><dt>Neuwert</dt><dd id="zw-new-result"></dd></div>
            <div><dt>Lineare Grundentwertung</dt><dd id="zw-base-rate"></dd></div>
            <div><dt>Abzug „Neu für Alt“</dt><dd id="zw-deduction"></dd></div>
            <div class="zw-highlight"><dt>Technischer Zeitwert</dt><dd id="zw-time-value"></dd></div>
          </dl>
          <div class="zw-formula"><strong>Rechenweg</strong><p id="zw-formula"></p></div>
          <label>Begründungstext<textarea id="zw-text" rows="10"></textarea></label>
          <div class="zw-actions"><button id="zw-copy" class="zw-secondary" type="button">Text kopieren</button><span id="zw-copy-state"></span></div>
        </div>
      </section>
    </div>

    <section class="zw-card zw-transfer">
      <div class="zw-title"><div><p class="zw-step">3</p><h2>In die Kalkulation übernehmen</h2></div></div>
      <p>Wähle, welche Bestandteile in der BKI-Kalkulation ergänzt werden sollen.</p>
      <div class="zw-transfer-options">
        <label class="zw-check"><input id="zw-transfer-amount" type="checkbox" checked> Betrag als Kalkulationsposition übernehmen</label>
        <label>Art der Position<select id="zw-transfer-mode"><option value="deduction">Abzug „Neu für Alt“ als negative Position</option><option value="timevalue">Technischen Zeitwert als positive Position</option></select></label>
        <label class="zw-check"><input id="zw-transfer-text" type="checkbox" checked> Begründungstext als Hinweis übernehmen</label>
      </div>
      <button id="zw-transfer" class="zw-primary" type="button" disabled>Auswahl in Kalkulation übernehmen</button>
      <p id="zw-transfer-state" class="zw-state" role="status" aria-live="polite"></p>
    </section>
  </main>
</InternalLayout>

<style is:global>
:root{--zw-navy:#17324a;--zw-muted:#687b8c;--zw-orange:#ff970f;--zw-line:#d7e1e8;--zw-green:#2e775b}.zw-app{max-width:1420px;margin:auto;padding:18px 24px 56px;color:var(--zw-navy)}.zw-back{display:inline-block;margin-bottom:12px;color:var(--zw-navy);font-weight:800;text-decoration:none}.zw-head{display:flex;align-items:flex-start;justify-content:space-between;gap:24px;margin-bottom:16px}.zw-head h1{margin:.15rem 0}.zw-head p{margin:.2rem 0;color:var(--zw-muted)}.zw-kicker{color:var(--zw-orange)!important;font-weight:900;text-transform:uppercase;letter-spacing:.04em}.zw-case{max-width:480px;padding:10px 13px;border:1px solid var(--zw-line);border-left:4px solid var(--zw-orange);background:#fff;font-weight:800}.zw-case.on{border-left-color:var(--zw-green);background:#edf7f2;color:#225f49}.zw-notice{margin-bottom:16px;padding:14px 16px;border:1px solid #e7c48e;border-left:4px solid var(--zw-orange);background:#fff8ed}.zw-notice p{margin:.35rem 0 .45rem;line-height:1.5}.zw-notice a{color:var(--zw-navy);font-weight:800}.zw-layout{display:grid;grid-template-columns:minmax(0,1fr) minmax(420px,.9fr);gap:16px}.zw-card{margin-bottom:16px;padding:18px;border:1px solid var(--zw-line);background:#fff;box-shadow:0 2px 8px rgba(7,26,46,.05)}.zw-title{display:flex;align-items:flex-start;justify-content:space-between;gap:12px;margin-bottom:14px}.zw-title>div{display:flex;align-items:center;gap:10px}.zw-title h2{margin:0}.zw-step{display:grid;place-items:center;width:30px;height:30px;margin:0;border-radius:2px;background:var(--zw-navy);color:#fff;font-weight:900}.zw-card label{display:grid;gap:5px;margin-bottom:11px;color:#526a7d;font-size:.8rem;font-weight:800}.zw-card input,.zw-card select,.zw-card textarea{box-sizing:border-box;width:100%;padding:10px;border:1px solid #b9c8d3;border-radius:3px;background:#fff;color:#172f44;font:inherit}.zw-card input:focus,.zw-card select:focus,.zw-card textarea:focus{outline:2px solid rgba(255,151,15,.24);border-color:var(--zw-orange)}.zw-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:0 12px}.zw-reference{margin:4px 0 14px;padding:11px 12px;border:1px solid var(--zw-line);background:#f5f8fa;line-height:1.5}.zw-reference strong,.zw-reference span{display:block}.zw-reference span{color:var(--zw-muted);font-size:.8rem}.zw-check{display:flex!important;align-items:flex-start;gap:8px;color:var(--zw-navy)!important;font-size:.88rem!important}.zw-check input{flex:0 0 auto;width:18px;height:18px;margin:1px 0 0;accent-color:var(--zw-orange)}.zw-primary,.zw-secondary{padding:10px 14px;border-radius:3px;font-weight:850;cursor:pointer}.zw-primary{border:1px solid var(--zw-navy);background:var(--zw-navy);color:#fff}.zw-secondary{border:1px solid #aebfcb;background:#fff;color:var(--zw-navy)}.zw-primary:disabled{cursor:not-allowed;opacity:.45}.zw-state{min-height:1.3em;margin:.6rem 0 0;color:var(--zw-muted);font-size:.85rem}.zw-empty{display:grid;min-height:260px;place-items:center;padding:20px;border:1px dashed #b9c8d3;background:#f8fafb;color:var(--zw-muted);text-align:center}.zw-results{display:grid;gap:9px;margin:0}.zw-results>div{display:grid;grid-template-columns:1fr auto;gap:12px;padding:10px 12px;border-bottom:1px solid #e5ebef}.zw-results dt{color:var(--zw-muted)}.zw-results dd{margin:0;text-align:right;font-weight:900}.zw-results dd small{display:block;color:var(--zw-muted);font-weight:700}.zw-results .zw-highlight{border:1px solid #a9d1bf;background:#edf7f2}.zw-formula{margin:14px 0;padding:12px;border-left:4px solid var(--zw-orange);background:#fff8ed}.zw-formula p{margin:.35rem 0 0;line-height:1.5}.zw-actions{display:flex;align-items:center;gap:10px}.zw-transfer{border-top:4px solid var(--zw-orange)}.zw-transfer>p{color:var(--zw-muted)}.zw-case-calc{border-top:4px solid var(--zw-green)}.zw-case-help{max-width:980px;color:var(--zw-muted);line-height:1.5}.zw-case-search{display:grid;grid-template-columns:minmax(260px,420px) auto;gap:12px;align-items:end}.zw-case-search label{margin:0}.zw-case-summary{margin:12px 0;padding:11px 13px;border:1px solid #b9d8c8;background:#edf7f2}.zw-case-lines{overflow:auto;margin-top:14px}.zw-case-lines table{width:100%;border-collapse:collapse;min-width:920px}.zw-case-lines th,.zw-case-lines td{padding:8px;border-bottom:1px solid var(--zw-line);text-align:left;vertical-align:top}.zw-case-lines th{background:#f4f7f9;color:#526a7d;font-size:.78rem}.zw-case-lines input,.zw-case-lines select{width:100%;box-sizing:border-box;padding:7px;border:1px solid #b9c8d3;border-radius:3px}.zw-case-lines .zw-line-value{text-align:right;white-space:nowrap;font-weight:800}.zw-case-total{margin-top:14px;padding:14px;border:1px solid #a9d1bf;background:#edf7f2}.zw-case-total strong{font-size:1.15rem}.zw-case-total dl{display:grid;grid-template-columns:1fr auto;gap:6px;margin:10px 0 0}.zw-case-total dd{margin:0;text-align:right;font-weight:800}.zw-case-total .zw-case-open-points{margin-top:10px;color:#7a4b08;font-size:.88rem}.zw-case-calc .zw-title>span{color:#225f49;background:#edf7f2;padding:5px 8px;border-radius:12px;font-size:.78rem;font-weight:800}@media(max-width:620px){.zw-case-search{grid-template-columns:1fr}.zw-case-search .zw-primary{width:100%}}.zw-transfer-options{display:grid;grid-template-columns:1fr minmax(280px,.7fr) 1fr;gap:14px;align-items:end}.zw-transfer-options label{margin:0}.zw-transfer-options .zw-check{align-self:center}.zw-result-card textarea{line-height:1.45;resize:vertical}@media(max-width:1000px){.zw-layout{grid-template-columns:1fr}.zw-transfer-options{grid-template-columns:1fr}}@media(max-width:620px){.zw-app{padding:12px 10px 40px}.zw-head{display:block}.zw-case{margin-top:12px}.zw-grid{grid-template-columns:1fr}.zw-results>div{grid-template-columns:1fr}.zw-results dd{text-align:left}.zw-primary,.zw-secondary{width:100%}.zw-actions{align-items:stretch;flex-direction:column}.zw-card input,.zw-card select,.zw-card textarea{font-size:16px}}@media print{.intern-header,.intern-sidebar,.calculation-type-nav,.zw-back,.zw-transfer,.zw-actions,.skip-link{display:none!important}.intern-portal-shell{display:block!important}.zw-app{max-width:none;padding:0}.zw-layout{display:block}.zw-card,.zw-notice{box-shadow:none;break-inside:avoid}.zw-card:first-child{margin-bottom:8mm}.zw-result-card textarea{border:0;min-height:70mm}}
</style>

<script type="module" is:inline>
import { calculateTimeValue, buildTimeValueText } from '/intern/time-value.js';
(() => {
  const root=document.querySelector('.zw-app');if(!root)return;
  const catalog=JSON.parse(root.dataset.catalog||'[]'),$=id=>document.getElementById(id);
  const money=value=>new Intl.NumberFormat('de-DE',{style:'currency',currency:'EUR'}).format(Number(value)||0);
  const number=value=>new Intl.NumberFormat('de-DE',{maximumFractionDigits:2}).format(Number(value)||0);
  const percent=value=>new Intl.NumberFormat('de-DE',{maximumFractionDigits:2}).format((Number(value)||0)*100)+' %';
  let filtered=catalog,current=null,result=null,baseLifetime=0;
  for(const store of[sessionStorage,localStorage])try{const active=JSON.parse(store.getItem('svnet-case')||'null');if(active?.folder_id){const meta=active.meta||{};$('zw-case').classList.add('on');$('zw-case').textContent=`Fall ${meta.schaden_nr||'ohne Schaden-Nr.'} · ${meta.schadenart||'Schaden'} · ${meta.vn_objekt||meta.ort||''}`;break}}catch{}
  const defaultLifetime=row=>Number(row.mean??(row.min!=null&&row.max!=null?(Number(row.min)+Number(row.max))/2:row.min??row.max??0));
  function esc(value){return String(value??'').replace(/[&<>"']/g,char=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[char]))}
  const usageApplies=row=>row?.source==='paritaet'&&['Decken und Wände','Bodenbeläge'].includes(row.category);
  function applyUsage(){if(!current)return;const select=$('zw-usage'),allowed=usageApplies(current);select.disabled=!allowed;if(!allowed)select.value='1';const factor=allowed?Number(select.value):1;$('zw-lifetime').value=String(Math.round(baseLifetime*factor*10)/10);}
  function filterCatalog(){const query=$('zw-search').value.trim().toLocaleLowerCase('de'),source=$('zw-source').value;filtered=catalog.filter(row=>(source==='all'||row.source===source)&&`${row.code} ${row.category||''} ${row.name}`.toLocaleLowerCase('de').includes(query));fill()}
  function fill(){const prior=$('zw-component').value;$('zw-component').innerHTML=filtered.map(row=>`<option value="${catalog.indexOf(row)}">${esc(row.sourceLabel)} · ${esc(row.category?`${row.category} · `:'')}${esc(row.name)}</option>`).join('');if(prior&&[...$('zw-component').options].some(option=>option.value===prior))$('zw-component').value=prior;selectComponent();$('zw-count').textContent=`${filtered.length} von ${catalog.length} Richtwerten`}
  function selectComponent(){current=catalog[Number($('zw-component').value)]||filtered[0]||null;if(!current){$('zw-reference').textContent='Kein passendes Bauteil gefunden.';return}baseLifetime=defaultLifetime(current);const range=current.min!=null&&current.max!=null?`${number(current.min)} bis ${number(current.max)} Jahre`:current.mean!=null?`${number(current.mean)} Jahre`:'';applyUsage();$('zw-reference').innerHTML=`<strong>${esc(current.sourceLabel)} ${esc(current.code)} · ${esc(current.name)}</strong><span>${current.category?`${esc(current.category)} · `:''}${current.mean!=null?`Richtwert ${number(current.mean)} Jahre`:current.min!=null&&current.max!=null?`Kein Mittelwert angegeben; Spanne ${range}`:'Richtwert'}${current.min!=null&&current.max!=null&&current.mean!=null?` · Spanne ${range}`:''} · Quelle Seite ${current.page}${usageApplies(current)?' · Nutzungsreduzierung für Boden-, Wand- und Deckenbeläge anwendbar':''}</span>`;result=null;showEmpty()}
  function showEmpty(){$('zw-empty').hidden=false;$('zw-result').hidden=true;$('zw-transfer').disabled=true}
  function calculate(){if(!current)return;result=calculateTimeValue({newValueNet:$('zw-new-value').value,age:$('zw-age').value,lifetime:$('zw-lifetime').value,correctionFactor:$('zw-factor').value,limitedRemainingLife:$('zw-limited-life').value,vatRate:$('zw-vat').value,noLifeExtension:$('zw-no-extension').checked});if(!result.valid){showEmpty();$('zw-state').textContent=result.error;return}$('zw-state').textContent='Zeitwert wurde berechnet. Bitte Ansatz und Einzelfall würdigen.';$('zw-empty').hidden=true;$('zw-result').hidden=false;$('zw-new-result').innerHTML=`${money(result.newValueNet)} netto<small>${money(result.newValueGross)} brutto</small>`;$('zw-base-rate').innerHTML=`${percent(result.baseDepreciationRate)}<small>${result.age} ÷ ${result.effectiveLifetime} Jahre</small>`;$('zw-deduction').innerHTML=`${money(result.deductionNet)} netto<small>${money(result.deductionGross)} brutto · ${percent(result.depreciationRate)}</small>`;$('zw-time-value').innerHTML=`${money(result.timeValueNet)} netto<small>${money(result.timeValueGross)} brutto · ${percent(result.timeValueRate)}</small>`;$('zw-formula').textContent=result.noLifeExtension?'Teilreparatur ohne Nutzungsdauerverlängerung: Zeitwertanteil 100 %.':`Grundentwertung = ${number(result.age)} Jahre ÷ ${number(result.effectiveLifetime)} Jahre = ${percent(result.baseDepreciationRate)}; korrigierte Entwertung = ${percent(result.baseDepreciationRate)} × ${number(result.correctionFactor)} = ${percent(result.depreciationRate)}; Zeitwert = Neuwert × ${percent(result.timeValueRate)}.`;const usageNote=usageApplies(current)&&Number($('zw-usage').value)<1?` Die tabellarische Lebensdauer von ${number(baseLifetime)} Jahren wurde wegen der gewählten Nutzungsbeanspruchung um ${number((1-Number($('zw-usage').value))*100)} % auf ${number(result.lifetime)} Jahre reduziert.`:'';$('zw-text').value=buildTimeValueText(current.name,result,{page:current.page,title:current.sourceTitle,stand:current.sourceStand,usageNote});$('zw-transfer').disabled=false}
  const caseState={case:null,calculations:[],rows:[]};
  const api=async(url,options={})=>{const response=await fetch(url,{credentials:'same-origin',...options}),data=await response.json().catch(()=>({}));if(!response.ok)throw new Error(data.error||`HTTP ${response.status}`);return data};
  const lineNet=row=>{const quantity=Number(row.quantity)||0,unit=Number(row.unit_price)||0,factor=Number(row.regional_factor)||1;return quantity*unit*factor};
  function caseRowMarkup(row,index){const suggested=catalog.find(item=>`${item.name} ${item.category||''}`.toLocaleLowerCase('de').includes(String(row.description||'').toLocaleLowerCase('de').split(/[,/–-]/)[0].trim().slice(0,18)));const life=suggested?defaultLifetime(suggested):'';return `<tr data-case-row="${index}"><td><strong>${esc(row.description||'Kalkulationsposition')}</strong><small>${esc(row.source_name||'')} · ${esc(row.unit||'psch')} · ${money(lineNet(row))} netto</small></td><td><input data-case-age type="number" min="0" step="0.1" placeholder="Jahre"></td><td><input data-case-life type="number" min="0.1" step="0.1" value="${life?esc(life):''}" placeholder="Jahre"></td><td><select data-case-factor><option value="1">1,00</option><option value="0.8">0,80</option><option value="0.75">0,75</option><option value="0.5">0,50</option></select></td><td class="zw-line-value" data-case-result>offen</td></tr>`}
  function recalcCase(){const box=$('zw-case-lines');if(!box||!caseState.rows.length)return;let net=0,deduction=0,complete=0,open=0;box.querySelectorAll('tbody tr').forEach((tr,index)=>{const row=caseState.rows[index],amount=lineNet(row),age=Number(tr.querySelector('[data-case-age]')?.value),life=Number(tr.querySelector('[data-case-life]')?.value),factor=Number(tr.querySelector('[data-case-factor]')?.value||1),out=tr.querySelector('[data-case-result]');if(!Number.isFinite(age)||age<0||!Number.isFinite(life)||life<=0){out.textContent='Lebensdauer fehlt';open++;return}const result=calculateTimeValue({newValueNet:amount,age,lifetime:life,correctionFactor:factor,vatRate:caseState.case?.vat_rate??19});if(!result.valid){out.textContent='nicht berechenbar';open++;return}complete++;net+=result.timeValueNet;deduction+=result.deductionNet;out.textContent=`${money(result.timeValueNet)} · ${percent(result.timeValueRate)}`});const total=$('zw-case-total');total.hidden=false;total.innerHTML=`<strong>Gesamtzeitwert der belegten Positionen: ${money(net)} netto</strong><dl><dt>Ausgangswert der belegten Positionen</dt><dd>${money(net+deduction)} netto</dd><dt>Gesamtabzug „Neu für Alt“</dt><dd>${money(deduction)} netto</dd><dt>Vollständig berechnete Positionen</dt><dd>${complete} von ${caseState.rows.length}</dd></dl>${open?`<div class="zw-case-open-points">${open} Position${open===1?'':'en'} bleiben offen, weil Alter oder technische Lebensdauer fehlen.</div>`:''}`}
  async function loadCase(){const state=$('zw-case-load-state'),numberInput=$('zw-case-number'),query=numberInput.value.trim();if(query.length<2){state.textContent='Bitte eine Schadennummer eingeben.';return}const button=$('zw-case-load');button.disabled=true;state.textContent='Schadenfall und Kalkulationen werden geladen …';$('zw-case-summary').hidden=true;$('zw-case-lines').hidden=true;$('zw-case-total').hidden=true;try{const found=await api('/intern/api/google-drive-sync.php?action=search_cases&q='+encodeURIComponent(query));const cases=found.results||[];if(!cases.length)throw Error('Kein zugänglicher Schadenfall mit dieser Schadennummer gefunden.');const exact=cases.find(item=>String(item.meta?.schaden_nr||'').replace(/[^a-z0-9]/gi,'').toLowerCase()===query.replace(/[^a-z0-9]/gi,'').toLowerCase())||cases[0];const loaded=await api('/intern/api/google-drive-sync.php?action=load_case&id='+encodeURIComponent(exact.id));const meta=loaded.case?.meta||exact.meta||{};const list=await api('/intern/api/bki-calculator.php?action=list&folder_id='+encodeURIComponent(exact.id));const calculations=list.items||[];const details=[];for(const item of calculations.slice(0,10)){const detail=await api('/intern/api/bki-calculator.php?action=get&id='+encodeURIComponent(item.id));for(const row of (detail.item?.items||[]))if(row?.type!=='section'&&lineNet(row)>0)details.push(row)}caseState.case={...meta,vat_rate:calculations[0]?.vat_rate||19};caseState.calculations=calculations;caseState.rows=details;const summary=$('zw-case-summary');summary.hidden=false;summary.innerHTML=`<strong>Fall ${esc(meta.schaden_nr||query)}</strong> · ${esc(meta.schadenart||meta.fallart||'Schaden')} · ${esc(meta.vn_objekt||meta.ort||'')}<br><span>${calculations.length?`${calculations.length} gespeicherte Kalkulation${calculations.length===1?'':'en'} · ${details.length} bepreiste Position${details.length===1?'':'en'}`:'Keine gespeicherte Kalkulation im Fall gefunden.'}</span>`;const lines=$('zw-case-lines');if(!details.length){lines.hidden=false;lines.innerHTML='<p class="zw-state">Für diesen Fall ist noch keine gespeicherte Kalkulation mit bepreisten Positionen vorhanden. Bitte zuerst die Fallkalkulation erstellen und speichern.</p>';state.textContent='Fall geladen, aber keine kalkulierbaren Positionen gefunden.';return}lines.hidden=false;lines.innerHTML=`<table><thead><tr><th>Position und Neuwert netto</th><th>Alter</th><th>Technische Lebensdauer</th><th>Korrektur</th><th>Zeitwert</th></tr></thead><tbody>${details.map(caseRowMarkup).join('')}</tbody></table>`;lines.querySelectorAll('input,select').forEach(input=>input.addEventListener('input',recalcCase));state.textContent='Fall geladen. Bitte Alter und technische Lebensdauer je Position prüfen.'}catch(error){state.textContent=error.message}finally{button.disabled=false}}
  $('zw-case-load').onclick=loadCase;$('zw-case-number').onkeydown=event=>{if(event.key==='Enter'){event.preventDefault();loadCase()}};
  $('zw-search').oninput=filterCatalog;$('zw-source').onchange=filterCatalog;$('zw-component').onchange=selectComponent;$('zw-usage').onchange=()=>{applyUsage();if(result)calculate()};$('zw-calculate').onclick=calculate;['zw-new-value','zw-vat','zw-age','zw-lifetime','zw-factor','zw-limited-life','zw-no-extension'].forEach(id=>$(id).addEventListener('input',()=>{if(result)calculate()}));$('zw-copy').onclick=async()=>{try{await navigator.clipboard.writeText($('zw-text').value);$('zw-copy-state').textContent='Text kopiert.'}catch{$('zw-text').select();$('zw-copy-state').textContent='Text ist markiert – bitte Strg+C drücken.'}};$('zw-transfer').onclick=()=>{if(!result?.valid||!current)return;const includeAmount=$('zw-transfer-amount').checked,includeText=$('zw-transfer-text').checked;if(!includeAmount&&!includeText){$('zw-transfer-state').textContent='Bitte Betrag oder Begründungstext auswählen.';return}const deduction=$('zw-transfer-mode').value==='deduction',amount=deduction?-result.deductionNet:result.timeValueNet,sourceName=`${current.sourceTitle}${current.sourceStand?` · ${current.sourceStand}`:''}`,description=deduction?`Abzug „Neu für Alt“ – ${current.name}, Zeitwertanteil ${percent(result.timeValueRate)}, TLD ${number(result.lifetime)} Jahre`:`Technischer Zeitwert – ${current.name}, Zeitwertanteil ${percent(result.timeValueRate)}, TLD ${number(result.lifetime)} Jahre`;sessionStorage.setItem('svnet-time-value-transfer',JSON.stringify({includeAmount,includeText,section:`Zeitwertermittlung – ${current.name}`,item:{position_code:`ZW ${current.code}`,description,quantity:1,unit:'psch',unit_price:amount,regional_factor:1,source_name:sourceName},note:$('zw-text').value,createdAt:new Date().toISOString()}));window.location.assign('/intern/kalkulation/?zeitwert=1')};fill();
})();
</script>
