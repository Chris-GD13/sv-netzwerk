---
import InternalLayout from '../../../layouts/InternalLayout.astro';
---
<InternalLayout title="Terminplanung" description="Gemeinsame Terminplanung für Claimsforce und Rekon." currentPath="/intern/terminplanung/">
  <main class="tp-app">
    <header class="tp-head">
      <div><p class="tp-kicker">SV-Netzwerk</p><h1>Terminplanung</h1><p id="tp-profile">Fälle und Kalender werden geladen …</p></div>
      <button id="tp-refresh" type="button">Aktualisieren</button>
    </header>
    <section class="tp-status" aria-live="polite"><span id="tp-state">Daten werden geladen …</span><span id="tp-calendar"></span></section>
    <section class="tp-layout">
      <div class="tp-card">
        <div class="tp-card-head"><div><h2>Fälle zur Terminierung</h2><p>Nur offene Claimsforce- und Rekon-Fälle aus dem zugeordneten Bearbeiterprofil.</p></div><form id="tp-search"><input id="tp-query" placeholder="Schadennummer, VN oder Ort" autocomplete="off" /><button type="submit">Suchen</button></form></div>
        <div id="tp-cases" class="tp-cases"><p class="tp-empty">Fälle werden geladen …</p></div>
      </div>
      <div class="tp-card tp-schedule">
        <h2>Termin anlegen</h2><p id="tp-selected" class="tp-selected">Noch kein Fall ausgewählt.</p>
        <label>Datum<input id="tp-date" type="date" /></label>
        <div class="tp-row"><label>Beginn<input id="tp-time" type="time" step="900" /></label><label>Dauer<select id="tp-duration"><option value="30">30 Minuten</option><option value="60" selected>60 Minuten</option><option value="90">90 Minuten</option><option value="120">120 Minuten</option></select></label></div>
        <label>Besichtigungsadresse<input id="tp-address" readonly /></label>
        <label>Interne Notiz<textarea id="tp-notes" rows="4" placeholder="Anfahrt, Ansprechpartner oder Hinweise"></textarea></label>
        <div class="tp-actions"><button id="tp-check" class="secondary" type="button" disabled>Verfügbarkeit prüfen</button><button id="tp-create" type="button" disabled>Termin anlegen</button></div>
        <p id="tp-action-state" class="tp-action-state" aria-live="polite"></p>
      </div>
    </section>
    <section class="tp-card tp-week"><div class="tp-card-head"><div><h2>Kalenderwoche</h2><p id="tp-week-label">Wird geladen …</p></div><div class="tp-week-actions"><button id="tp-prev" type="button">←</button><button id="tp-today" type="button">Heute</button><button id="tp-next" type="button">→</button></div></div><div id="tp-events" class="tp-events"></div></section>
  </main>
</InternalLayout>
<style is:global>
  .tp-app{box-sizing:border-box;min-height:calc(100vh - 112px);padding:26px;color:#17324a}.tp-head{display:flex;align-items:flex-end;justify-content:space-between;gap:18px;margin-bottom:14px}.tp-kicker{margin:0;color:#f59a23;font-size:.78rem;font-weight:900;text-transform:uppercase;letter-spacing:.06em}.tp-head h1{margin:3px 0;font-size:2rem;color:#071a2e}.tp-head p{margin:0;color:#647789}.tp-head button,.tp-card-head button,.tp-actions button,.tp-week-actions button{border:1px solid #17324a;background:#17324a;color:#fff;padding:9px 12px;font:inherit;font-weight:800;cursor:pointer}.tp-status{display:flex;justify-content:space-between;gap:12px;margin-bottom:14px;padding:11px 13px;border-left:4px solid #f59a23;background:#fff}.tp-status span:last-child{color:#647789}.tp-layout{display:grid;grid-template-columns:minmax(0,1.35fr) minmax(290px,.65fr);gap:14px}.tp-card{padding:17px;border:1px solid #d5dde3;background:#fff}.tp-card h2{margin:0;color:#071a2e;font-size:1.12rem}.tp-card p{margin:4px 0 0;color:#647789;font-size:.8rem}.tp-card-head{display:flex;align-items:flex-end;justify-content:space-between;gap:12px;margin-bottom:14px}.tp-card-head form{display:grid;grid-template-columns:minmax(180px,1fr) auto;gap:6px}.tp-card input,.tp-card select,.tp-card textarea{box-sizing:border-box;width:100%;border:1px solid #bac7d0;background:#fff;color:#17324a;padding:9px;font:inherit}.tp-cases{display:grid;gap:7px;max-height:480px;overflow:auto}.tp-case{display:grid;grid-template-columns:minmax(0,1fr) auto;align-items:center;gap:10px;padding:10px;border-left:4px solid #8b9ca8;background:#f3f6f8}.tp-case.selected{border-left-color:#f59a23;background:#fff7e9}.tp-case strong{display:block;color:#071a2e}.tp-case small{display:block;margin-top:3px;color:#647789;line-height:1.35}.tp-case button{border:1px solid #17324a;background:#fff;color:#17324a;padding:7px 9px;font:inherit;font-size:.75rem;font-weight:800;cursor:pointer}.tp-tags{display:flex;flex-wrap:wrap;gap:4px;margin-top:5px}.tp-tag{display:inline-block;padding:2px 6px;background:#dce7ee;color:#38546a;border-radius:10px;font-size:.66rem;font-weight:800}.tp-tag.claims{background:#e4eefb;color:#235a96}.tp-tag.rekon{background:#eee5fb;color:#643d92}.tp-selected{min-height:42px;padding:10px;border-left:4px solid #f59a23;background:#fff7e9!important}.tp-schedule label{display:grid;gap:4px;margin:12px 0;color:#52697a;font-size:.76rem;font-weight:800}.tp-row{display:grid;grid-template-columns:1fr 1fr;gap:8px}.tp-actions{display:flex;flex-wrap:wrap;gap:7px;margin-top:14px}.tp-actions .secondary,.tp-week-actions button{background:#fff;color:#17324a}.tp-actions button:disabled{cursor:not-allowed;opacity:.5}.tp-action-state{min-height:1.2em;margin-top:10px!important}.tp-empty{padding:16px;background:#f3f6f8}.tp-week{margin-top:14px}.tp-week-actions{display:flex;gap:5px}.tp-events{display:grid;grid-template-columns:repeat(7,minmax(125px,1fr));border-top:1px solid #d5dde3;border-left:1px solid #d5dde3;overflow:auto}.tp-day{min-height:170px;border-right:1px solid #d5dde3;border-bottom:1px solid #d5dde3}.tp-day.today{background:#fffaf2}.tp-day-head{padding:8px;background:#edf2f5;border-bottom:1px solid #d5dde3}.tp-day-head strong,.tp-day-head span{display:block}.tp-day-head span{color:#647789;font-size:.72rem}.tp-day-items{display:grid;gap:5px;padding:6px}.tp-event{padding:6px;border-left:3px solid #f59a23;background:#f3f6f8;font-size:.72rem}.tp-event strong,.tp-event small{display:block}.tp-event small{margin-top:2px;color:#647789}.tp-ok{color:#24713c!important}.tp-bad{color:#a52f2f!important}@media(max-width:1000px){.tp-layout{grid-template-columns:1fr}.tp-events{grid-template-columns:repeat(7,minmax(160px,1fr))}}@media(max-width:700px){.tp-app{padding:14px}.tp-head,.tp-card-head{align-items:flex-start;flex-direction:column}.tp-card-head form{width:100%}.tp-status{align-items:flex-start;flex-direction:column}.tp-row{grid-template-columns:1fr}}
</style>
<script is:inline>
(() => {
  const CASES='/intern/api/google-drive-sync.php', CAL='/intern/api/outlook-case-calendar.php', $=id=>document.getElementById(id), esc=v=>String(v??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
  const req=async(url,opt={})=>{const r=await fetch(url,{credentials:'same-origin',cache:'no-store',...opt}),d=await r.json().catch(()=>({}));if(!r.ok||d.ok===false)throw Error(d.error||`HTTP ${r.status}`);return d};
  const pad=n=>String(n).padStart(2,'0'), iso=d=>`${d.getFullYear()}-${pad(d.getMonth()+1)}-${pad(d.getDate())}`, monday=v=>{const d=new Date(v);d.setHours(12,0,0,0);const day=d.getDay()||7;d.setDate(d.getDate()-day+1);return d};
  const fmtDay=new Intl.DateTimeFormat('de-DE',{weekday:'short'}), fmtDate=new Intl.DateTimeFormat('de-DE',{day:'2-digit',month:'2-digit'}), fmtTime=new Intl.DateTimeFormat('de-DE',{hour:'2-digit',minute:'2-digit'}); let selected=null, week=monday(new Date());
  const addr=m=>[m.schaden_strasse||m.strasse,m.schaden_plz||m.plz,m.schaden_ort||m.ort].filter(Boolean).join(' ');
  function setState(text,kind=''){$('tp-state').textContent=text;$('tp-state').className=kind?`tp-${kind}`:''}
  function renderCases(rows){const box=$('tp-cases');if(!rows.length){box.innerHTML='<p class="tp-empty">Keine passenden Fälle gefunden.</p>';return}box.innerHTML=rows.map((r,i)=>{const m=r.meta||{},tags=(r.source_labels||[]).map(label=>`<span class="tp-tag ${label==='Claimsforce'?'claims':'rekon'}">${esc(label)}</span>`).join('');const ap=m.claimsforce_termin||m.rekon_termin||null;return `<article class="tp-case ${selected?.id===r.id?'selected':''}"><div><strong>${esc(m.schaden_nr||r.name||'Fall')}</strong><small>${esc([m.vn_objekt,addr(m),r.case_profile==='christian'?'Christian':r.case_profile==='marc'?'Marc':r.case_profile==='holger'?'Holger':''].filter(Boolean).join(' · '))}</small><div class="tp-tags">${tags||'<span class="tp-tag" title="Im Fallordner ist noch keine eindeutige Claimsforce- oder Rekon-Kennung hinterlegt.">Quelle nicht zugeordnet</span>'}${ap?'<span class="tp-tag">Termin vorhanden</span>':''}</div></div><button type="button" data-case="${i}">${selected?.id===r.id?'Ausgewählt':'Termin wählen'}</button></article>`}).join('');box.querySelectorAll('[data-case]').forEach(b=>b.onclick=()=>selectCase(rows[Number(b.dataset.case)]))}
  function selectCase(row){selected=row;const m=row.meta||{};$('tp-selected').textContent=`${m.schaden_nr||row.name||'Fall'} · ${m.vn_objekt||'VN/Objekt offen'}`;$('tp-address').value=addr(m);$('tp-check').disabled=false;$('tp-create').disabled=false;renderCases(window.caseRows||[])}
  async function loadCases(q=''){const d=await req(`${CASES}?action=schedule_cases&limit=80${q?`&q=${encodeURIComponent(q)}`:''}`);window.caseRows=d.results||[];$('tp-profile').textContent=`Profil: ${d.backoffice?'Zentrale Terminierung · ':''}${d.selected_expert||d.profile||'–'} · ${window.caseRows.length} Fälle`;renderCases(window.caseRows)}
  async function loadCalendar(){const d=await req(`${CAL}?action=list&start=${encodeURIComponent(iso(week))}`);$('tp-calendar').textContent=`${d.calendar||'Kalender'} · ${d.mailbox||''}`;$('tp-week-label').textContent=`${fmtDate.format(week)} – ${fmtDate.format(new Date(week.getTime()+6*86400000))}`;const events=d.events||[],today=iso(new Date());$('tp-events').innerHTML=Array.from({length:7},(_,i)=>{const day=new Date(week);day.setDate(day.getDate()+i);const key=iso(day),items=events.filter(e=>String(e.start||'').slice(0,10)===key);return `<section class="tp-day ${key===today?'today':''}"><header class="tp-day-head"><strong>${esc(fmtDay.format(day))}</strong><span>${esc(fmtDate.format(day))}</span></header><div class="tp-day-items">${items.length?items.map(e=>`<div class="tp-event"><strong>${esc(fmtTime.format(new Date(e.start)))}–${esc(fmtTime.format(new Date(e.end)))}</strong><small>${esc(e.subject)}${e.location?' · '+esc(e.location):''}</small></div>`).join(''):'<span class="tp-empty">–</span>'}</div></section>`}).join('')}
  async function refresh(){const b=$('tp-refresh');b.disabled=true;setState('Fälle und Kalender werden geladen …');try{await Promise.all([loadCases($('tp-query').value.trim()),loadCalendar()]);setState('Bereit','tp-ok')}catch(e){setState(e.message||'Daten konnten nicht geladen werden.','tp-bad')}finally{b.disabled=false}}
  $('tp-search').onsubmit=e=>{e.preventDefault();loadCases($('tp-query').value.trim()).catch(err=>setState(err.message,'tp-bad'))};$('tp-refresh').onclick=refresh;$('tp-prev').onclick=()=>{week.setDate(week.getDate()-7);loadCalendar().catch(e=>setState(e.message,'tp-bad'))};$('tp-next').onclick=()=>{week.setDate(week.getDate()+7);loadCalendar().catch(e=>setState(e.message,'tp-bad'))};$('tp-today').onclick=()=>{week=monday(new Date());loadCalendar().catch(e=>setState(e.message,'tp-bad'))};
  $('tp-check').onclick=async()=>{if(!selected)return;const s=$('tp-action-state');s.textContent='Verfügbarkeit wird geprüft …';try{const d=await req(`${CAL}?action=availability`,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({date:$('tp-date').value,time:$('tp-time').value,duration:$('tp-duration').value})});s.textContent=d.available?'Der Zeitraum ist frei.':'Der Zeitraum überschneidet sich mit einem bestehenden Termin.';s.className=d.available?'tp-action-state tp-ok':'tp-action-state tp-bad'}catch(e){s.textContent=e.message;s.className='tp-action-state tp-bad'}};
  $('tp-create').onclick=async()=>{if(!selected)return;const s=$('tp-action-state');s.textContent='Termin wird angelegt …';try{const fd=new FormData();fd.append('folder_id',selected.id);fd.append('date',$('tp-date').value);fd.append('time',$('tp-time').value);fd.append('duration',$('tp-duration').value);fd.append('notes',$('tp-notes').value.trim());fd.append('invite_vn','0');const d=await req(`${CAL}?action=create`,{method:'POST',body:fd});s.textContent=`Termin angelegt: ${d.event?.calendar||'Kalender'} · ${d.event?.start||''}`;s.className='tp-action-state tp-ok';await loadCalendar()}catch(e){s.textContent=e.message;s.className='tp-action-state tp-bad'}};
  $('tp-date').value=iso(new Date());$('tp-time').value='09:00';refresh();
})();
</script>
