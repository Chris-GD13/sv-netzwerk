---
import InternalLayout from '../../../layouts/InternalLayout.astro';
---
<InternalLayout title="Versicherungswissen" description="Versichererbezogene Bedingungen, Rahmenvereinbarungen und Bearbeitungshinweise.">
<section class="knowledge-page">
  <header><p class="intern-header__eyebrow">VERSICHERUNGSBEARBEITUNG</p><h1>Versicherungswissen</h1><p class="knowledge-lead">Bedingungen, Rahmenvereinbarungen und Bearbeitungshinweise werden dem jeweiligen Versicherer zugeordnet und stehen für Fallbearbeitung und Berichte bereit.</p></header>
  <nav class="knowledge-tabs" aria-label="Versicherungswissen"><button type="button" class="active" data-tab="documents" aria-selected="true">Unterlagen</button><button type="button" data-tab="sparkassen" aria-selected="false">Sparkassen Versicherung · Bedingungen &amp; Rahmenvereinbarungen</button></nav>
  <section id="knowledge-documents" class="knowledge-card"><div class="knowledge-controls"><label>Versicherer<select id="knowledge-insurer"><option value="">Alle Versicherer</option></select></label><label>Suche<input id="knowledge-search" placeholder="Datei, Sparte oder Ordner"></label></div><p id="knowledge-status" role="status">Wird geladen …</p><div id="knowledge-files" class="knowledge-groups"></div></section>
  <section id="knowledge-sparkassen" class="knowledge-card" hidden><h2>Sparkassen Versicherung · Bedingungen &amp; Rahmenvereinbarungen</h2><p class="knowledge-meta">Aus der hinterlegten Vergleichsdatei. Die Fassung bleibt an Quelle und Gültigkeitsstand gebunden.</p><div class="knowledge-controls"><label>Bereich<select id="knowledge-sheet"></select></label><label>Vergleich durchsuchen<input id="knowledge-table-search" placeholder="Bedingung, Sparte oder Inhalt"></label></div><div id="knowledge-table" class="knowledge-table"></div></section>
</section>
<style is:global>
.knowledge-page{max-width:1500px;padding:30px 34px 60px;color:#17324a}.knowledge-page h1{margin:0 0 8px;font-size:2.1rem}.knowledge-lead{max-width:850px;color:#526575}.knowledge-tabs{display:flex;flex-wrap:wrap;gap:8px;border-bottom:1px solid #d6dce1;margin:22px 0 14px}.knowledge-tabs button{border:1px solid #b8c7d2;background:#fff;color:#17324a;padding:11px 14px;font:inherit;font-weight:800;cursor:pointer}.knowledge-tabs button.active{background:#17324a;color:#fff}.knowledge-card{background:#fff;border:1px solid #d6dce1;border-top:4px solid #f59a23;padding:18px}.knowledge-controls{display:grid;grid-template-columns:280px minmax(240px,1fr);gap:12px}.knowledge-controls label,.knowledge-card>label{display:grid;gap:5px;font-weight:800;font-size:.82rem}.knowledge-controls input,.knowledge-controls select,.knowledge-card>label select{border:1px solid #bdcbd6;border-radius:3px;padding:10px;font:inherit;background:#fff}.knowledge-groups{display:grid;gap:12px}.knowledge-group{border:1px solid #d6dce1;background:#fafbfc}.knowledge-group>summary{cursor:pointer;padding:12px 14px;font-weight:800;color:#17324a}.knowledge-files{display:grid;grid-template-columns:repeat(auto-fill,minmax(300px,1fr));gap:8px;padding:0 10px 10px}.knowledge-file{border:1px solid #d6dce1;padding:10px;background:#fafbfc}.knowledge-file strong,.knowledge-file small{display:block;overflow-wrap:anywhere}.knowledge-file small{color:#617486;margin-top:4px}.knowledge-folder-link{display:inline;padding:0;border:0;background:none;color:#315f86;text-decoration:underline;cursor:pointer;font:inherit;text-align:left}.knowledge-meta,#knowledge-status{color:#617486;font-size:.86rem}.knowledge-table{overflow:auto;margin-top:14px;max-height:640px}.knowledge-table table{border-collapse:collapse;width:100%;font-size:.78rem}.knowledge-table th,.knowledge-table td{border:1px solid #d6dce1;padding:7px;text-align:left;vertical-align:top}.knowledge-table th{position:sticky;top:0;background:#edf2f5}.knowledge-table td{white-space:pre-wrap;min-width:150px}@media(max-width:700px){.knowledge-page{padding:20px 12px}.knowledge-controls{grid-template-columns:1fr}}
</style>
<script is:inline>
const esc=(s)=>String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const state={data:null}; const $=id=>document.getElementById(id);
async function load(){const r=await fetch('/intern/api/insurance-knowledge.php',{credentials:'same-origin',cache:'no-store'});const j=await r.json();if(!r.ok)throw Error(j.error||'Laden fehlgeschlagen');state.data=j;const sel=$('knowledge-insurer');j.insurers.filter(Boolean).sort().forEach(x=>sel.insertAdjacentHTML('beforeend',`<option>${esc(x)}</option>`));renderFiles();renderWorkbook();}
function renderFiles(){const d=state.data,ins=$('knowledge-insurer').value,q=$('knowledge-search').value.toLowerCase();const fs=(d.files||[]).filter(f=>(!ins||f.insurer===ins)&&(!q||(f.path+' '+f.name).toLowerCase().includes(q)));$('knowledge-status').textContent=`${fs.length} Unterlagen · Bestand geprüft ${d.generated_at||''}`;const groups={};fs.forEach(f=>(groups[f.insurer||'Unzugeordnet']??=[]).push(f));$('knowledge-files').innerHTML=Object.entries(groups).sort(([a],[b])=>a.localeCompare(b,'de')).map(([insurer,items])=>`<details class="knowledge-group" open><summary>${esc(insurer)} · ${items.length} Unterlagen</summary><div class="knowledge-files">${items.map(f=>{const folder=(f.path||'').split('/').slice(0,-1).join('/');return `<article class="knowledge-file"><strong>${esc(f.name)}</strong><small><button type="button" class="knowledge-folder-link" data-folder="${esc(folder)}" aria-label="Ordner ${esc(folder)} öffnen">${esc(f.path)}</button> · ${Math.ceil((f.size||0)/1024)} KB</small></article>`;}).join('')}</div></details>`).join('')||'<p>Keine passenden Unterlagen.</p>';document.querySelectorAll('.knowledge-folder-link').forEach(b=>b.onclick=()=>{$('knowledge-search').value=b.dataset.folder||'';renderFiles();});}function renderWorkbook(){const w=state.data.workbook||{},sel=$('knowledge-sheet');sel.innerHTML='';(w.sheets||[]).forEach((s,i)=>sel.insertAdjacentHTML('beforeend',`<option value="${i}">${esc(s.name)} (${s.rows.length} Einträge)</option>`));renderSheet();}
function renderSheet(){const s=(state.data.workbook?.sheets||[])[$('knowledge-sheet').value||0];if(!s){$('knowledge-table').innerHTML='<p>Für diesen Versicherer ist keine Vergleichstabelle hinterlegt.</p>';return}$('knowledge-table').innerHTML=`<table><thead><tr>${s.columns.map(c=>`<th>${esc(c)}</th>`).join('')}</tr></thead><tbody>${s.rows.filter(r=>!q||r.join(' ').toLowerCase().includes(q)).map(r=>`<tr>${r.map(c=>`<td>${esc(c)}</td>`).join('')}</tr>`).join('')}</tbody></table>`;}
function setTab(tab,writeHash=true){const active=tab==='sparkassen'?'sparkassen':'documents';document.querySelectorAll('.knowledge-tabs button').forEach(x=>{const on=x.dataset.tab===active;x.classList.toggle('active',on);x.setAttribute('aria-selected',String(on));});$('knowledge-documents').hidden=active!=='documents';$('knowledge-sparkassen').hidden=active!=='sparkassen';if(writeHash)history.replaceState(null,'',`${location.pathname}${location.search}#${active}`);}
document.querySelectorAll('.knowledge-tabs button').forEach(b=>b.onclick=()=>setTab(b.dataset.tab));$('knowledge-insurer').onchange=renderFiles;$('knowledge-search').oninput=renderFiles;$('knowledge-sheet').onchange=renderSheet;setTab(location.hash==='#sparkassen'?'sparkassen':'documents',false);load().catch(e=>$('knowledge-status').textContent=e.message);
</script>
</InternalLayout>
