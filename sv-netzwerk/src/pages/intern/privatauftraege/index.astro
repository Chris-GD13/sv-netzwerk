---
import InternalLayout from '../../../layouts/InternalLayout.astro';
---
<InternalLayout title="Privataufträge" description="Eigene private Gutachten und Auftragsunterlagen.">
<main class="po-app">
<section class="po-active"><div><p class="eyebrow">Privataufträge</p><h1 id="active-title">Noch kein Auftrag geöffnet</h1><p id="active-path">Links einen Auftrag suchen und öffnen.</p></div></section>
<div class="po-grid"><aside class="po-card"><div class="po-step"><b>1</b><div><strong>Auftrag auswählen</strong><small>Suchen, öffnen oder neu anlegen</small></div></div><div class="po-search"><input id="q" type="search" placeholder="Kunde, Ort, Auftragsnummer oder Datei" aria-label="Privatauftrag suchen"><button id="recent">Suchen</button></div><div id="cases" class="case-list"></div><button id="new" class="secondary full">＋ Neuen Auftrag anlegen</button></aside>
<section class="po-card po-work"><div class="po-step"><b>2</b><div><strong>Unterlagen und Ordner</strong><small>Wie bei den Versicherungsfällen</small></div><button id="upload" class="primary" disabled>＋ Datei / Mail hinzufügen</button><input id="file" type="file" multiple hidden accept=".pdf,.doc,.docx,.xls,.xlsx,.csv,.txt,.msg,.eml,.jpg,.jpeg,.png,.webp,.zip"></div><div id="drop" class="drop" tabindex="0"><strong>Dateien oder Outlook-Mails hier hineinziehen</strong><small>Alternativ klicken · abgelegt wird im aktuell geöffneten Ordner</small></div><p id="dropzone" class="dropzone" hidden>Dateien oder E-Mails hier ablegen</p><div id="folders" class="folder-grid"></div><div id="files" class="file-list"></div><p id="empty" class="empty">Bitte zuerst links einen Auftrag öffnen.</p><p id="state" class="meta" role="status"></p></section></div></main>
<dialog id="create-dialog"><form id="create-form"><h2>Neuen Privatauftrag anlegen</h2><p>Mit Auftrag, Angebot, Rechnungen, Gutachten, Dateien, Bilder, E-Mails und Eingang KI.</p><label>Auftragsname<input id="new-name" required maxlength="120" placeholder="z. B. Müller · Wasserschaden · 2026"></label><div class="dialog-actions"><button type="button" id="cancel" class="secondary">Abbrechen</button><button class="primary">Auftrag anlegen</button></div><p id="create-state" class="meta"></p></form></dialog>
</InternalLayout>
<style>
.po-app{padding:26px;max-width:1500px;color:#17324a}.po-active{border:1px solid #d6dce1;background:#fff;padding:18px 20px;margin-bottom:14px;box-shadow:0 1px 2px #172f4420}.po-active h1{margin:4px 0;font-size:1.4rem}.eyebrow{margin:0;color:#f59a23;font-size:.78rem;font-weight:900;text-transform:uppercase;letter-spacing:.06em}.po-active p:last-child,.meta{color:#65798a;margin:.3rem 0 0}.po-grid{display:grid;grid-template-columns:340px minmax(0,1fr);gap:14px}.po-card{border:1px solid #d6dce1;background:#fff;padding:16px;box-shadow:0 1px 2px #172f4420}.po-step{display:flex;align-items:center;gap:10px;margin-bottom:13px}.po-step>b{display:grid;place-items:center;width:28px;height:28px;border-radius:50%;background:#17324a;color:#fff}.po-step strong,.po-step small{display:block}.po-step small{color:#65798a;margin-top:2px}.po-step #upload{margin-left:auto}.po-search{display:flex;gap:7px;margin-bottom:12px}.po-search input{min-width:0;flex:1;padding:10px;border:1px solid #bdcbd6;border-radius:3px;font:inherit}.primary,.secondary{border:1px solid #17324a;border-radius:3px;padding:9px 12px;font:inherit;font-weight:800;cursor:pointer}.primary{background:#17324a;color:#fff}.secondary{background:#fff;color:#17324a}.primary:disabled{opacity:.45;cursor:not-allowed}.full{width:100%;margin-top:10px}.case-list,.file-list{display:grid;gap:7px}.case{display:flex;justify-content:space-between;gap:8px;align-items:center;border:1px solid #d6dce1;background:#f7f9fa;padding:10px 11px;cursor:pointer;text-align:left;font:inherit;color:#17324a}.case:hover,.case.active{border-color:#f59a23;background:#fff8ec}.case strong{display:block;overflow-wrap:anywhere}.case small,.file small{display:block;color:#6b7e8e;margin-top:3px}.drop{border:2px dashed #bdcbd6;padding:22px;text-align:center;background:#f8fafb;margin-bottom:14px;cursor:pointer}.drop:hover,.drop:focus,.drop.active{border-color:#f59a23;background:#fff8ec}.drop strong,.drop small{display:block}.drop small{color:#65798a;margin-top:5px}.folder-grid{display:flex;flex-wrap:wrap;gap:8px;margin-bottom:14px}.folder{border:1px solid #cdd8df;background:#f7f9fa;padding:9px 11px;cursor:pointer;font:inherit;color:#17324a}.folder:hover,.folder.active{border-color:#f59a23;background:#fff8ec}.file{display:flex;justify-content:space-between;gap:12px;align-items:center;border-top:1px solid #e5e9ec;padding:10px 0}.file strong{overflow-wrap:anywhere}.file a,.file button{color:#146b8c;font-weight:800;white-space:nowrap;border:0;background:none;cursor:pointer;font:inherit}.empty{padding:14px;background:#fff8ec;border-left:4px solid #f59a23}.dialog-actions{display:flex;justify-content:flex-end;gap:8px}dialog{border:0;box-shadow:0 12px 50px #10253655;padding:0;max-width:480px;width:calc(100% - 32px)}dialog::backdrop{background:#10253666}#create-form{padding:22px;display:grid;gap:13px}#create-form input{box-sizing:border-box;width:100%;padding:10px;border:1px solid #bdcbd6;border-radius:3px;font:inherit;margin-top:5px}@media(max-width:850px){.po-grid{grid-template-columns:1fr}.po-step #upload{margin-left:0}.po-step{flex-wrap:wrap}}
</style>
<script is:inline>
(()=>{const $=id=>document.getElementById(id),q=$('q'),cases=$('cases'),folders=$('folders'),files=$('files'),state=$('state'),empty=$('empty'),upload=$('upload'),input=$('file'),drop=$('drop'),activeTitle=$('active-title'),activePath=$('active-path'),dialog=$('create-dialog'),form=$('create-form'),newName=$('new-name'),createState=$('create-state');let root=[],active=null,activeFolder=null;const esc=s=>String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));const flat=(rows,out=[])=>{for(const r of rows){out.push(r);if(r.folder)flat(r.children||[],out)}return out};const fmt=n=>n>1048576?(n/1048576).toFixed(1)+' MB':n>1024?(n/1024).toFixed(0)+' KB':n+' B';
function renderCases(){const t=q.value.trim().toLowerCase();const rows=root.filter(r=>r.folder&&(!t||(`${r.name} ${r.path} `+flat(r.children||[]).map(x=>x.name).join(' ')).toLowerCase().includes(t)));cases.innerHTML=rows.length?rows.map(r=>`<button class="case ${active?.id===r.id?'active':''}" data-id="${esc(r.id)}"><span><strong>📁 ${esc(r.name)}</strong><small>${flat(r.children||[]).filter(x=>!x.folder).length} Dateien</small></span><span>›</span></button>`).join(''):'<p class="empty">Keine passenden Aufträge.</p>';cases.querySelectorAll('.case').forEach(b=>b.onclick=()=>openCase(root.find(x=>x.id===b.dataset.id)))}
function openCase(r){active=r||null;activeFolder=active;activeTitle.textContent=active?.name||'Noch kein Auftrag geöffnet';activePath.textContent=active?.path||'Links einen Auftrag suchen und öffnen.';upload.disabled=!active;drop.hidden=!active;empty.hidden=!!active;renderFolders();renderFiles();renderCases()}
function renderFolders(){const rs=(active?.children||[]).filter(x=>x.folder);folders.innerHTML=rs.map(r=>`<button class="folder ${activeFolder?.id===r.id?'active':''}" data-id="${esc(r.id)}">📁 ${esc(r.name)}</button>`).join('');folders.querySelectorAll('.folder').forEach(b=>b.onclick=()=>{activeFolder=flat(active.children||[]).find(x=>x.id===b.dataset.id)||active;renderFolders();renderFiles()})}
function renderFiles(){if(!active)return;const t=q.value.trim().toLowerCase();const rs=flat((activeFolder||active).children||[]).filter(x=>!x.folder&&(!t||(`${x.name} ${x.path}`).toLowerCase().includes(t)));files.innerHTML=rs.length?rs.map(x=>{const mail=/\.(msg|eml)$/i.test(x.name);return `<div class="file"><span><strong>${mail?'✉':'📄'} ${esc(x.name)}</strong><small>${esc(x.path)} · ${fmt(x.size||0)}</small></span><span>${mail?`<button data-mail="${esc(x.id)}" data-name="${esc(x.name)}">Lesen</button>`:''} <a href="/intern/api/private-orders.php?action=file&id=${encodeURIComponent(x.id)}" target="_blank" rel="noreferrer">Öffnen</a></span></div>`}).join(''):'<p class="empty">Keine Dateien in diesem Ordner.</p>';files.querySelectorAll('[data-mail]').forEach(b=>b.onclick=()=>readMail(b.dataset.mail,b.dataset.name))}
async function readMail(id,name){state.textContent='Mail wird geöffnet …';try{const r=await fetch('/intern/api/private-orders.php?action=file&id='+encodeURIComponent(id),{credentials:'same-origin'});if(!r.ok)throw Error('Mail konnte nicht geladen werden.');const text=await r.text();const w=window.open('','_blank');if(!w)throw Error('Bitte Pop-up für Mailansicht erlauben.');w.document.write(`<title>${esc(name)}</title><pre style="white-space:pre-wrap;font:15px system-ui;padding:24px">${esc(text)}</pre>`);w.document.close();state.textContent='Mail geöffnet.'}catch(e){state.textContent=e.message}}
async function load(){try{const r=await fetch('/intern/api/private-orders.php?action=list',{credentials:'same-origin',cache:'no-store'}),d=await r.json();if(!r.ok||!d.ok)throw Error(d.error||`HTTP ${r.status}`);root=d.items||[];state.textContent=`${flat(root).filter(x=>!x.folder).length} Dateien · ${d.root?.path||'OneDrive'}`;renderCases()}catch(e){state.textContent=e.message}}
async function sendFiles(fs){if(!activeFolder||!fs.length)return;upload.disabled=true;state.textContent='Unterlagen werden abgelegt …';try{for(const f of fs){const body=new FormData();body.append('folder_id',activeFolder.id);body.append('file',f);const r=await fetch('/intern/api/private-orders.php?action=upload',{method:'POST',credentials:'same-origin',body});const d=await r.json();if(!r.ok||!d.ok)throw Error(d.error||`HTTP ${r.status}`)}await load();openCase(flat(root).find(x=>x.id===active.id));state.textContent='Unterlagen abgelegt.'}catch(e){state.textContent=e.message}finally{upload.disabled=false;input.value=''}}
upload.onclick=()=>input.click();drop.onclick=()=>input.click();input.onchange=()=>sendFiles([...input.files]);['dragover','dragenter'].forEach(ev=>drop.addEventListener(ev,e=>{e.preventDefault();drop.classList.add('active')}));['dragleave','drop'].forEach(ev=>drop.addEventListener(ev,e=>{e.preventDefault();drop.classList.remove('active')}));drop.addEventListener('drop',e=>sendFiles([...e.dataTransfer.files]));q.oninput=()=>{renderCases();if(active)renderFiles()};$('new').onclick=()=>{newName.value='';createState.textContent='';dialog.showModal();newName.focus()};$('cancel').onclick=()=>dialog.close();form.onsubmit=async e=>{e.preventDefault();createState.textContent='Auftrag wird angelegt …';try{const r=await fetch('/intern/api/private-orders.php?action=create',{method:'POST',credentials:'same-origin',headers:{'Content-Type':'application/json'},body:JSON.stringify({name:newName.value.trim()})}),d=await r.json();if(!r.ok||!d.ok)throw Error(d.error||`HTTP ${r.status}`);dialog.close();await load();openCase(root.find(x=>x.id===d.item?.id)||null)}catch(err){createState.textContent=err.message}};load()})();
</script>
