---
import InternalLayout from '../../../layouts/InternalLayout.astro';
---
<InternalLayout title="Privataufträge" description="Eigene private Gutachten und Auftragsunterlagen.">
<main class="po-app">
<section class="po-active"><div><p class="eyebrow">Privataufträge</p><h1 id="active-title">Noch kein Auftrag geöffnet</h1><p id="active-path">Einen Auftrag suchen und öffnen.</p></div></section>
<div class="po-grid"><aside class="po-card"><div class="po-step"><b>1</b><div><strong>Auftrag auswählen</strong><small>Suchen, öffnen oder neu anlegen</small></div></div><div class="po-search"><input id="q" type="search" placeholder="Kunde, Ort oder Auftragsnummer" aria-label="Privatauftrag suchen"><button id="recent">Suchen</button></div><nav id="alphabet" class="po-alphabet" aria-label="Aufträge nach Anfangsbuchstaben filtern"></nav><p id="case-count" class="meta"></p><div id="cases" class="case-list"></div><button id="new" class="secondary full">＋ Neuen Auftrag anlegen</button></aside>
<section class="po-card po-work"><div class="po-step"><b>2</b><div><strong>Unterlagen und Ordner</strong><small>Wie bei den Versicherungsfällen</small></div><button id="upload" class="primary" disabled>＋ Datei / Mail hinzufügen</button><input id="file" type="file" multiple hidden accept=".pdf,.doc,.docx,.xls,.xlsx,.csv,.txt,.msg,.eml,.jpg,.jpeg,.png,.webp,.zip"></div><div id="drop" class="drop" tabindex="0"><strong>Dateien oder Outlook-Mails hier hineinziehen</strong><small>Alternativ klicken · abgelegt wird im aktuell geöffneten Ordner</small></div><nav id="breadcrumbs" class="po-breadcrumbs" aria-label="Aktueller Auftragsordner"></nav><div id="folders" class="folder-grid"></div><div id="files" class="file-list"></div><p id="empty" class="empty">Bitte zuerst links einen Auftrag öffnen.</p><p id="state" class="meta" role="status"></p><button id="retry" class="secondary" hidden>Erneut versuchen</button></section></div></main>
<dialog id="create-dialog"><form id="create-form"><h2>Neuen Privatauftrag anlegen</h2><p>Mit Auftrag, Angebot, Rechnungen, Gutachten, Dateien, Bilder, E-Mails und Eingang KI.</p><label>Auftragsname<input id="new-name" required maxlength="120" placeholder="z. B. Müller · Wasserschaden · 2026"></label><div class="dialog-actions"><button type="button" id="cancel" class="secondary">Abbrechen</button><button class="primary">Auftrag anlegen</button></div><p id="create-state" class="meta"></p></form></dialog>
</InternalLayout>
<style is:global>
.po-app{padding:22px 26px 56px;max-width:1600px;color:#17324a}.po-app .po-active,.po-app .po-card{border:1px solid #d6dce1;background:#fff;padding:20px;box-shadow:0 1px 3px #172f4418;border-radius:3px}.po-app .po-active{margin-bottom:16px}.po-app .po-active h1{margin:4px 0;font-size:1.4rem}.po-app .eyebrow{margin:0;color:#f59a23;font-size:.78rem;font-weight:800;text-transform:uppercase;letter-spacing:.06em}.po-app .meta,.po-app .po-active p:last-child{color:#65798a;margin:.4rem 0}.po-app .po-grid{display:grid;grid-template-columns:340px minmax(0,1fr);gap:16px;align-items:start}.po-app .po-step{display:flex;align-items:flex-start;gap:12px;margin-bottom:16px}.po-app .po-step>b{display:grid;place-items:center;width:40px;height:40px;flex:0 0 40px;border-radius:3px;background:#17324a;color:#fff;font-weight:750}.po-app .po-step strong,.po-app .po-step small{display:block}.po-app .po-step small{color:#65798a;margin-top:3px}.po-app .po-step #upload{margin-left:auto}.po-app .po-search{display:flex;gap:8px;margin-bottom:14px}.po-app .po-search input{min-width:0;flex:1;padding:10px;border:1px solid #bdcbd6;border-radius:3px;background:#fff;color:#17324a;font:inherit}.po-app button,#create-dialog button{border:1px solid #bdcbd6;border-radius:3px;padding:10px 12px;font:inherit;font-weight:700;cursor:pointer;background:#fff;color:#17324a;box-sizing:border-box}.po-app button.primary,.po-app #recent,#create-dialog button.primary{background:#17324a;color:#fff;border-color:#17324a}.po-app button:disabled{opacity:.45;cursor:not-allowed}.po-app .full{width:100%;margin-top:14px}.po-app .po-alphabet{display:flex;flex-wrap:wrap;gap:5px;margin:0 0 10px}.po-app .po-alphabet button{padding:7px 9px;min-width:34px}.po-app .po-alphabet button[aria-pressed="true"]{background:#17324a;color:#fff;border-color:#17324a}.po-app .case-list{display:grid;gap:8px}.po-app .po-letter-group{border:1px solid #d6dce1;border-radius:3px;padding:0;background:#fff}.po-app .po-letter-group>summary{padding:11px 12px;cursor:pointer;font-weight:750;color:#17324a}.po-app .po-letter-group>summary small{font-weight:400;color:#65798a}.po-app .po-letter-items{display:grid;gap:6px;padding:0 9px 9px}.po-app .case{display:block;width:100%;text-align:left;white-space:normal;overflow-wrap:anywhere;background:#fff;border-radius:3px;padding:12px}.po-app .case:hover,.po-app .case.active{border-color:#f59a23;background:#fff8ec}.po-app .case strong{display:block;font-size:1rem}.po-app .case small{display:block;font-size:.78rem;font-weight:400;color:#65798a;margin-top:4px}.po-app .drop{border:2px dashed #bdcbd6;padding:22px;text-align:center;background:#f8fafb;margin-bottom:16px;cursor:pointer}.po-app .drop strong,.po-app .drop small{display:block}.po-app .drop small{color:#65798a;margin-top:5px}.po-app .drop.active{border-color:#f59a23;background:#fff8ec}.po-app .po-breadcrumbs{display:flex;flex-wrap:wrap;gap:6px;margin-bottom:12px}.po-app .po-breadcrumbs button{padding:7px 10px;font-size:.85rem}.po-app .po-breadcrumbs button[aria-current="location"]{background:#eef3f6}.po-app .folder-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px;margin-bottom:16px}.po-app .folder{width:100%;text-align:left;overflow-wrap:anywhere}.po-app .folder small{display:block;font-weight:400;color:#65798a;margin-top:3px}.po-app .file-list{display:grid;gap:6px}.po-app .file{display:flex;justify-content:space-between;gap:12px;border-top:1px solid #e5e9ec;padding:12px 0;align-items:center}.po-app .file strong{overflow-wrap:anywhere}.po-app .file small{display:block;color:#65798a;margin-top:4px}.po-app .file a{color:#146b8c;font-weight:700;white-space:nowrap}.po-app .file button{padding:6px 8px}.po-app .empty{padding:14px;background:#fff8ec;border-left:3px solid #f59a23}.po-app [hidden]{display:none!important}#create-dialog{border:0;box-shadow:0 12px 50px #10253655;padding:0;max-width:480px;width:calc(100% - 32px)}#create-dialog::backdrop{background:#10253666}#create-form{padding:22px;display:grid;gap:13px}#create-form input{box-sizing:border-box;width:100%;padding:10px;border:1px solid #bdcbd6;border-radius:3px;font:inherit;margin-top:5px}#create-dialog .dialog-actions{display:flex;justify-content:flex-end;gap:8px}@media(max-width:850px){.po-app{padding:16px}.po-app .po-grid{grid-template-columns:1fr}.po-app .po-step{flex-wrap:wrap}.po-app .po-step #upload{margin-left:52px}}@media(max-width:550px){.po-app .folder-grid{grid-template-columns:1fr}.po-app .file{align-items:flex-start;flex-direction:column}}
</style>
<script is:inline>
(()=>{const $=id=>document.getElementById(id),q=$('q'),cases=$('cases'),folders=$('folders'),files=$('files'),state=$('state'),empty=$('empty'),upload=$('upload'),input=$('file'),drop=$('drop'),activeTitle=$('active-title'),activePath=$('active-path'),dialog=$('create-dialog'),form=$('create-form'),newName=$('new-name'),createState=$('create-state');let root=[],active=null,activeFolder=null,letter="",breadcrumbs=[],openEpoch=0;const esc=s=>String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));const flat=(rows,out=[])=>{for(const r of rows){out.push(r);if(r.folder)flat(r.children||[],out)}return out};const fmt=n=>n>1048576?(n/1048576).toFixed(1)+' MB':n>1024?(n/1024).toFixed(0)+' KB':n+' B';
function norm(v){return String(v??'').toLocaleLowerCase('de-DE').normalize('NFD').replace(/[\u0300-\u036f]/g,'').replace(/ß/g,'ss')}
function caseRows(){const standard=new Set(['auftrag','angebot','rechnungen','gutachten','fotos','bilder','dateien','e-mails','eingang ki','sonstige unterlagen']);const rows=[];const seen=new Set();for(const top of root){const candidates=top.folder&&/^20\d{2}$/.test(String(top.name).trim())?(top.children||[]):[top];for(const r of candidates){const name=String(r.name||'').trim();const key=String(r.id||name);if(r.folder&&!standard.has(norm(name))&&!/^20\d{2}$/.test(name)&&!seen.has(key)){seen.add(key);rows.push(r)}}}return rows}
function firstLetter(name){const c=norm(name.trim()).charAt(0).toUpperCase();return /^[A-Z]$/.test(c)?c:'#'}
function displayName(name){return String(name||'').replace(/_/g,' ')}
function renderCases(){const t=norm(q.value.trim());const all=caseRows().sort((a,b)=>norm(a.name).localeCompare(norm(b.name),'de'));const letters=[...new Set(all.map(r=>firstLetter(r.name)))].sort();$('alphabet').innerHTML=['',...letters].map(c=>`<button type="button" data-letter="${c}" aria-pressed="${c===letter}">${c||'Alle'}</button>`).join('');$('alphabet').querySelectorAll('button').forEach(b=>b.onclick=()=>{letter=b.dataset.letter;renderCases()});const rows=all.filter(r=>(!letter||firstLetter(r.name)===letter)&&(!t||norm([r.name,r.path].join(' ')).includes(t)));$('case-count').textContent=rows.length+' von '+all.length+' Aufträgen';const groups=new Map();for(const r of rows){const c=firstLetter(r.name);if(!groups.has(c))groups.set(c,[]);groups.get(c).push(r)}cases.innerHTML=rows.length?[...groups].map(([c,items])=>`<details class="po-letter-group" ${t||letter?'open':''}><summary>${c} <small>· ${items.length} ${items.length===1?'Auftrag':'Aufträge'}</small></summary><div class="po-letter-items">${items.map(r=>`<button type="button" class="case ${active?.id===r.id?'active':''}" data-id="${esc(r.id)}"><strong>${esc(displayName(r.name))}</strong><small>${esc((r.path||'').match(/(?:^|\/)(20\d{2})(?:\/|$)/)?.[1]||'Privatauftrag')}</small></button>`).join('')}</div></details>`).join(''):'<p class="empty">Keine passenden Aufträge.</p>';cases.querySelectorAll('.case').forEach(b=>b.onclick=()=>openCase(flat(root).find(x=>x.id===b.dataset.id)))}
async function responseJson(response){const text=await response.text();try{return JSON.parse(text)}catch{throw Error(response.ok?'Ungültige Serverantwort.':`Serverantwort ungültig (HTTP ${response.status}).`)}}
async function request(url,options={}){const controller=new AbortController();const timeout=setTimeout(()=>controller.abort(),90000);try{const response=await fetch(url,{credentials:'same-origin',cache:'no-store',...options,signal:controller.signal});const data=await responseJson(response);if(!response.ok||!data.ok)throw Error(data.error||('HTTP '+response.status));return data}finally{clearTimeout(timeout)}}
async function openCase(r){const epoch=++openEpoch;active=r?.id?{...r}:null;activeFolder=active;breadcrumbs=[];$('retry').hidden=true;activeTitle.textContent=active?displayName(active.name):'Noch kein Auftrag geöffnet';activePath.textContent=active?.path||'Einen Auftrag suchen und öffnen.';upload.disabled=true;drop.hidden=!active;empty.hidden=!!active;folders.innerHTML='';files.innerHTML='';renderCases();if(!active)return;const id=active.id;state.textContent='Unterlagen werden in die Auftragsordner einsortiert …';try{const sorted=await request('/intern/api/private-orders.php?action=organize-case',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({id})});if(epoch!==openEpoch)return;state.textContent='Auftragsordner werden geladen …';const data=await request('/intern/api/private-orders.php?action=case&id='+encodeURIComponent(id));if(epoch!==openEpoch)return;if(!data.item?.id)throw Error('Der Auftrag konnte nicht vollständig geladen werden.');active={...active,...data.item,path:active.path||data.item.path};activeFolder=active;breadcrumbs=[active];upload.disabled=false;renderFolders();renderFiles();renderCases();state.textContent=sorted.moved?sorted.moved+' Einträge einsortiert. Bitte einen Ordner öffnen.':'Unterlagen nach Ordnern geladen. Bitte einen Ordner öffnen.'}catch(e){if(epoch!==openEpoch)return;state.textContent=e.name==='AbortError'?'Auftrag konnte nicht rechtzeitig geladen oder sortiert werden. Bitte erneut versuchen.':e.message;$('retry').hidden=false}}
async function openFolder(folder,index=null){if(!active?.id||!folder?.id){state.textContent='Bitte den Auftrag erneut öffnen und einen Ordner auswählen.';return}state.textContent='Ordner wird geladen …';const epoch=++openEpoch,caseId=active.id;upload.disabled=true;try{const data=await request('/intern/api/private-orders.php?action=folder&id='+encodeURIComponent(folder.id));if(epoch!==openEpoch||active?.id!==caseId)return;if(!data.item?.id)throw Error('Der Ordner konnte nicht vollständig geladen werden.');activeFolder={...folder,...data.item};breadcrumbs=index===null?[...breadcrumbs,activeFolder]:[...breadcrumbs.slice(0,index),activeFolder];renderFolders();renderFiles();state.textContent='Geöffneter Ordner: '+activeFolder.name}catch(e){if(epoch===openEpoch)state.textContent=e.message}finally{if(epoch===openEpoch)upload.disabled=!activeFolder?.id}}
function renderFolders(){const rs=(activeFolder?.children||[]).filter(x=>x.folder).sort((a,b)=>norm(a.name).localeCompare(norm(b.name),'de'));$('breadcrumbs').innerHTML=breadcrumbs.map((r,i)=>`<button type="button" data-index="${i}" ${i===breadcrumbs.length-1?'aria-current="location"':''}>${esc(i===0?'Auftrag':r.name)}</button>`).join('');$('breadcrumbs').querySelectorAll('button').forEach(b=>b.onclick=()=>openFolder(breadcrumbs[Number(b.dataset.index)],Number(b.dataset.index)));folders.innerHTML=rs.map(r=>`<button type="button" class="folder" data-id="${esc(r.id)}">${esc(r.name)}<small>Ordner öffnen</small></button>`).join('');folders.querySelectorAll('.folder').forEach(b=>b.onclick=()=>openFolder(rs.find(x=>x.id===b.dataset.id)))}
function renderFiles(){if(!active)return;const rs=((activeFolder||active).children||[]).filter(x=>!x.folder).sort((a,b)=>norm(a.name).localeCompare(norm(b.name),'de'));files.innerHTML=rs.length?rs.map(x=>{const mail=/\.(msg|eml)$/i.test(x.name);return `<div class="file"><span><strong>${esc(x.name)}</strong><small>${fmt(x.size||0)}</small></span><span>${mail?`<button data-mail="${esc(x.id)}" data-name="${esc(x.name)}">Lesen</button>`:''} <a href="/intern/api/private-orders.php?action=file&id=${encodeURIComponent(x.id)}" target="_blank" rel="noreferrer">Öffnen</a></span></div>`}).join(''):activeFolder?.id===active.id?'<p class="meta">Die Unterlagen befinden sich in den Auftragsordnern.</p>':'<p class="empty">Keine Dateien in diesem Ordner.</p>';files.querySelectorAll('[data-mail]').forEach(b=>b.onclick=()=>readMail(b.dataset.mail,b.dataset.name))}
$('retry').onclick=()=>openCase(active);
async function readMail(id,name){state.textContent='Mail wird geöffnet …';try{const r=await fetch('/intern/api/private-orders.php?action=file&id='+encodeURIComponent(id),{credentials:'same-origin'});if(!r.ok)throw Error('Mail konnte nicht geladen werden.');const text=await r.text();const w=window.open('','_blank');if(!w)throw Error('Bitte Pop-up für Mailansicht erlauben.');w.document.write(`<title>${esc(name)}</title><pre style="white-space:pre-wrap;font:15px system-ui;padding:24px">${esc(text)}</pre>`);w.document.close();state.textContent='Mail geöffnet.'}catch(e){state.textContent=e.message}}
const cacheKey='svnet-private-orders-v4';function applyItems(items,source){root=Array.isArray(items)?items:[];state.textContent=`${flat(root).filter(x=>!x.folder).length} Dateien · ${source}`;renderCases()}
async function load(){let cached=null;try{cached=JSON.parse(localStorage.getItem(cacheKey)||'null')}catch{}if(cached?.items?.length)applyItems(cached.items,'lokaler Zwischenspeicher');const controller=new AbortController();const timeout=setTimeout(()=>controller.abort(),30000);try{const r=await fetch('/intern/api/private-orders.php?action=cases',{credentials:'same-origin',cache:'no-store',signal:controller.signal}),d=await responseJson(r);if(!r.ok||!d.ok)throw Error(d.error||`HTTP ${r.status}`);applyItems(d.items||[],d.root?.path||'OneDrive');try{localStorage.setItem(cacheKey,JSON.stringify({updatedAt:Date.now(),items:d.items||[]}))}catch{}}catch(e){if(!cached?.items?.length)state.textContent=e.name==='AbortError'?'Fallmenü konnte nicht geladen werden.':e.message}finally{clearTimeout(timeout)}}
async function sendFiles(fs){if(!active?.id||!activeFolder?.id||!fs.length)return;const caseId=active.id,folderId=activeFolder.id,epoch=openEpoch,selected={...activeFolder},selectedIndex=breadcrumbs.length-1;upload.disabled=true;state.textContent='Unterlagen werden abgelegt …';try{for(const f of fs){const body=new FormData();body.append('folder_id',folderId);body.append('file',f);const d=await request('/intern/api/private-orders.php?action=upload',{method:'POST',body});if(!d.item?.id)throw Error('Die Ablage wurde nicht vollständig bestätigt.')}if(epoch!==openEpoch||active?.id!==caseId)return;await openFolder(selected,selectedIndex);if(active?.id===caseId&&activeFolder?.id===folderId)state.textContent='Unterlagen abgelegt. Geöffneter Ordner: '+activeFolder.name}catch(e){if(active?.id===caseId)state.textContent=e.message}finally{upload.disabled=!activeFolder?.id;input.value=''}}
upload.onclick=()=>input.click();drop.onclick=()=>input.click();input.onchange=()=>sendFiles([...input.files]);['dragover','dragenter'].forEach(ev=>drop.addEventListener(ev,e=>{e.preventDefault();drop.classList.add('active')}));['dragleave','drop'].forEach(ev=>drop.addEventListener(ev,e=>{e.preventDefault();drop.classList.remove('active')}));drop.addEventListener('drop',e=>sendFiles([...e.dataTransfer.files]));function startSearch(){active=null;activeFolder=null;activeTitle.textContent='Suchergebnisse';activePath.textContent='Bitte einen Auftrag auswählen.';upload.disabled=true;drop.hidden=true;empty.hidden=false;folders.innerHTML='';files.innerHTML='';$('breadcrumbs').innerHTML='';openEpoch++;renderCases()}q.oninput=startSearch;$('recent').onclick=startSearch;$('new').onclick=()=>{newName.value='';createState.textContent='';dialog.showModal();newName.focus()};$('cancel').onclick=()=>dialog.close();form.onsubmit=async e=>{e.preventDefault();createState.textContent='Auftrag wird angelegt …';try{const r=await fetch('/intern/api/private-orders.php?action=create',{method:'POST',credentials:'same-origin',headers:{'Content-Type':'application/json'},body:JSON.stringify({name:newName.value.trim()})}),d=await responseJson(r);if(!r.ok||!d.ok)throw Error(d.error||`HTTP ${r.status}`);dialog.close();await load();openCase(root.find(x=>x.id===d.item?.id)||null)}catch(err){createState.textContent=err.message}};load()})();
</script>

