<!-- Deployment trigger: structured private-order folders -->
---
import InternalLayout from '../../../layouts/InternalLayout.astro';
---
<InternalLayout title="Privataufträge" description="Eigene private Gutachten und Auftragsunterlagen.">
<main class="po-app"><header class="po-head"><div><p class="eyebrow">Persönlicher Arbeitsbereich</p><h1>Privataufträge</h1><p id="state">Eigene Aufträge werden geladen …</p></div><button id="new" class="primary">＋ Neuer Auftrag</button></header>
<section class="toolbar"><label>Auftrag suchen<input id="q" type="search" placeholder="Kunde, Ort, Auftragsnummer oder Datei"></label></section>
<div class="workspace"><aside class="panel"><h2>Aufträge</h2><div id="cases" class="case-list"></div></aside><section class="panel detail"><div class="detail-head"><div><p class="eyebrow">Aktiver Auftrag</p><h2 id="active-title">Noch kein Auftrag geöffnet</h2><p id="active-path">Bitte links einen Auftrag auswählen.</p></div><div class="actions"><button id="upload" class="primary" disabled>＋ Datei / Mail hinzufügen</button><input id="file" type="file" multiple hidden></div></div><p id="dropzone" class="dropzone" hidden>Dateien oder E-Mails hier ablegen – sie werden im geöffneten Ordner gespeichert.</p><div id="folders" class="folder-grid"></div><div id="files" class="file-list"></div><p id="empty" class="empty">Noch keinen Auftrag geöffnet.</p></section></div>
</main>
<dialog id="create-dialog"><form id="create-form"><h2>Neuen Privatauftrag anlegen</h2><p>Der Auftrag wird mit den Ordnern Auftrag, Angebot, Rechnungen, Gutachten, Dateien, Bilder, E-Mails und Eingang KI angelegt.</p><label>Auftragsname<input id="new-name" required maxlength="120" placeholder="z. B. Müller · Wasserschaden · 2026"></label><div class="dialog-actions"><button type="button" id="cancel" class="secondary">Abbrechen</button><button class="primary">Auftrag anlegen</button></div><p id="create-state" role="status"></p></form></dialog>
</InternalLayout>
<style>
.po-app{padding:26px;max-width:1500px;color:#17324a}.po-head{display:flex;justify-content:space-between;align-items:end;border-bottom:1px solid #d6dce1;padding-bottom:18px;margin-bottom:16px}.eyebrow{margin:0;color:#f59a23;font-size:.78rem;font-weight:900;text-transform:uppercase;letter-spacing:.06em}.po-head h1{margin:4px 0}.po-head p:last-child,.detail-head p:last-child{color:#65798a;margin:.3rem 0 0}.toolbar{display:flex;gap:12px;align-items:end;margin-bottom:14px}.toolbar label{display:grid;gap:5px;font-size:.78rem;font-weight:800;flex:1}.toolbar input,.create-dialog input{box-sizing:border-box;padding:10px 11px;border:1px solid #bdcbd6;border-radius:3px;font:inherit;background:#fff}.workspace{display:grid;grid-template-columns:300px minmax(0,1fr);gap:14px}.panel{border:1px solid #d6dce1;background:#fff;padding:16px;box-shadow:0 1px 2px #172f4420}.panel h2{margin:0 0 12px;font-size:1.05rem}.case-list,.file-list{display:grid;gap:7px}.case{display:flex;justify-content:space-between;gap:8px;align-items:center;border:1px solid #d6dce1;background:#f7f9fa;padding:10px 11px;cursor:pointer;text-align:left;font:inherit;color:#17324a}.case:hover,.case.active{border-color:#f59a23;background:#fff8ec}.case strong{display:block;overflow-wrap:anywhere}.case small{display:block;color:#6b7e8e;margin-top:3px}.detail-head{display:flex;justify-content:space-between;gap:12px;align-items:start;border-bottom:1px solid #e1e6ea;padding-bottom:13px;margin-bottom:13px}.actions{display:flex;gap:8px}.primary,.secondary{border:1px solid #17324a;border-radius:3px;padding:9px 12px;font:inherit;font-weight:800;cursor:pointer}.primary{background:#17324a;color:#fff}.primary:disabled{opacity:.45;cursor:not-allowed}.secondary{background:#fff;color:#17324a}.folder-grid{display:flex;flex-wrap:wrap;gap:8px;margin-bottom:14px}.folder{border:1px solid #cdd8df;background:#f7f9fa;padding:9px 11px;cursor:pointer;font:inherit;color:#17324a}.folder:hover,.folder.active{border-color:#f59a23;background:#fff8ec}.file{display:flex;justify-content:space-between;gap:12px;align-items:center;border-top:1px solid #e5e9ec;padding:10px 0}.file strong{overflow-wrap:anywhere}.file small{display:block;color:#6b7e8e}.file a{color:#146b8c;font-weight:800;white-space:nowrap}.empty{padding:14px;background:#fff8ec;border-left:4px solid #f59a23}.dropzone{padding:14px;border:2px dashed #f59a23;background:#fff8ec;text-align:center;font-weight:800}.dropzone.is-over{background:#ffe8c2}dialog{border:0;box-shadow:0 12px 50px #10253655;padding:0;max-width:480px;width:calc(100% - 32px)}dialog::backdrop{background:#10253666}#create-form{padding:22px;display:grid;gap:13px}.dialog-actions{display:flex;justify-content:flex-end;gap:8px}#create-state{min-height:1.2em;color:#607486}@media(max-width:850px){.workspace{grid-template-columns:1fr}.po-head,.detail-head{display:block}.actions{margin-top:12px}.po-app{padding:16px 12px}}
</style>
<script is:inline>
(()=>{const state=document.getElementById('state'),dropzone=document.getElementById('dropzone'),q=document.getElementById('q'),cases=document.getElementById('cases'),folders=document.getElementById('folders'),files=document.getElementById('files'),empty=document.getElementById('empty'),detail=document.querySelector('.detail'),activeTitle=document.getElementById('active-title'),activePath=document.getElementById('active-path'),upload=document.getElementById('upload'),fileInput=document.getElementById('file'),dialog=document.getElementById('create-dialog'),newBtn=document.getElementById('new'),form=document.getElementById('create-form'),cancel=document.getElementById('cancel'),newName=document.getElementById('new-name'),createState=document.getElementById('create-state');let root=[],active=null,activeFolder=null;const esc=s=>String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));const allRows=(rows,out=[])=>{for(const r of rows){out.push(r);if(r.folder)allRows(r.children||[],out)}return out};const fmt=n=>n>1048576?(n/1048576).toFixed(1)+' MB':n>1024?(n/1024).toFixed(0)+' KB':n+' B';
function renderCases(){const term=q.value.trim().toLowerCase();const rows=root.filter(r=>r.folder&&(!term||allRows(r.children||[]).some(x=>`${x.name} ${x.path}`.toLowerCase().includes(term))||`${r.name} ${r.path}`.toLowerCase().includes(term)));cases.innerHTML=rows.length?rows.map(r=>`<button class="case ${active?.id===r.id?'active':''}" data-id="${esc(r.id)}"><span><strong>📁 ${esc(r.name)}</strong><small>${allRows(r.children||[]).filter(x=>!x.folder).length} Dateien</small></span><span>›</span></button>`).join(''):'<p class="empty">Keine passenden Aufträge.</p>';cases.querySelectorAll('.case').forEach(b=>b.onclick=()=>openCase(root.find(x=>x.id===b.dataset.id)))}
function openCase(row){active=row;activeFolder=row;activeTitle.textContent=row?.name||'Noch kein Auftrag geöffnet';activePath.textContent=row?.path||'Bitte links einen Auftrag auswählen.';upload.disabled=!row;dropzone.hidden=!row;if(!row){folders.innerHTML='';files.innerHTML='';detail.classList.remove('has-data');empty.hidden=false;return}detail.classList.add('has-data');empty.hidden=true;renderFolders();renderFiles();renderCases()}
function renderFolders(){const rows=(active?.children||[]).filter(x=>x.folder);folders.innerHTML=rows.map(r=>`<button class="folder ${activeFolder?.id===r.id?'active':''}" data-id="${esc(r.id)}">📁 ${esc(r.name)}</button>`).join('');folders.querySelectorAll('.folder').forEach(b=>b.onclick=()=>{activeFolder=allRows(active.children||[]).find(x=>x.id===b.dataset.id)||active;renderFolders();renderFiles()})}
function renderFiles(){const term=q.value.trim().toLowerCase();let rows=term?allRows(active?.children||[]):(activeFolder===active?allRows(active.children||[]):allRows(activeFolder?.children||[]));rows=rows.filter(x=>!x.folder&&(!term||`${x.name} ${x.path}`.toLowerCase().includes(term)));files.innerHTML=rows.length?rows.map(x=>`<div class="file"><span><strong>📄 ${esc(x.name)}</strong><small>${esc(x.path)} · ${fmt(x.size||0)}</small></span><a href="/intern/api/private-orders.php?action=file&id=${encodeURIComponent(x.id)}" target="_blank" rel="noreferrer">Öffnen</a></div>`).join(''):'<p class="empty">Keine Dateien in diesem Ordner.</p>'}
async function load(){try{const r=await fetch('/intern/api/private-orders.php?action=list',{credentials:'same-origin',cache:'no-store'}),d=await r.json();if(!r.ok||!d.ok)throw Error(d.error||`HTTP ${r.status}`);root=d.items||[];state.textContent=`Quelle: ${d.root?.path||'OneDrive'} · ${allRows(root).filter(x=>!x.folder).length} Dateien`;renderCases()}catch(e){state.textContent=e.message;state.className='error'}}
newBtn.onclick=()=>{newName.value='';createState.textContent='';dialog.showModal();newName.focus()};cancel.onclick=()=>dialog.close();form.onsubmit=async e=>{e.preventDefault();const name=newName.value.trim();if(!name)return;createState.textContent='Auftrag wird angelegt …';try{const r=await fetch('/intern/api/private-orders.php?action=create',{method:'POST',credentials:'same-origin',headers:{'Content-Type':'application/json'},body:JSON.stringify({name})}),d=await r.json();if(!r.ok||!d.ok)throw Error(d.error||`HTTP ${r.status}`);dialog.close();await load();openCase(root.find(x=>x.id===d.item?.id)||null)}catch(err){createState.textContent=err.message}};upload.onclick=()=>fileInput.click();fileInput.onchange=async()=>{if(!fileInput.files.length||!activeFolder)return;upload.disabled=true;state.textContent='Dateien werden hochgeladen …';try{for(const f of fileInput.files){const body=new FormData();body.append('folder_id',activeFolder.id);body.append('file',f);const r=await fetch('/intern/api/private-orders.php?action=upload',{method:'POST',credentials:'same-origin',body});const d=await r.json();if(!r.ok||!d.ok)throw Error(d.error||`HTTP ${r.status}`)}await load();openCase(allRows(root).find(x=>x.id===active.id))}catch(e){state.textContent=e.message}finally{upload.disabled=false;fileInput.value=''}};dropzone.ondragover=e=>{e.preventDefault();dropzone.classList.add('is-over')};dropzone.ondragleave=()=>dropzone.classList.remove('is-over');dropzone.ondrop=e=>{e.preventDefault();dropzone.classList.remove('is-over');if(e.dataTransfer.files.length){fileInput.files=e.dataTransfer.files;fileInput.dispatchEvent(new Event('change'))}};q.oninput=()=>{renderCases();if(active)renderFiles()};load()})();
</script>
