---
import InternalLayout from '../../../../layouts/InternalLayout.astro';
---
<InternalLayout title="Gutachten" description="Gutachten verwalten, Daten bearbeiten und dauerhaft in Google Drive archivierte Fassungen abrufen.">
  <main class="intern-app" style="max-width:1200px;margin:0 auto;padding:24px">
    <section class="intern-card">
      <p class="sv-eyebrow">SV-Netzwerk Prüfportal</p>
      <h1>Gutachten</h1>
      <p>Hier verwalten Sie den Gutachtenstand. Änderungen am zugrunde liegenden Fensterbestand werden über die Massenänderung, die Bestandsprüfung oder den Word-Master vorgenommen; archivierte Gutachten bleiben als abgeschlossene Fassungen erhalten.</p>
      <div class="intern-actions" style="margin-top:16px;gap:10px;flex-wrap:wrap">
        <a class="sv-button sv-button-primary" href="/intern/fensterpruefung-bonn/massenaenderung/">Massenänderung</a>
        <a class="sv-button sv-button-secondary" href="/intern/fensterpruefung-bonn/word-master/">Word-Master & Fotozuordnung</a>
        <a class="sv-button sv-button-secondary" href="/intern/fensterpruefung-bonn/bestand-pruefen/">Bestand prüfen</a>
        <a class="sv-button sv-button-secondary" href="/intern/fensterpruefung-bonn/export/">Neue Gutachtenfassung erzeugen</a>
        <a class="sv-button sv-button-secondary" href="/intern/fensterpruefung-bonn/">Dashboard</a>
      </div>
    </section>

    <section class="intern-card" style="margin-top:16px">
      <h2>Zentrale Gutachtenablage</h2>
      <p class="intern-meta">Neue Gutachten werden erst dann als archiviert geführt, wenn die Datei dauerhaft in Google Drive gespeichert und bestätigt wurde. Lokale Deployment-Dateien sind nicht mehr die Master-Ablage.</p>
      <div id="reports-status" class="intern-alert intern-alert-info">Archiv wird geladen …</div>
      <div id="reports-list" style="margin-top:12px"></div>
    </section>
  </main>

  <script is:inline>
    const statusEl = document.getElementById('reports-status');
    const listEl = document.getElementById('reports-list');
    const esc = (v) => String(v ?? '').replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#039;'}[c]));
    const fmt = (value) => { if (!value) return '—'; const d = new Date(String(value).replace(' ', 'T') + 'Z'); return Number.isNaN(d.getTime()) ? String(value) : d.toLocaleString('de-DE'); };
    const size = (bytes) => { const n = Number(bytes || 0); if (n < 1024) return `${n} B`; if (n < 1024*1024) return `${(n/1024).toFixed(1)} KB`; return `${(n/1024/1024).toFixed(1)} MB`; };
    async function deleteReport(id, fileName) {
      if (!window.confirm(`Gutachten „${fileName || 'Gutachten'}“ wirklich dauerhaft löschen?\n\nDie Archivdatei wird auch aus Google Drive entfernt.`)) return;
      try {
        const r = await fetch(`/intern/api/report-archive-delete.php?id=${encodeURIComponent(String(id))}`, { method: 'DELETE', credentials: 'same-origin' });
        const j = await r.json().catch(() => ({}));
        if (!r.ok) throw new Error(j.error || 'Gutachten konnte nicht gelöscht werden.');
        await loadReports();
      } catch (e) {
        window.alert(e instanceof Error ? e.message : 'Gutachten konnte nicht gelöscht werden.');
      }
    }
    async function loadReports() {
      if (!statusEl || !listEl) return;
      try {
        const r = await fetch('/intern/api/report-archive.php?project_id=1', { credentials: 'same-origin' });
        const j = await r.json();
        if (!r.ok) throw new Error(j.error || 'Gutachtenarchiv konnte nicht geladen werden.');
        const items = Array.isArray(j.items) ? j.items : [];
        if (!items.length) { statusEl.className = 'intern-alert intern-alert-info'; statusEl.textContent = 'Noch kein Gutachten zentral archiviert.'; listEl.innerHTML = ''; return; }
        const persistentCount = items.filter(item => item.persistent).length;
        const missingCount = items.filter(item => !item.available).length;
        statusEl.className = missingCount ? 'intern-alert intern-alert-warning' : 'intern-alert intern-alert-success';
        statusEl.textContent = `${items.length} archivierte Gutachtendatei/-en gefunden · ${persistentCount} dauerhaft in Google Drive${missingCount ? ` · ${missingCount} historischer Eintrag ohne verfügbare Datei` : ''}.`;
        listEl.innerHTML = `<div class="intern-table-wrap"><table class="intern-table"><thead><tr><th>Erstellt</th><th>Dateiname</th><th>Umfang</th><th>Dateigröße</th><th>Ablage</th><th>Erstellt von</th><th>Aktion</th></tr></thead><tbody>${items.map(item => {
          const extent = `${Number(item.window_count || 0)} Fenster · ${Number(item.photo_count || 0)} Fotos · ${Number(item.attachment_count || 0)} Anlagen`;
          const masterUrl = `/intern/fensterpruefung-bonn/word-master/?archive_id=${encodeURIComponent(String(item.id))}&file_name=${encodeURIComponent(String(item.file_name || ''))}`;
          const storage = item.persistent ? 'Google Drive · dauerhaft' : (item.available ? 'Altbestand · lokal' : 'Altbestand · Datei fehlt');
          const download = item.download_url ? `<a class="sv-button sv-button-primary" href="${esc(item.download_url)}">Herunterladen</a>` : `<span class="intern-meta"><strong>Datei nicht verfügbar</strong></span>`;
          const driveLink = item.drive_web_view_link ? `<a class="sv-button sv-button-secondary" href="${esc(item.drive_web_view_link)}" target="_blank" rel="noreferrer">In Google Drive öffnen</a>` : '';
          return `<tr><td>${esc(fmt(item.created_at))}</td><td><strong>${esc(item.file_name || 'Gutachten')}</strong></td><td>${esc(extent)}</td><td>${esc(size(item.file_size))}</td><td>${esc(storage)}</td><td>${esc(item.created_by_name || '—')}</td><td><div class="intern-actions" style="gap:8px;flex-wrap:wrap">${item.available ? `<a class="sv-button sv-button-secondary" href="${masterUrl}">Als Master prüfen</a>` : ''}<a class="sv-button sv-button-secondary" href="/intern/fensterpruefung-bonn/massenaenderung/">Daten bearbeiten</a>${driveLink}${download}${item.can_delete ? `<button class="sv-button sv-button-danger" type="button" data-delete-report="${Number(item.id)}" data-report-name="${esc(item.file_name || 'Gutachten')}">Löschen</button>` : ''}</div></td></tr>`;
        }).join('')}</tbody></table></div>`;
        listEl.querySelectorAll('[data-delete-report]').forEach((button) => {
          button.addEventListener('click', () => deleteReport(button.getAttribute('data-delete-report'), button.getAttribute('data-report-name')));
        });
      } catch (e) { statusEl.className = 'intern-alert intern-alert-error'; statusEl.textContent = e instanceof Error ? e.message : 'Gutachtenarchiv konnte nicht geladen werden.'; }
    }
    loadReports();
  </script>
</InternalLayout>
