---
import InternalLayout from '../../../../layouts/InternalLayout.astro';
import InternalAppShell from '../../../../components/internal/InternalAppShell.astro';
---

<InternalLayout title="SharePoint-Import" description="Excel und Fotos aus SharePoint einlesen und Fenstern zuordnen.">
  <section class="intern-card" id="sharepoint-import-mode" style="margin-bottom:1rem;">
    <p class="sv-eyebrow">Importmodus</p>
    <h2 style="margin-top:0;">Umfang des SharePoint-Imports festlegen</h2>
    <p class="intern-meta">Bei Nachträgen werden bereits vorhandene Fenster und Fotozuordnungen wiederverwendet. Ein vollständiger Neuaufbau ist nur erforderlich, wenn die bestehende Zuordnung bewusst verworfen werden soll.</p>
    <div class="intern-actions" role="group" aria-label="Importmodus" style="gap:.65rem;flex-wrap:wrap;">
      <button type="button" class="sv-button sv-button-secondary" data-sp-mode="new">Nur neu</button>
      <button type="button" class="sv-button sv-button-primary" data-sp-mode="complete">Vervollständigen / Aktualisieren</button>
      <button type="button" class="sv-button sv-button-secondary" data-sp-mode="photos">Nur Fotos neu zuordnen</button>
      <button type="button" class="sv-button sv-button-secondary" data-sp-mode="full">Vollständig neu einlesen</button>
    </div>
    <label style="display:flex;align-items:center;gap:.55rem;margin-top:1rem;font-weight:600;">
      <input type="checkbox" id="sp-preserve-photo-assignments" checked />
      Bestehende Fotozuordnungen beibehalten
    </label>
    <div id="sp-delta-info" class="intern-alert intern-alert--info" style="margin-top:1rem;">
      Standard: vorhandene Daten vervollständigen, nur neue bzw. noch nicht zugeordnete Fotos laden und analysieren.
    </div>
  </section>

  <script is:inline>
    (() => {
      const STORAGE_KEY = 'sv-sharepoint-import-mode';
      const PRESERVE_KEY = 'sv-sharepoint-preserve-photo-assignments';
      const PHOTO_SOURCE = 'VS Schäden/Marc/Privatgutachten/2026/Bundesministerium Verteidigung_Bonn';
      const OCR_DB = 'sv-netzwerk-photo-index';
      const OCR_STORE = 'ocr-checkpoints';
      const originalFetch = window.fetch.bind(window);
      const query = new URLSearchParams(window.location.search);
      const photoOnlyRequested = query.get('photo_only') === '1';
      let mode = photoOnlyRequested ? 'photos' : (localStorage.getItem(STORAGE_KEY) || 'complete');
      let preserveAssignments = photoOnlyRequested ? false : localStorage.getItem(PRESERVE_KEY) !== 'false';
      const photoById = new Map();
      const photoByName = new Map();

      if (photoOnlyRequested) {
        localStorage.setItem(STORAGE_KEY, 'photos');
        localStorage.setItem(PRESERVE_KEY, 'false');
      }

      const buildingId = () => {
        const params = new URLSearchParams(window.location.search);
        const fromUrl = Number(params.get('building_id') || 0);
        if (fromUrl > 0) return fromUrl;
        const root = document.querySelector('[data-building-id]');
        return Number(root?.getAttribute('data-building-id') || 1);
      };

      const projectKey = () => `${location.pathname.split('/').filter(Boolean)[1] || 'fensterpruefung-bonn'}:${buildingId()}`;
      const ocrKey = (photo) => `${projectKey()}|${String(photo?.id || '')}|${String(photo?.name || '')}|${Number(photo?.size || 0)}`;

      const openOcrDb = () => new Promise((resolve, reject) => {
        const request = indexedDB.open(OCR_DB, 2);
        request.onerror = () => reject(request.error);
        request.onsuccess = () => resolve(request.result);
        request.onupgradeneeded = () => {
          const db = request.result;
          if (!db.objectStoreNames.contains(OCR_STORE)) db.createObjectStore(OCR_STORE, { keyPath: 'key' });
        };
      });

      const getOcrCheckpoint = async (photo) => {
        if (!photo?.name) return null;
        try {
          const db = await openOcrDb();
          return await new Promise((resolve) => {
            const tx = db.transaction(OCR_STORE, 'readonly');
            const request = tx.objectStore(OCR_STORE).get(ocrKey(photo));
            request.onsuccess = () => resolve(request.result || null);
            request.onerror = () => resolve(null);
            tx.oncomplete = () => db.close();
          });
        } catch {
          return null;
        }
      };

      const putOcrCheckpoint = async (photo, text) => {
        if (!photo?.name) return;
        try {
          const db = await openOcrDb();
          await new Promise((resolve) => {
            const tx = db.transaction(OCR_STORE, 'readwrite');
            tx.objectStore(OCR_STORE).put({
              key: ocrKey(photo),
              project: projectKey(),
              item_id: String(photo.id || ''),
              name: String(photo.name || ''),
              size: Number(photo.size || 0),
              text: String(text || ''),
              analyzed_at: new Date().toISOString(),
            });
            tx.oncomplete = resolve;
            tx.onerror = resolve;
          });
          db.close();
        } catch {}
      };

      const tinyPng = Uint8Array.from(atob('iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAQAAAC1HAwCAAAAC0lEQVR42mNk+A8AAQUBAScY42YAAAAASUVORK5CYII='), c => c.charCodeAt(0));

      // Tesseract wird im bestehenden Client dynamisch geladen. Wir kapseln die
      // recognize-Funktion, sobald sie gesetzt wird. Vorhandene OCR-Ergebnisse
      // werden sofort aus IndexedDB geliefert; neue Ergebnisse werden unmittelbar
      // nach jedem einzelnen Foto gespeichert. Ein Abbruch verliert daher nicht
      // mehr die bereits analysierten Bilder.
      let tesseractValue = window.Tesseract;
      const wrapTesseract = (value) => {
        if (!value || typeof value.recognize !== 'function' || value.__svCheckpointWrapped) return value;
        const originalRecognize = value.recognize.bind(value);
        value.recognize = async (source, lang, options) => {
          const name = source && typeof source === 'object' && 'name' in source ? String(source.name || '') : '';
          const photo = photoByName.get(name);
          if (photo) {
            const cached = await getOcrCheckpoint(photo);
            if (cached && typeof cached.text === 'string') {
              return { data: { text: cached.text } };
            }
          }
          const result = await originalRecognize(source, lang, options);
          if (photo) await putOcrCheckpoint(photo, result?.data?.text || '');
          return result;
        };
        Object.defineProperty(value, '__svCheckpointWrapped', { value: true });
        return value;
      };
      if (tesseractValue) tesseractValue = wrapTesseract(tesseractValue);
      try {
        Object.defineProperty(window, 'Tesseract', {
          configurable: true,
          get: () => tesseractValue,
          set: (value) => { tesseractValue = wrapTesseract(value); },
        });
      } catch {}

      const normalizeNumber = (value) => {
        const match = String(value ?? '').match(/\d+/);
        if (!match) return String(value ?? '').trim().toLowerCase();
        return String(Number(match[0]));
      };

      const rowNumber = (row) => {
        if (!row || typeof row !== 'object') return '';
        for (const key of ['__window_number', 'schlagzahl', 'Schlagzahl', 'Fensternummer', 'Fenster-Nr', 'Fenster-Nr.', 'window_number', 'Nummer', 'Nr']) {
          if (row[key] !== undefined && String(row[key]).trim() !== '') return normalizeNumber(row[key]);
        }
        for (const [key, value] of Object.entries(row)) {
          const k = String(key).toLowerCase();
          if ((k.includes('schlag') || k.includes('fenster')) && String(value ?? '').trim() !== '') return normalizeNumber(value);
        }
        return '';
      };

      const extractItemId = (value) => {
        if (!value || typeof value !== 'object') return '';
        for (const key of ['item_id', 'sharepoint_id', 'drive_item_id', 'photo_id', 'id']) {
          if (value[key] !== undefined && value[key] !== null && String(value[key]).trim()) return String(value[key]).trim();
        }
        for (const child of Object.values(value)) {
          if (child && typeof child === 'object') {
            const found = extractItemId(child);
            if (found) return found;
          }
        }
        return '';
      };

      const info = (message, kind = 'info') => {
        const el = document.getElementById('sp-delta-info');
        if (!el) return;
        el.className = `intern-alert intern-alert--${kind}`;
        el.textContent = message;
      };

      const isAlreadyImported = async (payload) => {
        const itemId = String(payload?.item_id || '');
        const fileName = String(payload?.file_name || '');
        if (!itemId && !fileName) return false;
        try {
          const response = await originalFetch('/intern/api/sharepoint-delta.php?action=filter', {
            method: 'POST',
            credentials: 'same-origin',
            headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
            body: JSON.stringify({
              building_id: buildingId(),
              mode: 'complete',
              photos: [{ id: itemId, name: fileName }],
            }),
          });
          if (!response.ok) return false;
          const json = await response.json();
          return Number(json?.skipped || 0) > 0;
        } catch {
          return false;
        }
      };

      window.fetch = async (input, init = {}) => {
        let requestInput = input;
        const rawUrl = typeof input === 'string' ? input : input instanceof Request ? input.url : String(input);
        const method = String(init.method || (input instanceof Request ? input.method : 'GET')).toUpperCase();

        if (mode === 'photos' && method === 'GET' && rawUrl.includes('sharepoint.php?action=list_sharepoint_photos')) {
          requestInput = '/intern/api/sharepoint-project-photos.php';
          info(`Nur Fotos: Projektordner „${PHOTO_SOURCE}“ wird rekursiv eingelesen. Fenster, Räume, Etagen und Excel-Daten bleiben unverändert.`, 'warning');
        }

        // Bereits OCR-analysierte SharePoint-Dateien werden nicht erneut vollständig
        // heruntergeladen. Die Reihenfolge bleibt erhalten, der Client erhält nur ein
        // minimales Platzhalterbild; die gepufferte OCR-Antwort liefert anschließend
        // das gespeicherte Ergebnis.
        if (method === 'GET' && rawUrl.includes('sharepoint.php?action=sharepoint_photo')) {
          try {
            const id = new URL(rawUrl, location.origin).searchParams.get('id') || '';
            const photo = photoById.get(id);
            if (photo && await getOcrCheckpoint(photo)) {
              return new Response(tinyPng, {
                status: 200,
                headers: { 'Content-Type': photo.mime_type || 'image/png', 'Cache-Control': 'no-store', 'X-SV-OCR-Checkpoint': 'hit' },
              });
            }
          } catch {}
        }

        if (mode === 'photos' && method === 'POST' && rawUrl.includes('sharepoint.php?action=apply_excel')) {
          const targetResponse = await originalFetch(`/intern/api/sharepoint-photo-targets.php?building_id=${encodeURIComponent(buildingId())}`, {
            method: 'GET',
            credentials: 'same-origin',
            headers: { Accept: 'application/json' },
            cache: 'no-store',
          });
          const body = await targetResponse.text();
          if (!targetResponse.ok) return new Response(body, { status: targetResponse.status, headers: { 'Content-Type': 'application/json; charset=utf-8' } });
          try {
            const parsed = JSON.parse(body);
            info(`Nur Fotos: ${parsed.targets_found || 0} vorhandene Fenster-/Flügelziele werden verwendet. Quelle: ${PHOTO_SOURCE}.`, 'success');
          } catch {}
          return new Response(body, { status: 200, headers: { 'Content-Type': 'application/json; charset=utf-8', 'Cache-Control': 'no-store' } });
        }

        if (mode === 'new' && method === 'POST' && rawUrl.includes('sharepoint.php?action=apply_excel') && typeof init.body === 'string') {
          try {
            const payload = JSON.parse(init.body);
            if (Array.isArray(payload?.rows)) {
              const response = await originalFetch('/intern/api/windows.php?_=1', { credentials: 'same-origin', headers: { Accept: 'application/json' } });
              const existing = response.ok ? await response.json() : [];
              const existingNumbers = new Set((Array.isArray(existing) ? existing : []).map((item) => normalizeNumber(item?.window_number ?? item?.inspection_number ?? item?.schlagzahl ?? '')).filter(Boolean));
              const before = payload.rows.length;
              payload.rows = payload.rows.filter((row) => {
                const number = rowNumber(row);
                return !number || !existingNumbers.has(number);
              });
              init = { ...init, body: JSON.stringify(payload) };
              info(`Modus „Nur neu“: ${before - payload.rows.length} bereits vorhandene Excel-Zeilen übersprungen, ${payload.rows.length} neue Zeilen werden verarbeitet.`);
            }
          } catch (error) {
            console.warn('[SharePoint-Delta] Excel-Filter konnte nicht angewendet werden:', error);
          }
        }

        // Bereits erfolgreich übernommene Fotos werden nicht nochmals an das Backend
        // übertragen. So bleiben Wiederanläufe idempotent und erzeugen keine Dubletten.
        if (method === 'POST' && rawUrl.includes('sharepoint.php?action=import_sharepoint_photo') && typeof init.body === 'string') {
          try {
            const payload = JSON.parse(init.body);
            if (await isAlreadyImported(payload)) {
              return new Response(JSON.stringify({ ok: true, skipped: true, message: 'Bereits übernommen; vorhandene Zuordnung wird wiederverwendet.' }), {
                status: 200,
                headers: { 'Content-Type': 'application/json; charset=utf-8', 'Cache-Control': 'no-store' },
              });
            }
          } catch {}
        }

        const response = await originalFetch(requestInput, init);

        if (response.ok && method === 'GET' && rawUrl.includes('sharepoint.php?action=list_sharepoint_photos')) {
          try {
            const json = await response.clone().json();
            const photos = Array.isArray(json?.photos) ? json.photos : [];
            photoById.clear();
            photoByName.clear();
            for (const photo of photos) {
              if (photo?.id) photoById.set(String(photo.id), photo);
              if (photo?.name) photoByName.set(String(photo.name), photo);
            }
            let cached = 0;
            for (const photo of photos) if (await getOcrCheckpoint(photo)) cached++;
            if (mode === 'photos') {
              info(`Nur Fotos: ${photos.length} Bilder gefunden. ${cached} OCR-Ergebnisse sind bereits als Checkpoint vorhanden und werden ohne erneute Bildanalyse wiederverwendet.`, 'success');
            }
          } catch {}
        }

        if (response.ok && method === 'GET' && rawUrl.includes('sharepoint.php?action=list_sharepoint_photos') && mode !== 'full' && mode !== 'photos' && preserveAssignments) {
          try {
            const json = await response.clone().json();
            const photos = Array.isArray(json?.photos) ? json.photos : [];
            const deltaResponse = await originalFetch('/intern/api/sharepoint-delta.php?action=filter', {
              method: 'POST',
              credentials: 'same-origin',
              headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
              body: JSON.stringify({ building_id: buildingId(), mode, photos }),
            });
            if (deltaResponse.ok) {
              const delta = await deltaResponse.json();
              const remaining = Array.isArray(delta?.photos) ? delta.photos : photos;
              const skipped = Number(delta?.skipped || 0);
              info(`Delta-Import: ${skipped} bereits vorhandene Fotos werden wiederverwendet; nur ${remaining.length} von ${photos.length} Fotos müssen neu geladen und ausgewertet werden.`, 'success');
              return new Response(JSON.stringify({ ...json, photos: remaining, delta: { total: photos.length, skipped, remaining: remaining.length, mode } }), {
                status: response.status,
                statusText: response.statusText,
                headers: { 'Content-Type': 'application/json; charset=utf-8', 'Cache-Control': 'no-store' },
              });
            }
          } catch (error) {
            console.warn('[SharePoint-Delta] Foto-Delta konnte nicht ermittelt werden:', error);
          }
        }

        if (response.ok && method === 'POST' && rawUrl.includes('sharepoint.php?action=import_sharepoint_photo')) {
          try {
            let payload = {};
            if (typeof init.body === 'string') payload = JSON.parse(init.body);
            const itemId = extractItemId(payload);
            if (itemId) {
              void originalFetch('/intern/api/sharepoint-delta.php?action=mark', {
                method: 'POST',
                credentials: 'same-origin',
                headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
                body: JSON.stringify({ building_id: buildingId(), item_id: itemId, name: payload?.file_name || '', payload }),
              });
            }
          } catch (error) {
            console.warn('[SharePoint-Delta] Importstatus konnte nicht gespeichert werden:', error);
          }
        }

        return response;
      };

      const applyUi = () => {
        const buttons = [...document.querySelectorAll('[data-sp-mode]')];
        const preserve = document.getElementById('sp-preserve-photo-assignments');
        if (preserve instanceof HTMLInputElement) {
          preserve.checked = preserveAssignments;
          preserve.disabled = mode === 'photos';
        }

        const render = () => {
          for (const button of buttons) {
            const active = button.getAttribute('data-sp-mode') === mode;
            button.classList.toggle('sv-button-primary', active);
            button.classList.toggle('sv-button-secondary', !active);
          }
          if (preserve instanceof HTMLInputElement) {
            preserve.disabled = mode === 'photos';
            if (mode === 'photos') preserve.checked = false;
          }
          if (mode === 'full') {
            info('Vollständiger Neuimport: alle Excel-Daten und alle SharePoint-Fotos werden erneut verarbeitet. Dieser Modus kann bei großen Fotobeständen lange dauern.', 'warning');
          } else if (mode === 'photos') {
            info(`Nur Fotos neu zuordnen: Quelle „${PHOTO_SOURCE}“ wird rekursiv gelesen. OCR-Checkpoints und bereits übernommene Fotozuordnungen werden wiederverwendet; nur neue oder geänderte Bilder müssen tatsächlich analysiert werden.`, 'warning');
          } else if (mode === 'new') {
            info('Nur neu: vorhandene Fensternummern und bereits zugeordnete Fotos werden übersprungen.');
          } else {
            info('Vervollständigen / Aktualisieren: Excel-Daten werden zusammengeführt; bestehende Fotozuordnungen bleiben erhalten und nur neue Fotos werden analysiert.');
          }
        };

        for (const button of buttons) {
          button.addEventListener('click', () => {
            mode = button.getAttribute('data-sp-mode') || 'complete';
            localStorage.setItem(STORAGE_KEY, mode);
            if (mode === 'full' || mode === 'photos') {
              preserveAssignments = false;
              localStorage.setItem(PRESERVE_KEY, 'false');
            }
            render();
          });
        }
        preserve?.addEventListener('change', () => {
          if (mode === 'photos') return;
          preserveAssignments = preserve instanceof HTMLInputElement ? preserve.checked : true;
          localStorage.setItem(PRESERVE_KEY, String(preserveAssignments));
          if (!preserveAssignments && mode !== 'full') {
            info('Bestehende Fotozuordnungen werden nicht geschützt; beim nächsten Start können Fotos erneut verarbeitet werden.', 'warning');
          } else {
            render();
          }
        });
        render();
      };

      if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', applyUi, { once: true });
      else applyUi();
    })();
  </script>

  <InternalAppShell route="sharepoint-import" />
</InternalLayout>
