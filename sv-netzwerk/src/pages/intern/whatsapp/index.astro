---
import InternalLayout from '../../../layouts/InternalLayout.astro';
---

<InternalLayout title="WhatsApp" description="Persönliche WhatsApp-Business-Verbindung und fallbezogener Nachrichteneingang." currentPath="/intern/whatsapp/">
  <section slot="sidebar-extra" id="wa-profile-panel" class="intern-sidebar__expert" hidden>
    <label for="wa-profile-select"><strong>WhatsApp-Profil</strong><small>Konten und Nachrichten bleiben getrennt</small></label>
    <select id="wa-profile-select"><option value="christian">Christian Wächter</option><option value="marc">Marc Schütt</option><option value="holger">Holger Roth</option></select>
  </section>
  <main class="wa-app">
    <header class="wa-head"><div><p class="wa-kicker">Persönlicher Kanal</p><h1>WhatsApp Business</h1><p>Verbindung, Status und Nachrichteneingang des ausgewählten Bearbeiters.</p></div><a href="/intern/versicherungsfaelle/">Versicherungsfälle öffnen</a></header>
    <section class="wa-card">
      <div class="wa-section-title"><div><small>Direkter Versand</small><h2>Nachricht schreiben</h2></div></div>
      <div class="wa-compose-grid">
        <div class="wa-picker">
          <label class="wa-field" for="wa-phonebook-search"><span>Telefonbuch</span><input id="wa-phonebook-search" type="search" placeholder="Name oder Rufnummer suchen" autocomplete="off" /></label>
          <button id="wa-phonebook-open" class="secondary" type="button">Telefonbuch aufrufen</button>
          <div id="wa-phonebook-results" class="wa-pick-results" hidden></div>
        </div>
        <div class="wa-picker">
          <label class="wa-field" for="wa-case-search"><span>Aus Schadenakte übernehmen</span><input id="wa-case-search" type="search" placeholder="Schaden-Nr. oder VN suchen" autocomplete="off" /></label>
          <button id="wa-case-open" class="secondary" type="button">Akten durchsuchen</button>
          <div id="wa-case-results" class="wa-pick-results" hidden></div>
        </div>
      </div>
      <input id="wa-case-folder" type="hidden" />
      <input id="wa-case-number" type="hidden" />
      <p id="wa-selected-case" class="wa-note" hidden></p>
      <label class="wa-field" for="wa-recipient-phone"><span>Empfänger-Rufnummer</span><input id="wa-recipient-phone" type="tel" placeholder="z. B. +49 171 1234567" autocomplete="tel" /></label>
      <label class="wa-field" for="wa-message-text"><span>Nachricht</span><textarea id="wa-message-text" rows="6" maxlength="4096" placeholder="WhatsApp-Nachricht eingeben"></textarea></label>
      <div class="wa-actions"><button id="wa-message-send" type="button" disabled>Nachricht senden</button><a class="wa-button-link" href="/intern/telefon/">Telefonbuch verwalten</a></div>
      <p id="wa-compose-state" class="wa-compose-state" aria-live="polite"></p>
      <p class="wa-help">Freie Textnachrichten sind nach den Meta-Vorgaben innerhalb des 24-Stunden-Servicefensters möglich. Außerhalb dieses Fensters verlangt Meta eine freigegebene Nachrichtenvorlage.</p>
    </section>
    <section class="wa-card"><div class="wa-section-title"><div><small>Persönlicher Eingang</small><h2>Nachrichten und Dateien</h2></div><button id="wa-inbox-refresh" class="secondary" type="button">Eingang aktualisieren</button></div><div id="wa-messages" class="wa-messages"><p class="wa-empty">Nachrichten werden geladen …</p></div></section>
    <details class="wa-card wa-account-card">
      <summary class="wa-account-summary"><span><small>Aktives Konto</small><strong id="wa-account-name">WhatsApp-Profil wird geladen …</strong><b id="wa-account-number"></b></span><span id="wa-account-state" class="wa-state pending">Status wird geprüft …</span></summary>
      <div class="wa-account-details">
        <p id="wa-account-note" class="wa-note">Die Verbindung wird ausschließlich diesem Bearbeiterprofil zugeordnet.</p>
        <div class="wa-actions"><button id="wa-connect" type="button" disabled>WhatsApp verbinden</button><button id="wa-refresh" class="secondary" type="button">Status aktualisieren</button></div>
        <details class="wa-guide"><summary>So wird das eigene Konto verbunden</summary><ol><li>Mit dem eigenen Meta-Unternehmenskonto anmelden.</li><li>Nur die angezeigte WhatsApp-Business-Nummer auswählen.</li><li>Die Bestätigung in der eigenen WhatsApp-Business-App abschließen.</li><li>Die Verbindung wird verschlüsselt ausschließlich unter diesem Bearbeiterprofil gespeichert.</li></ol></details>
      </div>
    </details>
  </main>
</InternalLayout>

<style is:global>
.wa-app{box-sizing:border-box;min-height:calc(100vh - 112px);padding:24px;color:#17324a}.wa-head{display:flex;align-items:flex-end;justify-content:space-between;gap:18px;margin-bottom:18px}.wa-head h1{margin:3px 0}.wa-head p{margin:0;color:#647789}.wa-head>a{padding:10px 13px;border:1px solid #17324a;background:#fff;color:#17324a;font-weight:800;text-decoration:none}.wa-kicker{color:#f59a23!important;font-weight:900}.wa-card{margin-bottom:14px;padding:20px;border:1px solid #ccd5dc;border-top:4px solid #f59a23;background:#fff}.wa-account-head,.wa-section-title{display:flex;align-items:flex-start;justify-content:space-between;gap:16px}.wa-card h2{margin:3px 0 0}.wa-card small{color:#6b7d8c;font-weight:800}.wa-state{padding:8px 10px;border:1px solid #e5bd7d;background:#fff7e8;font-weight:800}.wa-state.ok{border-color:#9bc7a7;background:#edf8f0;color:#23643a}.wa-state.bad{border-color:#d8a1a1;background:#fff0f0;color:#8a2929}.wa-note{margin:16px 0;padding:11px 12px;border-left:4px solid #18324a;background:#f1f5f7}.wa-actions{display:flex;flex-wrap:wrap;gap:9px}.wa-actions button,.wa-section-title button{padding:10px 14px;border:1px solid #18324a;background:#18324a;color:#fff;font:inherit;font-weight:800;cursor:pointer}.wa-actions button.secondary,.wa-section-title button.secondary{background:#fff;color:#18324a}.wa-actions button:disabled{cursor:not-allowed;opacity:.5}.wa-guide{margin-top:15px}.wa-guide summary{cursor:pointer;font-weight:900}.wa-guide li{margin:6px 0}.wa-messages{display:grid;gap:9px;margin-top:15px}.wa-message{display:grid;grid-template-columns:minmax(170px,.7fr) minmax(220px,1fr) auto;gap:12px;align-items:center;padding:12px;border:1px solid #d6dde2;background:#f7f9fa}.wa-message span,.wa-message small{overflow-wrap:anywhere}.wa-message a{font-weight:800;color:#17324a}.wa-empty{margin:0;color:#718392}@media(max-width:760px){.wa-app{padding:14px}.wa-head,.wa-account-head,.wa-section-title{align-items:stretch;flex-direction:column}.wa-message{grid-template-columns:1fr}}
.wa-compose-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px;margin-top:14px}.wa-picker{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:8px;align-items:end}.wa-field{display:grid;gap:5px;margin-top:14px}.wa-field span{font-weight:800}.wa-field input,.wa-field textarea{box-sizing:border-box;width:100%;padding:10px;border:1px solid #aebdca;background:#fff;color:#17324a;font:inherit}.wa-field textarea{resize:vertical}.wa-picker button,.wa-button-link{padding:10px 14px;border:1px solid #18324a;background:#fff;color:#18324a;font:inherit;font-weight:800;cursor:pointer;text-decoration:none}.wa-pick-results{grid-column:1/-1;max-height:240px;overflow:auto;border:1px solid #ccd5dc;background:#f7f9fa}.wa-pick-result{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:9px 10px;border-bottom:1px solid #dbe2e7}.wa-pick-result:last-child{border-bottom:0}.wa-pick-result button{padding:7px 9px;white-space:nowrap}.wa-pick-result div{min-width:0}.wa-pick-result small{display:block;overflow-wrap:anywhere}.wa-compose-state{min-height:1.35em;margin:10px 0 0;font-weight:800}.wa-compose-state.ok{color:#23643a}.wa-compose-state.bad{color:#8a2929}.wa-help{margin:8px 0 0;color:#647789;font-size:.9rem}@media(max-width:760px){.wa-compose-grid{grid-template-columns:1fr}.wa-picker{grid-template-columns:1fr}}
.wa-account-card{padding:0}.wa-account-summary{display:flex;align-items:center;justify-content:space-between;gap:16px;padding:15px 20px;cursor:pointer;list-style:none}.wa-account-summary::-webkit-details-marker{display:none}.wa-account-summary>span:first-child{display:flex;align-items:baseline;flex-wrap:wrap;gap:5px 12px}.wa-account-summary strong{font-size:1.05rem}.wa-account-summary b{font-size:.88rem}.wa-account-summary::after{content:'›';font-size:1.35rem;font-weight:900;transition:transform .15s}.wa-account-card[open]>.wa-account-summary::after{transform:rotate(90deg)}.wa-account-details{padding:0 20px 20px;border-top:1px solid #dbe2e7}.wa-account-summary .wa-state{margin-left:auto}@media(max-width:760px){.wa-account-summary{align-items:flex-start;flex-wrap:wrap;padding:14px}.wa-account-summary .wa-state{margin-left:0}.wa-account-details{padding:0 14px 14px}}
</style>
<script is:inline src="/intern/whatsapp-account.js?v=20260909-6"></script>
