---
import InternalLayout from '../../../layouts/InternalLayout.astro';
---

<InternalLayout title="Fahrtenbuch" description="Mobiles Fahrtenbuch für Womo und GLE/VLE." currentPath="/intern/fahrtenbuch/">
  <section class="fb-app">
    <header class="fb-head">
      <div><p class="fb-kicker">SV-Netzwerk · Outlook</p><h1>Fahrtenbuch</h1><p>Womo GD-SC 137 · GLE / VLE GD-CW 137E</p></div>
      <div class="fb-actions"><button id="fb-outlook" class="fb-btn primary">Outlook-Kalender laden</button><button id="fb-free" class="fb-btn">+ Freie Fahrt</button></div>
    </header>
    <div id="fb-state" class="fb-state" role="status">Bereit. Fahrzeug wählen oder Outlook-Termine laden.</div>
    <div id="fb-vehicles" class="fb-vehicles"></div><div class="fb-odometer"><label>Aktueller km-Stand <input id="fb-odo" type="number" min="0" step="1" placeholder="noch nicht erfasst"></label><button id="fb-odo-save" class="fb-btn small">km-Stand speichern</button><span id="fb-odo-state">Noch nicht erfasst</span></div>
    <div class="fb-kpis"><div><span>Gefahrene Strecke</span><strong id="fb-km">0 km</strong></div><div><span>Fahrten</span><strong id="fb-count">0</strong></div><div><span>Geschäftlich</span><strong id="fb-biz">0 km</strong></div><div><span>Privat</span><strong id="fb-priv">0 km</strong></div></div>
    <div class="fb-grid">
      <section class="fb-card"><div class="fb-title"><h2>Fahrten</h2><span id="fb-vehicle-label"></span></div><div class="fb-table-wrap"><table><thead><tr><th>Datum</th><th>Start / Ziel</th><th>km</th><th>Odometer</th><th>Typ</th><th>Anlass</th></tr></thead><tbody id="fb-rows"></tbody></table></div></section>
      <section class="fb-card"><div class="fb-title"><h2>Outlook-Termine</h2><button id="fb-home" class="fb-btn small">Heimatadresse</button></div><div id="fb-events" class="fb-events">Noch keine Termine geladen.</div></section>
    </div>
  </section>

  <div id="fb-outlook-modal" class="fb-modal" hidden><div class="fb-sheet"><button class="fb-close" data-close="fb-outlook-modal">×</button><h2>Outlook-Kalender abfragen</h2><p class="fb-note">Alle Termine werden ab dem gewählten Monat bis heute über das angemeldete SV-Portal geladen.</p><div class="fb-form"><label>Von Monat<select id="fb-month"><option value="01">Januar</option><option value="02">Februar</option><option value="03">März</option><option value="04">April</option><option value="05">Mai</option><option value="06">Juni</option><option value="07">Juli</option><option value="08">September</option><option value="09">September</option><option value="10">Oktober</option><option value="11">November</option><option value="12">Dezember</option></select></label><label>Jahr<input id="fb-year" type="number" value="2026"></label><button id="fb-load" class="fb-btn primary">Termine laden</button></div></div></div>
  <div id="fb-free-modal" class="fb-modal" hidden><div class="fb-sheet"><button class="fb-close" data-close="fb-free-modal">×</button><h2>Freie Fahrt</h2><form id="fb-form" class="fb-form"><label>Datum<input name="date" type="date" required></label><label>Typ<select name="type"><option>Geschäftlich</option><option>Privat</option></select></label><label class="wide">Start / Ziel<input name="route" placeholder="z. B. Aalen → Stuttgart" required></label><label>km<input name="km" type="number" min="0" step="0.1" required></label><label>Anlass<input name="reason" placeholder="z. B. Ortstermin"></label><button class="fb-btn primary wide" type="submit">Fahrt speichern</button></form></div></div>
  <div id="fb-home-modal" class="fb-modal" hidden><div class="fb-sheet"><button class="fb-close" data-close="fb-home-modal">×</button><h2>Heimatadresse</h2><form id="fb-home-form" class="fb-form"><label class="wide">Adresse<input id="fb-home-input" value="Nordstraße 15, 73432 Aalen" required></label><button class="fb-btn primary wide" type="submit">Speichern</button></form></div></div>
</InternalLayout>

<style is:global>
.fb-app{padding:24px;min-height:calc(100vh - 112px);box-sizing:border-box;background:#f4f5f6;color:#17324a}.fb-head{display:flex;justify-content:space-between;align-items:flex-end;gap:18px;margin-bottom:14px}.fb-kicker{margin:0;color:#f59a23;font-weight:800}.fb-head h1{margin:4px 0}.fb-head p:last-child{margin:0;color:#647789}.fb-actions{display:flex;gap:8px;flex-wrap:wrap}.fb-btn{border:1px solid #bcc8d1;background:#fff;color:#17324a;border-radius:5px;padding:10px 13px;font-weight:800;cursor:pointer}.fb-btn.primary{background:#17324a;color:#fff;border-color:#17324a}.fb-btn.small{padding:7px 10px;font-size:.82rem}.fb-state{padding:12px 14px;margin-bottom:14px;border-left:4px solid #f59a23;background:#fff7e9}.fb-state.ok{background:#edf8f0;border-left-color:#34834b}.fb-state.bad{background:#fff0f0;border-left-color:#b33131}.fb-vehicles{display:flex;gap:10px;flex-wrap:wrap;margin-bottom:14px}.fb-vehicle{flex:1 1 240px;text-align:left;padding:13px;border:1px solid #d5dde3;border-radius:6px;background:#fff;color:#17324a;cursor:pointer}.fb-vehicle.active{border-color:#f59a23;box-shadow:inset 4px 0 #f59a23}.fb-vehicle strong,.fb-vehicle small{display:block}.fb-vehicle small{margin-top:4px;color:#647789}.fb-odometer{display:flex;align-items:end;gap:10px;flex-wrap:wrap;margin:0 0 14px;padding:12px;background:#fff;border:1px solid #d5dde3;border-radius:6px}.fb-odometer label{display:grid;gap:5px;color:#647789;font-size:.82rem}.fb-odometer input{padding:9px;border:1px solid #cbd5df;border-radius:5px;font:inherit;width:180px}.fb-odometer span{color:#647789;font-size:.82rem;padding-bottom:9px}.fb-kpis{display:grid;grid-template-columns:repeat(4,1fr);gap:10px;margin-bottom:14px}.fb-kpis>div,.fb-card{background:#fff;border:1px solid #d5dde3;border-radius:6px}.fb-kpis>div{padding:13px}.fb-kpis span{display:block;color:#647789;font-size:.82rem}.fb-kpis strong{display:block;margin-top:4px;font-size:1.35rem}.fb-grid{display:grid;grid-template-columns:1.15fr .85fr;gap:14px}.fb-card{padding:14px}.fb-title{display:flex;justify-content:space-between;align-items:center;gap:8px}.fb-title h2{margin:0;font-size:1.1rem}.fb-table-wrap{overflow:auto;margin-top:10px}.fb-card table{width:100%;border-collapse:collapse;min-width:620px}.fb-card th,.fb-card td{padding:9px;border-bottom:1px solid #e1e6ea;text-align:left;font-size:.86rem}.fb-card th{color:#647789;background:#f8fafb}.fb-pill{display:inline-block;padding:3px 8px;border-radius:99px;background:#e8f7f1;color:#26744e;font-size:.76rem}.fb-pill.private{background:#f0eefb;color:#5a4b9a}.fb-events{display:grid;gap:9px;margin-top:10px}.fb-event{padding:11px;border:1px solid #d5dde3;border-radius:5px}.fb-event strong,.fb-event small{display:block}.fb-event small{margin-top:4px;color:#647789}.fb-event .fb-btn{margin-top:8px}.fb-modal{position:fixed;inset:0;z-index:1000;display:grid;place-items:end center;padding:18px;background:rgba(7,26,46,.52)}.fb-modal[hidden]{display:none}.fb-sheet{width:min(720px,100%);max-height:88vh;overflow:auto;padding:20px;border-radius:10px 10px 0 0;background:#fff}.fb-close{float:right;border:0;border-radius:50%;width:32px;height:32px;background:#eef1f4;font-size:1.3rem;cursor:pointer}.fb-note{padding:11px;background:#f4f7fb;border-left:4px solid #3154db}.fb-form{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px;margin-top:14px}.fb-form label{display:grid;gap:5px;color:#647789;font-size:.82rem}.fb-form input,.fb-form select{padding:10px;border:1px solid #cbd5df;border-radius:5px;font:inherit;color:#17324a}.fb-form .wide{grid-column:1/-1}@media(max-width:760px){.fb-app{padding:14px}.fb-head{align-items:stretch;flex-direction:column}.fb-actions .fb-btn{flex:1}.fb-kpis{grid-template-columns:repeat(2,1fr)}.fb-grid{grid-template-columns:1fr}.fb-form{grid-template-columns:1fr}.fb-form .wide{grid-column:auto}}
</style>

<script is:inline>
(() => {
  const key='svnet-fahrtenbuch-v1'; const homeKey='svnet-fahrtenbuch-home'; let selected='womo'; let events=[]; let odometers=JSON.parse(localStorage.getItem('svnet-fahrtenbuch-odometers')||'{"womo":31923.0}' ); let home=localStorage.getItem(homeKey)||'Nordstraße 15, 73432 Aalen';
  const vehicles={womo:{name:'Womo',plate:'GD-SC 137',model:'Sprinter 417 CDI Standard'},gle:{name:'GLE / VLE',plate:'GD-CW 137E',model:'Mercedes-Benz GLE / VLE'}};
  const seed=[{id:'seed-1',vehicle:'womo',date:'2026-09-15',route:'Nordstraße 15, 73432 Aalen → Neresheimer Straße 32, 73450 Elchingen',km:6.5,odoStart:31503.4,odoEnd:31510.0,type:'Geschäftlich',reason:'Rückfahrt Tanken'},{id:'seed-2',vehicle:'womo',date:'2026-09-15',route:'Neresheimer Straße 32, 73450 Elchingen → Nordstraße 19, 73432 Ebnat',km:6.3,odoStart:31510.0,odoEnd:31516.3,type:'Geschäftlich',reason:'Tanken'},{id:'seed-3',vehicle:'womo',date:'2026-09-19',route:'Privat → Privat',km:406.7,odoStart:31516.3,odoEnd:31923.0,type:'Privat',reason:'Privat'}];
  let trips=JSON.parse(localStorage.getItem(key)||'null'); if(!Array.isArray(trips)) trips=seed;
  const $=s=>document.querySelector(s); const esc=v=>String(v??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
  const save=()=>localStorage.setItem(key,JSON.stringify(trips)); const setState=(t,c='')=>{const e=$('#fb-state');e.textContent=t;e.className='fb-state '+c};
  function renderVehicles(){ $('#fb-vehicles').innerHTML=Object.entries(vehicles).map(([id,v])=>'<button class="fb-vehicle '+(id===selected?'active':'')+'" data-v="'+id+'"><strong>'+v.name+' · '+v.plate+'</strong><small>'+v.model+'</small></button>').join(''); document.querySelectorAll('[data-v]').forEach(b=>b.onclick=()=>{selected=b.dataset.v;render()}); }
  function render(){renderVehicles();const odo=odometers[selected];$('#fb-odo').value=odo??'';$('#fb-odo-state').textContent=odo===undefined?'Noch nicht erfasst':Number(odo).toLocaleString('de-DE')+' km';const rows=trips.filter(t=>t.vehicle===selected);const km=rows.reduce((n,t)=>n+Number(t.km||0),0);const biz=rows.filter(t=>t.type==='Geschäftlich').reduce((n,t)=>n+Number(t.km||0),0);const priv=rows.filter(t=>t.type==='Privat').reduce((n,t)=>n+Number(t.km||0),0);$('#fb-km').textContent=km.toLocaleString('de-DE',{maximumFractionDigits:1})+' km';$('#fb-count').textContent=rows.length;$('#fb-biz').textContent=biz.toLocaleString('de-DE',{maximumFractionDigits:1})+' km';$('#fb-priv').textContent=priv.toLocaleString('de-DE',{maximumFractionDigits:1})+' km';$('#fb-vehicle-label').textContent=vehicles[selected].name+' · '+vehicles[selected].plate;$('#fb-rows').innerHTML=rows.length?rows.map(t=>'<tr><td>'+esc(new Date(t.date+'T12:00:00').toLocaleDateString('de-DE'))+'</td><td>'+esc(t.route)+'</td><td>'+String(t.km).replace('.',',')+'</td><td>'+((t.odoStart??'–')+' → '+(t.odoEnd??'–')).replace('.',',')+'</td><td><span class="fb-pill '+(t.type==='Privat'?'private':'')+'">'+esc(t.type)+'</span></td><td>'+esc(t.reason||'')+'</td></tr>').join(''):'<tr><td colspan="5">Für dieses Fahrzeug sind noch keine Fahrten gespeichert.</td></tr>';renderEvents();}
  function renderEvents(){if(!events.length){$('#fb-events').textContent='Noch keine Outlook-Termine geladen.';return}$('#fb-events').innerHTML=events.map((e,i)=>'<div class="fb-event"><strong>'+esc(e.subject)+'</strong><small>'+esc(e.date)+' · '+esc(e.location||'Ort nicht angegeben')+'</small><button class="fb-btn small" data-add="'+i+'">Als Fahrt übernehmen</button></div>').join('');document.querySelectorAll('[data-add]').forEach(b=>b.onclick=()=>{const e=events[Number(b.dataset.add)];const type=/urlaub|ferien/i.test(e.subject+' '+e.location)?'Privat':null;if(!type){const answer=window.prompt('Privat oder Geschäftlich?', 'Geschäftlich');if(answer!=='Privat'&&answer!=='Geschäftlich')return;const start=Number(odometers[selected]||0); const end=start; trips.unshift({id:'event-'+Date.now(),vehicle:selected,date:e.date.slice(0,10),route:(home+' → '+(e.location||e.subject)),km:0,odoStart:start||null,odoEnd:end||null,type:answer,reason:e.subject});}else trips.unshift({id:'event-'+Date.now(),vehicle:selected,date:e.date.slice(0,10),route:(home+' → '+(e.location||e.subject)),km:0,type:'Privat',reason:e.subject});save();render();setState('Termin übernommen. Bitte km ergänzen oder freie Fahrt bearbeiten.','ok');});}
  async function loadOutlook(){const year=$('#fb-year').value,month=$('#fb-month').value,start=year+'-'+month+'-01';setState('Outlook wird über das SV-Portal abgefragt …');const begin=new Date(start+'T12:00:00');const end=new Date();const all=[];for(let d=new Date(begin);d<end;d.setDate(d.getDate()+7)){const response=await fetch('/intern/api/outlook-case-calendar.php?action=list&start='+encodeURIComponent(d.toISOString().slice(0,10)),{credentials:'same-origin'});const data=await response.json().catch(()=>({}));if(!response.ok||!data.ok)throw new Error(data.error||'Outlook-Kalender konnte nicht geladen werden.');for(const event of(data.events||[])){const id=event.id||event.subject+'|'+event.start;if(!all.some(x=>x.id===id))all.push({id,subject:event.subject||'(Ohne Titel)',location:event.location||'',date:(event.start||'').slice(0,10)});}}events=all;renderEvents();setState(all.length+' Outlook-Termine geladen.','ok');}
  $('#fb-odo-save').onclick=()=>{const value=Number($('#fb-odo').value);if(!Number.isFinite(value)||value<0){setState('Bitte einen gültigen km-Stand eingeben.','bad');return}odometers[selected]=Math.round(value);localStorage.setItem('svnet-fahrtenbuch-odometers',JSON.stringify(odometers));$('#fb-odo-state').textContent=Math.round(value).toLocaleString('de-DE')+' km';setState('km-Stand gespeichert.','ok')}; $('#fb-outlook').onclick=()=>$('#fb-outlook-modal').hidden=false; $('#fb-free').onclick=()=>$('#fb-free-modal').hidden=false; $('#fb-home').onclick=()=>{$('#fb-home-input').value=home;$('#fb-home-modal').hidden=false}; document.querySelectorAll('[data-close]').forEach(b=>b.onclick=()=>$('#'+b.dataset.close).hidden=true); $('#fb-load').onclick=async()=>{try{$('#fb-outlook-modal').hidden=true;await loadOutlook()}catch(e){setState(e.message||'Outlook konnte nicht geladen werden.','bad')}}; $('#fb-home-form').onsubmit=e=>{e.preventDefault();home=$('#fb-home-input').value.trim();localStorage.setItem(homeKey,home);$('#fb-home-modal').hidden=true;setState('Heimatadresse gespeichert.','ok')}; $('#fb-form').onsubmit=e=>{e.preventDefault();const f=new FormData(e.target);const km=Number(f.get('km')||0); const odoStart=Number(odometers[selected]||0)||null; const odoEnd=odoStart===null?null:odoStart+km; trips.unshift({id:'manual-'+Date.now(),vehicle:selected,date:f.get('date'),route:f.get('route'),km,odoStart,odoEnd,type:f.get('type'),reason:f.get('reason')||''}); if(odoEnd!==null){odometers[selected]=odoEnd;localStorage.setItem('svnet-fahrtenbuch-odometers',JSON.stringify(odometers));}save();$('#fb-free-modal').hidden=true;e.target.reset();render();setState('Freie Fahrt gespeichert.','ok')}; render();
})();
</script>
