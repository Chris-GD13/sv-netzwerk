---
import InternalLayout from '../../../layouts/InternalLayout.astro';
---

<InternalLayout title="Fahrtenbuch" description="Mobiles Fahrtenbuch für Womo und GLE/VLE." currentPath="/intern/fahrtenbuch/">
  <section class="fb-shell">
    <div class="fb-card">
      <p class="fb-kicker">SV-Netzwerk</p>
      <h1>Fahrtenbuch</h1>
      <p class="fb-subtitle">Womo GD-SC 137 · GLE / VLE GD-CW 137E</p>
      <p class="fb-copy">Das Fahrtenbuch ist bereit. Öffne es jetzt direkt und bediene es auf dem iPhone oder im Portal-Browser.</p>
      <a class="fb-open" href="https://fahrtenbuch-mb-portal.netzwerk-5149.chatgpt.site/">Fahrtenbuch öffnen</a>
      <p class="fb-note">Die Portal-Anmeldung ist für diesen Menüpunkt bereits erfolgt.</p>
    </div>
  </section>
</InternalLayout>

<style is:global>
  .fb-shell { min-height: calc(100vh - 112px); display: grid; place-items: center; padding: 22px; box-sizing: border-box; background: #f4f5f6; color: #17324a; }
  .fb-card { width: min(640px, 100%); padding: 32px; border: 1px solid #d5dde3; border-top: 5px solid #f59a23; border-radius: 8px; background: #fff; box-shadow: 0 8px 28px rgba(23,50,74,.1); }
  .fb-kicker { margin: 0; color: #f59a23; font-weight: 800; }
  .fb-card h1 { margin: 6px 0 4px; font-size: clamp(2rem, 5vw, 3rem); }
  .fb-subtitle { margin: 0 0 22px; color: #647789; font-weight: 700; }
  .fb-copy { margin: 0 0 22px; line-height: 1.55; }
  .fb-open { display: inline-flex; align-items: center; justify-content: center; min-height: 50px; padding: 0 20px; border-radius: 5px; background: #17324a; color: #fff; text-decoration: none; font-size: 1.05rem; font-weight: 800; }
  .fb-open:hover, .fb-open:focus-visible { background: #0d263c; }
  .fb-note { margin: 18px 0 0; color: #647789; font-size: .9rem; }
  @media (max-width: 680px) {
    .fb-shell { padding: 14px; }
    .fb-card { padding: 24px 20px; }
    .fb-open { width: 100%; }
  }
</style>
