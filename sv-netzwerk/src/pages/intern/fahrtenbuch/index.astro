---
import InternalLayout from '../../../layouts/InternalLayout.astro';
---

<InternalLayout title="Fahrtenbuch" description="Mobiles Fahrtenbuch für Womo und GLE/VLE." currentPath="/intern/fahrtenbuch/">
  <section class="fb-app">
    <header class="fb-head">
      <div><p class="fb-kicker">SV-Netzwerk · Outlook</p><h1>Fahrtenbuch</h1><p>Womo GD-SC 137 · GLE / VLE GD-CW 137E</p></div>
      <div class="fb-actions"><button id="fb-outlook" class="fb-btn primary">Outlook-Kalender laden</button><button id="fb-free" class="fb-btn">+ Freie Fahrt</button></div>
    </header>
    <div id="fb-state" class="fb-state" role="status">Bereit. Fahrzeug wählen oder Outlook-Termine laden.</div>
    <div id="fb-vehicles" class="fb-vehicles"></div><div class="fb-odometer"><label>Aktueller km-Stand <input id="fb-odo" type="number" min="0" step="1" placeholder="noch nicht erfasst"></label><button id="fb-odo-save" class="fb-btn small">km-Stand speichern</button><span id="fb-odo-state">Noch nicht erfasst</span></div>
    <div class="fb-kpis"><div><span>Gefahrene Strecke</span><strong id="fb-km">0 km</strong></div><div><span>Fahrten</span><strong id="fb-count">0</strong></div><div><span>Geschäftlich</span><strong id="fb-biz">0 km</strong></div><div><span>Privat</span><strong id="fb-priv">0 km</strong></div></div>
    <div class="fb-grid">
      <section class="fb-card"><div class="fb-title"><h2>Fahrten</h2><span id="fb-vehicle-label"></span></div><div class="fb-table-wrap"><table><thead><tr><th>Datum</th><th>Start / Ziel</th><th>km</th><th>Odometer</th><th>Typ</th><th>Anlass</th></tr></thead><tbody id="fb-rows"></tbody></table></div></section>
      <section class="fb-card"><div class="fb-title"><h2>Outlook-Termine</h2><div><button id="fb-import-all" class="fb-btn small">Alle mit Adresse übernehmen</button><button id="fb-home" class="fb-btn small">Heimatadresse</button></div></div><div id="fb-events" class="fb-events">Noch keine Termine geladen.</div></section>
    </div>
  </section>

  <div id="fb-outlook-modal" class="fb-modal" hidden><div class="fb-sheet"><button class="fb-close" data-close="fb-outlook-modal">×</button><h2>Outlook-Kalender abfragen</h2><p class="fb-note">Alle Termine werden ab dem gewählten Monat bis heute über das angemeldete SV-Portal geladen.</p><div class="fb-form"><label>Von Monat<select id="fb-month"><option value="01">Januar</option><option value="02">Februar</option><option value="03">März</option><option value="04">April</option><option value="05">Mai</option><option value="06">Juni</option><option value="07">Juli</option><option value="08">August</option><option value="09">September</option><option value="10">Oktober</option><option value="11">November</option><option value="12">Dezember</option></select></label><label>Jahr<input id="fb-year" type="number" value="2026"></label><button id="fb-load" class="fb-btn primary">Termine laden</button></div></div></div>
  <div id="fb-free-modal" class="fb-modal" hidden><div class="fb-sheet"><button class="fb-close" data-close="fb-free-modal">×</button><h2>Freie Fahrt</h2><form id="fb-form" class="fb-form"><label>Datum<input name="date" type="date" required></label><label>Typ<select name="type"><option>Geschäftlich</option><option>Privat</option></select></label><label class="wide">Start / Ziel<input name="route" placeholder="z. B. Aalen → Stuttgart" required></label><label>km<input name="km" type="number" min="0" step="0.1" required></label><label>Anlass<input name="reason" placeholder="z. B. Ortstermin"></label><button class="fb-btn primary wide" type="submit">Fahrt speichern</button></form></div></div>
  <div id="fb-home-modal" class="fb-modal" hidden><div class="fb-sheet"><button class="fb-close" data-close="fb-home-modal">×</button><h2>Heimatadresse</h2><form id="fb-home-form" class="fb-form"><label class="wide">Adresse<input id="fb-home-input" value="Nordstraße 15, 73432 Aalen" required></label><button class="fb-btn primary wide" type="submit">Speichern</button></form></div></div>
</InternalLayout>

<style is:global>
.fb-app{padding:24px;min-height:calc(100vh - 112px);box-sizing:border-box;background:#f4f5f6;color:#17324a}.fb-head{display:flex;justify-content:space-between;align-items:flex-end;gap:18px;margin-bottom:14px}.fb-kicker{margin:0;color:#f59a23;font-weight:800}.fb-head h1{margin:4px 0}.fb-head p:last-child{margin:0;color:#647789}.fb-actions{display:flex;gap:8px;flex-wrap:wrap}.fb-btn{border:1px solid #bcc8d1;background:#fff;color:#17324a;border-radius:5px;padding:10px 13px;font-weight:800;cursor:pointer}.fb-btn.primary{background:#17324a;color:#fff;border-color:#17324a}.fb-btn.small{padding:7px 10px;font-size:.82rem}.fb-state{padding:12px 14px;margin-bottom:14px;border-left:4px solid #f59a23;background:#fff7e9}.fb-state.ok{background:#edf8f0;border-left-color:#34834b}.fb-state.bad{background:#fff0f0;border-left-color:#b33131}.fb-vehicles{display:flex;gap:10px;flex-wrap:wrap;margin-bottom:14px}.fb-vehicle{flex:1 1 240px;text-align:left;padding:13px;border:1px solid #d5dde3;border-radius:6px;background:#fff;color:#17324a;cursor:pointer}.fb-vehicle.active{border-color:#f59a23;box-shadow:inset 4px 0 #f59a23}.fb-vehicle strong,.fb-vehicle small{display:block}.fb-vehicle small{margin-top:4px;color:#647789}.fb-odometer{display:flex;align-items:end;gap:10px;flex-wrap:wrap;margin:0 0 14px;padding:12px;background:#fff;border:1px solid #d5dde3;border-radius:6px}.fb-odometer label{display:grid;gap:5px;color:#647789;font-size:.82rem}.fb-odometer input{padding:9px;border:1px solid #cbd5df;border-radius:5px;font:inherit;width:180px}.fb-odometer span{color:#647789;font-size:.82rem;padding-bottom:9px}.fb-kpis{display:grid;grid-template-columns:repeat(4,1fr);gap:10px;margin-bottom:14px}.fb-kpis>div,.fb-card{background:#fff;border:1px solid #d5dde3;border-radius:6px}.fb-kpis>div{padding:13px}.fb-kpis span{display:block;color:#647789;font-size:.82rem}.fb-kpis strong{display:block;margin-top:4px;font-size:1.35rem}.fb-grid{display:grid;grid-template-columns:1.15fr .85fr;gap:14px}.fb-card{padding:14px}.fb-title{display:flex;justify-content:space-between;align-items:center;gap:8px}.fb-title h2{margin:0;font-size:1.1rem}.fb-table-wrap{overflow:auto;margin-top:10px}.fb-card table{width:100%;border-collapse:collapse;min-width:620px}.fb-card th,.fb-card td{padding:9px;border-bottom:1px solid #e1e6ea;text-align:left;font-size:.86rem}.fb-card th{color:#647789;background:#f8fafb}.fb-pill{display:inline-block;padding:3px 8px;border-radius:99px;background:#e8f7f1;color:#26744e;font-size:.76rem}.fb-pill.private{background:#f0eefb;color:#5a4b9a}.fb-events{display:grid;gap:9px;margin-top:10px}.fb-event{padding:11px;border:1px solid #d5dde3;border-radius:5px}.fb-event strong,.fb-event small{display:block}.fb-event small{margin-top:4px;color:#647789}.fb-event .fb-btn{margin-top:8px}.fb-modal{position:fixed;inset:0;z-index:1000;display:grid;place-items:end center;padding:18px;background:rgba(7,26,46,.52)}.fb-modal[hidden]{display:none}.fb-sheet{width:min(720px,100%);max-height:88vh;overflow:auto;padding:20px;border-radius:10px 10px 0 0;background:#fff}.fb-close{float:right;border:0;border-radius:50%;width:32px;height:32px;background:#eef1f4;font-size:1.3rem;cursor:pointer}.fb-note{padding:11px;background:#f4f7fb;border-left:4px solid #3154db}.fb-form{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px;margin-top:14px}.fb-form label{display:grid;gap:5px;color:#647789;font-size:.82rem}.fb-form input,.fb-form select{padding:10px;border:1px solid #cbd5df;border-radius:5px;font:inherit;color:#17324a}.fb-form .wide{grid-column:1/-1}@media(max-width:760px){.fb-app{padding:14px}.fb-head{align-items:stretch;flex-direction:column}.fb-actions .fb-btn{flex:1}.fb-kpis{grid-template-columns:repeat(2,1fr)}.fb-grid{grid-template-columns:1fr}.fb-form{grid-template-columns:1fr}.fb-form .wide{grid-column:auto}}
</style>

<script is:inline>
(() => {
  const key='svnet-fahrtenbuch-v2'; const homeKey='svnet-fahrtenbuch-home'; let selected='womo'; let events=[]; let odometers=JSON.parse(localStorage.getItem('svnet-fahrtenbuch-odometers')||'{"womo":34726.8}' ); let home=localStorage.getItem(homeKey)||'Nordstraße 15, 73432 Aalen';
  const vehicles={womo:{name:'Womo',plate:'GD-SC 137',model:'Sprinter 417 CDI Standard'},gle:{name:'GLE / VLE',plate:'GD-CW 137E',model:'Mercedes-Benz GLE / VLE'}};
  const seed=[{"id":"mercedes-1","vehicle":"womo","date":"2026-09-14","route":"Privatfahrt","km":0.1,"odoStart":31503.4,"odoEnd":31503.5,"type":"Privat","reason":"Privat"},{"id":"mercedes-2","vehicle":"womo","date":"2026-09-15","route":"Nordstraße 15, 73432 Ebnat → Neresheimer Straße 32, 73450 Elchingen","km":6.5,"odoStart":31503.5,"odoEnd":31510,"type":"Geschäftlich","reason":"Rückfahrt Tanken"},{"id":"mercedes-3","vehicle":"womo","date":"2026-09-15","route":"Neresheimer Straße 32, 73450 Elchingen → Nordstraße 19, 73432 Ebnat","km":6.3,"odoStart":31510,"odoEnd":31516.3,"type":"Geschäftlich","reason":"Tanken"},{"id":"mercedes-4","vehicle":"womo","date":"2026-09-15","route":"Privatfahrt","km":406.7,"odoStart":31516.3,"odoEnd":31923,"type":"Privat","reason":"Privat"},{"id":"mercedes-5","vehicle":"womo","date":"2026-09-16","route":"Privatfahrt","km":381.8,"odoStart":31923,"odoEnd":32304.8,"type":"Privat","reason":"Privat"},{"id":"mercedes-6","vehicle":"womo","date":"2026-09-18","route":"Privatfahrt","km":61,"odoStart":32304.8,"odoEnd":32365.8,"type":"Privat","reason":"Privat"},{"id":"mercedes-7","vehicle":"womo","date":"2026-09-19","route":"Privatfahrt","km":338.1,"odoStart":32365.8,"odoEnd":32703.9,"type":"Privat","reason":"Privat"},{"id":"mercedes-8","vehicle":"womo","date":"2026-09-19","route":"Privatfahrt","km":2.3,"odoStart":32703.9,"odoEnd":32706.2,"type":"Privat","reason":"Privat"},{"id":"mercedes-9","vehicle":"womo","date":"2026-09-20","route":"Privatfahrt","km":4.5,"odoStart":32706.2,"odoEnd":32710.7,"type":"Privat","reason":"Privat"},{"id":"mercedes-10","vehicle":"womo","date":"2026-09-22","route":"Privatfahrt","km":3.5,"odoStart":32710.7,"odoEnd":32714.2,"type":"Privat","reason":"Privat"},{"id":"mercedes-11","vehicle":"womo","date":"2026-09-22","route":"Privatfahrt","km":0.2,"odoStart":32714.2,"odoEnd":32714.4,"type":"Privat","reason":"Privat"},{"id":"mercedes-12","vehicle":"womo","date":"2026-09-22","route":"Privatfahrt","km":3,"odoStart":32714.4,"odoEnd":32717.4,"type":"Privat","reason":"Privat"},{"id":"mercedes-13","vehicle":"womo","date":"2026-09-22","route":"Privatfahrt","km":3.1,"odoStart":32717.4,"odoEnd":32720.5,"type":"Privat","reason":"Privat"},{"id":"mercedes-14","vehicle":"womo","date":"2026-09-24","route":"Privatfahrt","km":3,"odoStart":32720.5,"odoEnd":32723.5,"type":"Privat","reason":"Privat"},{"id":"mercedes-15","vehicle":"womo","date":"2026-09-24","route":"Privatfahrt","km":3,"odoStart":32723.5,"odoEnd":32726.5,"type":"Privat","reason":"Privat"},{"id":"mercedes-16","vehicle":"womo","date":"2026-09-24","route":"Privatfahrt","km":0.2,"odoStart":32726.5,"odoEnd":32726.7,"type":"Privat","reason":"Privat"},{"id":"mercedes-17","vehicle":"womo","date":"2026-09-28","route":"Privatfahrt","km":0.1,"odoStart":32726.7,"odoEnd":32726.8,"type":"Privat","reason":"Privat"},{"id":"mercedes-18","vehicle":"womo","date":"2026-09-28","route":"Privatfahrt","km":11.2,"odoStart":32726.8,"odoEnd":32738,"type":"Privat","reason":"Privat"},{"id":"mercedes-19","vehicle":"womo","date":"2026-09-28","route":"Privatfahrt","km":10.8,"odoStart":32738,"odoEnd":32748.8,"type":"Privat","reason":"Privat"},{"id":"mercedes-20","vehicle":"womo","date":"2026-09-28","route":"Privatfahrt","km":166.8,"odoStart":32748.8,"odoEnd":32915.6,"type":"Privat","reason":"Privat"},{"id":"mercedes-21","vehicle":"womo","date":"2026-09-28","route":"Privatfahrt","km":97.1,"odoStart":32915.6,"odoEnd":33012.7,"type":"Privat","reason":"Privat"},{"id":"mercedes-22","vehicle":"womo","date":"2026-09-28","route":"Privatfahrt","km":20.2,"odoStart":33012.7,"odoEnd":33032.9,"type":"Privat","reason":"Privat"},{"id":"mercedes-23","vehicle":"womo","date":"2026-09-30","route":"Privatfahrt","km":286.9,"odoStart":33032.9,"odoEnd":33319.8,"type":"Privat","reason":"Privat"},{"id":"mercedes-24","vehicle":"womo","date":"2026-10-06","route":"Privatfahrt","km":0.1,"odoStart":33319.8,"odoEnd":33319.9,"type":"Privat","reason":"Privat"},{"id":"mercedes-25","vehicle":"womo","date":"2026-10-01","route":"Teichweg 1, 8734 Lobmingtal → Obdacher Straße, 8753 Zeltweg","km":13.9,"odoStart":33319.9,"odoEnd":33333.8,"type":"Geschäftlich","reason":"Kundenbesuche"},{"id":"mercedes-26","vehicle":"womo","date":"2026-10-06","route":"Obdacher Straße, 8753 Zeltweg → B 12, 84375 Kirchdorf am Inn","km":269,"odoStart":33333.8,"odoEnd":33602.8,"type":"Geschäftlich","reason":"Kundenbesuche"},{"id":"mercedes-27","vehicle":"womo","date":"2026-10-06","route":"B 12, 84375 Kirchdorf am Inn → Nordstraße 17, 73432 Ebnat","km":276,"odoStart":33602.8,"odoEnd":33878.8,"type":"Geschäftlich","reason":"Kundenbesuche"},{"id":"mercedes-28","vehicle":"womo","date":"2026-10-04","route":"Nordstraße 17, 73432 Ebnat → Nordstraße 17, 73432 Ebnat","km":0.1,"odoStart":33878.8,"odoEnd":33878.9,"type":"Geschäftlich","reason":"Tanken"},{"id":"mercedes-29","vehicle":"womo","date":"2026-10-05","route":"Nordstraße 15, 73432 Ebnat → Nordstraße 17, 73432 Ebnat","km":0.1,"odoStart":33878.9,"odoEnd":33879,"type":"Privat","reason":"Arbeitsweg im Export – als Privat übernommen"},{"id":"mercedes-30","vehicle":"womo","date":"2026-10-30","route":"Nordstraße 15, 73432 Ebnat → Am Campingplatz 1, 56338 Braubach","km":847.8,"odoStart":33879,"odoEnd":34726.8,"type":"Geschäftlich","reason":"Jahrestreffen"}];
  let trips=JSON.parse(localStorage.getItem(key)||'null'); if(!Array.isArray(trips)) trips=seed;
  const $=s=>document.querySelector(s); const esc=v=>String(v??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
  let remoteReady=false; const save=()=>{localStorage.setItem(key,JSON.stringify(trips));if(remoteReady)fetch('/intern/api/fahrtenbuch.php',{method:'POST',credentials:'same-origin',headers:{'Content-Type':'application/json'},body:JSON.stringify({data:{trips,odometers,home}})}).catch(()=>{});}; const loadRemote=async()=>{try{const response=await fetch('/intern/api/fahrtenbuch.php',{credentials:'same-origin'});const payload=await response.json();if(payload.ok&&payload.data){if(Array.isArray(payload.data.trips)){const merged=new Map();[...payload.data.trips,...trips].forEach(trip=>{const id=trip.sourceKey||trip.id;if(id)merged.set(id,trip);});trips=[...merged.values()];}if(payload.data.odometers&&typeof payload.data.odometers==='object'){const mergedOdo={...payload.data.odometers};Object.entries(odometers).forEach(([vehicle,value])=>{mergedOdo[vehicle]=Math.max(Number(mergedOdo[vehicle]||0),Number(value||0));});odometers=mergedOdo;}if(typeof payload.data.home==='string'&&payload.data.home.trim())home=payload.data.home;localStorage.setItem(key,JSON.stringify(trips));localStorage.setItem('svnet-fahrtenbuch-odometers',JSON.stringify(odometers));localStorage.setItem(homeKey,home);}remoteReady=true;save();}catch(_){remoteReady=true;}}; const setState=(t,c='')=>{const e=$('#fb-state');e.textContent=t;e.className='fb-state '+c};
  function renderVehicles(){ $('#fb-vehicles').innerHTML=Object.entries(vehicles).map(([id,v])=>'<button class="fb-vehicle '+(id===selected?'active':'')+'" data-v="'+id+'"><strong>'+v.name+' · '+v.plate+'</strong><small>'+v.model+'</small></button>').join(''); document.querySelectorAll('[data-v]').forEach(b=>b.onclick=()=>{selected=b.dataset.v;render()}); }
  function render(){renderVehicles();const odo=odometers[selected];$('#fb-odo').value=odo??'';$('#fb-odo-state').textContent=odo===undefined?'Noch nicht erfasst':Number(odo).toLocaleString('de-DE')+' km';const rows=trips.filter(t=>t.vehicle===selected);const km=rows.reduce((n,t)=>n+Number(t.km||0),0);const biz=rows.filter(t=>t.type==='Geschäftlich').reduce((n,t)=>n+Number(t.km||0),0);const priv=rows.filter(t=>t.type==='Privat').reduce((n,t)=>n+Number(t.km||0),0);$('#fb-km').textContent=km.toLocaleString('de-DE',{maximumFractionDigits:1})+' km';$('#fb-count').textContent=rows.length;$('#fb-biz').textContent=biz.toLocaleString('de-DE',{maximumFractionDigits:1})+' km';$('#fb-priv').textContent=priv.toLocaleString('de-DE',{maximumFractionDigits:1})+' km';$('#fb-vehicle-label').textContent=vehicles[selected].name+' · '+vehicles[selected].plate;$('#fb-rows').innerHTML=rows.length?rows.map(t=>'<tr><td>'+esc(new Date(t.date+'T12:00:00').toLocaleDateString('de-DE'))+'</td><td>'+esc(t.route)+'</td><td>'+String(t.km).replace('.',',')+'</td><td>'+((t.odoStart??'–')+' → '+(t.odoEnd??'–')).replace('.',',')+'</td><td><span class="fb-pill '+(t.type==='Privat'?'private':'')+'">'+esc(t.type)+'</span></td><td>'+esc(t.reason||'')+'</td></tr>').join(''):'<tr><td colspan="5">Für dieses Fahrzeug sind noch keine Fahrten gespeichert.</td></tr>';renderEvents();}
  const cleanAddress=value=>String(value||'').replace(/\s+/g,' ').trim();
  const hasAddress=e=>{const a=cleanAddress(e.location);return a.length>=6&&(/[0-9]{2,}/.test(a)||a.includes(',')||/[A-Za-zÄÖÜäöüß]{3,}\s+[A-Za-zÄÖÜäöüß]{3,}/.test(a));};
  const geocodeCache=new Map();
  async function geocode(address){const a=cleanAddress(address);if(!a)return null;if(geocodeCache.has(a))return geocodeCache.get(a);const response=await fetch('https://nominatim.openstreetmap.org/search?format=jsonv2&limit=1&countrycodes=de,at,ch&q='+encodeURIComponent(a));const data=await response.json().catch(()=>[]);const point=data[0]?{lat:Number(data[0].lat),lon:Number(data[0].lon)}:null;geocodeCache.set(a,point);return point;}
  async function routeKm(points){if(points.length<2)return 0;const coords=points.map(p=>p.lon+','+p.lat).join(';');try{const response=await fetch('https://router.project-osrm.org/route/v1/driving/'+coords+'?overview=false&steps=false');const data=await response.json();if(data.code==='Ok'&&data.routes?.[0])return data.routes[0].distance/1000;}catch(_){ }let total=0;for(let i=1;i<points.length;i++){const p1=points[i-1],p2=points[i],rad=Math.PI/180,lat1=p1.lat*rad,lat2=p2.lat*rad,dl=(p2.lat-p1.lat)*rad,do_=(p2.lon-p1.lon)*rad;const a=Math.sin(dl/2)**2+Math.cos(lat1)*Math.cos(lat2)*Math.sin(do_/2)**2;total+=6371*2*Math.atan2(Math.sqrt(a),Math.sqrt(1-a))*1.2;}return total;}
  const groupByDay=list=>Object.values(list.reduce((groups,e)=>{(groups[e.date]??=[]).push(e);return groups;},{}));
  const importedKey=group=>selected+'|'+group.map(e=>e.id).sort().join(',');
  function renderEvents(){if(!events.length){$('#fb-events').textContent='Keine Outlook-Termine mit Adresse gefunden.';return}$('#fb-events').innerHTML=events.map((e,i)=>'<div class="fb-event"><strong>'+esc(e.subject)+'</strong><small>'+esc(e.date)+' · '+esc(e.location)+'</small></div>').join('');}
  async function importEventGroups(groups){const valid=groups.flat().filter(hasAddress);if(!valid.length){setState('Keine Termine mit Adresse übernommen.','bad');return}let added=0,skipped=0,discarded=groups.flat().length-valid.length;for(const group of groups){const usable=group.filter(hasAddress);if(!usable.length)continue;const sourceKey=importedKey(usable);if(trips.some(t=>t.sourceKey===sourceKey)){skipped++;continue}const ordered=usable.slice().sort((a,b)=>String(a.start||a.date).localeCompare(String(b.start||b.date)));const stops=[];for(const e of ordered){const a=cleanAddress(e.location);if(a&&!stops.includes(a))stops.push(a);}if(!stops.length)continue;const homePoint=await geocode(home);const stopPoints=[];for(const stop of stops){const point=await geocode(stop);if(point)stopPoints.push({address:stop,point});}if(!stopPoints.length){discarded+=usable.length;continue}const points=homePoint?[homePoint,...stopPoints.map(x=>x.point),homePoint]:stopPoints.map(x=>x.point);const km=Number((await routeKm(points)).toFixed(1));const route=[home,...stopPoints.map(x=>x.address),home].join(' → ');const vacation=ordered.some(e=>/urlaub|ferien/i.test((e.subject||'')+' '+(e.location||'')));let type=vacation?'Privat':null;if(!type){const answer=window.prompt('Termine am '+ordered[0].date+' als Privat oder Geschäftlich übernehmen?','Geschäftlich');if(answer!=='Privat'&&answer!=='Geschäftlich')continue;type=answer;}const odoStart=Number(odometers[selected]||0)||null;const odoEnd=odoStart===null?null:Number((odoStart+km).toFixed(1));trips.unshift({id:'outlook-'+Date.now()+'-'+added,sourceKey,sourceEventIds:ordered.map(e=>e.id),vehicle:selected,date:ordered[0].date,route,km,odoStart,odoEnd,type,reason:ordered.map(e=>e.subject).join(' · ')});if(odoEnd!==null){odometers[selected]=odoEnd;localStorage.setItem('svnet-fahrtenbuch-odometers',JSON.stringify(odometers));}added++;}save();render();setState(added+' Tagesfahrten übernommen'+(discarded?' · '+discarded+' Termine ohne Adresse gelöscht':'')+(skipped?' · '+skipped+' bereits vorhanden übersprungen':'' )+'.','ok');}
  async function loadOutlook(){const year=$('#fb-year').value,month=$('#fb-month').value,start=year+'-'+month+'-01';setState('Outlook wird über das SV-Portal abgefragt …');const begin=new Date(start+'T12:00:00');const end=new Date();const all=[];for(let d=new Date(begin);d<end;d.setDate(d.getDate()+7)){const response=await fetch('/intern/api/outlook-case-calendar.php?action=list&start='+encodeURIComponent(d.toISOString().slice(0,10)),{credentials:'same-origin'});const data=await response.json().catch(()=>({}));if(!response.ok||!data.ok)throw new Error(data.error||'Outlook-Kalender konnte nicht geladen werden.');for(const event of(data.events||[])){const id=event.id||event.subject+'|'+event.start;if(!all.some(x=>x.id===id))all.push({id,subject:event.subject||'(Ohne Titel)',location:cleanAddress(event.location),date:(event.start||'').slice(0,10),start:event.start||''});}}events=all.filter(hasAddress);const removed=all.length-events.length;renderEvents();setState(events.length+' Termine mit Adresse geladen'+(removed?' · '+removed+' ohne Adresse verworfen':'')+'.','ok');}

  $('#fb-import-all').onclick=async()=>{try{setState('Tagesfahrten werden berechnet …');await importEventGroups(groupByDay(events));}catch(e){setState(e.message||'Import konnte nicht abgeschlossen werden.','bad')}}; $('#fb-odo-save').onclick=()=>{const value=Number($('#fb-odo').value);if(!Number.isFinite(value)||value<0){setState('Bitte einen gültigen km-Stand eingeben.','bad');return}odometers[selected]=Math.round(value);localStorage.setItem('svnet-fahrtenbuch-odometers',JSON.stringify(odometers));$('#fb-odo-state').textContent=Math.round(value).toLocaleString('de-DE')+' km';setState('km-Stand gespeichert.','ok')}; $('#fb-outlook').onclick=()=>$('#fb-outlook-modal').hidden=false; $('#fb-free').onclick=()=>$('#fb-free-modal').hidden=false; $('#fb-home').onclick=()=>{$('#fb-home-input').value=home;$('#fb-home-modal').hidden=false}; document.querySelectorAll('[data-close]').forEach(b=>b.onclick=()=>$('#'+b.dataset.close).hidden=true); $('#fb-load').onclick=async()=>{try{$('#fb-outlook-modal').hidden=true;await loadOutlook()}catch(e){setState(e.message||'Outlook konnte nicht geladen werden.','bad')}}; $('#fb-home-form').onsubmit=e=>{e.preventDefault();home=$('#fb-home-input').value.trim();localStorage.setItem(homeKey,home);$('#fb-home-modal').hidden=true;setState('Heimatadresse gespeichert.','ok')}; $('#fb-form').onsubmit=e=>{e.preventDefault();const f=new FormData(e.target);const km=Number(f.get('km')||0); const odoStart=Number(odometers[selected]||0)||null; const odoEnd=odoStart===null?null:odoStart+km; trips.unshift({id:'manual-'+Date.now(),vehicle:selected,date:f.get('date'),route:f.get('route'),km,odoStart,odoEnd,type:f.get('type'),reason:f.get('reason')||''}); if(odoEnd!==null){odometers[selected]=odoEnd;localStorage.setItem('svnet-fahrtenbuch-odometers',JSON.stringify(odometers));}save();$('#fb-free-modal').hidden=true;e.target.reset();render();setState('Freie Fahrt gespeichert.','ok')}; render(); loadRemote().then(render);
})();
</script>
