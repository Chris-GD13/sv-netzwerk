---
import InternalLayout from '../../../layouts/InternalLayout.astro';
---

<InternalLayout title="Fahrtenbuch" description="Mobiles Fahrtenbuch für Womo und GLE/VLE." currentPath="/intern/fahrtenbuch/">
  <section class="fb-app">
    <header class="fb-head">
      <div><p class="fb-kicker">SV-Netzwerk · Outlook</p><h1>Fahrtenbuch</h1><p>Womo GD-SC 137 · GLE / VLE GD-CW 137E</p></div>
      <div class="fb-actions"><button id="fb-outlook" class="fb-btn primary">Outlook-Kalender laden</button><button id="fb-free" class="fb-btn">+ Freie Fahrt</button></div>
    </header>
    <div id="fb-state" class="fb-state" role="status">Bereit. Fahrzeug wählen oder Outlook-Termine laden.</div>
    <div id="fb-vehicles" class="fb-vehicles"></div><div class="fb-odometer"><label>Aktueller km-Stand <input id="fb-odo" type="number" min="0" step="1" placeholder="noch nicht erfasst"></label><button id="fb-odo-save" class="fb-btn small">km-Stand speichern</button><span id="fb-odo-state">Noch nicht erfasst</span></div>
    <div class="fb-kpis"><div><span>Gefahrene Strecke</span><strong id="fb-km">0 km</strong></div><div><span>Fahrten</span><strong id="fb-count">0</strong></div><div><span>Geschäftlich</span><strong id="fb-biz">0 km</strong></div><div><span>Privat</span><strong id="fb-priv">0 km</strong></div></div>
    <div class="fb-grid">
      <section class="fb-card"><div class="fb-title"><h2>Fahrten</h2><div class="fb-title-tools"><select id="fb-year-filter" class="fb-year-filter"><option value="all">Alle Jahre</option></select><button id="fb-export-pdf" class="fb-btn small">PDF exportieren</button><span id="fb-vehicle-label"></span></div></div><div class="fb-table-wrap"><table><thead><tr><th>Datum</th><th>Start / Ziel</th><th>km</th><th>Odometer</th><th>Typ</th><th>Anlass</th></tr></thead><tbody id="fb-rows"></tbody></table></div></section>
      <section class="fb-card"><div class="fb-title"><h2>Outlook-Termine</h2><div><button id="fb-import-all" type="button" class="fb-btn small">Alle mit Adresse übernehmen</button><button id="fb-home" class="fb-btn small">Heimatadresse</button></div></div><div id="fb-events" class="fb-events">Noch keine Termine geladen.</div></section>
    </div>
  </section>

  <div id="fb-outlook-modal" class="fb-modal" hidden><div class="fb-sheet"><button class="fb-close" data-close="fb-outlook-modal">×</button><h2>Outlook-Kalender abfragen</h2><p class="fb-note">Alle Termine werden ab dem gewählten Monat bis heute über das angemeldete SV-Portal geladen.</p><div class="fb-form"><label>Von Monat<select id="fb-month"><option value="01">Januar</option><option value="02">Februar</option><option value="03">März</option><option value="04">April</option><option value="05">Mai</option><option value="06">Juni</option><option value="07">Juli</option><option value="08">August</option><option value="09">September</option><option value="10">Oktober</option><option value="11">November</option><option value="12">Dezember</option></select></label><label>Jahr<input id="fb-year" type="number" value="2026"></label><button id="fb-load" class="fb-btn primary">Termine laden</button></div></div></div>
  <div id="fb-free-modal" class="fb-modal" hidden><div class="fb-sheet"><button class="fb-close" data-close="fb-free-modal">×</button><h2>Freie Fahrt</h2><form id="fb-form" class="fb-form"><label>Datum<input name="date" type="date" required></label><label>Typ<select name="type"><option>Geschäftlich</option><option>Privat</option></select></label><label class="wide">Start / Ziel<input name="route" placeholder="z. B. Aalen → Stuttgart" required></label><label>km<input name="km" type="number" min="0" step="0.1" required></label><label>Anlass<input name="reason" placeholder="z. B. Ortstermin"></label><button class="fb-btn primary wide" type="submit">Fahrt speichern</button></form></div></div>
  <div id="fb-home-modal" class="fb-modal" hidden><div class="fb-sheet"><button class="fb-close" data-close="fb-home-modal">×</button><h2>Heimatadresse</h2><form id="fb-home-form" class="fb-form"><label class="wide">Adresse<input id="fb-home-input" value="Nordstraße 15, 73432 Aalen" required></label><button class="fb-btn primary wide" type="submit">Speichern</button></form></div></div>
</InternalLayout>

<style is:global>
.fb-app{padding:24px;min-height:calc(100vh - 112px);box-sizing:border-box;background:#f4f5f6;color:#17324a}.fb-head{display:flex;justify-content:space-between;align-items:flex-end;gap:18px;margin-bottom:14px}.fb-kicker{margin:0;color:#f59a23;font-weight:800}.fb-head h1{margin:4px 0}.fb-head p:last-child{margin:0;color:#647789}.fb-actions{display:flex;gap:8px;flex-wrap:wrap}.fb-btn{border:1px solid #bcc8d1;background:#fff;color:#17324a;border-radius:5px;padding:10px 13px;font-weight:800;cursor:pointer}.fb-btn.primary{background:#17324a;color:#fff;border-color:#17324a}.fb-btn.small{padding:7px 10px;font-size:.82rem}.fb-state{padding:12px 14px;margin-bottom:14px;border-left:4px solid #f59a23;background:#fff7e9}.fb-state.ok{background:#edf8f0;border-left-color:#34834b}.fb-state.bad{background:#fff0f0;border-left-color:#b33131}.fb-vehicles{display:flex;gap:10px;flex-wrap:wrap;margin-bottom:14px}.fb-vehicle{flex:1 1 240px;text-align:left;padding:13px;border:1px solid #d5dde3;border-radius:6px;background:#fff;color:#17324a;cursor:pointer}.fb-vehicle.active{border-color:#f59a23;box-shadow:inset 4px 0 #f59a23}.fb-vehicle strong,.fb-vehicle small{display:block}.fb-vehicle small{margin-top:4px;color:#647789}.fb-odometer{display:flex;align-items:end;gap:10px;flex-wrap:wrap;margin:0 0 14px;padding:12px;background:#fff;border:1px solid #d5dde3;border-radius:6px}.fb-odometer label{display:grid;gap:5px;color:#647789;font-size:.82rem}.fb-odometer input{padding:9px;border:1px solid #cbd5df;border-radius:5px;font:inherit;width:180px}.fb-odometer span{color:#647789;font-size:.82rem;padding-bottom:9px}.fb-kpis{display:grid;grid-template-columns:repeat(4,1fr);gap:10px;margin-bottom:14px}.fb-kpis>div,.fb-card{background:#fff;border:1px solid #d5dde3;border-radius:6px}.fb-kpis>div{padding:13px}.fb-kpis span{display:block;color:#647789;font-size:.82rem}.fb-kpis strong{display:block;margin-top:4px;font-size:1.35rem}.fb-grid{display:grid;grid-template-columns:1.15fr .85fr;gap:14px}.fb-card{padding:14px}.fb-title{display:flex;justify-content:space-between;align-items:center;gap:8px}.fb-title h2{margin:0;font-size:1.1rem}.fb-title-tools{display:flex;align-items:center;gap:8px;flex-wrap:wrap}.fb-year-filter{padding:7px 9px;border:1px solid #cbd5df;border-radius:5px;background:#fff;color:#17324a}.fb-table-wrap{overflow:auto;margin-top:10px}.fb-card table{width:100%;border-collapse:collapse;min-width:620px}.fb-card th,.fb-card td{padding:9px;border-bottom:1px solid #e1e6ea;text-align:left;font-size:.86rem}.fb-card th{color:#647789;background:#f8fafb}.fb-pill{display:inline-block;padding:3px 8px;border-radius:99px;background:#e8f7f1;color:#26744e;font-size:.76rem}.fb-pill.private{background:#f0eefb;color:#5a4b9a}.fb-events{display:grid;gap:9px;margin-top:10px}.fb-event{padding:11px;border:1px solid #d5dde3;border-radius:5px}.fb-event strong,.fb-event small{display:block}.fb-event small{margin-top:4px;color:#647789}.fb-event .fb-btn{margin-top:8px}.fb-modal{position:fixed;inset:0;z-index:1000;display:grid;place-items:end center;padding:18px;background:rgba(7,26,46,.52)}.fb-modal[hidden]{display:none}.fb-sheet{width:min(720px,100%);max-height:88vh;overflow:auto;padding:20px;border-radius:10px 10px 0 0;background:#fff}.fb-close{float:right;border:0;border-radius:50%;width:32px;height:32px;background:#eef1f4;font-size:1.3rem;cursor:pointer}.fb-note{padding:11px;background:#f4f7fb;border-left:4px solid #3154db}.fb-form{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px;margin-top:14px}.fb-form label{display:grid;gap:5px;color:#647789;font-size:.82rem}.fb-form input,.fb-form select{padding:10px;border:1px solid #cbd5df;border-radius:5px;font:inherit;color:#17324a}.fb-form .wide{grid-column:1/-1}@media(max-width:760px){.fb-app{padding:14px}.fb-head{align-items:stretch;flex-direction:column}.fb-actions .fb-btn{flex:1}.fb-kpis{grid-template-columns:repeat(2,1fr)}.fb-grid{grid-template-columns:1fr}.fb-form{grid-template-columns:1fr}.fb-form .wide{grid-column:auto}}
</style>

<script is:inline>
(() => {
  const key='svnet-fahrtenbuch-v2'; const homeKey='svnet-fahrtenbuch-home'; let selected='womo'; let events=[]; let odometers=JSON.parse(localStorage.getItem('svnet-fahrtenbuch-odometers')||'{"womo":34726.8}' ); let home=localStorage.getItem(homeKey)||'Nordstraße 15, 73432 Aalen';
  const vehicles={womo:{name:'Womo',plate:'GD-SC 137',model:'Sprinter 417 CDI Standard'},gle:{name:'GLE / VLE',plate:'GD-CW 137E',model:'Mercedes-Benz GLE / VLE'}};
  const seed=[{"id":"mercedes-1","vehicle":"womo","date":"2026-09-14","route":"Privatfahrt","km":0.1,"odoStart":31503.4,"odoEnd":31503.5,"type":"Privat","reason":"Privat"},{"id":"mercedes-2","vehicle":"womo","date":"2026-09-15","route":"Nordstraße 15, 73432 Ebnat → Neresheimer Straße 32, 73450 Elchingen","km":6.5,"odoStart":31503.5,"odoEnd":31510,"type":"Geschäftlich","reason":"Rückfahrt Tanken"},{"id":"mercedes-3","vehicle":"womo","date":"2026-09-15","route":"Neresheimer Straße 32, 73450 Elchingen → Nordstraße 19, 73432 Ebnat","km":6.3,"odoStart":31510,"odoEnd":31516.3,"type":"Geschäftlich","reason":"Tanken"},{"id":"mercedes-4","vehicle":"womo","date":"2026-09-15","route":"Privatfahrt","km":406.7,"odoStart":31516.3,"odoEnd":31923,"type":"Privat","reason":"Privat"},{"id":"mercedes-5","vehicle":"womo","date":"2026-09-16","route":"Privatfahrt","km":381.8,"odoStart":31923,"odoEnd":32304.8,"type":"Privat","reason":"Privat"},{"id":"mercedes-6","vehicle":"womo","date":"2026-09-18","route":"Privatfahrt","km":61,"odoStart":32304.8,"odoEnd":32365.8,"type":"Privat","reason":"Privat"},{"id":"mercedes-7","vehicle":"womo","date":"2026-09-19","route":"Privatfahrt","km":338.1,"odoStart":32365.8,"odoEnd":32703.9,"type":"Privat","reason":"Privat"},{"id":"mercedes-8","vehicle":"womo","date":"2026-09-19","route":"Privatfahrt","km":2.3,"odoStart":32703.9,"odoEnd":32706.2,"type":"Privat","reason":"Privat"},{"id":"mercedes-9","vehicle":"womo","date":"2026-09-20","route":"Privatfahrt","km":4.5,"odoStart":32706.2,"odoEnd":32710.7,"type":"Privat","reason":"Privat"},{"id":"mercedes-10","vehicle":"womo","date":"2026-09-22","route":"Privatfahrt","km":3.5,"odoStart":32710.7,"odoEnd":32714.2,"type":"Privat","reason":"Privat"},{"id":"mercedes-11","vehicle":"womo","date":"2026-09-22","route":"Privatfahrt","km":0.2,"odoStart":32714.2,"odoEnd":32714.4,"type":"Privat","reason":"Privat"},{"id":"mercedes-12","vehicle":"womo","date":"2026-09-22","route":"Privatfahrt","km":3,"odoStart":32714.4,"odoEnd":32717.4,"type":"Privat","reason":"Privat"},{"id":"mercedes-13","vehicle":"womo","date":"2026-09-22","route":"Privatfahrt","km":3.1,"odoStart":32717.4,"odoEnd":32720.5,"type":"Privat","reason":"Privat"},{"id":"mercedes-14","vehicle":"womo","date":"2026-09-24","route":"Privatfahrt","km":3,"odoStart":32720.5,"odoEnd":32723.5,"type":"Privat","reason":"Privat"},{"id":"mercedes-15","vehicle":"womo","date":"2026-09-24","route":"Privatfahrt","km":3,"odoStart":32723.5,"odoEnd":32726.5,"type":"Privat","reason":"Privat"},{"id":"mercedes-16","vehicle":"womo","date":"2026-09-24","route":"Privatfahrt","km":0.2,"odoStart":32726.5,"odoEnd":32726.7,"type":"Privat","reason":"Privat"},{"id":"mercedes-17","vehicle":"womo","date":"2026-09-28","route":"Privatfahrt","km":0.1,"odoStart":32726.7,"odoEnd":32726.8,"type":"Privat","reason":"Privat"},{"id":"mercedes-18","vehicle":"womo","date":"2026-09-28","route":"Privatfahrt","km":11.2,"odoStart":32726.8,"odoEnd":32738,"type":"Privat","reason":"Privat"},{"id":"mercedes-19","vehicle":"womo","date":"2026-09-28","route":"Privatfahrt","km":10.8,"odoStart":32738,"odoEnd":32748.8,"type":"Privat","reason":"Privat"},{"id":"mercedes-20","vehicle":"womo","date":"2026-09-28","route":"Privatfahrt","km":166.8,"odoStart":32748.8,"odoEnd":32915.6,"type":"Privat","reason":"Privat"},{"id":"mercedes-21","vehicle":"womo","date":"2026-09-28","route":"Privatfahrt","km":97.1,"odoStart":32915.6,"odoEnd":33012.7,"type":"Privat","reason":"Privat"},{"id":"mercedes-22","vehicle":"womo","date":"2026-09-28","route":"Privatfahrt","km":20.2,"odoStart":33012.7,"odoEnd":33032.9,"type":"Privat","reason":"Privat"},{"id":"mercedes-23","vehicle":"womo","date":"2026-09-30","route":"Privatfahrt","km":286.9,"odoStart":33032.9,"odoEnd":33319.8,"type":"Privat","reason":"Privat"},{"id":"mercedes-24","vehicle":"womo","date":"2026-10-06","route":"Privatfahrt","km":0.1,"odoStart":33319.8,"odoEnd":33319.9,"type":"Privat","reason":"Privat"},{"id":"mercedes-25","vehicle":"womo","date":"2026-10-01","route":"Teichweg 1, 8734 Lobmingtal → Obdacher Straße, 8753 Zeltweg","km":13.9,"odoStart":33319.9,"odoEnd":33333.8,"type":"Geschäftlich","reason":"Kundenbesuche"},{"id":"mercedes-26","vehicle":"womo","date":"2026-10-06","route":"Obdacher Straße, 8753 Zeltweg → B 12, 84375 Kirchdorf am Inn","km":269,"odoStart":33333.8,"odoEnd":33602.8,"type":"Geschäftlich","reason":"Kundenbesuche"},{"id":"mercedes-27","vehicle":"womo","date":"2026-10-06","route":"B 12, 84375 Kirchdorf am Inn → Nordstraße 17, 73432 Ebnat","km":276,"odoStart":33602.8,"odoEnd":33878.8,"type":"Geschäftlich","reason":"Kundenbesuche"},{"id":"mercedes-28","vehicle":"womo","date":"2026-10-04","route":"Nordstraße 17, 73432 Ebnat → Nordstraße 17, 73432 Ebnat","km":0.1,"odoStart":33878.8,"odoEnd":33878.9,"type":"Geschäftlich","reason":"Tanken"},{"id":"mercedes-29","vehicle":"womo","date":"2026-10-05","route":"Nordstraße 15, 73432 Ebnat → Nordstraße 17, 73432 Ebnat","km":0.1,"odoStart":33878.9,"odoEnd":33879,"type":"Privat","reason":"Arbeitsweg im Export – als Privat übernommen"},{"id":"mercedes-30","vehicle":"womo","date":"2026-10-30","route":"Nordstraße 15, 73432 Ebnat → Am Campingplatz 1, 56338 Braubach","km":847.8,"odoStart":33879,"odoEnd":34726.8,"type":"Geschäftlich","reason":"Jahrestreffen"}];
  let trips=JSON.parse(localStorage.getItem(key)||'null'); if(!Array.isArray(trips)) trips=seed;
  const $=s=>document.querySelector(s); const esc=v=>String(v??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
  let remoteReady=false; let saveQueue=Promise.resolve();
  const snapshot=()=>({trips,odometers,home});
  const save=()=>{
    localStorage.setItem(key,JSON.stringify(trips));
    localStorage.setItem('svnet-fahrtenbuch-odometers',JSON.stringify(odometers));
    localStorage.setItem(homeKey,home);
    if(!remoteReady)return Promise.resolve();
    saveQueue=saveQueue.then(async()=>{
      const response=await fetch('/intern/api/fahrtenbuch.php',{method:'POST',credentials:'same-origin',headers:{'Content-Type':'application/json'},body:JSON.stringify({data:snapshot()})});
      const payload=await response.json().catch(()=>({}));
      if(!response.ok||!payload.ok)throw new Error(payload.error||'Fahrtenbuch konnte nicht dauerhaft gespeichert werden.');
      return payload;
    });
    return saveQueue;
  };
  const loadRemote=async()=>{
    try{
      const response=await fetch('/intern/api/fahrtenbuch.php',{credentials:'same-origin'});
      const payload=await response.json();
      if(!response.ok||!payload.ok)throw new Error(payload.error||'Fahrtenbuch konnte nicht geladen werden.');
      if(payload.data){
        if(Array.isArray(payload.data.trips)){
          const merged=new Map();
          // Lokale Einträge bleiben erhalten, der dauerhaft gespeicherte Bestand gewinnt bei gleicher ID.
          [...trips,...payload.data.trips].forEach(trip=>{const id=trip.sourceKey||trip.id;if(id)merged.set(id,trip);});
          trips=[...merged.values()];
        }
        if(payload.data.odometers&&typeof payload.data.odometers==='object')odometers={...odometers,...payload.data.odometers};
        if(typeof payload.data.home==='string'&&payload.data.home.trim())home=payload.data.home;
      }
      remoteReady=true;
      await save();
      return true;
    }catch(error){
      remoteReady=false;
      setState(error.message||'Dauerhafte Speicherung derzeit nicht erreichbar. Die Daten bleiben lokal erhalten.','bad');
      return false;
    }
  };
  const setState=(t,c='')=>{const e=$('#fb-state');e.textContent=t;e.className='fb-state '+c};
  function renderVehicles(){ $('#fb-vehicles').innerHTML=Object.entries(vehicles).map(([id,v])=>'<button class="fb-vehicle '+(id===selected?'active':'')+'" data-v="'+id+'"><strong>'+v.name+' · '+v.plate+'</strong><small>'+v.model+'</small></button>').join(''); document.querySelectorAll('[data-v]').forEach(b=>b.onclick=()=>{selected=b.dataset.v;render()}); }
  const visibleRows=()=>{const year=$('#fb-year-filter')?.value||'all';return trips.filter(t=>t.vehicle===selected&&(year==='all'||String(t.date||'').slice(0,4)===year)).slice().sort((a,b)=>String(b.date||'').localeCompare(String(a.date||''))||String(b.start||'').localeCompare(String(a.start||''))||String(b.id||'').localeCompare(String(a.id||'')));};
  function populateYearFilter(){const select=$('#fb-year-filter');if(!select)return;const current=select.value||'all';const years=[...new Set(trips.filter(t=>t.vehicle===selected).map(t=>String(t.date||'').slice(0,4)).filter(Boolean))].sort((a,b)=>b.localeCompare(a));select.innerHTML='<option value="all">Alle Jahre</option>'+years.map(y=>'<option value="'+y+'">'+y+'</option>').join('');select.value=years.includes(current)?current:'all';}
  function render(){renderVehicles();populateYearFilter();const odo=odometers[selected];$('#fb-odo').value=odo??'';$('#fb-odo-state').textContent=odo===undefined?'Noch nicht erfasst':Number(odo).toLocaleString('de-DE')+' km';const rows=visibleRows();const km=rows.reduce((n,t)=>n+Number(t.km||0),0);const biz=rows.filter(t=>t.type==='Geschäftlich').reduce((n,t)=>n+Number(t.km||0),0);const priv=rows.filter(t=>t.type==='Privat').reduce((n,t)=>n+Number(t.km||0),0);$('#fb-km').textContent=km.toLocaleString('de-DE',{maximumFractionDigits:1})+' km';$('#fb-count').textContent=rows.length;$('#fb-biz').textContent=biz.toLocaleString('de-DE',{maximumFractionDigits:1})+' km';$('#fb-priv').textContent=priv.toLocaleString('de-DE',{maximumFractionDigits:1})+' km';$('#fb-vehicle-label').textContent=vehicles[selected].name+' · '+vehicles[selected].plate;$('#fb-rows').innerHTML=rows.length?rows.map(t=>'<tr><td>'+esc(new Date(t.date+'T12:00:00').toLocaleDateString('de-DE'))+'</td><td>'+esc(t.route)+'</td><td>'+String(t.km).replace('.',',')+'</td><td>'+((t.odoStart??'–')+' → '+(t.odoEnd??'–')).replace('.',',')+'</td><td><span class="fb-pill '+(t.type==='Privat'?'private':'')+'">'+esc(t.type)+'</span></td><td>'+esc(t.reason||'')+'</td></tr>').join(''):'<tr><td colspan="6">Für dieses Fahrzeug sind noch keine Fahrten gespeichert.</td></tr>';renderEvents();}
  function exportPdf(){const rows=visibleRows();const year=$('#fb-year-filter')?.value||'all';const w=window.open('','_blank');if(!w){setState('Bitte Pop-ups für den PDF-Export erlauben.','bad');return}w.document.write('<!doctype html><html lang="de"><head><meta charset="utf-8"><title>Fahrtenbuch '+esc(vehicles[selected].name)+'</title><style>body{font:12px Arial;color:#172b3a}h1{font-size:20px;margin-bottom:4px}p{color:#526574}table{width:100%;border-collapse:collapse}th,td{border:1px solid #b9c5cd;padding:6px;text-align:left;vertical-align:top}th{background:#edf2f5}@media print{button{display:none}}</style></head><body><h1>Fahrtenbuch – '+esc(vehicles[selected].name)+' · '+esc(vehicles[selected].plate)+'</h1><p>Jahr: '+esc(year==='all'?'Alle':year)+' · Erstellt: '+new Date().toLocaleString('de-DE')+'</p><table><thead><tr><th>Datum</th><th>Route / Orte</th><th>km</th><th>Odometer</th><th>Typ</th><th>Anlass</th></tr></thead><tbody>'+rows.map(t=>'<tr><td>'+esc(new Date(t.date+'T12:00:00').toLocaleDateString('de-DE'))+'</td><td>'+esc(t.route)+'</td><td>'+String(t.km).replace('.',',')+'</td><td>'+esc((t.odoStart??'–')+' → '+(t.odoEnd??'–'))+'</td><td>'+esc(t.type)+'</td><td>'+esc(t.reason||'')+'</td></tr>').join('')+'</tbody></table><script>window.onload=()=>window.print();<\\/script></body></html>');w.document.close();}
  const cleanAddress=value=>String(value||'').replace(/\s+/g,' ').trim();
  const hasAddress=e=>{const a=cleanAddress(e.location);return a.length>=6&&(/[0-9]{2,}/.test(a)||a.includes(',')||/[A-Za-zÄÖÜäöüß]{3,}\s+[A-Za-zÄÖÜäöüß]{3,}/.test(a));};
  async function calculateRoute(addresses){const response=await fetch('/intern/api/fahrtenbuch-route.php',{method:'POST',credentials:'same-origin',headers:{'Content-Type':'application/json'},body:JSON.stringify({home,addresses})});const data=await response.json().catch(()=>({}));if(!response.ok||!data.ok)return null;return{km:Number(data.km||0),addresses:Array.isArray(data.query_addresses)?data.query_addresses.slice(1,-1):addresses};}
  async function repairZeroTrips(){const candidates=trips.filter(t=>t.vehicle===selected&&Number(t.km||0)===0&&t.sourceKey&&String(t.route||'').includes('→'));if(!candidates.length)return;let changed=false;for(const t of candidates){const parts=String(t.route).split('→').map(cleanAddress).filter(Boolean);const stops=parts.length>2?parts.slice(1,-1):parts.slice(1);const result=await calculateRoute(stops);if(result&&result.km>0){t.km=result.km;t.route=[home,...result.addresses,home].join(' → ');changed=true;}}if(!changed)return;const ordered=candidates.filter(t=>Number(t.km||0)>0).sort((a,b)=>String(a.date).localeCompare(String(b.date)));for(let i=ordered.length-1;i>=0;i--){const t=ordered[i];const later=trips.filter(x=>x.vehicle===selected&&String(x.date)>String(t.date)&&Number(x.odoStart)>0).sort((a,b)=>Number(a.odoStart)-Number(b.odoStart))[0];const anchor=later?Number(later.odoStart):Math.max(Number(odometers[selected]||0),...trips.filter(x=>x.vehicle===selected).map(x=>Number(x.odoEnd)||0));t.odoEnd=Number(anchor.toFixed(1));t.odoStart=Number((anchor-t.km).toFixed(1));}odometers[selected]=Math.max(Number(odometers[selected]||0),...trips.filter(x=>x.vehicle===selected).map(x=>Number(x.odoEnd)||0));await save();}
  const groupByDay=list=>Object.values(list.reduce((groups,e)=>{(groups[e.date]??=[]).push(e);return groups;},{}));
  const importedKey=group=>selected+'|'+group.map(e=>e.id).sort().join(',');
  function renderEvents(){if(!events.length){$('#fb-events').textContent='Keine Outlook-Termine mit Adresse gefunden.';return}$('#fb-events').innerHTML=events.map(e=>'<div class="fb-event"><strong>'+esc(e.subject)+'</strong><small>'+esc(e.date)+' · '+esc(e.location)+'</small></div>').join('');}
  async function importEventGroups(groups){
    const all=groups.flat(),valid=all.filter(hasAddress);
    if(!valid.length){setState('Keine Termine mit Adresse übernommen.','bad');return}
    const prepared=[];let skipped=0,discarded=all.length-valid.length,failed=0;
    for(const [groupIndex,group] of groups.entries()){
      setState(`Tagesfahrt ${groupIndex+1} von ${groups.length} wird berechnet …`);
      const usable=group.filter(hasAddress);if(!usable.length)continue;
      const sourceKey=importedKey(usable);if(trips.some(t=>t.sourceKey===sourceKey)){skipped++;continue}
      const ordered=usable.slice().sort((a,b)=>String(a.start||a.date).localeCompare(String(b.start||b.date)));
      const stops=[];for(const e of ordered){const a=cleanAddress(e.location);if(a&&!stops.includes(a))stops.push(a)}
      if(!stops.length)continue;
      const routeResult=await calculateRoute(stops);if(!routeResult||routeResult.km<=0){failed++;discarded+=usable.length;continue}
      const km=Number(routeResult.km.toFixed(1));
      const route=[home,...routeResult.addresses,home].join(' → ');
      const vacation=ordered.some(e=>/urlaub|ferien/i.test((e.subject||'')+' '+(e.location||'')));
      prepared.push({sourceKey,ordered,route,km,type:vacation?'Privat':'Geschäftlich'});
    }
    if(!prepared.length){setState('Keine neuen Outlook-Termine zur Übernahme vorhanden.','ok');return}
    // Rückwärts rechnen: Der aktuelle km-Stand ist der Endstand der jüngsten Fahrt.
    prepared.sort((a,b)=>String(a.ordered[0].date).localeCompare(String(b.ordered[0].date)));
    let cursor=Number(odometers[selected]||0)||null;const created=[];
    for(let i=prepared.length-1;i>=0;i--){const item=prepared[i];const odoEnd=cursor===null?null:Number(cursor.toFixed(1));const odoStart=cursor===null?null:Number((cursor-item.km).toFixed(1));created.push({...item,odoStart,odoEnd});if(odoStart!==null)cursor=odoStart;}
    const stamp=Date.now();created.reverse().forEach((item,i)=>trips.push({id:'outlook-'+stamp+'-'+i,sourceKey:item.sourceKey,sourceEventIds:item.ordered.map(e=>e.id),vehicle:selected,date:item.ordered[0].date,start:item.ordered[0].start,route:item.route,km:item.km,odoStart:item.odoStart,odoEnd:item.odoEnd,type:item.type,reason:item.ordered.map(e=>e.subject).join(' · ')}));
    if(cursor!==null)odometers[selected]=cursor;
    try{await save();render();setState(prepared.length+' Tagesfahrten dauerhaft übernommen'+(discarded?' · '+discarded+' Termine ohne Adresse verworfen':'')+(failed?' · '+failed+' Tagesfahrten konnten nicht berechnet werden':'')+(skipped?' · '+skipped+' bereits vorhanden übersprungen':'')+'.',failed?'bad':'ok');}
    catch(error){render();setState(error.message||'Import lokal gespeichert, aber nicht dauerhaft bestätigt.','bad');}
  }
  async function loadOutlook(){const year=$('#fb-year').value,month=$('#fb-month').value,start=year+'-'+month+'-01';setState('Outlook wird über das SV-Portal abgefragt …');const begin=new Date(start+'T12:00:00');const end=new Date();const all=[];for(let d=new Date(begin);d<end;d.setDate(d.getDate()+7)){const response=await fetch('/intern/api/outlook-case-calendar.php?action=list&start='+encodeURIComponent(d.toISOString().slice(0,10)),{credentials:'same-origin'});const data=await response.json().catch(()=>({}));if(!response.ok||!data.ok)throw new Error(data.error||'Outlook-Kalender konnte nicht geladen werden.');for(const event of(data.events||[])){const id=event.id||event.subject+'|'+event.start;if(!all.some(x=>x.id===id))all.push({id,subject:event.subject||'(Ohne Titel)',location:cleanAddress(event.location),date:(event.start||'').slice(0,10),start:event.start||''});}}events=all.filter(hasAddress);const removed=all.length-events.length;renderEvents();setState(events.length+' Outlook-Termine geladen. Mit „Alle mit Adresse übernehmen“ einmalig bestätigen.'+(removed?' '+removed+' Termine ohne Adresse wurden ausgeblendet.':''),'ok');}

  $('#fb-import-all').onclick=async()=>{if(!events.length){setState('Bitte zuerst Outlook-Termine laden.','bad');return}const button=$('#fb-import-all');button.disabled=true;try{setState('Alle Outlook-Termine werden berechnet und übernommen …');await importEventGroups(groupByDay(events));}catch(e){setState(e.message||'Import konnte nicht abgeschlossen werden.','bad')}finally{button.disabled=false}}; $('#fb-year-filter').onchange=render; $('#fb-export-pdf').onclick=exportPdf; $('#fb-odo-save').onclick=()=>{const value=Number($('#fb-odo').value);if(!Number.isFinite(value)||value<0){setState('Bitte einen gültigen km-Stand eingeben.','bad');return}odometers[selected]=Math.round(value);localStorage.setItem('svnet-fahrtenbuch-odometers',JSON.stringify(odometers));save().then(()=>setState('km-Stand dauerhaft gespeichert.','ok')).catch(e=>setState(e.message||'km-Stand konnte nicht dauerhaft gespeichert werden.','bad'));$('#fb-odo-state').textContent=Math.round(value).toLocaleString('de-DE')+' km';setState('km-Stand gespeichert.','ok')}; $('#fb-outlook').onclick=()=>$('#fb-outlook-modal').hidden=false; $('#fb-free').onclick=()=>$('#fb-free-modal').hidden=false; $('#fb-home').onclick=()=>{$('#fb-home-input').value=home;$('#fb-home-modal').hidden=false}; document.querySelectorAll('[data-close]').forEach(b=>b.onclick=()=>$('#'+b.dataset.close).hidden=true); $('#fb-load').onclick=async()=>{try{$('#fb-outlook-modal').hidden=true;await loadOutlook()}catch(e){setState(e.message||'Outlook konnte nicht geladen werden.','bad')}}; $('#fb-home-form').onsubmit=e=>{e.preventDefault();home=$('#fb-home-input').value.trim();localStorage.setItem(homeKey,home);save().then(()=>setState('Heimatadresse dauerhaft gespeichert.','ok')).catch(e=>setState(e.message||'Heimatadresse konnte nicht dauerhaft gespeichert werden.','bad'));$('#fb-home-modal').hidden=true;setState('Heimatadresse gespeichert.','ok')}; $('#fb-form').onsubmit=e=>{e.preventDefault();const f=new FormData(e.target);const km=Number(f.get('km')||0); const odoStart=Number(odometers[selected]||0)||null; const odoEnd=odoStart===null?null:odoStart+km; trips.unshift({id:'manual-'+Date.now(),vehicle:selected,date:f.get('date'),route:f.get('route'),km,odoStart,odoEnd,type:f.get('type'),reason:f.get('reason')||''}); if(odoEnd!==null){odometers[selected]=odoEnd;localStorage.setItem('svnet-fahrtenbuch-odometers',JSON.stringify(odometers));}save().then(()=>setState('Freie Fahrt dauerhaft gespeichert.','ok')).catch(e=>setState(e.message||'Freie Fahrt konnte nicht dauerhaft gespeichert werden.','bad'));$('#fb-free-modal').hidden=true;e.target.reset();render();setState('Freie Fahrt gespeichert.','ok')}; render(); loadRemote().then(async()=>{await repairZeroTrips();render();});
})();
</script>
