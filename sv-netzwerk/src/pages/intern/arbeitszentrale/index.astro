---
import InternalLayout from '../../../layouts/InternalLayout.astro';
---

<InternalLayout title="Tagescockpit – Arbeitsorganisation" description="Wiedervorlagen, Fallsuche, Qualitätsprüfung und Vor-Ort-Notizen an einem Ort." currentPath="/intern/tagescockpit/">
  <main class="wc-app">
    <header class="wc-head">
      <div><p class="wc-kicker">Tagescockpit</p><h1>Arbeitsorganisation</h1><p id="wc-profile">Persönlicher Arbeitsstand wird geladen …</p></div>
      <button id="wc-refresh" type="button">Alles aktualisieren</button>
    </header>

    <nav class="wc-modes" aria-label="Tagescockpit Ansichten">
      <a href="/intern/tagescockpit/">Übersicht</a>
      <a class="active" href="/intern/arbeitszentrale/">Arbeitsorganisation</a>
    </nav>

    <section class="wc-system-strip" aria-label="Systemstatus">
      <strong>Systemstatus</strong>
      <div class="wc-system" data-system="drive"><i></i><span>Drive wird geprüft …</span></div>
      <div class="wc-system" data-system="outlook"><i></i><span>Outlook wird geprüft …</span></div>
      <div class="wc-system" data-system="claims"><i></i><span>ClaimsForce wird geprüft …</span></div>
      <div class="wc-system" data-system="revenue"><i></i><span>Abrechnung wird geprüft …</span></div>
      <small id="wc-auto-run"></small>
    </section>

    <section class="wc-stats" aria-label="Arbeitsstand">
      <article><span>Offen</span><strong id="wc-open">–</strong><small>Wiedervorlagen</small></article>
      <article><span>Heute fällig</span><strong id="wc-today">–</strong><small>direkt bearbeiten</small></article>
      <article><span>Überfällig</span><strong id="wc-overdue">–</strong><small>Priorität prüfen</small></article>
      <article><span>Erledigt</span><strong id="wc-done">–</strong><small>letzte 30 Tage</small></article>
      <article><span>Fallqualität</span><strong id="wc-quality">–</strong><small>letzte Fälle vollständig</small></article>
    </section>

    <nav class="wc-tabs" aria-label="Werkzeuge">
      <button class="active" data-tab="search" type="button">Globale Fallsuche</button>
      <button data-tab="quality" type="button">Qualitätsprüfung</button>
      <button data-tab="field" type="button">Vor Ort</button>
      <button data-tab="control" type="button">Controlling</button>
    </nav>

    <section class="wc-panel active" data-panel="search">
      <div class="wc-card"><div class="wc-title"><span>1</span><h2>Alle eigenen Fälle durchsuchen</h2></div><form id="wc-search-form" class="wc-search"><input id="wc-search" minlength="2" placeholder="Schaden-Nr., VN, Objekt, Ort oder Versicherer" /><button type="submit">Suchen</button></form><div id="wc-search-results" class="wc-results"><p class="wc-empty">Mindestens zwei Zeichen eingeben.</p></div></div>
    </section>

    <section class="wc-panel" data-panel="quality">
      <div class="wc-card"><div class="wc-title"><span>1</span><h2>Aktiven Fall prüfen</h2></div><p id="wc-quality-case" class="wc-context">Noch kein Fall geöffnet.</p><div id="wc-quality-results"><p class="wc-empty">Öffne zuerst einen Fall über die Versicherungsfälle oder die Fallsuche.</p></div><p class="wc-hint">Die Prüfung weist auf offene oder widersprüchliche Angaben hin. Sie verändert und sperrt keine Berichts- oder Versandfunktion.</p></div>
    </section>

    <section class="wc-panel" data-panel="field">
      <div class="wc-card"><div class="wc-title"><span>1</span><h2>Vor-Ort-Notizen zum aktiven Fall</h2></div><p id="wc-field-case" class="wc-context">Noch kein Fall geöffnet.</p><label>Notizen<textarea id="wc-field-note" rows="12" maxlength="50000" placeholder="Feststellungen, Maße, Beteiligte und nächste Schritte …"></textarea></label><div class="wc-actions"><button id="wc-dictate" type="button">Diktat starten</button><button id="wc-note-save" type="button">Notiz speichern</button><button id="wc-note-copy" class="secondary" type="button">Text kopieren</button></div><label class="wc-upload">Fotos oder Unterlagen zum Fall ablegen<input id="wc-field-files" type="file" multiple accept="image/*,.pdf,.doc,.docx,.xlsx" /></label><button id="wc-field-upload" type="button">Ausgewählte Dateien speichern</button><p id="wc-field-state" class="wc-state" aria-live="polite"></p></div>
    </section>

    <section class="wc-panel" data-panel="control">
      <div class="wc-card"><div class="wc-title"><span>1</span><h2>Arbeitscontrolling</h2></div><div id="wc-control" class="wc-control"><p class="wc-empty">Kennzahlen werden aus Wiedervorlagen und den zuletzt bearbeiteten Fällen berechnet …</p></div><p class="wc-hint">Die Kennzahlen sind Arbeitskennzahlen, keine Umsatz- oder Leistungsabrechnung.</p></div>
    </section>
  </main>
</InternalLayout>

<style is:global>
  .wc-app{box-sizing:border-box;min-height:calc(100vh - 112px);padding:26px;color:#17324a}.wc-head{display:flex;align-items:flex-end;justify-content:space-between;gap:18px;margin-bottom:17px}.wc-kicker{margin:0;color:#f59a23;font-size:.82rem;font-weight:900;text-transform:uppercase;letter-spacing:.05em}.wc-head h1{margin:3px 0;font-size:2.1rem}.wc-head p{margin:0;color:#647789}.wc-head button,.wc-actions button,.wc-search button,.wc-card>button{border:1px solid #17324a;background:#17324a;color:#fff;padding:10px 13px;font:inherit;font-weight:800;cursor:pointer}.wc-stats{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:10px;margin-bottom:14px}.wc-stats article{padding:14px 15px;border-top:4px solid #f59a23;background:#fff}.wc-stats span,.wc-stats small{display:block;color:#647789}.wc-stats span{font-size:.76rem;font-weight:800}.wc-stats strong{display:block;margin:3px 0;color:#071a2e;font-size:1.55rem}.wc-stats small{font-size:.7rem}.wc-tabs{display:flex;gap:4px;overflow-x:auto;margin-bottom:14px;padding-bottom:2px}.wc-tabs button{white-space:nowrap;border:1px solid #bdc9d2;background:#fff;color:#17324a;padding:10px 13px;font:inherit;font-weight:800;cursor:pointer}.wc-tabs button.active{border-color:#17324a;background:#17324a;color:#fff}.wc-panel{display:none}.wc-panel.active{display:block}.wc-grid{display:grid;grid-template-columns:minmax(300px,.75fr) minmax(440px,1.25fr);gap:14px}.wc-card{padding:18px;border:1px solid #d5dde3;background:#fff}.wc-title{display:flex;align-items:center;gap:9px;margin-bottom:15px}.wc-title span{display:grid;width:29px;height:29px;place-items:center;background:#17324a;color:#fff;font-weight:900}.wc-title h2{margin:0;color:#071a2e;font-size:1.12rem}.wc-card label{display:grid;gap:5px;margin:11px 0;color:#52697a;font-size:.78rem;font-weight:800}.wc-card input,.wc-card select,.wc-card textarea{box-sizing:border-box;width:100%;border:1px solid #bac7d0;background:#fff;color:#17324a;padding:10px;font:inherit}.wc-card textarea{resize:vertical}.wc-form-row{display:grid;grid-template-columns:1fr 150px;gap:10px}.wc-check{display:flex!important;align-items:center;grid-template-columns:auto 1fr!important}.wc-check input{width:auto}.wc-actions{display:flex;flex-wrap:wrap;gap:8px;margin-top:12px}.wc-actions .secondary{background:#fff;color:#17324a}.wc-state{min-height:1.2em;margin:10px 0 0;color:#647789;font-size:.76rem}.wc-state.bad{color:#ae382f}.wc-state.ok{color:#24713c}.wc-list,.wc-results{display:grid;gap:8px}.wc-item,.wc-result{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:11px;border-left:4px solid #93a3af;background:#f3f6f8}.wc-item[data-priority="hoch"]{border-left-color:#d38a17}.wc-item[data-priority="dringend"],.wc-item.overdue{border-left-color:#b63c35}.wc-item.done{opacity:.65}.wc-item strong,.wc-result strong{display:block;color:#071a2e}.wc-item small,.wc-result small{display:block;margin-top:3px;color:#647789}.wc-item .wc-actions{flex:0 0 auto;margin:0}.wc-item button,.wc-result button{border:1px solid #17324a;background:#fff;color:#17324a;padding:7px 9px;font:inherit;font-size:.72rem;font-weight:800;cursor:pointer}.wc-empty{margin:0;padding:18px;background:#f3f6f8;color:#718291}.wc-search{display:grid;grid-template-columns:1fr auto;gap:8px;margin-bottom:14px}.wc-context{padding:11px;border-left:4px solid #f59a23;background:#fff7e9}.wc-checks{display:grid;gap:7px}.wc-check-row{padding:10px;border-left:4px solid #2f8a4b;background:#f1f7f2}.wc-check-row.warn{border-left-color:#d38a17;background:#fff7e9}.wc-check-row.bad{border-left-color:#b63c35;background:#fff0ed}.wc-hint{margin:15px 0 0;padding:10px;border-left:3px solid #9baab5;background:#f3f6f8;color:#647789;font-size:.75rem}.wc-upload{margin-top:17px!important;padding:12px;background:#f3f6f8}.wc-control{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:10px}.wc-control article{padding:15px;border-top:4px solid #f59a23;background:#f3f6f8}.wc-control strong,.wc-control span{display:block}.wc-control strong{font-size:1.5rem}.wc-control span{margin-top:3px;color:#647789;font-size:.75rem}@media(max-width:1150px){.wc-stats{grid-template-columns:repeat(3,1fr)}.wc-grid{grid-template-columns:1fr}}@media(max-width:700px){.wc-app{padding:14px}.wc-head{align-items:flex-start;flex-direction:column}.wc-stats,.wc-control{grid-template-columns:1fr 1fr}.wc-form-row{grid-template-columns:1fr}.wc-item,.wc-result{align-items:flex-start;flex-direction:column}.wc-search{grid-template-columns:1fr}}
  .wc-modes{display:flex;gap:5px;margin:-5px 0 10px;border-bottom:1px solid #cbd5dc}.wc-modes a{padding:9px 13px;color:#17324a;text-decoration:none;font-weight:900}.wc-modes a.active{background:#17324a;color:#fff}.wc-system-strip{display:grid;grid-template-columns:auto repeat(4,minmax(130px,1fr));align-items:center;gap:7px;margin-bottom:10px;padding:7px 9px;border-left:3px solid #f59a23;background:#fff}.wc-system-strip>strong{font-size:.78rem}.wc-system-strip>small{grid-column:1/-1;color:#718291;font-size:.68rem}.wc-system{display:flex;align-items:center;gap:6px;min-width:0;color:#52697a;font-size:.7rem}.wc-system i{width:8px;height:8px;flex:0 0 auto;border-radius:50%;background:#a6b2bc}.wc-system span{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.wc-system.ok i{background:#2f8a4b}.wc-system.warn i{background:#d38a17}.wc-system.bad i{background:#b63c35}@media(max-width:1000px){.wc-system-strip{grid-template-columns:auto repeat(2,minmax(130px,1fr))}.wc-system-strip>strong{grid-row:1/3}.wc-system-strip>small{grid-column:1/-1}}@media(max-width:700px){.wc-system-strip{grid-template-columns:1fr 1fr}.wc-system-strip>strong,.wc-system-strip>small{grid-column:1/-1;grid-row:auto}}
</style>

<script is:inline>
(() => {
  const API='/intern/api/work-center.php',DRIVE='/intern/api/google-drive-sync.php',$=id=>document.getElementById(id),esc=value=>String(value??'').replace(/[&<>"']/g,char=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[char]));
  const request=async(url,options={})=>{const response=await fetch(url,{credentials:'same-origin',cache:'no-store',...options}),data=await response.json().catch(()=>({}));if(!response.ok||data.ok===false)throw Error(data.error||`HTTP ${response.status}`);return data};
  const post=(action,body)=>request(`${API}?action=${action}`,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(body)});
  const readActive=()=>{for(const store of [sessionStorage,localStorage]){try{const value=JSON.parse(store.getItem('svnet-case')||'null');if(value?.folder_id)return value}catch{}}return null};
  const dateLabel=value=>new Intl.DateTimeFormat('de-DE',{dateStyle:'medium',timeStyle:'short'}).format(new Date(String(value).replace(' ','T')+'Z'));
  const localIso=date=>{const pad=n=>String(n).padStart(2,'0');return `${date.getFullYear()}-${pad(date.getMonth()+1)}-${pad(date.getDate())}`};
  const monday=value=>{const date=new Date(value);date.setHours(12,0,0,0);const day=date.getDay()||7;date.setDate(date.getDate()-day+1);return date};
  const nextImport=()=>{const now=new Date(),next=new Date(now);next.setHours(3,0,0,0);if(next<=now)next.setDate(next.getDate()+1);while(next.getDay()===0||next.getDay()===6)next.setDate(next.getDate()+1);return new Intl.DateTimeFormat('de-DE',{weekday:'short',day:'2-digit',month:'2-digit',hour:'2-digit',minute:'2-digit'}).format(next)};
  const setSystem=(key,kind,text)=>{const row=document.querySelector(`.wc-system[data-system="${key}"]`);if(!row)return;row.className=`wc-system ${kind}`;row.querySelector('span').textContent=text};
  let work={items:[],summary:{}},recent=[],active=readActive(),activeMeta=active?.meta||{};

  document.querySelectorAll('[data-tab]').forEach(button=>button.addEventListener('click',()=>{document.querySelectorAll('[data-tab]').forEach(node=>node.classList.toggle('active',node===button));document.querySelectorAll('[data-panel]').forEach(panel=>panel.classList.toggle('active',panel.dataset.panel===button.dataset.tab));if(button.dataset.tab==='quality')loadActive();if(button.dataset.tab==='field')loadNote()}));
  const openCase=row=>{const selected={folder_id:row.id||row.folder_id,meta:row.meta||{}};sessionStorage.setItem('svnet-case',JSON.stringify(selected));localStorage.setItem('svnet-case',JSON.stringify(selected));location.assign('/intern/versicherungsfaelle/')};

  async function loadWork(){work=await request(`${API}?action=list`);const summary=work.summary||{};$('wc-open').textContent=summary.open??0;$('wc-today').textContent=summary.due_today??0;$('wc-overdue').textContent=summary.overdue??0;$('wc-done').textContent=summary.completed_30d??0;$('wc-profile').textContent=`Arbeitsstand Profil ${work.profile||'–'}`;renderControl()}
  async function loadRecent(){const data=await request(`${DRIVE}?action=recent_cases`);recent=Array.isArray(data.results)?data.results:[];const complete=recent.filter(row=>quality(row.meta||{}).every(item=>item.kind!=='bad')).length;$('wc-quality').textContent=recent.length?`${complete}/${recent.length}`:'–';renderControl()}

  $('wc-search-form').addEventListener('submit',async event=>{event.preventDefault();const box=$('wc-search-results'),term=$('wc-search').value.trim();if(term.length<2){box.innerHTML='<p class="wc-empty">Mindestens zwei Zeichen eingeben.</p>';return}box.innerHTML='<p class="wc-empty">Suche läuft …</p>';try{const data=await request(`${DRIVE}?action=search_cases&q=${encodeURIComponent(term)}`),rows=data.results||[];box.innerHTML=rows.length?rows.map((row,index)=>`<article class="wc-result"><div><strong>${esc(row.meta?.schaden_nr||row.name)}</strong><small>${esc([row.meta?.vn_objekt,row.meta?.schaden_ort||row.meta?.ort,row.meta?.versicherer].filter(Boolean).join(' · '))}</small></div><button type="button" data-search-open="${index}">Öffnen</button></article>`).join(''):'<p class="wc-empty">Kein Fall gefunden.</p>';box.querySelectorAll('[data-search-open]').forEach(button=>button.onclick=()=>openCase(rows[Number(button.dataset.searchOpen)]))}catch(error){box.innerHTML=`<p class="wc-empty">${esc(error.message)}</p>`}});

  function quality(meta){const items=[],need=(key,label)=>{if(!String(meta[key]||'').trim())items.push({kind:'bad',text:`${label} fehlt`})};need('schaden_nr','Schaden-Nr.');need('vn_objekt','VN / Objekt');need('schadenart','Schadenart');if(!String(meta.schaden_ort||meta.ort||'').trim())items.push({kind:'bad',text:'Schadenort fehlt'});if(!String(meta.email||meta.telefon||meta.mobil||'').trim())items.push({kind:'warn',text:'Keine Kontaktmöglichkeit zum VN hinterlegt'});const values=Object.entries(meta).map(([key,value])=>`${key} ${String(value)}`).join(' ').toLowerCase();if(values.includes('regress')&&values.includes('regress nein')&&values.includes('regress offen'))items.push({kind:'bad',text:'Widerspruch: Regress ist zugleich „Nein“ und „offen“'});if(/mey\s*generalbau/.test(values)&&/kontakt@meygeneralbau\.de/.test(values))items.push({kind:'bad',text:'Mey Generalbau: kontakt@… darf nicht für die KVA-Freigabe verwendet werden; Empfänger ist backoffice@meygeneralbau.de'});if(/wert\s*1914[^\n]{0,80}300[^\n]{0,40}selbstbehalt/.test(values))items.push({kind:'warn',text:'300 € als Selbstbehalt behandeln, nicht als Wert 1914'});if(!items.some(item=>item.kind==='bad'))items.unshift({kind:'ok',text:'Grunddaten ohne blockierenden Hinweis'});return items}
  async function loadActive(){active=readActive();if(!active?.folder_id){$('wc-quality-case').textContent='Noch kein Fall geöffnet.';$('wc-quality-results').innerHTML='<p class="wc-empty">Öffne zuerst einen Fall.</p>';return}try{const data=await request(`${DRIVE}?action=load_case&id=${encodeURIComponent(active.folder_id)}`);activeMeta={...(active.meta||{}),...(data.case?.meta||{})};active={folder_id:active.folder_id,meta:activeMeta};const caseName=activeMeta.schaden_nr||'Fall ohne Schaden-Nr.';$('wc-quality-case').textContent=`${caseName} · ${activeMeta.vn_objekt||'VN / Objekt offen'}`;$('wc-field-case').textContent=`${caseName} · ${activeMeta.vn_objekt||'VN / Objekt offen'}`;const checks=quality(activeMeta);$('wc-quality-results').innerHTML=`<div class="wc-checks">${checks.map(item=>`<div class="wc-check-row ${item.kind}">${esc(item.text)}</div>`).join('')}</div>`}catch(error){$('wc-quality-results').innerHTML=`<p class="wc-empty">${esc(error.message)}</p>`}}

  async function loadNote(){await loadActive();if(!active?.folder_id)return;const state=$('wc-field-state');try{const data=await request(`${API}?action=note&case_folder_id=${encodeURIComponent(active.folder_id)}`);$('wc-field-note').value=data.draft?.note||'';state.textContent=data.draft?.updated_at?`Gespeicherter Stand: ${dateLabel(data.draft.updated_at)}`:'Noch keine Vor-Ort-Notiz gespeichert.'}catch(error){state.className='wc-state bad';state.textContent=error.message}}
  $('wc-note-save').addEventListener('click',async()=>{const state=$('wc-field-state');if(!active?.folder_id){state.textContent='Bitte zuerst einen Fall öffnen.';return}try{await post('note',{case_folder_id:active.folder_id,case_no:activeMeta.schaden_nr||'',note:$('wc-field-note').value});state.className='wc-state ok';state.textContent='Vor-Ort-Notiz sicher gespeichert.'}catch(error){state.className='wc-state bad';state.textContent=error.message}});
  $('wc-note-copy').addEventListener('click',async()=>{await navigator.clipboard.writeText($('wc-field-note').value);$('wc-field-state').textContent='Notiz kopiert.'});
  let recognition=null;$('wc-dictate').addEventListener('click',()=>{const Speech=window.SpeechRecognition||window.webkitSpeechRecognition;if(!Speech){$('wc-field-state').textContent='Diktat wird von diesem Browser nicht unterstützt.';return}if(recognition){recognition.stop();return}recognition=new Speech();recognition.lang='de-DE';recognition.continuous=true;recognition.interimResults=false;recognition.onresult=event=>{const text=[...event.results].slice(event.resultIndex).map(result=>result[0].transcript).join(' ');$('wc-field-note').value+=($('wc-field-note').value.trim()?' ':'')+text};recognition.onend=()=>{recognition=null;$('wc-dictate').textContent='Diktat starten'};recognition.start();$('wc-dictate').textContent='Diktat beenden'});
  $('wc-field-upload').addEventListener('click',async()=>{const files=[...$('wc-field-files').files],state=$('wc-field-state');if(!active?.folder_id){state.textContent='Bitte zuerst einen Fall öffnen.';return}if(!files.length){state.textContent='Bitte Dateien auswählen.';return}let saved=0,duplicates=0;try{for(const file of files){state.textContent=`Speichere ${saved+duplicates+1} von ${files.length}: ${file.name}`;const form=new FormData();form.append('folder_id',active.folder_id);form.append('last_modified',String(file.lastModified||0));form.append('file',file);const data=await request(`${DRIVE}?action=upload_case_document`,{method:'POST',body:form});data.duplicate?duplicates++:saved++}state.className='wc-state ok';state.textContent=`${saved} Datei(en) gespeichert${duplicates?` · ${duplicates} Dublette(n) übersprungen`:''}.`;$('wc-field-files').value=''}catch(error){state.className='wc-state bad';state.textContent=error.message}});

  function renderControl(){if(!work.summary||!recent.length)return;const incomplete=recent.filter(row=>quality(row.meta||{}).some(item=>item.kind==='bad')).length,ratio=recent.length?Math.round((recent.length-incomplete)/recent.length*100):0;$('wc-control').innerHTML=`<article><strong>${work.summary.open||0}</strong><span>offene Wiedervorlagen</span></article><article><strong>${work.summary.overdue||0}</strong><span>davon überfällig</span></article><article><strong>${work.summary.completed_30d||0}</strong><span>in 30 Tagen erledigt</span></article><article><strong>${recent.length-incomplete}/${recent.length}</strong><span>letzte Fälle ohne Pflichtfeldfehler</span></article><article><strong>${ratio} %</strong><span>Vollständigkeitsquote der Stichprobe</span></article><article><strong>${incomplete}</strong><span>Fälle mit Nacharbeit in der Stichprobe</span></article>`}
  async function loadSystems(){
    $('wc-auto-run').textContent=`Nächster ClaimsForce-Lauf: ${nextImport()} Uhr`;
    const checks=[
      ['drive',async()=>{const data=await request(`${DRIVE}?action=status`);return `Drive · ${data.folders?.cases?.items??0} Fälle`}],
      ['outlook',async()=>{const data=await request('/intern/api/outlook-case-calendar.php?action=list&start='+encodeURIComponent(localIso(monday(new Date()))));return `Outlook · ${data.events?.length||0} Termine`}],
      ['claims',async()=>{const data=await request('/intern/api/claimsforce-queue.php?action=summary'),items=data.items||[],open=items.reduce((sum,item)=>sum+(Number.isFinite(Number(item.open_count))?Number(item.open_count):0),0);return items.some(item=>item.open_count!==null)?`ClaimsForce · ${open} offen`:'ClaimsForce erreichbar'}],
      ['revenue',async()=>{const data=await request('/intern/api/revenue-summary-v2.php?action=access');const stamp=data.summary_type==='holger'?[data.claims?.updated_at,data.rekon?.updated_at].filter(Boolean).join(' · '):data.source_updated_at;return stamp?`Abrechnung · ${stamp}`:'Abrechnung erreichbar'}]
    ];
    const results=await Promise.allSettled(checks.map(([,check])=>check()));results.forEach((result,index)=>setSystem(checks[index][0],result.status==='fulfilled'?'ok':'bad',result.status==='fulfilled'?result.value:'nicht erreichbar'));
  }
  async function refresh(){const button=$('wc-refresh');button.disabled=true;try{await Promise.all([loadWork(),loadRecent(),loadSystems()]);await loadActive()}finally{button.disabled=false}}
  $('wc-refresh').addEventListener('click',refresh);refresh();
})();
</script>
