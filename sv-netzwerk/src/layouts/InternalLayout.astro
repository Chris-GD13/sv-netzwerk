---
import SEO from '../components/SEO.astro';
import { portalProject } from '../lib/internal/schema';
import logoSrc from '../assets/sv-netzwerk-logo-freigestellt-v3.svg';
import '../styles/global.css';
import '../styles/header.css';
import '../styles/internal-portal.css';

interface Props {
  title: string;
  description: string;
  currentPath?: string;
}

const props = Astro.props;
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#071a2e" />
    <meta name="color-scheme" content="light" />
    <SEO {...props} noindex={true} robotsContent="noindex,nofollow" />
    <style is:global>
      .intern-header__logout {
        appearance: none;
        padding: .55rem .8rem;
        border: 1px solid rgba(255, 255, 255, .6);
        border-radius: 999px;
        background: transparent;
        color: #fff;
        font: inherit;
        font-weight: 800;
        cursor: pointer;
      }
      .intern-header__logout:hover,
      .intern-header__logout:focus-visible { background: rgba(255, 255, 255, .12); }
      .intern-header__logout:disabled { cursor: wait; opacity: .7; }
    </style>
  </head>
  <body class="intern-body">
    <a class="skip-link" href="#intern-main">Zum Inhalt springen</a>
    <header class="intern-header">
      <div class="sv-container intern-header__inner">
        <div class="intern-header__brand">
          <a class="site-brand" href="/" aria-label="SV-Netzwerk – Startseite">
            <img class="intern-header__logo" src={logoSrc.src} alt="SV-Netzwerk" width="220" height="46" />
          </a>
          <div class="intern-header__meta">
            <p class="intern-header__eyebrow">Geschütztes Prüfportal</p>
            <strong>{portalProject.title}</strong>
            <small>{portalProject.objectName}</small>
          </div>
        </div>
        <nav aria-label="Interne Navigation" class="intern-header__nav">
          <a class="intern-header__nav-highlight" href="/intern/fensterpruefung-bonn/">Dashboard</a>
          <a class="intern-header__nav-highlight" href="/intern/kalkulation/">Kalkulation</a>
          <a class="intern-header__nav-highlight" href="/intern/versicherungsfaelle/">Versicherungen</a>
          <a class="intern-header__nav-highlight" href="/intern/api/outlook-case-calendar.php?action=open" target="_blank" rel="noreferrer" title="Den anhand der Anmeldung zugeordneten Outlook-Kalender öffnen">Kalender</a>
          <button class="intern-header__logout" id="intern-logout" type="button">Abmelden</button>
        </nav>
      </div>
    </header>
    <main id="intern-main">
      <slot />
    </main>
    <script src="/intern/versicherungsfaelle-enhancements.js" defer></script>
    <script src="/intern/case-document-browser.js" defer></script>
    <script src="/intern/bki-offline.js" defer></script>
    <script is:inline>
      document.getElementById('intern-logout')?.addEventListener('click', async (event) => {
        const button = event.currentTarget;
        if (!(button instanceof HTMLButtonElement)) return;
        button.disabled = true;
        button.textContent = 'Wird abgemeldet …';
        try {
          await fetch('/intern/api/auth.php?action=logout', {
            method: 'POST',
            credentials: 'same-origin',
            headers: { 'Content-Type': 'application/json' },
            body: '{}',
          });
        } finally {
          sessionStorage.removeItem('svnet-case');
          localStorage.removeItem('svnet-case');
          localStorage.removeItem('svnet-case-owner');
          window.location.assign('/intern/login/');
        }
      });
      if ('serviceWorker' in navigator) {
        window.addEventListener('load', () => navigator.serviceWorker.register('/sw.js', { scope: '/intern/' }).catch(() => {}));
      }
    </script>
  </body>
</html>
